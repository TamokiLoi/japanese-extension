{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "vite/client", "node"],
    // "@/*" only ever resolves inside src/web/ -- the shadcn/ui components
    // living there use this alias internally. Everything under src/popup/
    // keeps its existing relative imports; this doesn't change that.
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/web/*"]
    }
  },
  "include": ["src", "manifest.config.ts", "vite.config.ts"]
}
