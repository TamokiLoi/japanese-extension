{
  "episodeId": "rUcJ29JsClM",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "昨日は、福井県の一乗谷朝倉氏遺跡の話をしました。"
    },
    {
      "startSec": 12.5,
      "text": "ちょっと難しいなと思った人もいるかもしれません。"
    },
    {
      "startSec": 18.5,
      "text": "でも今日は、もうちょっと簡単な食べ物とか"
    },
    {
      "startSec": 24.1,
      "text": "旅行の楽しかった話をしたいと思います。"
    },
    {
      "startSec": 30.6,
      "text": "私は食べ物のために旅行をすることが多いです。"
    },
    {
      "startSec": 38.2,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 40.2,
      "text": "皆さんは旅行する時に、何のために旅行をしますか？"
    },
    {
      "startSec": 48.3,
      "text": "美味しいものを食べるため？色んな人に会うため？"
    },
    {
      "startSec": 53.6,
      "text": "ショッピングをするため？ミュージアムに行くため？"
    },
    {
      "startSec": 61.7,
      "text": "アウトドアをするため？"
    },
    {
      "startSec": 64.2,
      "text": "何のために皆さんは、旅行するのが好きですか？"
    },
    {
      "startSec": 69.3,
      "text": "私は食べ物と文化、古いものを見るのが大好きです。"
    },
    {
      "startSec": 77.1,
      "text": "食べ物と文化、ミュージアムも好きかな。"
    },
    {
      "startSec": 83.1,
      "text": "最近は本当にアウトドアをしたいです。"
    },
    {
      "startSec": 87.5,
      "text": "ハイキングに行ったり、キャンプをしたり"
    },
    {
      "startSec": 91.4,
      "text": "サーフィンもやってみたいですね。"
    },
    {
      "startSec": 94.3,
      "text": "ぜひ皆さんが好きな旅行、コメントで教えてください。"
    },
    {
      "startSec": 100.6,
      "text": "今日はちょっと、私の三月の旅行の話をしたいと思います。"
    },
    {
      "startSec": 107.4,
      "text": "まず二日間、福井県に行きました。"
    },
    {
      "startSec": 112.2,
      "text": "福井県は私、今まで行ったことがなかったので"
    },
    {
      "startSec": 118.5,
      "text": "食べたことがない、福井県で有名なものを"
    },
    {
      "startSec": 123.3,
      "text": "食べたいと思っていました。"
    },
    {
      "startSec": 126.5,
      "text": "で、食べたのは、ソースカツ丼です。"
    },
    {
      "startSec": 133.2,
      "text": "皆さん、カツ丼は食べたことありますか？"
    },
    {
      "startSec": 138.6,
      "text": "カツ(トンカツ)、これはポーク、"
    },
    {
      "startSec": 141.4,
      "text": "お肉をディープフライにして"
    },
    {
      "startSec": 144.9,
      "text": "ご飯の上にカツ、その上に濃いソース、たれをかけています。"
    },
    {
      "startSec": 153.3,
      "text": "これがソースカツ。"
    },
    {
      "startSec": 155.4,
      "text": "で、結構ジャンキーです。"
    },
    {
      "startSec": 159.2,
      "text": "カツは結構薄くて、外の油で揚げた部分が多いです。"
    },
    {
      "startSec": 168.3,
      "text": "結構ジャンキーな感じ。"
    },
    {
      "startSec": 171.3,
      "text": "めっちゃお腹が重くなりました。"
    },
    {
      "startSec": 174.6,
      "text": "でも美味しかった。"
    },
    {
      "startSec": 176.8,
      "text": "もう一つは、越前そばです。"
    },
    {
      "startSec": 183.1,
      "text": "越前そば、そばを食べました。"
    },
    {
      "startSec": 186.2,
      "text": "このそばは、本当に手作りで美味しかったな。"
    },
    {
      "startSec": 193.1,
      "text": "多分今まで食べたそばの中で一番美味しかった。"
    },
    {
      "startSec": 198.6,
      "text": "皆さんは日本のそば、食べたことありますか？"
    },
    {
      "startSec": 204.4,
      "text": "是非いいそばを食べてみてください。"
    },
    {
      "startSec": 209.4,
      "text": "いいそばとか安いそばって全然味が違います。"
    },
    {
      "startSec": 215.4,
      "text": "是非日本に来たときはいいおそば屋さんに行って"
    },
    {
      "startSec": 221.5,
      "text": "美味しいそばを食べて、"
    },
    {
      "startSec": 223.4,
      "text": "ちょっと日本人みたいにスーッて、ヒューッて"
    },
    {
      "startSec": 226.8,
      "text": "食べてみてください。"
    },
    {
      "startSec": 228.8,
      "text": "これを、ヒューって食べるのを「すする」と言います。"
    },
    {
      "startSec": 235.7,
      "text": "皆さんはヌードル、麺(めん)食べる時すすりますか？"
    },
    {
      "startSec": 243,
      "text": "パスタですすったらダメですよね。"
    },
    {
      "startSec": 246,
      "text": "日本のそばとかラーメン食べる時だけ"
    },
    {
      "startSec": 251.4,
      "text": "ヒューッ、ちょっとすすってみてください。"
    },
    {
      "startSec": 256.8,
      "text": "で、福井の次はずっと京都にいました。"
    },
    {
      "startSec": 261.6,
      "text": "私は京都出身なので、京都の有名な食べ物は"
    },
    {
      "startSec": 269.2,
      "text": "正直知らないです。"
    },
    {
      "startSec": 273.1,
      "text": "でもその代わり、京都ってインターナショナルな町です。"
    },
    {
      "startSec": 280.4,
      "text": "なので、タイ料理とトルコ料理を食べました。"
    },
    {
      "startSec": 287.3,
      "text": "岡山県は田舎なので、"
    },
    {
      "startSec": 290.4,
      "text": "結構外国のレストランを探すのが難しいです。"
    },
    {
      "startSec": 301,
      "text": "だから京都で、タイ料理とトルコ料理、美味しかったです。"
    },
    {
      "startSec": 307.4,
      "text": "めっちゃ美味しかった。"
    },
    {
      "startSec": 309.2,
      "text": "特に私は、トルコ料理がすごく好きだと思います。"
    },
    {
      "startSec": 315.4,
      "text": "サモサと、あとケバブ、もちろん食べました。"
    },
    {
      "startSec": 322.7,
      "text": "もうヤバかった、もう一回食べたい。"
    },
    {
      "startSec": 325,
      "text": "本当に毎週食べたいです。"
    },
    {
      "startSec": 329.2,
      "text": "でカレーも、すごく辛いカレーとナンを食べました。"
    },
    {
      "startSec": 337,
      "text": "やっぱり私はインドカレーとか、"
    },
    {
      "startSec": 340.4,
      "text": "トルコのスパイスがあるカレーの方が好きです。"
    },
    {
      "startSec": 346.5,
      "text": "日本のカレーも美味しいけど"
    },
    {
      "startSec": 348.6,
      "text": "やっぱりトルコの辛いカレー、"
    },
    {
      "startSec": 352.8,
      "text": "スパイスの味は本当にいいです。"
    },
    {
      "startSec": 357.6,
      "text": "タイのカレーももちろん美味しかったです。"
    },
    {
      "startSec": 361.4,
      "text": "グリーンカレーを私は食べました。"
    },
    {
      "startSec": 365.8,
      "text": "あとはタイのお米も、ジャスミン米も美味しいです。"
    },
    {
      "startSec": 374.9,
      "text": "日本のお米はやっぱり一番美味しいけど"
    },
    {
      "startSec": 380.1,
      "text": "他の国のお米を食べる時も"
    },
    {
      "startSec": 384,
      "text": "なんかテンションが上がります。"
    },
    {
      "startSec": 386.5,
      "text": "なんかちょっとこれ違う"
    },
    {
      "startSec": 388.3,
      "text": "なんかこれ、なんかちょっとこっちの方が"
    },
    {
      "startSec": 390.9,
      "text": "ナティーみたいな感じかな、みたいな"
    },
    {
      "startSec": 393.9,
      "text": "なんか色々ワクワクしながら食べるのが好きです。"
    },
    {
      "startSec": 399.4,
      "text": "他にも、美味しい京都のおもちとか色々食べました。"
    },
    {
      "startSec": 405.8,
      "text": "またこの話は他のエピソードでしたいと思います。"
    },
    {
      "startSec": 411.1,
      "text": "と言うことで最後までありがとうございます。"
    },
    {
      "startSec": 414.5,
      "text": "是非皆さんの好きな食べ物と旅行の話"
    },
    {
      "startSec": 420,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 422.6,
      "text": "いつもありがとう。"
    },
    {
      "startSec": 423.9,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
