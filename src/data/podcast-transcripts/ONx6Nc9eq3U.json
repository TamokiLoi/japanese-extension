{
  "episodeId": "ONx6Nc9eq3U",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4,
      "text": "良い一日を過ごしていますか？"
    },
    {
      "startSec": 7.4,
      "text": "どんな一日ですか？"
    },
    {
      "startSec": 9.7,
      "text": "気分はいいですか？"
    },
    {
      "startSec": 12.2,
      "text": "私は今日は元気です。"
    },
    {
      "startSec": 15.5,
      "text": "前の日曜日に、すっごくいい体験をしたので"
    },
    {
      "startSec": 22.8,
      "text": "今日はちょっとその話を"
    },
    {
      "startSec": 25.2,
      "text": "皆さんにしたいなと思っています。"
    },
    {
      "startSec": 29,
      "text": "前の日曜日に田舎のマーケット、"
    },
    {
      "startSec": 33.5,
      "text": "ファーマーズマーケットみたいな感じですね、"
    },
    {
      "startSec": 36.7,
      "text": "マーケットに行ってきました。"
    },
    {
      "startSec": 39.2,
      "text": "それに行った理由は"
    },
    {
      "startSec": 41.7,
      "text": "ジャックがクラフトビールが大好きなので"
    },
    {
      "startSec": 45.9,
      "text": "そのマーケットにクラフトビールのお店が来ている"
    },
    {
      "startSec": 51.8,
      "text": "と聞いたので行ってきました。"
    },
    {
      "startSec": 58,
      "text": "思っていたよりもすっごくいいマーケットで"
    },
    {
      "startSec": 63.3,
      "text": "とても勉強になりました。"
    },
    {
      "startSec": 67,
      "text": "そのマーケットは、岡山の笠岡市という場所にあります。"
    },
    {
      "startSec": 73.9,
      "text": "岡山の海にはたくさん島があるんですが"
    },
    {
      "startSec": 80.8,
      "text": "その小さな島に住んでいる人達のマーケットでした。"
    },
    {
      "startSec": 89.3,
      "text": "だからその島でできた野菜とか果物とか"
    },
    {
      "startSec": 95.7,
      "text": "島で採れた野菜を使ったスコーンとか"
    },
    {
      "startSec": 101,
      "text": "そういうローカルなおいしい食べ物、"
    },
    {
      "startSec": 105.3,
      "text": "島でできたクラフトビールとか"
    },
    {
      "startSec": 108.1,
      "text": "そういう物を売っているマーケットでした。"
    },
    {
      "startSec": 112.5,
      "text": "お店は八個しかなかったんですが、"
    },
    {
      "startSec": 117.5,
      "text": "40人くらいお客さんがいました。"
    },
    {
      "startSec": 121.7,
      "text": "面白いことに、そのお客さんたちはすぐ帰らない。"
    },
    {
      "startSec": 129.2,
      "text": "ずっと何時間もそこにいました。"
    },
    {
      "startSec": 134.1,
      "text": "私は初めて、そのマーケットに行ったので"
    },
    {
      "startSec": 138,
      "text": "最初、そこに行った時は"
    },
    {
      "startSec": 140.6,
      "text": "全然普通のお客さんに見えたんですが"
    },
    {
      "startSec": 145.4,
      "text": "よくよく見るとお客さんも"
    },
    {
      "startSec": 149.1,
      "text": "ほとんどがその島の人たちでした。"
    },
    {
      "startSec": 154.7,
      "text": "だからそこにいるお店の人も、お客さんも"
    },
    {
      "startSec": 159.1,
      "text": "みんな知り合い。"
    },
    {
      "startSec": 161.8,
      "text": "みんな知っています。"
    },
    {
      "startSec": 164.1,
      "text": "友達みたいな感じでした。"
    },
    {
      "startSec": 166.9,
      "text": "なんかすごく優しいコミュニティーでした。"
    },
    {
      "startSec": 173,
      "text": "お客さんは「私、このクラフトビール大好きだから"
    },
    {
      "startSec": 177.3,
      "text": "応援してるの、サポートしてるの」と言って"
    },
    {
      "startSec": 181.7,
      "text": "ビールを買っていました。"
    },
    {
      "startSec": 183.8,
      "text": "本当に優しいコミュニティーで"
    },
    {
      "startSec": 187.5,
      "text": "すっごく気持ちが良かった。"
    },
    {
      "startSec": 190.9,
      "text": "そこに行ってるみんな、笑っていたし、幸せで"
    },
    {
      "startSec": 195.8,
      "text": "美味しいたこ焼きとか焼きそばとか"
    },
    {
      "startSec": 199.7,
      "text": "クラフトビールとか、楽しんで食べたり飲んだりして"
    },
    {
      "startSec": 204.5,
      "text": "他の人とおしゃべりを楽しんでいました。"
    },
    {
      "startSec": 211.6,
      "text": "私は本当に「ああ、いいなぁ」と思って"
    },
    {
      "startSec": 217.9,
      "text": "本当に私もこういうコミュニティーに入りたい"
    },
    {
      "startSec": 223.9,
      "text": "いつか私もこういうコミュニティーを作りたいって"
    },
    {
      "startSec": 228.2,
      "text": "すごく思いました。"
    },
    {
      "startSec": 231.1,
      "text": "で、ジャックはビールが大好きなので"
    },
    {
      "startSec": 234.2,
      "text": "ビールを九杯(9 cups)飲んで帰りました。"
    },
    {
      "startSec": 243.5,
      "text": "酔っ払っていました。"
    },
    {
      "startSec": 245.1,
      "text": "もう四時間くらいそこにいたかな。"
    },
    {
      "startSec": 248.8,
      "text": "私達は初めてそこに行ったけど、みんな優しくて"
    },
    {
      "startSec": 253.7,
      "text": "私達に色々話をしてくれました。"
    },
    {
      "startSec": 257.9,
      "text": "ジャックはクラフトビールを作ることに興味があります。"
    },
    {
      "startSec": 264.8,
      "text": "ジャック、私の彼氏です。"
    },
    {
      "startSec": 267.3,
      "text": "なので、本当にクラフトビールを作っているおじさんと"
    },
    {
      "startSec": 273.1,
      "text": "たくさん話ができたのは、本当に良かったし"
    },
    {
      "startSec": 278.2,
      "text": "やっぱりクラフトビールを飲んで酔っ払っている"
    },
    {
      "startSec": 283.3,
      "text": "酔っ払う(to get drunk)"
    },
    {
      "startSec": 285.7,
      "text": "酔っ払っている日本のおじいちゃん達"
    },
    {
      "startSec": 290.9,
      "text": "お年寄りの人を見るのも"
    },
    {
      "startSec": 293.2,
      "text": "なんかちょっと新鮮な感じ、そんな感じだった。"
    },
    {
      "startSec": 298.9,
      "text": "日本ではあんまりクラフトビールは有名じゃなくて"
    },
    {
      "startSec": 303.7,
      "text": "スーパーに行っても"
    },
    {
      "startSec": 305.4,
      "text": "アサヒのビールとかキリンビールばっかりです。"
    },
    {
      "startSec": 310.1,
      "text": "私も小さい時はよく、おじいちゃんの家に"
    },
    {
      "startSec": 315.6,
      "text": "親せき(relatives)が来て"
    },
    {
      "startSec": 318.7,
      "text": "よくお酒を飲んでいましたが"
    },
    {
      "startSec": 321.8,
      "text": "いつもみんなキリンビールを飲んでいたんです。"
    },
    {
      "startSec": 325.9,
      "text": "なんか私は、キリンビールとか臭いと思って"
    },
    {
      "startSec": 329.9,
      "text": "苦いし好きじゃなくて、"
    },
    {
      "startSec": 332.6,
      "text": "でもクラフトビールって本当にユニークで面白くて"
    },
    {
      "startSec": 339.6,
      "text": "色んな味があって、色も違って"
    },
    {
      "startSec": 343.5,
      "text": "もう本当に色んな材料(ingredients)で試すことができます。"
    },
    {
      "startSec": 349.6,
      "text": "作ることができます。"
    },
    {
      "startSec": 352.5,
      "text": "私達が飲んだ一つのビールはオイスター"
    },
    {
      "startSec": 357.3,
      "text": "貝のオイスターを使ったビールのスタウトでした。"
    },
    {
      "startSec": 362.7,
      "text": "でも美味しかった。"
    },
    {
      "startSec": 363.9,
      "text": "びっくりしました。"
    },
    {
      "startSec": 365.6,
      "text": "本当にユニークで、"
    },
    {
      "startSec": 369.9,
      "text": "「あ、クラフトビールっていいなあ、"
    },
    {
      "startSec": 372.9,
      "text": "手作りって、ハンドメイドっていいな」って"
    },
    {
      "startSec": 377.7,
      "text": "最近よく思っています。"
    },
    {
      "startSec": 380.8,
      "text": "最後ビールの話になってしまいましたが"
    },
    {
      "startSec": 383.9,
      "text": "私はこういう地域(local)の"
    },
    {
      "startSec": 388.3,
      "text": "コミュニティーとか手作りが大好きで"
    },
    {
      "startSec": 393.3,
      "text": "すごく興味があります。"
    },
    {
      "startSec": 396.7,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 398.1,
      "text": "皆さんも手作り、好きですか？"
    },
    {
      "startSec": 401.2,
      "text": "良かったらコメントで教えてください。"
    },
    {
      "startSec": 406.1,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 407.9,
      "text": "また明日も聞いてね！"
    },
    {
      "startSec": 409.5,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 412,
      "text": "バイバイ！"
    }
  ]
}
