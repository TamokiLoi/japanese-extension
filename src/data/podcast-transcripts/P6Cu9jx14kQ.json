{
  "episodeId": "P6Cu9jx14kQ",
  "segments": [
    {
      "startSec": 0,
      "text": "はい、皆さんこんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.7,
      "text": "私は5年間、日本の塾(cram school)で"
    },
    {
      "startSec": 11.8,
      "text": "アルバイトをしていました。"
    },
    {
      "startSec": 13.9,
      "text": "5年間子供達に勉強を教えていました。"
    },
    {
      "startSec": 19.5,
      "text": "その時の話を今日は皆さんとシェアしたいと思います。"
    },
    {
      "startSec": 25.2,
      "text": "私が子供達に教えていて"
    },
    {
      "startSec": 28.6,
      "text": "一番びっくりしたことは"
    },
    {
      "startSec": 32.8,
      "text": "子供達が日本語、字を全然読めないことです。"
    },
    {
      "startSec": 40.1,
      "text": "字を読めないというか、文章が読めない、"
    },
    {
      "startSec": 43.9,
      "text": "長い文章が全然読めないことです。"
    },
    {
      "startSec": 49.2,
      "text": "もちろん皆さんも日本語を勉強してますよね。"
    },
    {
      "startSec": 54,
      "text": "やっぱり助詞(particles)って難しいですよね。"
    },
    {
      "startSec": 61.8,
      "text": "でもこれが難しいのは、皆さんだけじゃなくて"
    },
    {
      "startSec": 68.1,
      "text": "日本の子供達にとっても"
    },
    {
      "startSec": 70.6,
      "text": "大人にとってもすごく難しいです。"
    },
    {
      "startSec": 75.5,
      "text": "例えば私が塾で教えていた時"
    },
    {
      "startSec": 81.2,
      "text": "算数(Maths)の問題で"
    },
    {
      "startSec": 84.3,
      "text": "例えば「ある数に5を足して2をかけると30になります」"
    },
    {
      "startSec": 94,
      "text": "「このある数は何ですか？」という問題がありました。"
    },
    {
      "startSec": 99.2,
      "text": "まあ今ね「5を足して2をかければ…」"
    },
    {
      "startSec": 101.6,
      "text": "今適当に作りましたが、"
    },
    {
      "startSec": 104.5,
      "text": "こう言う問題は全然ね"
    },
    {
      "startSec": 108.8,
      "text": "子供達は解けない、分からないです。"
    },
    {
      "startSec": 112.9,
      "text": "はい、答えが分からない。"
    },
    {
      "startSec": 114.7,
      "text": "その式を作ることができないです。"
    },
    {
      "startSec": 121.3,
      "text": "これはね、私もちょっとびっくりしました。"
    },
    {
      "startSec": 126.1,
      "text": "で、やっぱりね、その理由は"
    },
    {
      "startSec": 130,
      "text": "特に最近の子供達は本を読まないですよね。"
    },
    {
      "startSec": 136.9,
      "text": "はい、これが一番大きな理由だと思います。"
    },
    {
      "startSec": 141.3,
      "text": "子供の時に本を読まない。"
    },
    {
      "startSec": 145.9,
      "text": "文章(長いsentences)は全然読まない、なので"
    },
    {
      "startSec": 154.4,
      "text": "自分で文章を読むことができない。"
    },
    {
      "startSec": 158.6,
      "text": "もうこういう子供たちがほとんどでした。"
    },
    {
      "startSec": 162.6,
      "text": "本当にびっくりしました。"
    },
    {
      "startSec": 165.4,
      "text": "でやっぱりその子達に"
    },
    {
      "startSec": 168.6,
      "text": "「じゃあいつもは何して遊ぶの？」って"
    },
    {
      "startSec": 173.4,
      "text": "聞いたことがあります。"
    },
    {
      "startSec": 176.2,
      "text": "するとその子達は、"
    },
    {
      "startSec": 179,
      "text": "いつもはYouTubeでゲームを見たりとか"
    },
    {
      "startSec": 184.2,
      "text": "Switchっていうゲームで遊んだりとかしてるって"
    },
    {
      "startSec": 188.9,
      "text": "言ってました。"
    },
    {
      "startSec": 193.7,
      "text": "私が小学生・中学生の時は"
    },
    {
      "startSec": 199.2,
      "text": "YouTubeとか全然まだなかったです。"
    },
    {
      "startSec": 203,
      "text": "あったけど、全然面白いビデオとかはなかったし"
    },
    {
      "startSec": 208.2,
      "text": "私はゲームも持ってなかったので"
    },
    {
      "startSec": 211.1,
      "text": "いつも本を読んだりとか"
    },
    {
      "startSec": 213.8,
      "text": "外で友達とドッジボールしたり"
    },
    {
      "startSec": 217.6,
      "text": "サッカーしたりして遊んでいました。"
    },
    {
      "startSec": 221.3,
      "text": "なのでう～ん、最近の子供達に私はちょっとね"
    },
    {
      "startSec": 226.9,
      "text": "ちょっと心配です。"
    },
    {
      "startSec": 229.9,
      "text": "やっぱり本を読まなかったらどうするんでしょうね…"
    },
    {
      "startSec": 236.7,
      "text": "例えば大人になった時に"
    },
    {
      "startSec": 239.8,
      "text": "自分で何か勉強をしないといけない時"
    },
    {
      "startSec": 244.3,
      "text": "やっぱり私は"
    },
    {
      "startSec": 246,
      "text": "本は一番いい勉強の方法だと思っています。"
    },
    {
      "startSec": 251.7,
      "text": "今はYouTubeにも色んな情報がありますが"
    },
    {
      "startSec": 256.4,
      "text": "やっぱりいい本の情報って本当にすごいですよね。"
    },
    {
      "startSec": 264,
      "text": "YouTubeにたくさんある"
    },
    {
      "startSec": 265.8,
      "text": "短くてすごくキャッチーな"
    },
    {
      "startSec": 268.8,
      "text": "クリックベイトなビデオとは"
    },
    {
      "startSec": 271,
      "text": "全然違いますよね。"
    },
    {
      "startSec": 273.5,
      "text": "やっぱりそれが"
    },
    {
      "startSec": 275.6,
      "text": "私が塾で先生をしていた時に"
    },
    {
      "startSec": 279.5,
      "text": "一番びっくりしたことでした。"
    },
    {
      "startSec": 282.6,
      "text": "まあでも皆さんはね"
    },
    {
      "startSec": 285.5,
      "text": "日本語の勉強頑張ってるし"
    },
    {
      "startSec": 288.6,
      "text": "それだけでも私はすごいと思います。"
    },
    {
      "startSec": 292.3,
      "text": "やっぱり言語(language)を勉強しようとする人って"
    },
    {
      "startSec": 299.3,
      "text": "私はいつも尊敬します。"
    },
    {
      "startSec": 303.6,
      "text": "やっぱり勉強しなくてもいいことだけど"
    },
    {
      "startSec": 307.7,
      "text": "そこに楽しみを見つけて"
    },
    {
      "startSec": 312,
      "text": "そこに自分でゴールを作って"
    },
    {
      "startSec": 315.2,
      "text": "毎日コツコツ、少しずつ頑張ってる人は"
    },
    {
      "startSec": 320.4,
      "text": "やっぱりすごいなと思います。"
    },
    {
      "startSec": 325.7,
      "text": "本当に私が塾で教えた子達も"
    },
    {
      "startSec": 329.4,
      "text": "みんないい子なんだけど"
    },
    {
      "startSec": 331.7,
      "text": "これからどうするのかなと"
    },
    {
      "startSec": 334.2,
      "text": "本当にいつも心配でした。"
    },
    {
      "startSec": 336.9,
      "text": "またその子供達の話は"
    },
    {
      "startSec": 339.5,
      "text": "他のエピソードでしたいと思います。"
    },
    {
      "startSec": 343.3,
      "text": "じゃあ今日はこんな感じかな。"
    },
    {
      "startSec": 347.8,
      "text": "もし私のこのYouTubeで"
    },
    {
      "startSec": 352.1,
      "text": "このビデオを見ていて字幕の漢字が"
    },
    {
      "startSec": 356.4,
      "text": "「あ、ちょっと難しいな」と思ったら"
    },
    {
      "startSec": 359.1,
      "text": "ぜひPatreonをチェックしてください。"
    },
    {
      "startSec": 364.5,
      "text": "これからのエピソードのトランスクリプトに"
    },
    {
      "startSec": 369.5,
      "text": "漢字にふりがなを付けて"
    },
    {
      "startSec": 372.6,
      "text": "PDFで皆さんとシェアしたいと思います。"
    },
    {
      "startSec": 377.3,
      "text": "興味があったら"
    },
    {
      "startSec": 378.7,
      "text": "ぜひリンクからチェックしてください。"
    },
    {
      "startSec": 382.8,
      "text": "いつも本当にサポートして聞いてくれて"
    },
    {
      "startSec": 386.2,
      "text": "ありがとうございます。"
    },
    {
      "startSec": 387.8,
      "text": "じゃあ今日もね、自分に優しく"
    },
    {
      "startSec": 390.7,
      "text": "そして小さなことを楽しんで"
    },
    {
      "startSec": 393.9,
      "text": "素敵な一日にしてください。"
    },
    {
      "startSec": 396.4,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 398.3,
      "text": "またねバイバイ！"
    }
  ]
}
