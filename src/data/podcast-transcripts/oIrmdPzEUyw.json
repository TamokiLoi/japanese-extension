{
  "episodeId": "oIrmdPzEUyw",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.9,
      "text": "元気ですか？"
    },
    {
      "startSec": 5.3,
      "text": "今日も日本語のリスニング頑張りましょう。"
    },
    {
      "startSec": 9.8,
      "text": "今日は感動した時に使うことができる"
    },
    {
      "startSec": 16.6,
      "text": "六つ、六個の言葉を教えます。"
    },
    {
      "startSec": 22.5,
      "text": "感動する(to be touched, moved)"
    },
    {
      "startSec": 28.3,
      "text": "心が「ハッ、はぁ～」みたいな。"
    },
    {
      "startSec": 32.2,
      "text": "なんかとてもいい映画とか本を読んだら感動します。"
    },
    {
      "startSec": 39.8,
      "text": "じゃさっそく始めましょう。"
    },
    {
      "startSec": 43.6,
      "text": "一つ目は「泣きそう」、よく私は使います。"
    },
    {
      "startSec": 51.9,
      "text": "「〇〇そう(almost, about to)」"
    },
    {
      "startSec": 56.1,
      "text": "もうちょっとで食べそう"
    },
    {
      "startSec": 59.2,
      "text": "もうちょっとで携帯を、スマホを買ってしまいそう。"
    },
    {
      "startSec": 66.7,
      "text": "このそう「泣きそう」"
    },
    {
      "startSec": 70.1,
      "text": "「はぁ～やばいこの映画良すぎて泣きそう、ああやばい」"
    },
    {
      "startSec": 77.8,
      "text": "みたいな感じです「泣きそう」"
    },
    {
      "startSec": 82.4,
      "text": "じゃあ二つ目、これは似ています。"
    },
    {
      "startSec": 86.8,
      "text": "「泣ける」＝泣くことができる、泣ける"
    },
    {
      "startSec": 93.1,
      "text": "私を泣かせるみたいな意味です。"
    },
    {
      "startSec": 98.2,
      "text": "「あ、この映画良すぎて泣ける」"
    },
    {
      "startSec": 104.1,
      "text": "何かな、私最近「レオン」を見たんですが"
    },
    {
      "startSec": 108.7,
      "text": "レオンは泣けます。"
    },
    {
      "startSec": 110.9,
      "text": "最後めっちゃ泣きました。"
    },
    {
      "startSec": 113.4,
      "text": "いや～私は映画がすごく好きで"
    },
    {
      "startSec": 116.8,
      "text": "皆さんは好きですか？"
    },
    {
      "startSec": 119.4,
      "text": "最近は結構見たけど、すごくびっくりした映画は"
    },
    {
      "startSec": 125.3,
      "text": "「ジャンゴ」と「イングロリアス・バスターズ」です。"
    },
    {
      "startSec": 130.6,
      "text": "びっくりした、良かった、泣きました。"
    },
    {
      "startSec": 134.2,
      "text": "じゃあ三つ目。"
    },
    {
      "startSec": 135.5,
      "text": "三つ目は「ジーンとする」または「ジーンとくる」です。"
    },
    {
      "startSec": 145.4,
      "text": "この「ジーン」はもちろんオノマトペで、"
    },
    {
      "startSec": 151.5,
      "text": "心があったかくなるみたいな"
    },
    {
      "startSec": 155.9,
      "text": "心がジーンとするみたいな…わかりますか？"
    },
    {
      "startSec": 161.4,
      "text": "そんな感じです。"
    },
    {
      "startSec": 163.5,
      "text": "だから例えば、私は子供がいないですが"
    },
    {
      "startSec": 169,
      "text": "まだね、まだ若いからね。"
    },
    {
      "startSec": 171.4,
      "text": "もし子供がいて、その子が"
    },
    {
      "startSec": 174.4,
      "text": "あんまり人と話すのが苦手だった。"
    },
    {
      "startSec": 179.7,
      "text": "でもその子が公園で友達を見つけて"
    },
    {
      "startSec": 184.5,
      "text": "一緒に遊んでいるのを見て"
    },
    {
      "startSec": 187.5,
      "text": "私は「あ、なんかジーンとする、なんかジーンとくる」"
    },
    {
      "startSec": 193.9,
      "text": "「あ、なんか泣きそう」みたいな"
    },
    {
      "startSec": 196.4,
      "text": "ちょっと嬉しくて感動して、涙が出そうみたいな"
    },
    {
      "startSec": 202,
      "text": "心が温かくなるみたいな感じです。"
    },
    {
      "startSec": 208.1,
      "text": "じゃあ次四つ目、これも涙のフレーズです。"
    },
    {
      "startSec": 214.5,
      "text": "「うるうるする」"
    },
    {
      "startSec": 218,
      "text": "この「うるうる」、オノマトペで"
    },
    {
      "startSec": 221.2,
      "text": "目に涙がなんかたまっている、"
    },
    {
      "startSec": 225.8,
      "text": "目に涙が出てくる様子を表します。"
    },
    {
      "startSec": 232,
      "text": "うるうる、もう目に涙がいっぱいある。"
    },
    {
      "startSec": 235.8,
      "text": "「うるうるする」"
    },
    {
      "startSec": 237.5,
      "text": "例えばジャックが、今日は私のために"
    },
    {
      "startSec": 243.5,
      "text": "大きなケーキを作ってくれて"
    },
    {
      "startSec": 246.5,
      "text": "私に内緒＝秘密で、私のためにケーキを作って"
    },
    {
      "startSec": 253,
      "text": "サプライズをしてくれた。"
    },
    {
      "startSec": 256,
      "text": "だから私はちょっとうるうるしました。"
    },
    {
      "startSec": 259.5,
      "text": "うそだけど、これはexampleだけど。"
    },
    {
      "startSec": 262.8,
      "text": "「うるうるしました」みたいに使います。"
    },
    {
      "startSec": 266.6,
      "text": "で五つ目。"
    },
    {
      "startSec": 268.5,
      "text": "五つ目は「言葉にできない」"
    },
    {
      "startSec": 275.7,
      "text": "「もう言葉にできない」、意味はそのままです。"
    },
    {
      "startSec": 280.8,
      "text": "例えば私だったら"
    },
    {
      "startSec": 284.4,
      "text": "ジャックさんと会えたことは本当に良かったです。"
    },
    {
      "startSec": 290.6,
      "text": "だから例えばジャックのための手紙に"
    },
    {
      "startSec": 295.6,
      "text": "「いつも本当にありがとう」"
    },
    {
      "startSec": 298.3,
      "text": "「言葉にできないくらい本当に感謝しています」"
    },
    {
      "startSec": 305.3,
      "text": "言葉にできないくらい、"
    },
    {
      "startSec": 308.1,
      "text": "感謝＝ありがとう(grateful)"
    },
    {
      "startSec": 311.7,
      "text": "感謝しています、とかです。"
    },
    {
      "startSec": 314.4,
      "text": "まあちょっとロマンチックな感じです。"
    },
    {
      "startSec": 317.6,
      "text": "もし彼女・彼氏がいる人は使ってみてください。"
    },
    {
      "startSec": 324.5,
      "text": "そして最後のフレーズ、六つ目。"
    },
    {
      "startSec": 330.8,
      "text": "六つ目は「感激する」"
    },
    {
      "startSec": 335.9,
      "text": "「感激する」は「感動する」とちょっと似てる、同じ意味です。"
    },
    {
      "startSec": 342.8,
      "text": "例えば家に帰ってジャックが"
    },
    {
      "startSec": 347.7,
      "text": "またサプライズだけど"
    },
    {
      "startSec": 349.5,
      "text": "ジャックがなんか私の誕生日のために"
    },
    {
      "startSec": 354.6,
      "text": "ケーキを作ったりとか、"
    },
    {
      "startSec": 357.2,
      "text": "風船(balloon)のたくさん用意したりとか"
    },
    {
      "startSec": 362.8,
      "text": "プレゼントを用意したりとかして"
    },
    {
      "startSec": 365.7,
      "text": "サプライズしてくれた。"
    },
    {
      "startSec": 367.7,
      "text": "だから「やったー！すごい！って感激した」"
    },
    {
      "startSec": 372.7,
      "text": "「もう嬉しくて感動して、感激しました」"
    },
    {
      "startSec": 378.1,
      "text": "みたいな感じで使います。"
    },
    {
      "startSec": 380.8,
      "text": "ジャックは結構サプライズが好きでしてくれます。"
    },
    {
      "startSec": 384.7,
      "text": "私がジャックの好きなところは"
    },
    {
      "startSec": 388.1,
      "text": "高いブランドのものを買ったりとか"
    },
    {
      "startSec": 392,
      "text": "そういうことじゃなくて、"
    },
    {
      "startSec": 394.2,
      "text": "いつも私が好きなもの、すごくパーソナルなものを"
    },
    {
      "startSec": 402.4,
      "text": "手作りしてくれたりします。"
    },
    {
      "startSec": 406,
      "text": "一回私が、お父さんが自分で作った話、"
    },
    {
      "startSec": 413.1,
      "text": "何だろう…絵本じゃないけど"
    },
    {
      "startSec": 417.3,
      "text": "私のためにお父さんが、短いストーリーを作って"
    },
    {
      "startSec": 423.6,
      "text": "それは雷様の話、lighteningの神様の話を"
    },
    {
      "startSec": 430,
      "text": "お父さんが作って"
    },
    {
      "startSec": 432.2,
      "text": "私に昔何回も話してくれたことがあります。"
    },
    {
      "startSec": 438.9,
      "text": "でそのストーリーの中に私が出てくるんですが"
    },
    {
      "startSec": 444.2,
      "text": "すごくかわいい話です。"
    },
    {
      "startSec": 446.9,
      "text": "それを一回ジャックにしたことがあります。"
    },
    {
      "startSec": 452,
      "text": "そしたらジャックはすごく気に入って"
    },
    {
      "startSec": 455.3,
      "text": "何年か前に私がジャックに会いに"
    },
    {
      "startSec": 460.3,
      "text": "オーストラリアに行った時に"
    },
    {
      "startSec": 463.7,
      "text": "ジャックはそのストーリーを"
    },
    {
      "startSec": 467,
      "text": "自分で絵を書いて漫画にして"
    },
    {
      "startSec": 470,
      "text": "私にプレゼントをしてくれたことがあります。"
    },
    {
      "startSec": 474.7,
      "text": "それは本当に感激して泣けたし"
    },
    {
      "startSec": 480.1,
      "text": "目がうるうるしたし、ジーンときて泣きました。"
    },
    {
      "startSec": 486.8,
      "text": "本当に素敵な彼氏です。"
    },
    {
      "startSec": 491.1,
      "text": "いつもすいません彼氏の話ばかり。"
    },
    {
      "startSec": 494.5,
      "text": "はい、最後まで聞いてくれて"
    },
    {
      "startSec": 496.7,
      "text": "ありがとうございました。"
    },
    {
      "startSec": 498.8,
      "text": "じゃあ今日も皆さん、良い一日を！"
    },
    {
      "startSec": 502.1,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 505.2,
      "text": "じゃあまたね！バイバイ！"
    }
  ]
}
