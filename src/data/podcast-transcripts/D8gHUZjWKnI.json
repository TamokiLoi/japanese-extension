{
  "episodeId": "D8gHUZjWKnI",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.5,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.2,
      "text": "元気ですか？"
    },
    {
      "startSec": 4.4,
      "text": "今日は残業(overwork)です。"
    },
    {
      "startSec": 9.1,
      "text": "会社の後の残業について話をしたいと思います。"
    },
    {
      "startSec": 15.5,
      "text": "昨日「けんそんの文化」の話をしました。"
    },
    {
      "startSec": 22.5,
      "text": "「自分を相手よりも低く言う文化が"
    },
    {
      "startSec": 27.1,
      "text": "日本にはありますよ」と話をしました。"
    },
    {
      "startSec": 31.8,
      "text": "今日は残業の話ですが、"
    },
    {
      "startSec": 36.1,
      "text": "「残業はいい」と思っている日本人も"
    },
    {
      "startSec": 41.3,
      "text": "たくさんいるんですね。"
    },
    {
      "startSec": 44.3,
      "text": "びっくりしますが、います。"
    },
    {
      "startSec": 47.5,
      "text": "「残業はいいこと、頑張っているからいいこと」と考える人"
    },
    {
      "startSec": 53.6,
      "text": "まだまだ日本にはいます。"
    },
    {
      "startSec": 57.4,
      "text": "例えば私のお姉ちゃん、私のお父さんのお姉ちゃんなので"
    },
    {
      "startSec": 63.2,
      "text": "私の叔母、叔母さんです。"
    },
    {
      "startSec": 67.1,
      "text": "叔母さんはずっと独身(single)です。"
    },
    {
      "startSec": 77,
      "text": "もう60歳くらいですが"
    },
    {
      "startSec": 80.6,
      "text": "もうずっと長く東京の会社で働いていました。"
    },
    {
      "startSec": 89.2,
      "text": "で、時々叔母さんに仕事の話を聞くんですが"
    },
    {
      "startSec": 97.8,
      "text": "おばさんの生活は本当に忙しくて"
    },
    {
      "startSec": 101.8,
      "text": "毎日夜の12時くらいに家に帰ってきます。"
    },
    {
      "startSec": 107.5,
      "text": "そこからご飯を作ったり家事をしたりするので"
    },
    {
      "startSec": 113.1,
      "text": "寝るのはいつも夜の2時、朝ですね。"
    },
    {
      "startSec": 118.7,
      "text": "朝の2時くらいです。"
    },
    {
      "startSec": 121.1,
      "text": "で、朝6時に起きて"
    },
    {
      "startSec": 124.5,
      "text": "多分7時くらいに家を出て会社に行きます。"
    },
    {
      "startSec": 129.2,
      "text": "もう人でいっぱいの、東京の電車で会社に行きます。"
    },
    {
      "startSec": 135.3,
      "text": "で、もちろんそういう生活をしているので"
    },
    {
      "startSec": 139.6,
      "text": "結構お姉ちゃん、叔母さんは病気になります。"
    },
    {
      "startSec": 144.6,
      "text": "もちろん、そうですよね。"
    },
    {
      "startSec": 146.8,
      "text": "全然寝ていないし、ストレスばかりの生活です。"
    },
    {
      "startSec": 151.9,
      "text": "私が「あー、大丈夫？」って聞くと「もちろん、大丈夫」"
    },
    {
      "startSec": 158.1,
      "text": "「もう大丈夫、大丈夫。でもこれが社会人だからね」"
    },
    {
      "startSec": 162.9,
      "text": "といつも言います。"
    },
    {
      "startSec": 165.5,
      "text": "「これが社会人だからね」って。"
    },
    {
      "startSec": 168.9,
      "text": "社会人は、朝早く家を出て"
    },
    {
      "startSec": 173.1,
      "text": "一日中頑張って働いて、夜遅くに帰る。"
    },
    {
      "startSec": 178.1,
      "text": "これが社会人つまり仕事をしてる、サラリーマンです。"
    },
    {
      "startSec": 184.2,
      "text": "これがもう当たり前(common, normal)と思っています。"
    },
    {
      "startSec": 192.6,
      "text": "で、私はそれを大学生の時に聞いて"
    },
    {
      "startSec": 196.5,
      "text": "「あ、絶対に会社で働きたくない」"
    },
    {
      "startSec": 200.3,
      "text": "「残業はしたくない」と思いました。"
    },
    {
      "startSec": 203.8,
      "text": "本当に自分の時間はないですよね。"
    },
    {
      "startSec": 207.8,
      "text": "でもその人生は、自分の人生ですよね。"
    },
    {
      "startSec": 212.6,
      "text": "そこが私は本当によく分からないです。"
    },
    {
      "startSec": 218,
      "text": "自分の人生なのに自分の時間がない。"
    },
    {
      "startSec": 223.2,
      "text": "これっておかしいですよね？"
    },
    {
      "startSec": 226,
      "text": "しかもお姉ちゃんは、自分のためじゃなくて"
    },
    {
      "startSec": 229.8,
      "text": "会社のために働いています。"
    },
    {
      "startSec": 234.9,
      "text": "なんかすごく悲しい人生だと私は思ったんです。"
    },
    {
      "startSec": 240.7,
      "text": "なので今私は、会社に入らないで"
    },
    {
      "startSec": 244.6,
      "text": "なんかいろいろコンテンツを作ったり"
    },
    {
      "startSec": 247.4,
      "text": "ポッドキャストを作ったりしているんですが。"
    },
    {
      "startSec": 251.5,
      "text": "私の友達にも残業をしている友達がたくさんいます。"
    },
    {
      "startSec": 260.2,
      "text": "私は大学で建築(architecture)を勉強しましたが"
    },
    {
      "startSec": 265.5,
      "text": "建築を作る会社は、日本では残業が本当に多いです。"
    },
    {
      "startSec": 273.7,
      "text": "私の大好きな友達も会社に就職したんですが"
    },
    {
      "startSec": 279.4,
      "text": "毎日夜の10時くらいまで"
    },
    {
      "startSec": 282.7,
      "text": "仕事をしていると言っていました。"
    },
    {
      "startSec": 288.4,
      "text": "悲しいですね。"
    },
    {
      "startSec": 290,
      "text": "その子はすっごく元気で明るい"
    },
    {
      "startSec": 292.8,
      "text": "面白い友達だったんですが"
    },
    {
      "startSec": 295.6,
      "text": "学生の時はよく旅行にも行っていました。"
    },
    {
      "startSec": 301,
      "text": "でも今は本当に疲れてしまって"
    },
    {
      "startSec": 306.7,
      "text": "「あ、もうこれ以上何もやりたくない」と言っていました。"
    },
    {
      "startSec": 312.5,
      "text": "「もう会社を辞めて、アルバイトしたい」と言っていました。"
    },
    {
      "startSec": 317.8,
      "text": "その友達の性格が"
    },
    {
      "startSec": 320.4,
      "text": "本当に変わってしまうくらい"
    },
    {
      "startSec": 323.2,
      "text": "毎日仕事をしていたと思います。"
    },
    {
      "startSec": 327,
      "text": "本当につらいです。"
    },
    {
      "startSec": 329,
      "text": "私は絶対にそれは嫌なので"
    },
    {
      "startSec": 332.4,
      "text": "自分でビジネスを作りたいって頑張ってるんですが…"
    },
    {
      "startSec": 337.8,
      "text": "じゃ今日のポッドキャストはここまでです。"
    },
    {
      "startSec": 341.3,
      "text": "もしエピソードの感想、皆さんが思ったこと"
    },
    {
      "startSec": 347.6,
      "text": "良かったらYouTubeのコメントで教えてください。"
    },
    {
      "startSec": 352.6,
      "text": "読むのを楽しみにしています。"
    },
    {
      "startSec": 355.1,
      "text": "じゃあいつもありがとうございます。"
    },
    {
      "startSec": 357.3,
      "text": "良い一日を！Don't work too hard！バイバイ！"
    }
  ]
}
