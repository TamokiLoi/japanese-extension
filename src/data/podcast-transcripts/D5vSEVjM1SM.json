{
  "episodeId": "D5vSEVjM1SM",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.4,
      "text": "今日は関西弁について話したいと思います。"
    },
    {
      "startSec": 11.2,
      "text": "皆さんは方言勉強するのは好きですか？"
    },
    {
      "startSec": 18.3,
      "text": "この前YouTubeライブをした時に"
    },
    {
      "startSec": 22.5,
      "text": "関西弁を少し話しました。"
    },
    {
      "startSec": 26.5,
      "text": "すると喜んでくれた人が多かったので"
    },
    {
      "startSec": 31.8,
      "text": "今日は関西弁を皆さんに教えたいと思います。"
    },
    {
      "startSec": 36.6,
      "text": "ちょっとメモ書いたので見ながら話します。"
    },
    {
      "startSec": 42.5,
      "text": "まず関西弁「あかん」意味分かりますか？"
    },
    {
      "startSec": 50.4,
      "text": "「あかん」はダメという意味です。"
    },
    {
      "startSec": 54.5,
      "text": "例えば「あ、それしたらダメ(Don't do that)」"
    },
    {
      "startSec": 60.6,
      "text": "これは「それしたらあかん、あかんあかん」"
    },
    {
      "startSec": 64.5,
      "text": "ってなります。"
    },
    {
      "startSec": 65.7,
      "text": "「あかんで」"
    },
    {
      "startSec": 68.8,
      "text": "関西人はよく「で」とか「やん」を使います。"
    },
    {
      "startSec": 73.8,
      "text": "私は京都出身なので関西弁を話します。"
    },
    {
      "startSec": 80.1,
      "text": "で次「ええ」。"
    },
    {
      "startSec": 83.9,
      "text": "「ええ」＝「いい(good)」の「ええ」です。"
    },
    {
      "startSec": 89,
      "text": "例えば「明日レイラの家行ってもいい？」"
    },
    {
      "startSec": 94,
      "text": "「あ、ええよ」"
    },
    {
      "startSec": 95.4,
      "text": "「いいよ」＝「ええよ」です。"
    },
    {
      "startSec": 98.5,
      "text": "とか「あ、その服めっちゃええやん」"
    },
    {
      "startSec": 103.7,
      "text": "これは「その服めっちゃいいですね」"
    },
    {
      "startSec": 107.6,
      "text": "「いいね」＝「ええやん」になります。"
    },
    {
      "startSec": 112.1,
      "text": "あと次「おもろい」"
    },
    {
      "startSec": 116.2,
      "text": "これは面白いです。"
    },
    {
      "startSec": 119.4,
      "text": "例えば「あ～この漫画めっちゃおもろい」"
    },
    {
      "startSec": 126.6,
      "text": "「面白い」じゃなくて「おもろい」と言います。"
    },
    {
      "startSec": 131.4,
      "text": "「レイラってめっちゃおもろい人やなあ」とか。"
    },
    {
      "startSec": 135.9,
      "text": "で次、これは知ってる人が多いかな。"
    },
    {
      "startSec": 141,
      "text": "「ほんま」これは「本当に」の意味です。"
    },
    {
      "startSec": 148,
      "text": "「これほんま美味しいわ」「ほんまに旨いわ」とか。"
    },
    {
      "startSec": 153,
      "text": "「レイラってイギリス人の彼氏いるの？」"
    },
    {
      "startSec": 157.1,
      "text": "「あ、ほんまやで」"
    },
    {
      "startSec": 158.2,
      "text": "「ほんまにいるで」みたいな感じかな。"
    },
    {
      "startSec": 162.9,
      "text": "で次、「ちゃう」「ちゃうちゃうちゃう」"
    },
    {
      "startSec": 165.8,
      "text": "「え、ちゃうで」"
    },
    {
      "startSec": 169.6,
      "text": "「ちゃう」は「違う」の意味です。"
    },
    {
      "startSec": 172.8,
      "text": "だから「レイラって二十歳？」"
    },
    {
      "startSec": 177.7,
      "text": "「え、ちゃうちゃう、二十歳ちゃうで」"
    },
    {
      "startSec": 180.7,
      "text": "二十四歳ですね。"
    },
    {
      "startSec": 183,
      "text": "こんな感じ。"
    },
    {
      "startSec": 184.7,
      "text": "で次は…あー、これも使うな。"
    },
    {
      "startSec": 190,
      "text": "「せや」「あ、せや」"
    },
    {
      "startSec": 193.8,
      "text": "これは「あ、そうだ」と同じ意味です。"
    },
    {
      "startSec": 199.1,
      "text": "何かを思いついた時"
    },
    {
      "startSec": 202.8,
      "text": "「あ、せや、メール返さへんと」みたいな。"
    },
    {
      "startSec": 207,
      "text": "「メール返さないと」"
    },
    {
      "startSec": 208.9,
      "text": "これは「メール返さへんと」になります。"
    },
    {
      "startSec": 213.6,
      "text": "「ない」を「へん」によく変えます。"
    },
    {
      "startSec": 219.5,
      "text": "「あ、これ食べへんと」＝「これ食べないと」"
    },
    {
      "startSec": 224.2,
      "text": "「明日学校行かへんの？」"
    },
    {
      "startSec": 227.4,
      "text": "「明日学校行かないの？」です。"
    },
    {
      "startSec": 230.9,
      "text": "うん…難しいね～"
    },
    {
      "startSec": 234.5,
      "text": "次「早(う)」これは「早く」の意味です。"
    },
    {
      "startSec": 242.7,
      "text": "だから「あ～早く早く、レイラ早く」"
    },
    {
      "startSec": 246.2,
      "text": "これは「レイラ、早う、早よ来て」"
    },
    {
      "startSec": 249.2,
      "text": "「早う、早う」です。"
    },
    {
      "startSec": 251.2,
      "text": "「早う」＝「早く」"
    },
    {
      "startSec": 254.1,
      "text": "「早う行こう」＝「早く行こう」です。"
    },
    {
      "startSec": 258.5,
      "text": "よく使うな～"
    },
    {
      "startSec": 260.5,
      "text": "あとは…「かまへん」"
    },
    {
      "startSec": 265,
      "text": "これは「構いません」の関西弁です。"
    },
    {
      "startSec": 270,
      "text": "「構わない」だから「大丈夫」と同じ意味。"
    },
    {
      "startSec": 275.4,
      "text": "例えば「あ、レイラ、今日遅れてゴメン」"
    },
    {
      "startSec": 280,
      "text": "「あ、かまへん、かまへん。気にしんといて」"
    },
    {
      "startSec": 283.8,
      "text": "「気にしないで」＝「気にしんといて」です。"
    },
    {
      "startSec": 290.4,
      "text": "「あ、かまへん、かまへん。大丈夫やって」"
    },
    {
      "startSec": 293.9,
      "text": "「そんなん、もう気にしといてな」"
    },
    {
      "startSec": 297.1,
      "text": "「私全然気にしてへんから」"
    },
    {
      "startSec": 300.4,
      "text": "めっちゃ関西弁ですね。"
    },
    {
      "startSec": 302.7,
      "text": "あとちょっと面白いのはアクセントとか"
    },
    {
      "startSec": 308.5,
      "text": "suffixだけじゃなくて言葉が変わります。"
    },
    {
      "startSec": 313.9,
      "text": "捨てる(to throw away)"
    },
    {
      "startSec": 316.3,
      "text": "捨てるは「ほかす」と言います。"
    },
    {
      "startSec": 321.2,
      "text": "「あ、ちょっとこれほかしといて」みたいな感じ。"
    },
    {
      "startSec": 327.6,
      "text": "後は、片付ける(to tidy up)"
    },
    {
      "startSec": 333.2,
      "text": "片付けるは「あ、ちょっとこれなおしといて」"
    },
    {
      "startSec": 339.2,
      "text": "「なおす」になります。"
    },
    {
      "startSec": 341.7,
      "text": "スタンダードの日本語で"
    },
    {
      "startSec": 343.6,
      "text": "「直す」＝\"to fix\"という意味だけど"
    },
    {
      "startSec": 347.9,
      "text": "関西弁の「なおす」＝\"to tidy up\"です。"
    },
    {
      "startSec": 353.2,
      "text": "だから全然違うんですよね。"
    },
    {
      "startSec": 356,
      "text": "皆さん、関西弁・方言が好きな人も多いと思うので"
    },
    {
      "startSec": 361.9,
      "text": "このエピソード、気に入ってくれたらうれしいです。"
    },
    {
      "startSec": 367.9,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 371,
      "text": "今パトレオン(Patreon)で皆さんに"
    },
    {
      "startSec": 373.8,
      "text": "全部のエピソードのトランスクリプトを作っています。"
    },
    {
      "startSec": 379.2,
      "text": "興味がある人は是非パトレオンのメンバーになって"
    },
    {
      "startSec": 383.4,
      "text": "トランスクリプトをゲットして"
    },
    {
      "startSec": 386.1,
      "text": "このショーをサポートとしてくれると"
    },
    {
      "startSec": 389,
      "text": "本当に嬉しいです。"
    },
    {
      "startSec": 391.4,
      "text": "是非よろしくお願いします。"
    },
    {
      "startSec": 393.1,
      "text": "じゃあいつもありがとう！"
    },
    {
      "startSec": 394.6,
      "text": "お仕事・勉強頑張って。良い一日を！"
    },
    {
      "startSec": 398.7,
      "text": "じゃあまたね、バイバイ！"
    }
  ]
}
