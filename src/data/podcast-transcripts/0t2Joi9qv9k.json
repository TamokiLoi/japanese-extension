{
  "episodeId": "0t2Joi9qv9k",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.2,
      "text": "今日は日本語の語順(word order)の話をしたいと思います。"
    },
    {
      "startSec": 13.6,
      "text": "皆さんちょっとこの四つの文を"
    },
    {
      "startSec": 19.3,
      "text": "英語に、皆さんの言葉に訳して(訳す=to translate)ください。"
    },
    {
      "startSec": 26.9,
      "text": "一つ目、私は昨日友達とカフェで抹茶を飲みました。"
    },
    {
      "startSec": 36.1,
      "text": "二つ目、カフェで友達と昨日私は抹茶を飲みました。"
    },
    {
      "startSec": 45.2,
      "text": "三つ目、友達と私は抹茶をカフェで昨日飲みました。"
    },
    {
      "startSec": 54.7,
      "text": "四つ目、昨日カフェで私は友達と抹茶を飲みました。"
    },
    {
      "startSec": 64,
      "text": "この全部四つの文の意味、分かりましたか？"
    },
    {
      "startSec": 72,
      "text": "全部意味同じでした。"
    },
    {
      "startSec": 76.1,
      "text": "分かりましたか？"
    },
    {
      "startSec": 77.1,
      "text": "全部同じ意味、でも語順が違っていました。"
    },
    {
      "startSec": 82,
      "text": "全然違っていました。"
    },
    {
      "startSec": 84.6,
      "text": "これが日本語の特徴です。"
    },
    {
      "startSec": 89,
      "text": "語順が違っても、文章の意味は全然変わらないです。"
    },
    {
      "startSec": 97.8,
      "text": "そのまま変わりません。"
    },
    {
      "startSec": 101,
      "text": "日本語の文章の意味を決めるのは"
    },
    {
      "startSec": 107.8,
      "text": "助詞(particles)です。"
    },
    {
      "startSec": 113.9,
      "text": "これは英語と全然違います。"
    },
    {
      "startSec": 117.3,
      "text": "英語は、for example if I say I drank Matcha, Matcha drank me."
    },
    {
      "startSec": 123.9,
      "text": "英語は語順が意味を決めます。"
    },
    {
      "startSec": 127.7,
      "text": "でも日本語は違う。"
    },
    {
      "startSec": 130,
      "text": "助詞が文章の意味を決める。"
    },
    {
      "startSec": 133.7,
      "text": "でもこの助詞を変えたら意味は変わります。"
    },
    {
      "startSec": 141.1,
      "text": "例えば、私は抹茶を飲みました。"
    },
    {
      "startSec": 147.9,
      "text": "でもこの「を」を「私」に付けると"
    },
    {
      "startSec": 154.4,
      "text": "私を抹茶は飲みました。"
    },
    {
      "startSec": 158.3,
      "text": "これはMatcha drank meです。"
    },
    {
      "startSec": 162.1,
      "text": "助詞が難しいけどポイント、大切なポイントです。"
    },
    {
      "startSec": 171,
      "text": "私も日本語、まだまだわからないこと"
    },
    {
      "startSec": 174.7,
      "text": "たくさんありますが、面白いなと思います。"
    },
    {
      "startSec": 179.1,
      "text": "でも皆さんが日本語を勉強した時は"
    },
    {
      "startSec": 183.4,
      "text": "動詞は文章の最後に言ってくださいと勉強したと思います。"
    },
    {
      "startSec": 190.6,
      "text": "文章、日本語を書く時、書く時はそれでオッケー。"
    },
    {
      "startSec": 195.7,
      "text": "でも話す時は結構、ぐちゃぐちゃ。"
    },
    {
      "startSec": 200.9,
      "text": "本当にいつも動詞が最後とは限らない。"
    },
    {
      "startSec": 207.5,
      "text": "動詞が最後じゃない時もあります。"
    },
    {
      "startSec": 210.6,
      "text": "特に話す時はです。"
    },
    {
      "startSec": 212.7,
      "text": "私のポッドキャストを聞いても多分"
    },
    {
      "startSec": 216.8,
      "text": "私の語順がバラバラなのは、分かると思います。"
    },
    {
      "startSec": 222.2,
      "text": "でも一番ナチュラルな日本語の語順は、これです。"
    },
    {
      "startSec": 227.3,
      "text": "1：トピック、2：タイム、3：コンパニオン、4：プレイスで、"
    },
    {
      "startSec": 233.4,
      "text": "5：オブジェクト、6：バーブ(verb)です。"
    },
    {
      "startSec": 236,
      "text": "これが一番ナチュラルに聞こえるけど、"
    },
    {
      "startSec": 240.9,
      "text": "これは本当に日本語を書く時です、主に(mainly)。"
    },
    {
      "startSec": 250.1,
      "text": "会話だったら、もうちょっとぐちゃぐちゃかな。"
    },
    {
      "startSec": 254.8,
      "text": "本当に、ここは難しい。"
    },
    {
      "startSec": 258.1,
      "text": "ニュアンスとかも大切になるので。"
    },
    {
      "startSec": 263.1,
      "text": "でもいいこと。"
    },
    {
      "startSec": 264.5,
      "text": "皆さんにとっていいことは"
    },
    {
      "startSec": 268,
      "text": "「あれ？このタイムの次は、プレイスだっけ？何だっけ？」"
    },
    {
      "startSec": 274.2,
      "text": "「何何何？」って語順が分からなくなった時は"
    },
    {
      "startSec": 278.8,
      "text": "もう心配しないで"
    },
    {
      "startSec": 281.5,
      "text": "次に頭に思い付いた、頭に来た単語を"
    },
    {
      "startSec": 286.6,
      "text": "そのまま言ったら大丈夫。"
    },
    {
      "startSec": 288.8,
      "text": "語順は気にしなくて全然大丈夫です。"
    },
    {
      "startSec": 292.7,
      "text": "これは日本語のいいところで難しいところです。"
    },
    {
      "startSec": 298.5,
      "text": "最近私は本を読んでいます。"
    },
    {
      "startSec": 302,
      "text": "日本語がどこから来た？"
    },
    {
      "startSec": 305.1,
      "text": "例えば三千年前、二千年前は日本語はどんな言語だった"
    },
    {
      "startSec": 313.9,
      "text": "どんな文化とどんな文化が一緒になって、日本語ができたか"
    },
    {
      "startSec": 320.3,
      "text": "今これを勉強しています。"
    },
    {
      "startSec": 323.1,
      "text": "やっぱり日本語って"
    },
    {
      "startSec": 324.5,
      "text": "中国からってよく言われるけど"
    },
    {
      "startSec": 327.5,
      "text": "その前はもちろん日本は海にある島です。"
    },
    {
      "startSec": 332.3,
      "text": "なので、その大きな海に住んでいた"
    },
    {
      "startSec": 337,
      "text": "昔の人達の文化とか"
    },
    {
      "startSec": 341,
      "text": "インドの文化の影響(impact)もあります。"
    },
    {
      "startSec": 349.3,
      "text": "すごく面白いなあ。"
    },
    {
      "startSec": 350.9,
      "text": "またちゃんと勉強したら皆さんとシェアします。"
    },
    {
      "startSec": 355,
      "text": "じゃあいつもありがとうございます。"
    },
    {
      "startSec": 357.8,
      "text": "勉強、お仕事頑張ってください。"
    },
    {
      "startSec": 361,
      "text": "良い一日を！バイバイ！また明日！"
    }
  ]
}
