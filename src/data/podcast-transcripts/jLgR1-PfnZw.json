{
  "episodeId": "jLgR1-PfnZw",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.2,
      "text": "今日は「同じ」と「一緒」"
    },
    {
      "startSec": 7.8,
      "text": "この二つの言葉の違いについて話をしたいと思います。"
    },
    {
      "startSec": 15,
      "text": "皆さんこの二つの言葉、どう違うか分かりますか？"
    },
    {
      "startSec": 22.4,
      "text": "難しいですよね。"
    },
    {
      "startSec": 24,
      "text": "日本人もあんまりわからない。"
    },
    {
      "startSec": 27,
      "text": "でもなんかわかるんですよね。"
    },
    {
      "startSec": 31.6,
      "text": "じゃちょっとその違いを説明します。"
    },
    {
      "startSec": 35.3,
      "text": "まず例えば「私の足と夫の足のサイズは同じです」"
    },
    {
      "startSec": 44.1,
      "text": "この文ですが、これは「同じ」と「一緒」"
    },
    {
      "startSec": 49.5,
      "text": "どっちも使うことができます。"
    },
    {
      "startSec": 53.6,
      "text": "「私の足と夫の足は一緒のサイズです」"
    },
    {
      "startSec": 59.2,
      "text": "「サイズは一緒です」「同じサイズです」"
    },
    {
      "startSec": 62.8,
      "text": "これは「一緒」も「同じ」もどっちも使えます。"
    },
    {
      "startSec": 67.7,
      "text": "その理由は、この文章・文は"
    },
    {
      "startSec": 71.5,
      "text": "二つの物を比べていますよね。"
    },
    {
      "startSec": 76,
      "text": "AとB、私の足と私の夫(の足)、"
    },
    {
      "startSec": 80.7,
      "text": "この二つの違う物を比べて"
    },
    {
      "startSec": 84.1,
      "text": "「二つ同じ」と言いたい時は"
    },
    {
      "startSec": 88,
      "text": "「一緒」も「同じ」も使うことができます。"
    },
    {
      "startSec": 92.5,
      "text": "でも一つの物だけ言う時、"
    },
    {
      "startSec": 97.5,
      "text": "例えば一つの物を、その昔の物"
    },
    {
      "startSec": 102,
      "text": "例えば今日のAと昨日のAを比べる時、"
    },
    {
      "startSec": 107.5,
      "text": "こういう時は「同じ」しか使えないです。"
    },
    {
      "startSec": 112.7,
      "text": "「一緒」は使えません。"
    },
    {
      "startSec": 115.9,
      "text": "例えば「毎日同じ靴で学校に行きます」"
    },
    {
      "startSec": 122.9,
      "text": "これは靴について話していますよね。"
    },
    {
      "startSec": 127.7,
      "text": "昨日も今日と同じ靴。"
    },
    {
      "startSec": 130.6,
      "text": "で、明日も今日と同じ靴。"
    },
    {
      "startSec": 133.9,
      "text": "一つのことについて話しています。"
    },
    {
      "startSec": 137.1,
      "text": "なので、この時は「一緒」は使えないです。"
    },
    {
      "startSec": 144,
      "text": "「毎日一緒の靴で学校に行きます」"
    },
    {
      "startSec": 149.7,
      "text": "なんかこれは不自然です。"
    },
    {
      "startSec": 154.3,
      "text": "なんかもう細かいルールですけど"
    },
    {
      "startSec": 157.2,
      "text": "日本人は小さい時から"
    },
    {
      "startSec": 159.8,
      "text": "お母さんや友達とたくさん会話をして"
    },
    {
      "startSec": 163.6,
      "text": "こういう「同じ」と「一緒」のニュアンスの違いを"
    },
    {
      "startSec": 168.9,
      "text": "少しずつ勉強するんですよね。"
    },
    {
      "startSec": 173,
      "text": "人間ってすごいですね。"
    },
    {
      "startSec": 176.8,
      "text": "だから一つのことについて言う時は"
    },
    {
      "startSec": 180.9,
      "text": "「一緒」は使えません。"
    },
    {
      "startSec": 184.6,
      "text": "でも「一緒」にしかない意味も"
    },
    {
      "startSec": 188.9,
      "text": "もちろんたくさんあります。"
    },
    {
      "startSec": 191,
      "text": "それは英語だとtogetherです。"
    },
    {
      "startSec": 195,
      "text": "例えば「明日一緒に学校行こう」"
    },
    {
      "startSec": 200.2,
      "text": "この「一緒に＝together」で"
    },
    {
      "startSec": 203.2,
      "text": "「同じに」とか言いません。"
    },
    {
      "startSec": 207.7,
      "text": "でも「明日学校に同じ時間に行こう」"
    },
    {
      "startSec": 214.6,
      "text": "これは「一緒」は使えないです。"
    },
    {
      "startSec": 219.1,
      "text": "「同じ時間」だから、"
    },
    {
      "startSec": 220.9,
      "text": "一つの時間にだけついて話していて"
    },
    {
      "startSec": 224.7,
      "text": "AとBを比べていないので"
    },
    {
      "startSec": 228.1,
      "text": "「明日同じ時間に学校に行こう」"
    },
    {
      "startSec": 231.5,
      "text": "これは「一緒の時間に学校に行こう」は"
    },
    {
      "startSec": 236.6,
      "text": "ちょっと不自然です。"
    },
    {
      "startSec": 240.5,
      "text": "で他の例文は、例えば"
    },
    {
      "startSec": 245.6,
      "text": "「この商品、全部袋に一緒に入れてもいいですか？」"
    },
    {
      "startSec": 252.3,
      "text": "これはよく日本のお店に行くと、"
    },
    {
      "startSec": 255.8,
      "text": "スタッフの人が商品を袋に入れてくれるんですが"
    },
    {
      "startSec": 262.2,
      "text": "「一緒に袋に入れてもいいですか？」"
    },
    {
      "startSec": 266.6,
      "text": "この一緒にはtogether"
    },
    {
      "startSec": 269.3,
      "text": "全部一緒に、あ～難しいな…"
    },
    {
      "startSec": 273.6,
      "text": "この場合は「一緒に」だけ使えます。"
    },
    {
      "startSec": 277.5,
      "text": "でもこの文を「同じ」を使って言いたかったら"
    },
    {
      "startSec": 285.2,
      "text": "「この商品を全部同じ袋に入れてもいいですか？」"
    },
    {
      "startSec": 291.4,
      "text": "になります。意味は一緒。"
    },
    {
      "startSec": 293.9,
      "text": "「一緒に袋に入れてもいいですか？」と"
    },
    {
      "startSec": 298.5,
      "text": "「同じ袋に入れてもいいですか？」"
    },
    {
      "startSec": 302.3,
      "text": "意味は同じです。"
    },
    {
      "startSec": 305.6,
      "text": "面白いね。"
    },
    {
      "startSec": 308.2,
      "text": "で、あとは他の「一緒」の使い方があります。"
    },
    {
      "startSec": 314.2,
      "text": "例えば「クリスマスとお誕生日を一緒にお祝いする」"
    },
    {
      "startSec": 321.8,
      "text": "これはクリスマスとお誕生日を"
    },
    {
      "startSec": 325.1,
      "text": "同じ日にお祝いするという意味。"
    },
    {
      "startSec": 329.3,
      "text": "多分クリスマスが二十五日で"
    },
    {
      "startSec": 332.8,
      "text": "お誕生日は二十六日とかだから"
    },
    {
      "startSec": 338,
      "text": "「じゃあクリスマスの日に一緒に、"
    },
    {
      "startSec": 341.3,
      "text": "同じ日にお祝いしましょう」という意味です。"
    },
    {
      "startSec": 347.2,
      "text": "で、この文を「同じ」を使って言いたかったら"
    },
    {
      "startSec": 352.5,
      "text": "さっき言ったように"
    },
    {
      "startSec": 354.8,
      "text": "「同じ日にお祝いする」になります。"
    },
    {
      "startSec": 359.6,
      "text": "これが「同じ」と「一緒」の違いです。"
    },
    {
      "startSec": 364.1,
      "text": "あまりこのルールを聞いても正直難しいです。"
    },
    {
      "startSec": 370.1,
      "text": "なので、覚えてほしいことは"
    },
    {
      "startSec": 373.3,
      "text": "一つのことだけについて言ってるなら"
    },
    {
      "startSec": 376.7,
      "text": "「同じ」を使ったら間違えません。"
    },
    {
      "startSec": 380.8,
      "text": "はい、それだけですね。"
    },
    {
      "startSec": 382.6,
      "text": "難しかったら、together以外の意味は"
    },
    {
      "startSec": 385.8,
      "text": "もう「同じ」を使っちゃってもいいかなと思います。"
    },
    {
      "startSec": 390.7,
      "text": "私も今日頭使いました。"
    },
    {
      "startSec": 394.4,
      "text": "本当に文法のルールはもう細かくて難しいです。"
    },
    {
      "startSec": 400.7,
      "text": "じゃあ今日も最後まで聞いてくれて"
    },
    {
      "startSec": 404.2,
      "text": "ありがとうございます。"
    },
    {
      "startSec": 406,
      "text": "良かったらレビューを書いてくれると嬉しいです。"
    },
    {
      "startSec": 409.8,
      "text": "そしてパトレオンでサポートしてくれている人"
    },
    {
      "startSec": 413.7,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 416.6,
      "text": "じゃあまた明日のエピソードで会いましょう。"
    },
    {
      "startSec": 419.7,
      "text": "じゃあまたね！バイバイ！"
    }
  ]
}
