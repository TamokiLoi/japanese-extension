{
  "episodeId": "YUoJRvGkOs8",
  "segments": [
    {
      "startSec": 0,
      "text": "はい、皆さんこんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.8,
      "text": "今日はタトゥーの話をしたいと思います。"
    },
    {
      "startSec": 8.5,
      "text": "はい、皆さんの国ではタトゥーはよくしますか？"
    },
    {
      "startSec": 14.1,
      "text": "何か普通のことですか？"
    },
    {
      "startSec": 17.7,
      "text": "日本ではちょっとね"
    },
    {
      "startSec": 19.8,
      "text": "タトゥーが苦手な人もまだまだ多いですよね。"
    },
    {
      "startSec": 25.7,
      "text": "今日はちょっとその話を"
    },
    {
      "startSec": 27.9,
      "text": "皆さんとしたいと思います。"
    },
    {
      "startSec": 30.7,
      "text": "日本には2つタトゥーの言い方があります。"
    },
    {
      "startSec": 36.5,
      "text": "1つはもちろんカタカナでタトゥーです。"
    },
    {
      "startSec": 41.8,
      "text": "でもう1つは刺青です。"
    },
    {
      "startSec": 47.2,
      "text": "これは日本語でタトゥーのことですが"
    },
    {
      "startSec": 52.1,
      "text": "まあでも、タトゥーと刺青はなんかね"
    },
    {
      "startSec": 58.5,
      "text": "ちょっと意味が違います。"
    },
    {
      "startSec": 61.9,
      "text": "どっちも同じタトゥーのことですが"
    },
    {
      "startSec": 65.7,
      "text": "ちょっと意味が違います。"
    },
    {
      "startSec": 69.2,
      "text": "その意味をちょっと今から皆さんに話しますね。"
    },
    {
      "startSec": 74.5,
      "text": "カタカナでタトゥーと言うと"
    },
    {
      "startSec": 79.3,
      "text": "おしゃれなイメージがちょっとします。"
    },
    {
      "startSec": 83.7,
      "text": "最近の若い人はあまりタトゥーが"
    },
    {
      "startSec": 88.6,
      "text": "苦手な人が少なくなってきている。"
    },
    {
      "startSec": 93.1,
      "text": "タトゥーは「うんうん、おしゃれだね」って言う人も"
    },
    {
      "startSec": 96.2,
      "text": "増えています。"
    },
    {
      "startSec": 98.8,
      "text": "で、タトゥーとカタカナで言う時は"
    },
    {
      "startSec": 101.9,
      "text": "まあすごくおしゃれで、若い人がしてる"
    },
    {
      "startSec": 105.8,
      "text": "ハートのタトゥーとか星とか英語とか"
    },
    {
      "startSec": 112,
      "text": "ちょっとおしゃれなイメージです。"
    },
    {
      "startSec": 114.9,
      "text": "でも刺青と言うとヤクザのイメージです。"
    },
    {
      "startSec": 124.4,
      "text": "ヤクザの感じがします。"
    },
    {
      "startSec": 129,
      "text": "刺青は、背中にある大きな鯉の絵とか"
    },
    {
      "startSec": 137,
      "text": "仏様の絵とか、ドラゴンの絵とか"
    },
    {
      "startSec": 143.8,
      "text": "そういうイメージがします。"
    },
    {
      "startSec": 149.8,
      "text": "大きな違いですよね。"
    },
    {
      "startSec": 152.4,
      "text": "やっぱりもう最近の若い人がする"
    },
    {
      "startSec": 156,
      "text": "おしゃれなタトゥーに"
    },
    {
      "startSec": 157.7,
      "text": "まあ刺青という言葉を使うことは"
    },
    {
      "startSec": 161.2,
      "text": "ほとんどありません。"
    },
    {
      "startSec": 163.9,
      "text": "で、あと例えば、ヨーロッパ・アメリカとかイギリスとかの"
    },
    {
      "startSec": 171,
      "text": "タトゥーと日本のタトゥーの違いですね。"
    },
    {
      "startSec": 175.1,
      "text": "私がいつも面白いなと思う違いは"
    },
    {
      "startSec": 180,
      "text": "よく外国、ヨーロッパとかでは"
    },
    {
      "startSec": 184.6,
      "text": "お母さんとか大切な人の名前を"
    },
    {
      "startSec": 188.5,
      "text": "タトゥーにすることがありますよね。"
    },
    {
      "startSec": 192.2,
      "text": "でも日本では、それはないです。"
    },
    {
      "startSec": 196.5,
      "text": "うん、ないですね。"
    },
    {
      "startSec": 198.4,
      "text": "なんかね、やっぱり日本語って日本人は"
    },
    {
      "startSec": 202.9,
      "text": "「おしゃれじゃない」と思ってるので"
    },
    {
      "startSec": 206.9,
      "text": "日本語で例えばお母さんの名前ね"
    },
    {
      "startSec": 210,
      "text": "私のお母さんは「ひとみ」という名前ですが"
    },
    {
      "startSec": 213.8,
      "text": "もうここに「ひとみ」ってね"
    },
    {
      "startSec": 216.4,
      "text": "タトゥーで書いたりすることは絶対にないです。"
    },
    {
      "startSec": 221.1,
      "text": "それは何かダサい(lame)"
    },
    {
      "startSec": 224.6,
      "text": "ダサいってみんな思いますね。"
    },
    {
      "startSec": 229.1,
      "text": "これが私は外国と日本のタトゥーの"
    },
    {
      "startSec": 233.4,
      "text": "大きな違いだと思います。"
    },
    {
      "startSec": 237.3,
      "text": "まあね、もうちょっと私はタトゥーとか"
    },
    {
      "startSec": 240.2,
      "text": "イヤリング・ピアスとかもそうですが"
    },
    {
      "startSec": 243.1,
      "text": "もうちょっとね、日本でもたくさんの人が"
    },
    {
      "startSec": 246.4,
      "text": "受け入れてくれたらいいなと思います。"
    },
    {
      "startSec": 250.4,
      "text": "受け入れる(to accept)"
    },
    {
      "startSec": 252.9,
      "text": "受け入れてほしいですね。"
    },
    {
      "startSec": 255.7,
      "text": "じゃあ今日はこんな感じです。"
    },
    {
      "startSec": 258,
      "text": "いつも最後までありがとうございます。"
    },
    {
      "startSec": 261.8,
      "text": "皆さんはいつこのポッドキャストを聞いてますか?"
    },
    {
      "startSec": 266.2,
      "text": "朝ですか？夜ですか？"
    },
    {
      "startSec": 269.2,
      "text": "もしよかったらYouTubeのコメントで教えてください。"
    },
    {
      "startSec": 273.9,
      "text": "Patreonではこのポッドキャストの"
    },
    {
      "startSec": 278.2,
      "text": "トランスクリプトに漢字にふりがなを付けて"
    },
    {
      "startSec": 283.5,
      "text": "皆さんとシェアしています。"
    },
    {
      "startSec": 286,
      "text": "興味があったら、ぜひ良かったら"
    },
    {
      "startSec": 288.9,
      "text": "リンクからチェックしてください。"
    },
    {
      "startSec": 292.6,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 294.4,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
