{
  "episodeId": "dyJtY1K51Ag",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.9,
      "text": "今日は楽しいスラングを教えたいと思います。"
    },
    {
      "startSec": 10.2,
      "text": "多分皆さん、「めっちゃ」とか"
    },
    {
      "startSec": 13.5,
      "text": "「ウザイ」「マジで」「キモイ」とか"
    },
    {
      "startSec": 17.1,
      "text": "そういうスラングは多分、知っていると思います。"
    },
    {
      "startSec": 22.7,
      "text": "今日は多分、皆さんがあまり知らないけど"
    },
    {
      "startSec": 29.3,
      "text": "日本人がよく使うスラングを教えたいと思います。"
    },
    {
      "startSec": 37,
      "text": "まず一つ目、"
    },
    {
      "startSec": 40.4,
      "text": "これは「コスパがいい」「コスパが悪い」です。"
    },
    {
      "startSec": 47.8,
      "text": "このコストはコストパフォーマンス、一応英語です。"
    },
    {
      "startSec": 54.4,
      "text": "「コストパフォーマンスがいい」"
    },
    {
      "startSec": 57.5,
      "text": "これはお金を払ってゲットできるものが多い。"
    },
    {
      "startSec": 63.4,
      "text": "例えば「おにぎりはコスパがいい」"
    },
    {
      "startSec": 68.2,
      "text": "例えば百円でおにぎり一つ買って、美味しいけど"
    },
    {
      "startSec": 74.3,
      "text": "すごくお腹いっぱいになります。"
    },
    {
      "startSec": 77.7,
      "text": "多分ハンバーガーを買うよりも"
    },
    {
      "startSec": 80.9,
      "text": "おにぎりを買った方がお腹がいっぱいになる。"
    },
    {
      "startSec": 85.6,
      "text": "だから、同じ百円を払ってゲットできるものが"
    },
    {
      "startSec": 94.4,
      "text": "おにぎりとハンバーガーでは違います。"
    },
    {
      "startSec": 98.5,
      "text": "おにぎりの方が、もっとお腹がいっぱいになる"
    },
    {
      "startSec": 104.3,
      "text": "なので、おにぎりの方がコスパがいい。"
    },
    {
      "startSec": 108.3,
      "text": "こんな感じで使います。"
    },
    {
      "startSec": 110.9,
      "text": "「コスパが悪い」"
    },
    {
      "startSec": 112.6,
      "text": "ハンバーガーはちょっとコスパが悪い。"
    },
    {
      "startSec": 115.5,
      "text": "こんな感じです。よく使います。"
    },
    {
      "startSec": 120.8,
      "text": "でスラング二つ目、"
    },
    {
      "startSec": 123.8,
      "text": "二つ目は「あるある」です。"
    },
    {
      "startSec": 130.9,
      "text": "例えば、日本語を勉強している人に、あるあるなのは"
    },
    {
      "startSec": 140.7,
      "text": "リスニングの勉強をしないことです、"
    },
    {
      "startSec": 145.4,
      "text": "みたいな感じに使います。"
    },
    {
      "startSec": 147.8,
      "text": "あるある、意味は「よくある」ことです。"
    },
    {
      "startSec": 152.7,
      "text": "よくあることを、あるあると言います。"
    },
    {
      "startSec": 158.6,
      "text": "例えば大阪人にあるあるなのは話し過ぎてしまうこと。"
    },
    {
      "startSec": 169.7,
      "text": "大阪人によくあるのは、話し過ぎちゃうこと"
    },
    {
      "startSec": 175.3,
      "text": "みたいな感じで使います。"
    },
    {
      "startSec": 177.4,
      "text": "このあるあるは、よくYouTubeのタイトルとかで見ます。"
    },
    {
      "startSec": 183.1,
      "text": "英語学習者あるある、日本語学習者あるある"
    },
    {
      "startSec": 189.4,
      "text": "海外旅行あるある、みたいな感じで。"
    },
    {
      "startSec": 193.2,
      "text": "是非皆さんも使ってください。"
    },
    {
      "startSec": 196.9,
      "text": "でスラング三つ目、これは「諭吉」です。"
    },
    {
      "startSec": 203.5,
      "text": "多分これは皆さん、知らないんじゃないかな。"
    },
    {
      "startSec": 208.4,
      "text": "「諭吉」これは一万円札、一万円の紙のこと、"
    },
    {
      "startSec": 215.6,
      "text": "これを「諭吉」と言います。"
    },
    {
      "startSec": 219.8,
      "text": "理由がわかりますか？"
    },
    {
      "startSec": 222.9,
      "text": "諭吉、これは一万円札にある人の名前です。"
    },
    {
      "startSec": 230.8,
      "text": "福沢諭吉さんです。"
    },
    {
      "startSec": 236.9,
      "text": "この人は、大体二百年前の日本人です。"
    },
    {
      "startSec": 245.5,
      "text": "もちろん二百年前の日本は、大変な時でした。"
    },
    {
      "startSec": 251.6,
      "text": "まだ日本は閉じていました"
    },
    {
      "startSec": 254.8,
      "text": "他の国と全然連絡がなかった時です。"
    },
    {
      "startSec": 260,
      "text": "少しの国、ポルトガルとかオランダとかとは"
    },
    {
      "startSec": 265.3,
      "text": "連絡がありましたが"
    },
    {
      "startSec": 267.5,
      "text": "もう二百年前の日本はまだまだ侍がいた時代、"
    },
    {
      "startSec": 274.2,
      "text": "もう本当に中世(medieval time)と同じような感じ。"
    },
    {
      "startSec": 280.3,
      "text": "で、1853年にアメリカ人のペリーさんが"
    },
    {
      "startSec": 286.8,
      "text": "日本にやってきます。"
    },
    {
      "startSec": 289,
      "text": "でそれを見て日本は"
    },
    {
      "startSec": 291.5,
      "text": "「ヤバイ！なんかすごい国が日本の外にあるんだ」って"
    },
    {
      "startSec": 296.9,
      "text": "気が付いて、焦って"
    },
    {
      "startSec": 300.4,
      "text": "日本の国を他の国にオープンにして"
    },
    {
      "startSec": 304.8,
      "text": "他の国と連絡をするようになります。"
    },
    {
      "startSec": 308.9,
      "text": "で、その時代にいたすごい人が福沢諭吉さんです。"
    },
    {
      "startSec": 314.5,
      "text": "大きく日本を変えた人です。"
    },
    {
      "startSec": 318.7,
      "text": "1860年にアメリカに行きました、福沢諭吉さん。"
    },
    {
      "startSec": 325.7,
      "text": "すごいですよね、そんな昔に、"
    },
    {
      "startSec": 328.5,
      "text": "日本のサムライみたいな見た目の人が"
    },
    {
      "startSec": 333.5,
      "text": "アメリカに行って、アメリカ人と話をして"
    },
    {
      "startSec": 338.8,
      "text": "新しいことを勉強しました。"
    },
    {
      "startSec": 342.5,
      "text": "それを日本に持って帰って"
    },
    {
      "startSec": 345.5,
      "text": "日本をこれからどんどんモダンにして"
    },
    {
      "startSec": 349,
      "text": "強い国にしようって頑張った人です。"
    },
    {
      "startSec": 353.3,
      "text": "すいません、福沢諭吉さんの話が長くなりましたが"
    },
    {
      "startSec": 358.2,
      "text": "その人が一万円札にあるので"
    },
    {
      "startSec": 361.7,
      "text": "一万円札のことを「諭吉」と言います。"
    },
    {
      "startSec": 366.4,
      "text": "スラング四つ目、"
    },
    {
      "startSec": 370.4,
      "text": "四つ目は「ぶっちゃけ」です。"
    },
    {
      "startSec": 376.4,
      "text": "意味は、「はっきり言うと」みたいな。"
    },
    {
      "startSec": 381.1,
      "text": "例えば、ぶっちゃけ私テストで三十点だったんだよね"
    },
    {
      "startSec": 389.7,
      "text": "みたいな感じです。"
    },
    {
      "startSec": 392.4,
      "text": "「ぶっちゃけ(to be honest)」…ぶっちゃけるとの短い言い方です。"
    },
    {
      "startSec": 399.8,
      "text": "ぶっちゃけ、私家族いないんだよね"
    },
    {
      "startSec": 405.6,
      "text": "ちょっと悲しいあの例文ですが、こんな感じで使います。"
    },
    {
      "startSec": 411.5,
      "text": "最後のスラング五つ目、これは「無理ゲー」です。"
    },
    {
      "startSec": 420.5,
      "text": "これは、できないと思ったことに"
    },
    {
      "startSec": 425.2,
      "text": "「もうそれは無理ゲー、できないできない」みたいに使います。"
    },
    {
      "startSec": 429.9,
      "text": "だから意味は「無理」という意味。"
    },
    {
      "startSec": 434.2,
      "text": "この「ゲー」は、ゲームのゲーです。"
    },
    {
      "startSec": 439,
      "text": "スマホゲームとかテレビゲームのゲーム。"
    },
    {
      "startSec": 443.1,
      "text": "できない、難しいゲームをやった時に"
    },
    {
      "startSec": 447.6,
      "text": "「あ、これは無理ゲーだ」みたいな感じで使います。"
    },
    {
      "startSec": 452.8,
      "text": "でも今はゲーム以外のことにも"
    },
    {
      "startSec": 458,
      "text": "この「無理ゲー」を使うことができます。"
    },
    {
      "startSec": 462.9,
      "text": "例えば、会社で先輩から急に、(井本は私の名前)"
    },
    {
      "startSec": 471.3,
      "text": "「井本さん、明日のプレゼンお願いできますか？」"
    },
    {
      "startSec": 477.8,
      "text": "「いやいやいやいや、それは無理ゲー」みたいに…"
    },
    {
      "startSec": 481,
      "text": "先輩に無理ゲーは言ったらダメです。"
    },
    {
      "startSec": 483.5,
      "text": "友達に何か言われた時に"
    },
    {
      "startSec": 486.6,
      "text": "「それは無理ゲー」って言うことができます。"
    },
    {
      "startSec": 491.9,
      "text": "今日はこんな感じです。"
    },
    {
      "startSec": 493.4,
      "text": "ちょっと長くなってしまいました。すいません。"
    },
    {
      "startSec": 496.7,
      "text": "いつも最後まで聞いてくれて"
    },
    {
      "startSec": 499.4,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 501.8,
      "text": "良かったらPatreonでサポートもできますし"
    },
    {
      "startSec": 506,
      "text": "トランスクリプト使って"
    },
    {
      "startSec": 508.8,
      "text": "このポッドキャストを聞くことができます。"
    },
    {
      "startSec": 512.4,
      "text": "よかったらサポートとしてください。"
    },
    {
      "startSec": 514.8,
      "text": "いつもありがとう！"
    },
    {
      "startSec": 515.8,
      "text": "じゃあまたね～バイバイ！"
    }
  ]
}
