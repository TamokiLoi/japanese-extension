{
  "episodeId": "KzJWfGhQto4",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.5,
      "text": "今日はTSUTAYA、"
    },
    {
      "startSec": 8.5,
      "text": "皆さんTSUTAYA行ったことありますか？"
    },
    {
      "startSec": 11.6,
      "text": "TSUTAYAの話をしたいなと思います。"
    },
    {
      "startSec": 15.3,
      "text": "私昔、TSUTAYA大好きで"
    },
    {
      "startSec": 18.9,
      "text": "一週間に一回くらい行ってたかな。"
    },
    {
      "startSec": 24.8,
      "text": "TSUTAYAは本屋さんです。"
    },
    {
      "startSec": 28.7,
      "text": "本があって、でも普通の本屋さんじゃなくて"
    },
    {
      "startSec": 33.3,
      "text": "映画のDVDを借りたり、CDを借りたり"
    },
    {
      "startSec": 40.4,
      "text": "マンガを借りたり、色々出来るんですね。"
    },
    {
      "startSec": 44.3,
      "text": "雑誌もたくさんあって楽しいし、"
    },
    {
      "startSec": 48.9,
      "text": "ちょっと文房具(stationery)を売っていたり"
    },
    {
      "startSec": 54.9,
      "text": "ゲームを売っていたり、すごく楽しい場所です。"
    },
    {
      "startSec": 60,
      "text": "で、昔私はDVDを借りるために"
    },
    {
      "startSec": 66.5,
      "text": "TSUTAYAに行っていたんですね。"
    },
    {
      "startSec": 69.2,
      "text": "映画が大好きだったので、その映画を借りるために"
    },
    {
      "startSec": 74.6,
      "text": "TSUTAYAに行っていました。"
    },
    {
      "startSec": 76.8,
      "text": "で、すごくたくさんコレクションがあって"
    },
    {
      "startSec": 81.4,
      "text": "ほとんどじゃないけど"
    },
    {
      "startSec": 82.9,
      "text": "メジャーな映画は全部TSUTAYAにあります。"
    },
    {
      "startSec": 88.2,
      "text": "その時は確かDVD、映画五本で"
    },
    {
      "startSec": 92.8,
      "text": "千円で一週間くらい借りることができて"
    },
    {
      "startSec": 97.6,
      "text": "一週間とか二週間に一回"
    },
    {
      "startSec": 101.5,
      "text": "そのサービスを使っていました。"
    },
    {
      "startSec": 104.8,
      "text": "皆さんは映画好きですか？"
    },
    {
      "startSec": 109,
      "text": "私は大好きです、本当に。"
    },
    {
      "startSec": 112.8,
      "text": "昔は、昔と言っても五年前とかですけど"
    },
    {
      "startSec": 118.7,
      "text": "その時は本当にまだネットフリックス(Netflix)とか"
    },
    {
      "startSec": 123.1,
      "text": "ユーネクスト(U-NEXT)とかAmazonプライムとか"
    },
    {
      "startSec": 126.4,
      "text": "そういうのがあまりなかった時は"
    },
    {
      "startSec": 130.2,
      "text": "DVDを借りに行って見てました。"
    },
    {
      "startSec": 135.1,
      "text": "今はもうそのネットフリックスとか"
    },
    {
      "startSec": 138.6,
      "text": "すごく大きい会社になって"
    },
    {
      "startSec": 141.8,
      "text": "みんなそれで映画見ますよね。"
    },
    {
      "startSec": 145.9,
      "text": "DVDを借りに行く人は"
    },
    {
      "startSec": 148,
      "text": "もうほとんどいなくなっちゃったよね？"
    },
    {
      "startSec": 154.3,
      "text": "皆さんはどうですか？まだ借りに行きますか？"
    },
    {
      "startSec": 159.6,
      "text": "でも私はDVDを選ぶのが本当に楽しくて。"
    },
    {
      "startSec": 167.3,
      "text": "たくさんDVDがあって"
    },
    {
      "startSec": 170.1,
      "text": "で、気になる映画のをDVDを見て"
    },
    {
      "startSec": 174.9,
      "text": "タイトルで選んで、そして映画の説明を読む。"
    },
    {
      "startSec": 180.8,
      "text": "もうそれが楽しくて。"
    },
    {
      "startSec": 183.6,
      "text": "それが今あまりできなくなった。"
    },
    {
      "startSec": 187.5,
      "text": "あまりなくなったのは"
    },
    {
      "startSec": 189.1,
      "text": "ちょっと寂しい感じがしますね。"
    },
    {
      "startSec": 194.6,
      "text": "で、今はもちろん私は"
    },
    {
      "startSec": 198.2,
      "text": "ユーネクスト、使ってます。"
    },
    {
      "startSec": 200.4,
      "text": "ユーネクストは、日本人のための"
    },
    {
      "startSec": 203.6,
      "text": "日本語の映画の…何て言うの…"
    },
    {
      "startSec": 207.7,
      "text": "ネットフリックスみたいなやつ、ホームページで"
    },
    {
      "startSec": 212.5,
      "text": "で、それすごく良くて。"
    },
    {
      "startSec": 215.4,
      "text": "結構マイナーな映画、たくさんあるし。"
    },
    {
      "startSec": 219.7,
      "text": "ヨーロッパの映画とかもたくさんあるし。"
    },
    {
      "startSec": 224,
      "text": "私はあまり見ないけど"
    },
    {
      "startSec": 226.8,
      "text": "アニメとか本も読むことができて"
    },
    {
      "startSec": 232,
      "text": "で、ドラマとかもすごくたくさんあります。"
    },
    {
      "startSec": 236.5,
      "text": "まあ気になる人は調べてください。"
    },
    {
      "startSec": 239.4,
      "text": "ユーネクストです。"
    },
    {
      "startSec": 241.8,
      "text": "すごくおすすめです。"
    },
    {
      "startSec": 244,
      "text": "ユーネクストの好きなところは"
    },
    {
      "startSec": 246.6,
      "text": "一ヶ月に、二千円なんですけど"
    },
    {
      "startSec": 250.8,
      "text": "確か千二百ポイントもらえるんですね、毎月。"
    },
    {
      "startSec": 257.1,
      "text": "珍しい映画をポイントで"
    },
    {
      "startSec": 260.5,
      "text": "ユーネクストで映画を買うこともできるし"
    },
    {
      "startSec": 265.2,
      "text": "あとそのポイントを使って映画館に行って"
    },
    {
      "startSec": 270,
      "text": "映画館で映画を見ることができるんです。"
    },
    {
      "startSec": 275,
      "text": "本当にそれはいいですね、楽しい。"
    },
    {
      "startSec": 280,
      "text": "また今もポイントが貯まったので"
    },
    {
      "startSec": 282.9,
      "text": "映画観に行くのがすごく楽しみです。"
    },
    {
      "startSec": 287.7,
      "text": "TSUTAYAは本当にDVD、映画のDVDが楽しくて"
    },
    {
      "startSec": 295.1,
      "text": "でももう私、多分半年くらい行ってないです。"
    },
    {
      "startSec": 303.5,
      "text": "いや、また行きたい。"
    },
    {
      "startSec": 304.9,
      "text": "でも本屋さんはよく行きます。"
    },
    {
      "startSec": 309.4,
      "text": "あんまり買わないけど、"
    },
    {
      "startSec": 311.2,
      "text": "やっぱり本屋さん楽しいですよね。"
    },
    {
      "startSec": 315,
      "text": "いろんなタイトルの本を見て"
    },
    {
      "startSec": 317.8,
      "text": "その本の中身、コンテンツ、内容を想像して"
    },
    {
      "startSec": 324.9,
      "text": "やっぱり楽しいですよね。"
    },
    {
      "startSec": 326.7,
      "text": "全然本は買ってないし、"
    },
    {
      "startSec": 330.1,
      "text": "最近はあんまり読んでないんですけど"
    },
    {
      "startSec": 333.3,
      "text": "また読みたいです。"
    },
    {
      "startSec": 335.9,
      "text": "図書館も本当に好きですね。"
    },
    {
      "startSec": 338.4,
      "text": "最近ちょっと読んでいた本は"
    },
    {
      "startSec": 341.8,
      "text": "日本語の歴史の本。"
    },
    {
      "startSec": 345.6,
      "text": "二千年前とか二千五百年前、"
    },
    {
      "startSec": 349.2,
      "text": "すごく昔に日本語がどんな影響(influence)"
    },
    {
      "startSec": 356.9,
      "text": "影響を受けて、どんな文化、どんな国から影響を受けて"
    },
    {
      "startSec": 364,
      "text": "日本語ができたか、そういう話です。"
    },
    {
      "startSec": 368,
      "text": "で、大体二千年前に"
    },
    {
      "startSec": 371.7,
      "text": "チベットとかインドの南の方、上の方"
    },
    {
      "startSec": 376.7,
      "text": "あの辺りの場所の人が日本にやってきて"
    },
    {
      "startSec": 381.9,
      "text": "言語(language)と"
    },
    {
      "startSec": 384,
      "text": "そして畑仕事をする道具(tools)を持ってきたんですね。"
    },
    {
      "startSec": 390.4,
      "text": "そういうことを色々勉強して"
    },
    {
      "startSec": 394,
      "text": "本当に言語って面白いなと最近思っていました。"
    },
    {
      "startSec": 402.1,
      "text": "今は私達、中国語から来た漢字を使いますが、"
    },
    {
      "startSec": 409.3,
      "text": "結構漢字が日本に来たのは最近なんです。"
    },
    {
      "startSec": 415.3,
      "text": "二千年前は日本は他の国からまだ影響があって"
    },
    {
      "startSec": 423.9,
      "text": "で、それが今の日本語にも残っている。"
    },
    {
      "startSec": 427.6,
      "text": "まだその言葉が日本語に残ってるんですね。"
    },
    {
      "startSec": 432.2,
      "text": "まとてもシンプルな山・川・上・下、"
    },
    {
      "startSec": 436.4,
      "text": "こういう言葉はそういう他の国から来た言葉。"
    },
    {
      "startSec": 442,
      "text": "今の日本語の四千語、四千単語くらいは"
    },
    {
      "startSec": 448.6,
      "text": "他のその文化から来た。"
    },
    {
      "startSec": 451.9,
      "text": "まだ残ってるらしいです。"
    },
    {
      "startSec": 454.3,
      "text": "いや面白いね…ということで"
    },
    {
      "startSec": 456.5,
      "text": "ちょっと長くなったので"
    },
    {
      "startSec": 457.9,
      "text": "今日はここで終わりにしたいと思います。"
    },
    {
      "startSec": 461.2,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 463.9,
      "text": "良い一日を！"
    },
    {
      "startSec": 465.5,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 467.7,
      "text": "じゃあまたね、バイバイ！"
    }
  ]
}
