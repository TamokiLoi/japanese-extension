{
  "episodeId": "jOd9zosKV2A",
  "segments": [
    {
      "startSec": 0,
      "text": "はい、皆さんこんにちは。元気ですか？"
    },
    {
      "startSec": 4.5,
      "text": "私は元気です。今日はとても天気がいいです。"
    },
    {
      "startSec": 9.8,
      "text": "私はね、本当に天気がいい日は元気です。"
    },
    {
      "startSec": 15.2,
      "text": "で、曇りの日は、...."
    },
    {
      "startSec": 18.3,
      "text": "すごく元気じゃなくなります。"
    },
    {
      "startSec": 21.7,
      "text": "なんかね、日本語で"
    },
    {
      "startSec": 24,
      "text": "テンションが下がる"
    },
    {
      "startSec": 27.4,
      "text": "っていう言葉があります。"
    },
    {
      "startSec": 32.4,
      "text": "テンションが下がる"
    },
    {
      "startSec": 36.3,
      "text": "ハイテンションは"
    },
    {
      "startSec": 37.5,
      "text": "英語のtensionの意味じゃないです"
    },
    {
      "startSec": 41.1,
      "text": "But anyway, 皆さん元気ですか？"
    },
    {
      "startSec": 45.3,
      "text": "今日はね、えっと"
    },
    {
      "startSec": 47.7,
      "text": "オーブン！オーブンの話をしたいと思います。"
    },
    {
      "startSec": 52.6,
      "text": "皆さん、日本には"
    },
    {
      "startSec": 56.3,
      "text": "オーブンが全然ないって知っていますか？"
    },
    {
      "startSec": 62.7,
      "text": "知っていますか？"
    },
    {
      "startSec": 63.9,
      "text": "そう、もうちょっとで"
    },
    {
      "startSec": 67,
      "text": "ジャックさんとヨークシャプリングを料理したくて"
    },
    {
      "startSec": 73.8,
      "text": "オーブンをね、買いに行きました"
    },
    {
      "startSec": 78.1,
      "text": "まあ、でも日本のオーブンって"
    },
    {
      "startSec": 81.2,
      "text": "オーブンじゃないオーブンじゃないの。"
    },
    {
      "startSec": 86.7,
      "text": "あの〜電子レンジ！"
    },
    {
      "startSec": 88.9,
      "text": "microwave は電子レンジです"
    },
    {
      "startSec": 92.7,
      "text": "えっと、電子レンジのちょっと大きいやつ"
    },
    {
      "startSec": 99,
      "text": "何かオーブンレンジという名前でお店にあります。"
    },
    {
      "startSec": 105.6,
      "text": "オーブレンジ。そう、だから"
    },
    {
      "startSec": 108.5,
      "text": "それを電子レンジとして使うこともできるし"
    },
    {
      "startSec": 115.8,
      "text": "オーブンとして使うこともできます"
    },
    {
      "startSec": 119.5,
      "text": "そう、でもオーブンレンジ"
    },
    {
      "startSec": 122.8,
      "text": "その見た目そのlooks"
    },
    {
      "startSec": 125.3,
      "text": "見た目はレンジです。レンジ。"
    },
    {
      "startSec": 128.9,
      "text": "レンジ microwaveです"
    },
    {
      "startSec": 131.7,
      "text": "本当にすごくね、小さい。"
    },
    {
      "startSec": 135,
      "text": "小さい。ピザ一枚を焼くのは難しいかも"
    },
    {
      "startSec": 141.5,
      "text": "小さいピザだったら、焼くことはできるけど"
    },
    {
      "startSec": 146.1,
      "text": "なんかコストコで売ってる大きなピザ"
    },
    {
      "startSec": 149.5,
      "text": "絶対無理！大きすぎる。"
    },
    {
      "startSec": 153.4,
      "text": "絶対、無理ですね"
    },
    {
      "startSec": 155.2,
      "text": "そう、だからまあ"
    },
    {
      "startSec": 157.2,
      "text": "日本に来て、日本で住むなら"
    },
    {
      "startSec": 161.1,
      "text": "オーブンね、You will miss your oven"
    },
    {
      "startSec": 164.8,
      "text": "あと、面白いのが toasters、so we call toasters"
    },
    {
      "startSec": 170,
      "text": "「オーブントースター」でもオーブンじゃない"
    },
    {
      "startSec": 177.7,
      "text": "普通のトースターです。"
    },
    {
      "startSec": 180.8,
      "text": "普通のトースターをオーブントースターと言います"
    },
    {
      "startSec": 186.1,
      "text": "はい。そして面白いこと、Stove"
    },
    {
      "startSec": 192.9,
      "text": "私も英語でよく分からないけど"
    },
    {
      "startSec": 196.1,
      "text": "料理する時の「火」fire"
    },
    {
      "startSec": 198.8,
      "text": "stove! そう、でも"
    },
    {
      "startSec": 202.1,
      "text": "日本で「ストーブ」って言ったら、heater のことです。"
    },
    {
      "startSec": 210.8,
      "text": "そう、日本ではストーブはヒーターのことです"
    },
    {
      "startSec": 215.6,
      "text": "そうだから、私はなんかあ"
    },
    {
      "startSec": 218,
      "text": "You can say 「ストーブつけて！」"
    },
    {
      "startSec": 221.2,
      "text": "Please turn on the heater!"
    },
    {
      "startSec": 225.5,
      "text": "そして、その英語のstove in a kitchenを"
    },
    {
      "startSec": 231.3,
      "text": "日本では、「コンロ」と言います"
    },
    {
      "startSec": 238.8,
      "text": "キッチンのstove は「コンロ」"
    },
    {
      "startSec": 245,
      "text": "そして、冬に使うheaterは"
    },
    {
      "startSec": 250.6,
      "text": "「ストーブ」です。"
    },
    {
      "startSec": 254.4,
      "text": "えー、そして toaster を「オーブントースター」"
    },
    {
      "startSec": 260.7,
      "text": "ということもあります。"
    },
    {
      "startSec": 263.8,
      "text": "はい、まあだから、本当にね"
    },
    {
      "startSec": 267.3,
      "text": "日本のキッチンはすごく狭いですようん。"
    },
    {
      "startSec": 272.4,
      "text": "えっとね、usually we only have 2 stoves"
    },
    {
      "startSec": 277.4,
      "text": "日本語では二つの「コンロ」"
    },
    {
      "startSec": 280.3,
      "text": "料理をするための火、二つだけです"
    },
    {
      "startSec": 284.5,
      "text": "はい。そして、もう一つ。日本ではえっと"
    },
    {
      "startSec": 289.5,
      "text": "\"dish washer\"食洗機（しょくせんき）"
    },
    {
      "startSec": 295.3,
      "text": "食洗機はあるけど、"
    },
    {
      "startSec": 303.4,
      "text": "家のキッチンについていない。"
    },
    {
      "startSec": 306.9,
      "text": "まあでも、日本のdish washerってすごく小さい"
    },
    {
      "startSec": 312.3,
      "text": "This size! Very small!"
    },
    {
      "startSec": 318.7,
      "text": "Looks a little bit ugly! ですね、本当にだから"
    },
    {
      "startSec": 323.5,
      "text": "日本のキッチンと特にwestern countries"
    },
    {
      "startSec": 329.7,
      "text": "西洋の国のキッチンは"
    },
    {
      "startSec": 334.5,
      "text": "本当に全然違いますね。"
    },
    {
      "startSec": 338.4,
      "text": "私はやっぱりねええ"
    },
    {
      "startSec": 342.1,
      "text": "western countiries のキッチンいいなって"
    },
    {
      "startSec": 346.4,
      "text": "うらやましいなって時々思います。"
    },
    {
      "startSec": 350.5,
      "text": "うん、そうね、そんな感じかな。"
    },
    {
      "startSec": 355.1,
      "text": "日本にはオーブンはありません"
    },
    {
      "startSec": 358.2,
      "text": "気を付けてください。"
    },
    {
      "startSec": 360.2,
      "text": "うん、日本にね"
    },
    {
      "startSec": 361.4,
      "text": "特に日本に住みたい人、you will miss your kitchen!"
    },
    {
      "startSec": 366.1,
      "text": "今日は、短いけど"
    },
    {
      "startSec": 367.8,
      "text": "こんな感じで終わりたいと思います。"
    },
    {
      "startSec": 375.4,
      "text": "このポッドキャストにはじまくもあるので"
    },
    {
      "startSec": 379.8,
      "text": "字幕が読みたい人は"
    },
    {
      "startSec": 382.4,
      "text": "ぜひユーチューブで"
    },
    {
      "startSec": 384.5,
      "text": "ポッドキャストを見てください。"
    },
    {
      "startSec": 388.2,
      "text": "じゃあ今日はこんな感じです。"
    },
    {
      "startSec": 390.2,
      "text": "リスニング頑張ってください。"
    },
    {
      "startSec": 392.4,
      "text": "最後までありがとう"
    },
    {
      "startSec": 394,
      "text": "バイバイ"
    }
  ]
}
