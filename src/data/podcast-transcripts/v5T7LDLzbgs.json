{
  "episodeId": "v5T7LDLzbgs",
  "segments": [
    {
      "startSec": 0.2,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.3,
      "text": "今日は百一本目のエピソードですね。"
    },
    {
      "startSec": 9.7,
      "text": "はい、百一本目でございます。"
    },
    {
      "startSec": 13.8,
      "text": "百本目のエピソードを作っている時に"
    },
    {
      "startSec": 18,
      "text": "何本目か忘れちゃって"
    },
    {
      "startSec": 20.2,
      "text": "そのまま普通にパン屋さんの話をしたんですけど"
    },
    {
      "startSec": 26,
      "text": "「あ、そう言えば百本エピソード作ったな」と思って"
    },
    {
      "startSec": 31.8,
      "text": "今日はちょっと"
    },
    {
      "startSec": 33.3,
      "text": "セレブレーションじゃないけど"
    },
    {
      "startSec": 35.3,
      "text": "百本作りました、頑張りました。"
    },
    {
      "startSec": 39.1,
      "text": "このポッドキャストを始めてからの感想、"
    },
    {
      "startSec": 45.2,
      "text": "私のこのポッドキャストへの思いですね。"
    },
    {
      "startSec": 50.4,
      "text": "それをちょっと皆さんと話したいなと思います。"
    },
    {
      "startSec": 58.3,
      "text": "本当にたくさんの人が聞いてくれて"
    },
    {
      "startSec": 61.7,
      "text": "ありがとうございます。"
    },
    {
      "startSec": 63.7,
      "text": "YouTubeには毎日ビデオ、アップロードしてますが"
    },
    {
      "startSec": 69.9,
      "text": "大体三百人から四百人くらいの人が"
    },
    {
      "startSec": 75.4,
      "text": "いつも聞いてくれますね。"
    },
    {
      "startSec": 78.2,
      "text": "これは本当にすごい。"
    },
    {
      "startSec": 80.7,
      "text": "もうそれくらいの人が多分"
    },
    {
      "startSec": 83.1,
      "text": "私のポッドキャストを習慣にして"
    },
    {
      "startSec": 87.3,
      "text": "習慣(routine)にして聞いてくれますね。"
    },
    {
      "startSec": 91.4,
      "text": "これは本当に嬉しいです。"
    },
    {
      "startSec": 94.4,
      "text": "あとは、SpotifyとかApple Podcastでも"
    },
    {
      "startSec": 99.2,
      "text": "聞いてくれている人たちがいて"
    },
    {
      "startSec": 102.2,
      "text": "そういうポッドキャストの"
    },
    {
      "startSec": 104.2,
      "text": "YouTubeの他のポッドキャストの"
    },
    {
      "startSec": 108.5,
      "text": "ストリーミングapp、プラットフォーム"
    },
    {
      "startSec": 112.2,
      "text": "なんていうかな？"
    },
    {
      "startSec": 113.3,
      "text": "そこでも大体三百人くらいの人が"
    },
    {
      "startSec": 117.6,
      "text": "聞いてくれています。"
    },
    {
      "startSec": 119.8,
      "text": "これは本当にとても嬉しいことで"
    },
    {
      "startSec": 123.9,
      "text": "聞いてくれている人、ありがとうございます。"
    },
    {
      "startSec": 128.3,
      "text": "むちゃくちゃ嬉しいです。"
    },
    {
      "startSec": 133.8,
      "text": "このポッドキャストを始めたのは"
    },
    {
      "startSec": 136.8,
      "text": "2021年の11月くらいだったと思います。"
    },
    {
      "startSec": 145,
      "text": "最初は本当に全然話せなくて"
    },
    {
      "startSec": 150.4,
      "text": "レコーディングを始めて、なんか一分くらい話して"
    },
    {
      "startSec": 155.1,
      "text": "すぐに「あ、やっぱりダメ」って思ってやめて"
    },
    {
      "startSec": 160.6,
      "text": "また始めて、また消して、始めて、消してみたいな。"
    },
    {
      "startSec": 166.6,
      "text": "本当にそんな感じだったんですね。"
    },
    {
      "startSec": 170.3,
      "text": "でも本当最近は、そういうことはもうなくなって"
    },
    {
      "startSec": 177.5,
      "text": "普通に自分が話したい事をもう自由に"
    },
    {
      "startSec": 183.6,
      "text": "台本も書いてないので"
    },
    {
      "startSec": 186.8,
      "text": "カメラを見て話しています。"
    },
    {
      "startSec": 190.1,
      "text": "やっぱりこれは練習したから"
    },
    {
      "startSec": 193.7,
      "text": "今できるようになったんですね。"
    },
    {
      "startSec": 197,
      "text": "もちろんまだ、話はそんなに上手くないし"
    },
    {
      "startSec": 202.4,
      "text": "なんか自分で言ってることが"
    },
    {
      "startSec": 205.6,
      "text": "わからなくなること、それもたくさんあるんですが"
    },
    {
      "startSec": 211,
      "text": "やっぱり去年の11月に比べると"
    },
    {
      "startSec": 216.2,
      "text": "本当に言葉が、ちゃんと自分の中から"
    },
    {
      "startSec": 222.7,
      "text": "出てくるようになりました。"
    },
    {
      "startSec": 226.5,
      "text": "これは本当に練習ができて良かったなと思っています。"
    },
    {
      "startSec": 232.3,
      "text": "やっぱりスピーキングのスキルって"
    },
    {
      "startSec": 235.3,
      "text": "これからきっと大切ですよね。"
    },
    {
      "startSec": 238.6,
      "text": "だからそれは本当に「自分、頑張ったな」と思います。"
    },
    {
      "startSec": 244.1,
      "text": "毎日本当に少しずつ"
    },
    {
      "startSec": 247.5,
      "text": "一時間くらい練習したのが良かったと思います。"
    },
    {
      "startSec": 254.2,
      "text": "もちろん私がポッドキャストを始めたのは"
    },
    {
      "startSec": 258.3,
      "text": "私がポッドキャストが大好きだからです。"
    },
    {
      "startSec": 262.8,
      "text": "私も本当によくポッドキャストを聞いています。"
    },
    {
      "startSec": 269.2,
      "text": "やっぱりいいよね、ポッドキャスト。"
    },
    {
      "startSec": 273.4,
      "text": "やっぱり勉強にいいですよね。"
    },
    {
      "startSec": 276.1,
      "text": "英語の勉強とか"
    },
    {
      "startSec": 278.6,
      "text": "ビジネスの勉強、マナーの勉強とか"
    },
    {
      "startSec": 282.7,
      "text": "本当にポッドキャストはいいですよね。"
    },
    {
      "startSec": 289.2,
      "text": "あとは…何？何か言いたいことがあったけど"
    },
    {
      "startSec": 292.5,
      "text": "忘れちゃった（笑）"
    },
    {
      "startSec": 293.7,
      "text": "忘れることがあるんですよね。"
    },
    {
      "startSec": 295.6,
      "text": "やっぱりポッドキャストって"
    },
    {
      "startSec": 299.2,
      "text": "クリエイターさんの、ポッドキャスターの"
    },
    {
      "startSec": 303.1,
      "text": "性格がちゃんと出ますよね。"
    },
    {
      "startSec": 307.1,
      "text": "YouTubeだったら、本当にたくさんカットして"
    },
    {
      "startSec": 311.3,
      "text": "編集(editing)をするので性格は見えにくい。"
    },
    {
      "startSec": 317.4,
      "text": "でもポッドキャストは"
    },
    {
      "startSec": 319.5,
      "text": "本当にその人の性格が出やすいです。"
    },
    {
      "startSec": 325.6,
      "text": "やっぱりあとは"
    },
    {
      "startSec": 327.7,
      "text": "正直自分のポッドキャストを"
    },
    {
      "startSec": 331.5,
      "text": "どれくらいたくさんの人が聞いているかとか"
    },
    {
      "startSec": 336.4,
      "text": "フォローしてるかとか、コメントがあるかとか"
    },
    {
      "startSec": 341.1,
      "text": "他のクリエイターさんと"
    },
    {
      "startSec": 343.9,
      "text": "自分のオーディエンスの違いとかが"
    },
    {
      "startSec": 349,
      "text": "あまりわからないんですね。"
    },
    {
      "startSec": 351.8,
      "text": "だからそれが本当に心に優しい。"
    },
    {
      "startSec": 356.3,
      "text": "自分を他のクリエイターさんと比べないから"
    },
    {
      "startSec": 361.6,
      "text": "本当にいいです。"
    },
    {
      "startSec": 363.8,
      "text": "でもYouTubeとかInstagramは"
    },
    {
      "startSec": 367.2,
      "text": "もう自分と他の人を"
    },
    {
      "startSec": 370.9,
      "text": "本当にすごくよく比べるんですよね。"
    },
    {
      "startSec": 374.5,
      "text": "比べるようにデザインされてるんですよね、多分。"
    },
    {
      "startSec": 380.5,
      "text": "そう思います。"
    },
    {
      "startSec": 383.9,
      "text": "だから本当にクリエイターじゃなくても"
    },
    {
      "startSec": 387.4,
      "text": "InstagramとかTwitterとかに"
    },
    {
      "startSec": 392.6,
      "text": "中毒(addicted)になって"
    },
    {
      "startSec": 398.9,
      "text": "心の病気になる人もいますよね。"
    },
    {
      "startSec": 403.3,
      "text": "Instagram、そのおかげで"
    },
    {
      "startSec": 405.6,
      "text": "私はたくさんのフォロワーさんとか"
    },
    {
      "startSec": 408.7,
      "text": "先生と出会うことができて本当によかったけど"
    },
    {
      "startSec": 414.5,
      "text": "でももちろん辛い、悲しい思いをしたこととか"
    },
    {
      "startSec": 419.8,
      "text": "心が壊れそうになったこととかあります"
    },
    {
      "startSec": 425.9,
      "text": "でもやっぱりaddictiveなんですよね。"
    },
    {
      "startSec": 430.1,
      "text": "そういうソーシャルメディアを作った会社は"
    },
    {
      "startSec": 433.2,
      "text": "多分そういうこと全部わかって"
    },
    {
      "startSec": 436.9,
      "text": "人間の心をちゃんとわかって"
    },
    {
      "startSec": 440.8,
      "text": "そして多分デザインしたんですよね。"
    },
    {
      "startSec": 445.1,
      "text": "そう考えると、ちょっと怖いですけど。"
    },
    {
      "startSec": 453.4,
      "text": "ポッドキャストはそれとはまた違って"
    },
    {
      "startSec": 457,
      "text": "本当にいいと思います。"
    },
    {
      "startSec": 460.7,
      "text": "もうなんかメリットだけ考えちゃう。"
    },
    {
      "startSec": 463.6,
      "text": "デメリットあるかな、ポッドキャストのデメリット。"
    },
    {
      "startSec": 468.8,
      "text": "あんまりないと思うんですよね。"
    },
    {
      "startSec": 473.8,
      "text": "皆さん何かあったら教えてください。"
    },
    {
      "startSec": 478.5,
      "text": "これからもこのポッドキャストは"
    },
    {
      "startSec": 481.4,
      "text": "一日一つエピソードを作って"
    },
    {
      "startSec": 486.3,
      "text": "皆さんに日本語のビデオ・音声届けたいと思います。"
    },
    {
      "startSec": 493.7,
      "text": "本当にポッドキャストは好きだから"
    },
    {
      "startSec": 496.3,
      "text": "これからずっと続けたいです。"
    },
    {
      "startSec": 501,
      "text": "このポッドキャストだけじゃなくて"
    },
    {
      "startSec": 504.6,
      "text": "日本人のためのポッドキャストも"
    },
    {
      "startSec": 509.3,
      "text": "何か作りたいなと思っています。"
    },
    {
      "startSec": 513.8,
      "text": "私は結構学生だった時、生徒だった時"
    },
    {
      "startSec": 520.3,
      "text": "家のこととか、お父さん・お母さんのこと"
    },
    {
      "startSec": 523.8,
      "text": "クラスメート・友達のことで"
    },
    {
      "startSec": 527.5,
      "text": "悩んでいたことがとても多かったので"
    },
    {
      "startSec": 531.3,
      "text": "なんかそういう私の経験を"
    },
    {
      "startSec": 534.7,
      "text": "若い人に伝えることができたら"
    },
    {
      "startSec": 538.5,
      "text": "いいなと最近思っています。"
    },
    {
      "startSec": 541.4,
      "text": "特に学校に行きたくない子どもに"
    },
    {
      "startSec": 546.1,
      "text": "そういう私のメッセージを伝えたいです。"
    },
    {
      "startSec": 551.5,
      "text": "本当に、若い時、生徒・学生の時って"
    },
    {
      "startSec": 557.4,
      "text": "もう学校に行かないと"
    },
    {
      "startSec": 559.6,
      "text": "みんな心配して「学校に行きなさい」とか"
    },
    {
      "startSec": 563.8,
      "text": "「もっと頑張りなさい」とか言いますよね。"
    },
    {
      "startSec": 567.9,
      "text": "でもそういう言葉ってすごく辛くてしんどくて。"
    },
    {
      "startSec": 574,
      "text": "でも実は学校に行かなくても大丈夫って"
    },
    {
      "startSec": 579,
      "text": "私は思います。"
    },
    {
      "startSec": 581.4,
      "text": "やっぱり今こうやって休学して学校の外に出ると"
    },
    {
      "startSec": 587.7,
      "text": "もう世界は本当に広いって思います。"
    },
    {
      "startSec": 591.5,
      "text": "だから学校っていうすっごく小さい世界にいて"
    },
    {
      "startSec": 597.3,
      "text": "で、そこで自分がうまくできないからって"
    },
    {
      "startSec": 603.2,
      "text": "すごくもう悲しくなったりするんじゃなくて"
    },
    {
      "startSec": 608,
      "text": "もっと学校の外に出て、いろんな人の話を聞いて"
    },
    {
      "startSec": 614,
      "text": "「あ、みんな頑張ってるんだ」"
    },
    {
      "startSec": 617.2,
      "text": "「自分はこのままでいいんだ」みたいな"
    },
    {
      "startSec": 621,
      "text": "そういうふうに思えたら素敵ですよねって、"
    },
    {
      "startSec": 626.3,
      "text": "そういうことを伝えたいです。"
    },
    {
      "startSec": 629.9,
      "text": "で、やっぱり私の英語はまだまだ十分じゃないので"
    },
    {
      "startSec": 636.4,
      "text": "日本語で伝えたいです。"
    },
    {
      "startSec": 641.6,
      "text": "そういうことも考えています。"
    },
    {
      "startSec": 644.1,
      "text": "もしそういうポッドキャスト、"
    },
    {
      "startSec": 646.4,
      "text": "エピソードを作ったら"
    },
    {
      "startSec": 648.4,
      "text": "また皆さんに紹介したいと思います。"
    },
    {
      "startSec": 652.5,
      "text": "今日はこんな感じです。"
    },
    {
      "startSec": 654.3,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 656.7,
      "text": "今、毎週Patreonでメンバーの人オンリーに"
    },
    {
      "startSec": 663.4,
      "text": "エクスクルーシブ・エピソードを作っています。"
    },
    {
      "startSec": 667.3,
      "text": "で、そのエピソードでは"
    },
    {
      "startSec": 669.9,
      "text": "もっと私のパーソナルな話とか"
    },
    {
      "startSec": 675.3,
      "text": "日常のことですね、話をしています。"
    },
    {
      "startSec": 679.8,
      "text": "もし興味があったら"
    },
    {
      "startSec": 681.6,
      "text": "サポートとしてくれると嬉しいです。"
    },
    {
      "startSec": 685.4,
      "text": "本当にPatreonに入らなくても"
    },
    {
      "startSec": 688.2,
      "text": "本当にこのポッドキャストを聞いてくれるだけで"
    },
    {
      "startSec": 693.9,
      "text": "嬉しいので、本当にありがとうございます。"
    },
    {
      "startSec": 698.3,
      "text": "そしてこれからも是非聞いてください。"
    },
    {
      "startSec": 702.9,
      "text": "今日はここまでです。"
    },
    {
      "startSec": 704.1,
      "text": "ありがとうございます。"
    },
    {
      "startSec": 705.4,
      "text": "じゃあまたね、バイバイ！"
    }
  ]
}
