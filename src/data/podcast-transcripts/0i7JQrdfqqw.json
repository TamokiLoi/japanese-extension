{
  "episodeId": "0i7JQrdfqqw",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.7,
      "text": "今日は「部活」"
    },
    {
      "startSec": 6.2,
      "text": "これは学校の後にするクラブです。"
    },
    {
      "startSec": 10.9,
      "text": "「部活」と言います。"
    },
    {
      "startSec": 12.3,
      "text": "この部活について話したいと思います。"
    },
    {
      "startSec": 16.4,
      "text": "日本の部活はすっごく厳しくて"
    },
    {
      "startSec": 22.5,
      "text": "皆さんちょっとびっくりすると思います。"
    },
    {
      "startSec": 25.6,
      "text": "私も部活は大嫌いで"
    },
    {
      "startSec": 27.9,
      "text": "すっごく大変だったし"
    },
    {
      "startSec": 30.5,
      "text": "今日はちょっとその話を"
    },
    {
      "startSec": 32.6,
      "text": "皆さんとシェアしたいと思います。"
    },
    {
      "startSec": 35.7,
      "text": "日本の中学校と高校には部活があって"
    },
    {
      "startSec": 41.6,
      "text": "色んな種類があります。"
    },
    {
      "startSec": 43.7,
      "text": "大体10個くらい種類があるかな。"
    },
    {
      "startSec": 48.3,
      "text": "で、学校に入った時に"
    },
    {
      "startSec": 51.1,
      "text": "その部活を選ばないといけません。"
    },
    {
      "startSec": 55.1,
      "text": "私はバレーボールを選びました。"
    },
    {
      "startSec": 60.5,
      "text": "もちろん絶対部活に入らないといけないことはないです。"
    },
    {
      "startSec": 66,
      "text": "でも大体80％くらいの生徒が部活に入ります。"
    },
    {
      "startSec": 74,
      "text": "部活に入らなくてもいいけど"
    },
    {
      "startSec": 77,
      "text": "入らないといけない雰囲気(atomosphere)があります。"
    },
    {
      "startSec": 85,
      "text": "すっごくしんどくて"
    },
    {
      "startSec": 86.7,
      "text": "部活はほとんど毎日あります。"
    },
    {
      "startSec": 90.5,
      "text": "月曜日から金曜日まで。"
    },
    {
      "startSec": 93.4,
      "text": "めっちゃしんどい。"
    },
    {
      "startSec": 95,
      "text": "学校の勉強の後、4時半くらいから"
    },
    {
      "startSec": 99.5,
      "text": "夏は7時ぐらいまで…6時半くらいかな。"
    },
    {
      "startSec": 106.6,
      "text": "6時半とか7時くらいまで部活があります。"
    },
    {
      "startSec": 112.5,
      "text": "途中で帰ることはできません。"
    },
    {
      "startSec": 116.4,
      "text": "毎日あります。"
    },
    {
      "startSec": 120,
      "text": "毎日ですよ。"
    },
    {
      "startSec": 121,
      "text": "だから日本の生徒が家に帰るのは、もうすごく遅い。"
    },
    {
      "startSec": 126.4,
      "text": "7時とか8時ぐらい。"
    },
    {
      "startSec": 128.2,
      "text": "夜遅くに帰ります。"
    },
    {
      "startSec": 130.9,
      "text": "で、先輩が厳しいです。"
    },
    {
      "startSec": 136.1,
      "text": "ほとんどのクラブがそんな感じ。"
    },
    {
      "startSec": 139.4,
      "text": "先輩がすごく厳しくて"
    },
    {
      "startSec": 142.2,
      "text": "先輩に敬語で話さないといけないし"
    },
    {
      "startSec": 146.9,
      "text": "先輩の手伝いをしないといけないし"
    },
    {
      "startSec": 150.7,
      "text": "先輩よりも頑張らないといけないし"
    },
    {
      "startSec": 154.6,
      "text": "先輩より先に帰ったらいけません。"
    },
    {
      "startSec": 158.9,
      "text": "すごく厳しいね。"
    },
    {
      "startSec": 160.8,
      "text": "変なルールがたくさんあります。"
    },
    {
      "startSec": 164.7,
      "text": "で、土曜日も部活があることがあります。"
    },
    {
      "startSec": 169.9,
      "text": "例えば朝9時から12時までとか。"
    },
    {
      "startSec": 173.8,
      "text": "で、厳しい部活、"
    },
    {
      "startSec": 175.7,
      "text": "私の中学校は"
    },
    {
      "startSec": 177.5,
      "text": "ハンドボールとか野球(baseball)がすごく厳しくて"
    },
    {
      "startSec": 184.1,
      "text": "日曜日も部活がある時はありました。"
    },
    {
      "startSec": 188.8,
      "text": "夏休みとか冬休みも部活があります。"
    },
    {
      "startSec": 194.8,
      "text": "私のバレーボールも結構厳しかったので"
    },
    {
      "startSec": 200.4,
      "text": "もう毎日、月曜日から金曜日まで"
    },
    {
      "startSec": 205.6,
      "text": "朝9時から4時まで部活がありました。"
    },
    {
      "startSec": 210.4,
      "text": "休みですよ、夏休み。"
    },
    {
      "startSec": 213.3,
      "text": "夏休みとか冬休みに部活がありました。"
    },
    {
      "startSec": 217.2,
      "text": "ヤバイいですよね。"
    },
    {
      "startSec": 219.5,
      "text": "いつ生徒は休むことができるのでしょうか？"
    },
    {
      "startSec": 225.1,
      "text": "休む時間ないですよね。"
    },
    {
      "startSec": 227.7,
      "text": "ヤバくないですか？"
    },
    {
      "startSec": 230.3,
      "text": "で、日本の生徒はよく塾にも行きます。"
    },
    {
      "startSec": 236,
      "text": "塾は、学校の後に勉強する場所のことです。"
    },
    {
      "startSec": 243.2,
      "text": "結構高い。"
    },
    {
      "startSec": 244.8,
      "text": "1時間の授業が2,000円とかする。"
    },
    {
      "startSec": 248.3,
      "text": "結構高い場所で、学校で勉強したことを"
    },
    {
      "startSec": 253,
      "text": "もう一度塾で勉強します。"
    },
    {
      "startSec": 256.8,
      "text": "私は塾も絶対行きたくなかったので"
    },
    {
      "startSec": 260,
      "text": "私のお父さんお母さんも"
    },
    {
      "startSec": 261.9,
      "text": "「行く必要はない」と言ってくれたので"
    },
    {
      "startSec": 265.4,
      "text": "行きませんでしたが、"
    },
    {
      "startSec": 269,
      "text": "塾に行っている生徒も多かった。"
    },
    {
      "startSec": 272.9,
      "text": "多分50％ぐらいの生徒が行っていたと思います。"
    },
    {
      "startSec": 278.9,
      "text": "なので、日本の中学校とか高校の生徒は"
    },
    {
      "startSec": 284.5,
      "text": "朝もう多分8時ぐらいに学校に行って"
    },
    {
      "startSec": 288.7,
      "text": "4時半まで勉強をして"
    },
    {
      "startSec": 291.8,
      "text": "そこから部活をして、"
    },
    {
      "startSec": 294.2,
      "text": "7時ぐらいまで部活をして"
    },
    {
      "startSec": 297.1,
      "text": "そこから塾に行って"
    },
    {
      "startSec": 299.9,
      "text": "1時間半くらい勉強して家に帰る。"
    },
    {
      "startSec": 304.8,
      "text": "こういう生徒がすごく多いです。"
    },
    {
      "startSec": 307.8,
      "text": "ヤバイですよね。"
    },
    {
      "startSec": 309.5,
      "text": "私はこれが本当にしんどくて"
    },
    {
      "startSec": 312.3,
      "text": "前もエピソードで話したけど"
    },
    {
      "startSec": 314.5,
      "text": "15キロぐらいやせてしまったりとか"
    },
    {
      "startSec": 317.6,
      "text": "もう本当にストレスで学校は大嫌いでした。"
    },
    {
      "startSec": 323,
      "text": "ヤバイですよね。"
    },
    {
      "startSec": 324.4,
      "text": "またこの話を皆さんと"
    },
    {
      "startSec": 326.6,
      "text": "もうちょっと詳しくしたいと思います。"
    },
    {
      "startSec": 329.9,
      "text": "これはどう思いますか？"
    },
    {
      "startSec": 331.7,
      "text": "皆さんは日本の中学校、高校行けますか？"
    },
    {
      "startSec": 336,
      "text": "行きたいですか？どうですか？"
    },
    {
      "startSec": 339.8,
      "text": "大変ですよね。"
    },
    {
      "startSec": 342.3,
      "text": "いや～しんどかったな。"
    },
    {
      "startSec": 346.7,
      "text": "本当に、私は勉強とか部活よりも"
    },
    {
      "startSec": 350.3,
      "text": "もっとその自分の時間を"
    },
    {
      "startSec": 352.6,
      "text": "大切にする方がいいと思います。"
    },
    {
      "startSec": 356.3,
      "text": "もう自分の好きなこと、"
    },
    {
      "startSec": 358.4,
      "text": "例えば絵を描いたりとか"
    },
    {
      "startSec": 360.5,
      "text": "本を読んだりとか"
    },
    {
      "startSec": 362.3,
      "text": "家族といっぱい話したりとか"
    },
    {
      "startSec": 364.8,
      "text": "犬と散歩に行ったりとか"
    },
    {
      "startSec": 367.1,
      "text": "もっとご飯をゆっくり食べたりとか"
    },
    {
      "startSec": 369.9,
      "text": "もっと大切なことってたくさんありますよね。"
    },
    {
      "startSec": 374.2,
      "text": "でもほとんどの日本の生徒はできていないし"
    },
    {
      "startSec": 379.7,
      "text": "もちろん大人も、残業する人は本当に多いし"
    },
    {
      "startSec": 384.8,
      "text": "なかなか自分の時間を大切にするのは難しいです。"
    },
    {
      "startSec": 390.3,
      "text": "皆さんもきっと毎日忙しいと思うんですが"
    },
    {
      "startSec": 394.3,
      "text": "時には自分の時間も大切にして"
    },
    {
      "startSec": 397.7,
      "text": "自分が好きなことを色々やってみて"
    },
    {
      "startSec": 401.4,
      "text": "心も体も元気に毎日頑張ってください。"
    },
    {
      "startSec": 406.3,
      "text": "じゃあ今日はこんな感じで終わろうと思います。"
    },
    {
      "startSec": 409.2,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 411.2,
      "text": "じゃまた明日！バイバイ！"
    }
  ]
}
