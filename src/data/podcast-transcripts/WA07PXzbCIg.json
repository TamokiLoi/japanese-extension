{
  "episodeId": "WA07PXzbCIg",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.1,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.5,
      "text": "今日は、日本人に嫌われる食事のマナーについて"
    },
    {
      "startSec": 13.3,
      "text": "話したいと思います。"
    },
    {
      "startSec": 15.8,
      "text": "私は結構、マナーには優しいと思います。"
    },
    {
      "startSec": 21.3,
      "text": "私もあんまりマナーは気にしないです。"
    },
    {
      "startSec": 26.2,
      "text": "結構手で食べるのが好きなので"
    },
    {
      "startSec": 29.4,
      "text": "よくご飯もこう手で食べたりします。"
    },
    {
      "startSec": 33.4,
      "text": "なんか手で食べる方が"
    },
    {
      "startSec": 35.6,
      "text": "本当に食べ物を食べてるっていう感じが"
    },
    {
      "startSec": 40.3,
      "text": "私はそんな感じがします。"
    },
    {
      "startSec": 43.4,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 45.5,
      "text": "そんな私でもちょっと許したくない、許せないことがあります。"
    },
    {
      "startSec": 54.4,
      "text": "それは食べ物を全部食べないこと、"
    },
    {
      "startSec": 59.1,
      "text": "そして汚く食べることです。"
    },
    {
      "startSec": 64.7,
      "text": "日本人はいつも絶対食べ物はきれいに食べます。"
    },
    {
      "startSec": 71.7,
      "text": "ご飯を食べる時、食べ終わったら"
    },
    {
      "startSec": 76.3,
      "text": "食器の中にお米があることはないです。"
    },
    {
      "startSec": 82.9,
      "text": "全部きれいに取って食べます。"
    },
    {
      "startSec": 87.4,
      "text": "サラダを食べる時とかも、もうほとんど食べ物は"
    },
    {
      "startSec": 91.9,
      "text": "全部お箸で集めてきれいに食べます"
    },
    {
      "startSec": 98.2,
      "text": "でもこの前、京都でタイ料理を食べた時"
    },
    {
      "startSec": 105.1,
      "text": "ちょっとびっくりすることがあったんです。"
    },
    {
      "startSec": 109.3,
      "text": "タイ料理を食べていた時に、私達の横に、"
    },
    {
      "startSec": 115.5,
      "text": "アメリカ人の女の人達がご飯を食べていました。"
    },
    {
      "startSec": 122.2,
      "text": "でなんか、彼女たちのアクセントがすごく"
    },
    {
      "startSec": 126.6,
      "text": "可愛くて英語で話していました。"
    },
    {
      "startSec": 129.7,
      "text": "私はすごく優しい人達だなと思って"
    },
    {
      "startSec": 135.4,
      "text": "話を聞いていました。"
    },
    {
      "startSec": 138.1,
      "text": "で、彼女達が「That was so nice、美味しかった」と言って"
    },
    {
      "startSec": 143.7,
      "text": "お店を出たんです。"
    },
    {
      "startSec": 146.8,
      "text": "彼女達が出た後に、彼女達のテーブルを見たら、"
    },
    {
      "startSec": 157,
      "text": "びっくりしました。"
    },
    {
      "startSec": 158.2,
      "text": "めっちゃびっくりした。"
    },
    {
      "startSec": 160.4,
      "text": "もう本当に汚くて、"
    },
    {
      "startSec": 163.1,
      "text": "三歳の子供が食事をした後みたいな感じでした。"
    },
    {
      "startSec": 170.5,
      "text": "それは私はちょっと、文化が違っても"
    },
    {
      "startSec": 174.3,
      "text": "それは私はダメだと思います。"
    },
    {
      "startSec": 180.2,
      "text": "やっぱり食べ物は絶対大切にしないといけないと"
    },
    {
      "startSec": 186.6,
      "text": "私は思います。"
    },
    {
      "startSec": 188.6,
      "text": "だから私は絶対に、食べ物は残したくない。"
    },
    {
      "startSec": 194,
      "text": "絶対に残したくないです。"
    },
    {
      "startSec": 196.8,
      "text": "それはその食べ物に「ありがとう」という気持ちを"
    },
    {
      "startSec": 202.6,
      "text": "伝えるため、"
    },
    {
      "startSec": 204.7,
      "text": "そしてその食べ物を作ってくれた人に"
    },
    {
      "startSec": 210.6,
      "text": "「ありがとう、美味しかったよ」って伝えるためです。"
    },
    {
      "startSec": 215.7,
      "text": "でもその彼女達は、もう本当に全然食べていなくて"
    },
    {
      "startSec": 221.7,
      "text": "そのタイの美味しいスープも半分くらい残っていたし"
    },
    {
      "startSec": 229.2,
      "text": "色んなサラダもお皿の端、お皿の横に"
    },
    {
      "startSec": 235.3,
      "text": "サラダがベチョッて付いてる感じ"
    },
    {
      "startSec": 239.9,
      "text": "お皿からこぼれていました。"
    },
    {
      "startSec": 243.7,
      "text": "これって、皿を片付けてくれる人にも迷惑です。"
    },
    {
      "startSec": 252.7,
      "text": "だって汚いお皿は触りたくないです。"
    },
    {
      "startSec": 258.2,
      "text": "だから私はちょっとびっくりしました。"
    },
    {
      "startSec": 262.4,
      "text": "皆さんが結構、もし食べるのが汚かったら"
    },
    {
      "startSec": 268.2,
      "text": "日本に来た時はぜひ気を付けてください。"
    },
    {
      "startSec": 272.5,
      "text": "日本のマナーです。"
    },
    {
      "startSec": 275.3,
      "text": "私の彼氏はイギリス人なので"
    },
    {
      "startSec": 279.4,
      "text": "彼もすごくきれいに食べます。"
    },
    {
      "startSec": 283.5,
      "text": "イギリスでも、食べ物を残すことはよくないです。"
    },
    {
      "startSec": 290.3,
      "text": "全部きれいに食べることが当たり前、普通です。"
    },
    {
      "startSec": 297.5,
      "text": "この前、ずっと前に"
    },
    {
      "startSec": 300.3,
      "text": "彼氏の友達のJETプログラムの人達と"
    },
    {
      "startSec": 306.6,
      "text": "ご飯に行ったことがあります。"
    },
    {
      "startSec": 310.1,
      "text": "彼らはオーストラリア人です。"
    },
    {
      "startSec": 314.5,
      "text": "すごくたくさんご飯が出てきたので"
    },
    {
      "startSec": 319.3,
      "text": "めっちゃお腹いっぱいになったんですが"
    },
    {
      "startSec": 321.7,
      "text": "私は全部食べました。"
    },
    {
      "startSec": 324.8,
      "text": "で、彼氏も全部食べました。"
    },
    {
      "startSec": 328.1,
      "text": "でも彼の友達の人達は全然食べなかった。"
    },
    {
      "startSec": 335,
      "text": "ちょっと食べて、残す。"
    },
    {
      "startSec": 336.7,
      "text": "すごく食器が汚かったです。"
    },
    {
      "startSec": 341.8,
      "text": "これは是非日本に来たときは気を付けてください。"
    },
    {
      "startSec": 346.4,
      "text": "特に年上の人は、それをすごく気にすると思います。"
    },
    {
      "startSec": 356.3,
      "text": "すいません、ちょっと文句みたいになってしまいましたが"
    },
    {
      "startSec": 360.2,
      "text": "もちろん皆さんは、皆さんの文化でご飯を食べて"
    },
    {
      "startSec": 365.8,
      "text": "日本に来たときは気を付けてください、という話でした。"
    },
    {
      "startSec": 372.1,
      "text": "たくさん文句を言ってすみません。"
    },
    {
      "startSec": 376,
      "text": "でも最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 379.9,
      "text": "もしよかったら皆さんの国の"
    },
    {
      "startSec": 383.5,
      "text": "ご飯を食べる時のルールがあったら"
    },
    {
      "startSec": 387.3,
      "text": "是非コメントで教えてください。"
    },
    {
      "startSec": 390.8,
      "text": "日本だけじゃなくて、色んな文化のルールとか決まり、"
    },
    {
      "startSec": 398.6,
      "text": "習慣(custom)が勉強できるのは本当に楽しいです。"
    },
    {
      "startSec": 405.7,
      "text": "いつもコメントとかありがとうございます。"
    },
    {
      "startSec": 409.2,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
