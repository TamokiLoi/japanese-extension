{
  "episodeId": "9kt_dK1Sn0o",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい皆さん、Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3,
      "text": "元気ですか？"
    },
    {
      "startSec": 4.3,
      "text": "今日は、ちょっと私の話をしたいと思います。"
    },
    {
      "startSec": 10.5,
      "text": "最近、私がちょっと成長した話です。"
    },
    {
      "startSec": 18,
      "text": "ちょっといい人になったかも。"
    },
    {
      "startSec": 22.1,
      "text": "言うことが難しいですが、"
    },
    {
      "startSec": 24.6,
      "text": "最近、この1年くらいで"
    },
    {
      "startSec": 28.3,
      "text": "「あ、何か、頑張っているのは自分だけじゃないんだ」と"
    },
    {
      "startSec": 36,
      "text": "本当に心から思うことができるようになったんです。"
    },
    {
      "startSec": 43.4,
      "text": "本当にそうです。"
    },
    {
      "startSec": 45.1,
      "text": "この話を今日は皆さんとシェアしたいと思います。"
    },
    {
      "startSec": 50,
      "text": "私が会社に就職しないで"
    },
    {
      "startSec": 53.5,
      "text": "自分でビジネスしたい、自分で生きていきたいと"
    },
    {
      "startSec": 59.3,
      "text": "考えるようになったのは"
    },
    {
      "startSec": 61.9,
      "text": "大体2年くらい前です。"
    },
    {
      "startSec": 65.1,
      "text": "その時は本当にもう一生懸命で"
    },
    {
      "startSec": 68.9,
      "text": "すっごく頑張っていて"
    },
    {
      "startSec": 72.2,
      "text": "本当に色んな本とか"
    },
    {
      "startSec": 74.4,
      "text": "ビジネスを教えている人の"
    },
    {
      "startSec": 77.3,
      "text": "YouTubeのビデオとかを"
    },
    {
      "startSec": 79.8,
      "text": "毎日すごく見ていました。"
    },
    {
      "startSec": 83.3,
      "text": "やっぱりそういう本とか"
    },
    {
      "startSec": 85,
      "text": "ビジネスのYouTubeのビデオは結構厳しいです。"
    },
    {
      "startSec": 91.9,
      "text": "もちろんそういう本とかビデオは"
    },
    {
      "startSec": 94.8,
      "text": "その人達の商品(product)です。"
    },
    {
      "startSec": 99.2,
      "text": "だからその人達の商品を、もっと買ってもらうために"
    },
    {
      "startSec": 105.3,
      "text": "結構強いことを言ったりします。"
    },
    {
      "startSec": 110,
      "text": "頑張っていないのはいけない。"
    },
    {
      "startSec": 112.7,
      "text": "例えば、サラリーマンでいることは悪いことみたいに"
    },
    {
      "startSec": 117.6,
      "text": "すごくきつい、きついは強いという意味ですが"
    },
    {
      "startSec": 122.6,
      "text": "きついことを言います。"
    },
    {
      "startSec": 125.4,
      "text": "で、私はそういう本とかを結構読んでいたので"
    },
    {
      "startSec": 131.4,
      "text": "「ああ、もっと頑張らないとダメだ」といつも思っていました。"
    },
    {
      "startSec": 136.9,
      "text": "「もっと頑張らないと、もっと勉強しないといけない」と"
    },
    {
      "startSec": 141.7,
      "text": "すごく思っていました。"
    },
    {
      "startSec": 144.2,
      "text": "その時私は大学生だったんですが、"
    },
    {
      "startSec": 148.9,
      "text": "私の周りの友達が"
    },
    {
      "startSec": 153.4,
      "text": "あまり頑張っていないみたいに見えたんです。"
    },
    {
      "startSec": 160.9,
      "text": "私はあまりみんな頑張っていないように"
    },
    {
      "startSec": 164.5,
      "text": "見えてしまったんです。"
    },
    {
      "startSec": 167,
      "text": "本当にそれは、間違っていたし"
    },
    {
      "startSec": 170.2,
      "text": "自分が正しくなかった。"
    },
    {
      "startSec": 172,
      "text": "ですが、もう自分がビジネスに集中し過ぎて"
    },
    {
      "startSec": 178,
      "text": "周りのことが、他のことが"
    },
    {
      "startSec": 181.2,
      "text": "見えなくなっていました。"
    },
    {
      "startSec": 184.6,
      "text": "本当に恥ずかしい話です。"
    },
    {
      "startSec": 187.3,
      "text": "でも、もう2年前の話で、"
    },
    {
      "startSec": 190.8,
      "text": "で、1年くらい前から"
    },
    {
      "startSec": 193.1,
      "text": "InstagramとかYouTubeとか頑張って"
    },
    {
      "startSec": 196.5,
      "text": "日本語を少しずつ教えるようになって"
    },
    {
      "startSec": 201,
      "text": "本当にうまくいかないこと"
    },
    {
      "startSec": 204.7,
      "text": "うまくいかない＝成功しないこと、失敗することです。"
    },
    {
      "startSec": 210.3,
      "text": "失敗することがすごく多かったです。"
    },
    {
      "startSec": 215.8,
      "text": "やっぱり自分が、例えば"
    },
    {
      "startSec": 218.1,
      "text": "YouTube、1つのビデオ、1万回再生(play)"
    },
    {
      "startSec": 224.7,
      "text": "再生されてほしいと思っても無理ですし"
    },
    {
      "startSec": 229.1,
      "text": "で、日本語を教えることは難しいし"
    },
    {
      "startSec": 233.9,
      "text": "私は経験(experience)が全然ないし"
    },
    {
      "startSec": 239.8,
      "text": "分からないこと、いっぱいだし"
    },
    {
      "startSec": 242.6,
      "text": "どれだけたくさん頑張っても失敗するし"
    },
    {
      "startSec": 248.6,
      "text": "そういうことが1年間ありました。"
    },
    {
      "startSec": 254.9,
      "text": "1年間本当に頑張ったけど失敗をたくさんして"
    },
    {
      "startSec": 261.7,
      "text": "で、少しずつ自分にも他の人にも"
    },
    {
      "startSec": 268.3,
      "text": "優しくなれたと思います。"
    },
    {
      "startSec": 270.8,
      "text": "実は1週間前に"
    },
    {
      "startSec": 273.7,
      "text": "ちょっと京都に帰って"
    },
    {
      "startSec": 275.9,
      "text": "大学の時の友達に会いました。"
    },
    {
      "startSec": 279.8,
      "text": "その子は私が大学にいない間に"
    },
    {
      "startSec": 284.3,
      "text": "1年間すっごく頑張って"
    },
    {
      "startSec": 287.8,
      "text": "卒業するための論文(paper)を100ページ書いて"
    },
    {
      "startSec": 293.9,
      "text": "そしてすっごく難しい"
    },
    {
      "startSec": 297.5,
      "text": "建築士(architect)になるための"
    },
    {
      "startSec": 301.3,
      "text": "テストにも合格しました。"
    },
    {
      "startSec": 305.2,
      "text": "そういう話を聞いて、"
    },
    {
      "startSec": 307.3,
      "text": "で、しかもその子は、もう働く会社は決まっています。"
    },
    {
      "startSec": 312.9,
      "text": "この4月から働き始めます。"
    },
    {
      "startSec": 317,
      "text": "で、その友達を見て"
    },
    {
      "startSec": 320.1,
      "text": "その友達も、全然人には言わないけど"
    },
    {
      "startSec": 325.1,
      "text": "頑張ってたんだなってすごく思いました。"
    },
    {
      "startSec": 329.7,
      "text": "もちろん、私が正しいと思っていることを"
    },
    {
      "startSec": 333.4,
      "text": "他の人がそれをしてないからと言って"
    },
    {
      "startSec": 337,
      "text": "その他の人たちが頑張っていない"
    },
    {
      "startSec": 340.6,
      "text": "これは違います。"
    },
    {
      "startSec": 345,
      "text": "そこに気が付くことができました。"
    },
    {
      "startSec": 349.9,
      "text": "私の友達は何も考えないで"
    },
    {
      "startSec": 354.8,
      "text": "とりあえず大きな会社に就職する、"
    },
    {
      "startSec": 359.9,
      "text": "みんなそういう風に会社を決めて、"
    },
    {
      "startSec": 363.5,
      "text": "ネットで会社を探して、会社を決めて就職しました。"
    },
    {
      "startSec": 369.3,
      "text": "私はそれは本当にしたくなかったから"
    },
    {
      "startSec": 373.2,
      "text": "そうやって就職した友達が"
    },
    {
      "startSec": 377,
      "text": "頑張っていないみたいに見えたんです。"
    },
    {
      "startSec": 382.3,
      "text": "でも、京都に帰った時に"
    },
    {
      "startSec": 385.9,
      "text": "一人の友達と話をした時に、その友達は、"
    },
    {
      "startSec": 392.6,
      "text": "「会社は決まったけど本当にこれでいいのか、"
    },
    {
      "startSec": 397.9,
      "text": "本当にこれが正しいのか、"
    },
    {
      "startSec": 400.9,
      "text": "まだまだ迷っている、まだまだ考えている」"
    },
    {
      "startSec": 405.9,
      "text": "と言っていました。"
    },
    {
      "startSec": 408.8,
      "text": "そこで私は「あ、そっか、そうだったんだ」って。"
    },
    {
      "startSec": 414.2,
      "text": "みんな悩んでるよね。"
    },
    {
      "startSec": 416.2,
      "text": "私も悩んでいたけど、私だけじゃなくて"
    },
    {
      "startSec": 420.9,
      "text": "みんな悩んでるし、頑張ってるし"
    },
    {
      "startSec": 425.4,
      "text": "私がなりたい人、将来の姿が"
    },
    {
      "startSec": 432.2,
      "text": "他の人がなりたい姿と違っても"
    },
    {
      "startSec": 437.3,
      "text": "別に大丈夫なんだと、少し思えるようになりました。"
    },
    {
      "startSec": 445.9,
      "text": "今日は皆さんと正直に、私の気持ちを話しました。"
    },
    {
      "startSec": 452.6,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 456.8,
      "text": "これからも正直にエピソード、作っていきたいと思います。"
    },
    {
      "startSec": 462.2,
      "text": "いつも本当にありがとう。"
    },
    {
      "startSec": 464.1,
      "text": "じゃあ今日も良い一日を！"
    },
    {
      "startSec": 466.3,
      "text": "じゃあまたね！バイバイ！"
    }
  ]
}
