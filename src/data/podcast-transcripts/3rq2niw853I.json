{
  "episodeId": "3rq2niw853I",
  "segments": [
    {
      "startSec": 0.3,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4,
      "text": "今日はお知らせです。"
    },
    {
      "startSec": 7.5,
      "text": "三月の終わりに、私はジャック、彼氏と"
    },
    {
      "startSec": 12.9,
      "text": "ちょっと旅行に行きたいなと思っています。"
    },
    {
      "startSec": 17.4,
      "text": "でも旅行に一週間行きますが、その前に"
    },
    {
      "startSec": 22.3,
      "text": "たくさんポッドキャストを作ってから行くので"
    },
    {
      "startSec": 26.9,
      "text": "毎日のエピソードはちゃんと皆さんに届きます。"
    },
    {
      "startSec": 31.6,
      "text": "ちゃんと聞くことができます。"
    },
    {
      "startSec": 34.4,
      "text": "心配しないでください。"
    },
    {
      "startSec": 37.2,
      "text": "ちょっとその旅行の予定の話をしたいと思います。"
    },
    {
      "startSec": 43.6,
      "text": "一週間、三月の二十六日から行く予定です。"
    },
    {
      "startSec": 49.6,
      "text": "最初の二日(2days)、"
    },
    {
      "startSec": 54.1,
      "text": "二日間は福井県(prefecture)に"
    },
    {
      "startSec": 58.2,
      "text": "行きたいなと思っています。"
    },
    {
      "startSec": 61,
      "text": "理由は福井県にはすごく大きな"
    },
    {
      "startSec": 65.8,
      "text": "恐竜博物館(museum)があるんです。"
    },
    {
      "startSec": 70,
      "text": "恐竜(dinosaurs)は皆さん好きですか？"
    },
    {
      "startSec": 75.1,
      "text": "私は結構好き。"
    },
    {
      "startSec": 77.1,
      "text": "で、私の彼氏がすっごく好きなんです。"
    },
    {
      "startSec": 82.9,
      "text": "なので福井県に"
    },
    {
      "startSec": 84.9,
      "text": "恐竜のミュージアムを見るために行ってきます。"
    },
    {
      "startSec": 89.4,
      "text": "でもね、福井県ちょっと遠いです。"
    },
    {
      "startSec": 94,
      "text": "でも行きます。"
    },
    {
      "startSec": 96.9,
      "text": "で福井県に行った時に"
    },
    {
      "startSec": 99.2,
      "text": "私の大学生の時の友達に会いたいなと思っています。"
    },
    {
      "startSec": 106.2,
      "text": "彼女はもうちょっとで"
    },
    {
      "startSec": 108.5,
      "text": "多分今年か来年、結婚します。"
    },
    {
      "startSec": 113,
      "text": "私と同い年=同じ年、でも同じ年は言わない。"
    },
    {
      "startSec": 122.4,
      "text": "いつも同い年と言います。"
    },
    {
      "startSec": 127.3,
      "text": "彼女も私と同い年、二十四歳です。"
    },
    {
      "startSec": 135.7,
      "text": "で、びっくりしました。"
    },
    {
      "startSec": 137.2,
      "text": "「結婚するんだ」と思ってね。"
    },
    {
      "startSec": 143,
      "text": "私のベトナム人の友達、彼女は今二十七歳くらいかな。"
    },
    {
      "startSec": 150,
      "text": "彼女はまだ学生、大学で勉強しています。"
    },
    {
      "startSec": 155,
      "text": "日本の留学生。"
    },
    {
      "startSec": 157.6,
      "text": "でも彼女は今二十七歳で、ベトナムの友達は"
    },
    {
      "startSec": 163.2,
      "text": "もうほとんどみんな結婚したって言っていました。"
    },
    {
      "startSec": 168.7,
      "text": "で、ベトナムに帰ったら"
    },
    {
      "startSec": 171.2,
      "text": "お父さんお母さんに「いつ結婚するの？」って"
    },
    {
      "startSec": 175.9,
      "text": "よく聞かれるって言っていました。"
    },
    {
      "startSec": 181.1,
      "text": "文化によって場所によって"
    },
    {
      "startSec": 184.9,
      "text": "結婚の年、年齢は全然違いますよね。"
    },
    {
      "startSec": 191.2,
      "text": "ちょっと調べたんですが"
    },
    {
      "startSec": 193.4,
      "text": "日本の結婚する年の平均(average)は"
    },
    {
      "startSec": 199.7,
      "text": "2020年で男の人は31歳で、女の人は29歳です。"
    },
    {
      "startSec": 211.8,
      "text": "もう30歳です。"
    },
    {
      "startSec": 216.1,
      "text": "27年前の1995年、この時は"
    },
    {
      "startSec": 223.8,
      "text": "男の人の結婚の年は28歳、女の人は26歳でした。"
    },
    {
      "startSec": 233.2,
      "text": "なので本当に日本の結婚の年は"
    },
    {
      "startSec": 236.5,
      "text": "どんどん遅くなっています。"
    },
    {
      "startSec": 239.8,
      "text": "私は多分、30歳、33歳…ああどうしよう…"
    },
    {
      "startSec": 246.6,
      "text": "ジャックさんがビザが必要なので、日本にいるために、"
    },
    {
      "startSec": 252.6,
      "text": "だからジャックがビザが必要になったら結婚したいです。"
    },
    {
      "startSec": 259.4,
      "text": "でも子供はまだまだ全然欲しくない。"
    },
    {
      "startSec": 263.8,
      "text": "まだやりたいことがたくさんあります。"
    },
    {
      "startSec": 269.2,
      "text": "なので、子供は32歳くらいがいいかなって思ってます。"
    },
    {
      "startSec": 276.1,
      "text": "すいません、ちょっと結婚の話が長くなりましたが"
    },
    {
      "startSec": 280.1,
      "text": "福井県の後は、京都に行きます。"
    },
    {
      "startSec": 284.7,
      "text": "私は京都に住んでいたので"
    },
    {
      "startSec": 288,
      "text": "もう全部の場所に行ったので"
    },
    {
      "startSec": 291.4,
      "text": "ちょっと、リラックスして"
    },
    {
      "startSec": 295.7,
      "text": "いい景色を見て、いいお店を探して"
    },
    {
      "startSec": 300.6,
      "text": "クラフトビールを飲んで"
    },
    {
      "startSec": 302.6,
      "text": "ゆっくりしたいなと思っています。"
    },
    {
      "startSec": 305.9,
      "text": "で、一日だけ奈良に行きたいです。"
    },
    {
      "startSec": 311.1,
      "text": "その日は私とジャックと私の家族で"
    },
    {
      "startSec": 317.6,
      "text": "みんなで奈良を散歩したいなと思っています。"
    },
    {
      "startSec": 322.4,
      "text": "多分私の家族もジャックも、めっちゃ緊張してると思います。"
    },
    {
      "startSec": 328.6,
      "text": "その時は、私の大学を散歩してから"
    },
    {
      "startSec": 333.2,
      "text": "二月堂というすごくきれいなお寺があるので"
    },
    {
      "startSec": 338.7,
      "text": "そこに行きたいかな。"
    },
    {
      "startSec": 341.3,
      "text": "そのお寺は多分私が一番好きなお寺です。"
    },
    {
      "startSec": 346.9,
      "text": "あの良かったら検索してみてください。"
    },
    {
      "startSec": 350.5,
      "text": "二月堂だと思います。奈良にあります。"
    },
    {
      "startSec": 355.2,
      "text": "奈良の大きな仏様(Buddha)の"
    },
    {
      "startSec": 359,
      "text": "大きな像(statue)があります。"
    },
    {
      "startSec": 363.4,
      "text": "そのお寺、東大寺のちょっと上にあります。"
    },
    {
      "startSec": 368.2,
      "text": "是非奈良に来た時は行ってください。"
    },
    {
      "startSec": 371.7,
      "text": "東大寺よりもめっちゃいいです。"
    },
    {
      "startSec": 374.7,
      "text": "お勧めですよ。"
    },
    {
      "startSec": 378.5,
      "text": "じゃあ今日はこんな感じです。"
    },
    {
      "startSec": 380.5,
      "text": "また京都から帰ったらエピソードを作って"
    },
    {
      "startSec": 384.4,
      "text": "旅行の話をします。"
    },
    {
      "startSec": 387.2,
      "text": "いつも聞いてくれて本当にありがとう。"
    },
    {
      "startSec": 390.9,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
