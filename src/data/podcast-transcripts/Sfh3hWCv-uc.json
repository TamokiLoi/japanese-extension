{
  "episodeId": "Sfh3hWCv-uc",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.3,
      "text": "今日は日本人にモテるタイプの人"
    },
    {
      "startSec": 10.4,
      "text": "私の学校でよくモテていた友達"
    },
    {
      "startSec": 15.8,
      "text": "そのモテるタイプについて"
    },
    {
      "startSec": 18.3,
      "text": "ちょっと話をしたいと思います。"
    },
    {
      "startSec": 21.8,
      "text": "皆さん日本に興味があったら"
    },
    {
      "startSec": 26.2,
      "text": "日本人にモテるタイプの人、気になりますよね。"
    },
    {
      "startSec": 33.5,
      "text": "私は実はモテた経験がなくて"
    },
    {
      "startSec": 37.4,
      "text": "全然男の人に告白された経験はないです。"
    },
    {
      "startSec": 45.5,
      "text": "告白される、告白する(confess one's love to someone)"
    },
    {
      "startSec": 52,
      "text": "日本には告白カルチャーがあって"
    },
    {
      "startSec": 55.5,
      "text": "告白をしないと"
    },
    {
      "startSec": 58.1,
      "text": "お付き合い(dating someone)は始まらないです。"
    },
    {
      "startSec": 63.7,
      "text": "ちょっと鼻がかゆくてすいません。"
    },
    {
      "startSec": 66.1,
      "text": "告白しないと付き合いは始まらない。"
    },
    {
      "startSec": 71.2,
      "text": "告白はすごく"
    },
    {
      "startSec": 73.2,
      "text": "ロマンチックなことですよね。"
    },
    {
      "startSec": 75.8,
      "text": "でも私の友達ですごくモテていた友達がいて"
    },
    {
      "startSec": 83,
      "text": "多分その子はもう本当に中学校・高校・大学で多分"
    },
    {
      "startSec": 89.9,
      "text": "十人くらいの男の人に告白されたと思います。"
    },
    {
      "startSec": 97.5,
      "text": "すごいよね。"
    },
    {
      "startSec": 98.8,
      "text": "私は告白されたのは"
    },
    {
      "startSec": 102,
      "text": "昔付き合っていた男の人一人とジャックさん"
    },
    {
      "startSec": 106.1,
      "text": "ジャックさんと今付き合っていて"
    },
    {
      "startSec": 107.8,
      "text": "本当に二人だけなんですが、もうその子はモテモテで"
    },
    {
      "startSec": 113.5,
      "text": "ちょっとモテすぎて困っていたと思いますね。"
    },
    {
      "startSec": 119.1,
      "text": "でもちょっとその子の特徴を話したいと思います。"
    },
    {
      "startSec": 124.8,
      "text": "今私「その子」って言ったんですが"
    },
    {
      "startSec": 128.4,
      "text": "「子」は子供の「子」、でも「その子」と言ったけど"
    },
    {
      "startSec": 133.8,
      "text": "「その子」が子供という意味じゃなくて"
    },
    {
      "startSec": 137.8,
      "text": "「その人」という意味ね。"
    },
    {
      "startSec": 140.3,
      "text": "「その子」=「その人」同じ意味。"
    },
    {
      "startSec": 144.1,
      "text": "でも「子」を使った方が"
    },
    {
      "startSec": 147.4,
      "text": "何かフレンドリーに聞こえます。"
    },
    {
      "startSec": 151.3,
      "text": "まだその友達は若いし、私の友達なので"
    },
    {
      "startSec": 156.5,
      "text": "その子と言ったほうが"
    },
    {
      "startSec": 158.5,
      "text": "何かフレンドリ－に優しく聞こえます。"
    },
    {
      "startSec": 163.8,
      "text": "その子はすごく聞き上手"
    },
    {
      "startSec": 167.1,
      "text": "話を聞くことが上手、聞き上手な友達でした。"
    },
    {
      "startSec": 172.6,
      "text": "すごく優しくて"
    },
    {
      "startSec": 174.9,
      "text": "リアクションも何かいつも楽しくてかわいいし"
    },
    {
      "startSec": 180.2,
      "text": "すごく面白いわけじゃないし"
    },
    {
      "startSec": 184.6,
      "text": "すごく勉強ができるわけじゃないし"
    },
    {
      "startSec": 188.5,
      "text": "めちゃくちゃ美人、もうめっちゃきれい"
    },
    {
      "startSec": 192.2,
      "text": "っていうわけでもなかったです。"
    },
    {
      "startSec": 196.1,
      "text": "でもやっぱり肌がすごくきれいで"
    },
    {
      "startSec": 200.1,
      "text": "髪の毛もめっちゃきれいでかわいい女の子でした。"
    },
    {
      "startSec": 207.3,
      "text": "で、なんかやっぱりモテる日本の女の子は"
    },
    {
      "startSec": 214.1,
      "text": "他の国とどう違うかわからないけど"
    },
    {
      "startSec": 219.6,
      "text": "やっぱりモテる日本の女の子は"
    },
    {
      "startSec": 223.1,
      "text": "すごく清楚(せいそ)なタイプが多い。"
    },
    {
      "startSec": 227,
      "text": "清楚…これは控えめ、あまり派手じゃない。"
    },
    {
      "startSec": 233.1,
      "text": "例えばメイクがあまり濃くないとか"
    },
    {
      "startSec": 238.5,
      "text": "ファッションも優しい感じ、優しい雰囲気で"
    },
    {
      "startSec": 245.2,
      "text": "髪の毛の色とかも"
    },
    {
      "startSec": 247.3,
      "text": "日本人は黒の髪なので、黒に近い色で"
    },
    {
      "startSec": 253.1,
      "text": "ちょっとストレートな感じかな。"
    },
    {
      "startSec": 256.7,
      "text": "そういう優しいタイプの"
    },
    {
      "startSec": 259.7,
      "text": "控えめ(humble)な女の子が日本ではモテます。"
    },
    {
      "startSec": 267.6,
      "text": "派手な色の服を着ている人とか"
    },
    {
      "startSec": 273,
      "text": "髪の毛がすごい派手な色とか"
    },
    {
      "startSec": 276.8,
      "text": "そういう人はあんまりモテないかな。"
    },
    {
      "startSec": 283,
      "text": "あとやっぱり家事ね。"
    },
    {
      "startSec": 285.1,
      "text": "家の仕事ができるかどうか"
    },
    {
      "startSec": 288.9,
      "text": "これもモテるポイントだと思います。"
    },
    {
      "startSec": 295.2,
      "text": "あとはやっぱりまだ日本では細い人の方がモテます。"
    },
    {
      "startSec": 302.5,
      "text": "なんか今結構、体が大きい人、"
    },
    {
      "startSec": 306.8,
      "text": "足とかお尻が大きい女の人のスタイルが"
    },
    {
      "startSec": 312.2,
      "text": "すごく流行っていますよね。"
    },
    {
      "startSec": 314.8,
      "text": "トレンドですよね、特にアメリカとか。"
    },
    {
      "startSec": 317.8,
      "text": "でも日本にはそのトレンドはないですよね、正直。"
    },
    {
      "startSec": 323,
      "text": "やっぱり細い人がずっとモテるし"
    },
    {
      "startSec": 325.5,
      "text": "「細い」の基準(standard)もすごく高い。"
    },
    {
      "startSec": 329.1,
      "text": "だから体のBMI、ありますよね。"
    },
    {
      "startSec": 333.9,
      "text": "で日本では大体、BMIが21が平均(average)です。"
    },
    {
      "startSec": 343.4,
      "text": "でも21は大体私の体型、スタイルですが"
    },
    {
      "startSec": 350.2,
      "text": "私も結構足は太いです。"
    },
    {
      "startSec": 352.9,
      "text": "でもそれは普通じゃなくて"
    },
    {
      "startSec": 355.8,
      "text": "太ってると思っている男の人は結構多いです。"
    },
    {
      "startSec": 361.4,
      "text": "ちょっとこれは悲しいですよね。"
    },
    {
      "startSec": 364,
      "text": "私が高校生の時に"
    },
    {
      "startSec": 366.6,
      "text": "水トアナウンサーというかわいいアナウンサーが"
    },
    {
      "startSec": 370.7,
      "text": "すごく人気の時がありました。"
    },
    {
      "startSec": 374.9,
      "text": "で、彼女はすごく美味しい物を"
    },
    {
      "startSec": 377.7,
      "text": "たくさん食べるのが好きで。"
    },
    {
      "startSec": 380.7,
      "text": "でも彼女が人気だった理由は"
    },
    {
      "startSec": 384,
      "text": "彼女がちょっとぽっちゃり"
    },
    {
      "startSec": 386.3,
      "text": "ちょっと太っていたからです。"
    },
    {
      "startSec": 388.7,
      "text": "でも確か彼女の体型、スタイルは"
    },
    {
      "startSec": 392.3,
      "text": "五十二キロ、五十三キロとか"
    },
    {
      "startSec": 395.1,
      "text": "それぐらいだから全然重くない。"
    },
    {
      "startSec": 399.1,
      "text": "でもみんな、日本人は"
    },
    {
      "startSec": 403,
      "text": "それは彼女は太っていて"
    },
    {
      "startSec": 405.3,
      "text": "ちょっとぽっちゃりしていて"
    },
    {
      "startSec": 407,
      "text": "かわいいって言っていました。"
    },
    {
      "startSec": 409.2,
      "text": "だから「ぽっちゃりしているアナウンサー」と言えば"
    },
    {
      "startSec": 414.4,
      "text": "その水トアナウンサーみたいなイメージ。"
    },
    {
      "startSec": 418.4,
      "text": "だから体重が五十三キロ、五十四キロの"
    },
    {
      "startSec": 423.1,
      "text": "背が低い女の子"
    },
    {
      "startSec": 425.9,
      "text": "それが何か太っていると思われるのはちょっと…"
    },
    {
      "startSec": 434.3,
      "text": "なんかとちょっと私は嫌ですね。"
    },
    {
      "startSec": 438.6,
      "text": "もっと色んなスタイルの人が認めてもらえるような"
    },
    {
      "startSec": 444.5,
      "text": "社会になってほしいなと思いますね。"
    },
    {
      "startSec": 448.9,
      "text": "で男性だったら、働き始めたら"
    },
    {
      "startSec": 453.9,
      "text": "多分お金とか社会のポジションとかが"
    },
    {
      "startSec": 458.4,
      "text": "すごくモテるキーワードになると思うんですけど"
    },
    {
      "startSec": 465.3,
      "text": "生徒の時、小学校・中学校・高校生の時は"
    },
    {
      "startSec": 470.9,
      "text": "あまり勉強ができるかどうかは関係ないですよね。"
    },
    {
      "startSec": 477.7,
      "text": "勉強よりもやっぱり運動が出来るか"
    },
    {
      "startSec": 481.9,
      "text": "これがすごくポイントですよね。"
    },
    {
      "startSec": 485,
      "text": "足が速い、速く走れる子とか"
    },
    {
      "startSec": 489.5,
      "text": "運動が出来る子、これを「運動神経がいい子」"
    },
    {
      "startSec": 494.1,
      "text": "「運動神経がいい」「運動ができる」と言います。"
    },
    {
      "startSec": 498.2,
      "text": "そういう男の子がすごくモテたと思います。"
    },
    {
      "startSec": 504,
      "text": "で最後にちょっとこれは私の愚痴なんですけど"
    },
    {
      "startSec": 511,
      "text": "やっぱり日本のアニメって"
    },
    {
      "startSec": 514.4,
      "text": "気持ち悪いアニメありますよね。"
    },
    {
      "startSec": 517.1,
      "text": "女の子の中学生とか高校生の漫画・アニメで"
    },
    {
      "startSec": 523.3,
      "text": "胸とかお尻をすごく強調(exaggerate)して描く。"
    },
    {
      "startSec": 532.3,
      "text": "肌もすごく何か光っていて"
    },
    {
      "startSec": 536.2,
      "text": "ちょっとセクシャルな感じのアニメ・漫画が"
    },
    {
      "startSec": 540.6,
      "text": "すごく多いなと思っていて、それが私は嫌です。"
    },
    {
      "startSec": 547.6,
      "text": "よくその地域、ローカルのマスコットキャラクター"
    },
    {
      "startSec": 553,
      "text": "そのローカルを代表するキャラクターに"
    },
    {
      "startSec": 556.7,
      "text": "そういう若い女の子のキャラクターが多いです。"
    },
    {
      "startSec": 562.2,
      "text": "私が前住んでいた町・市のキャラクターも"
    },
    {
      "startSec": 567.4,
      "text": "若い女の子でした。"
    },
    {
      "startSec": 570.2,
      "text": "でもその子は何かスカートが十センチくらいで"
    },
    {
      "startSec": 574.7,
      "text": "お尻ほぼ見えてるし"
    },
    {
      "startSec": 576.7,
      "text": "胸もブラジャーをつけていないような変な胸で"
    },
    {
      "startSec": 582.1,
      "text": "でもそういうポスターが"
    },
    {
      "startSec": 583.5,
      "text": "町の色んな場所にあるんですよね。"
    },
    {
      "startSec": 588.2,
      "text": "で「気まず(い)！」と思って。"
    },
    {
      "startSec": 591.6,
      "text": "もう見たくないしそういう絵を。"
    },
    {
      "startSec": 594.4,
      "text": "でこの前私が福井県の一条谷という場所に行った時も"
    },
    {
      "startSec": 601.2,
      "text": "福井のマスコットキャラクターの"
    },
    {
      "startSec": 604.7,
      "text": "五人くらいの女の子のグループ"
    },
    {
      "startSec": 608.1,
      "text": "もちろんアニメ・漫画ですね。"
    },
    {
      "startSec": 611,
      "text": "(アニメ・漫画)があって"
    },
    {
      "startSec": 612.1,
      "text": "みんなスカートが十センチくらいで"
    },
    {
      "startSec": 615.5,
      "text": "もうパンツが見えそうな感じで"
    },
    {
      "startSec": 618.5,
      "text": "何かすごくセクシャルなんですよね。"
    },
    {
      "startSec": 623.6,
      "text": "それを本当にやめてほしいです、私は。"
    },
    {
      "startSec": 627.7,
      "text": "まあそういうのが好きだったら"
    },
    {
      "startSec": 629.7,
      "text": "隠れたところに"
    },
    {
      "startSec": 631,
      "text": "そういう本とかアニメを置いてほしい。"
    },
    {
      "startSec": 635.1,
      "text": "やっぱりみんなが集まる駅とか道で"
    },
    {
      "startSec": 639.9,
      "text": "そういう絵を出すのは"
    },
    {
      "startSec": 642.4,
      "text": "私は本当にやめてほしいなと思います。"
    },
    {
      "startSec": 646.5,
      "text": "ちょっと文句が多くなりましたが"
    },
    {
      "startSec": 651.4,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 654.8,
      "text": "皆さんはそういう日本のちょっと"
    },
    {
      "startSec": 659.9,
      "text": "気持ちが悪いアニメとか漫画どう思いますか？"
    },
    {
      "startSec": 667.1,
      "text": "ちょっとコメントで教えてください。"
    },
    {
      "startSec": 670.3,
      "text": "あと皆さんの国のモテるタイプの人の特徴について"
    },
    {
      "startSec": 679.5,
      "text": "コメントで教えてくれたらうれしいです。"
    },
    {
      "startSec": 683.9,
      "text": "皆さんのコメントを読むのを"
    },
    {
      "startSec": 686.3,
      "text": "楽しみにしています。"
    },
    {
      "startSec": 688.7,
      "text": "もしこのポッドキャスト、気に入ったら"
    },
    {
      "startSec": 691.6,
      "text": "レビューを残してくれるとすごく嬉しいです。"
    },
    {
      "startSec": 696.1,
      "text": "皆さんのレビューのおかげでやっぱり"
    },
    {
      "startSec": 699.6,
      "text": "成長することができるし"
    },
    {
      "startSec": 701.9,
      "text": "もっと多くの人に届けることができます。"
    },
    {
      "startSec": 706.8,
      "text": "なのでよかったらよろしくお願いします。"
    },
    {
      "startSec": 710.7,
      "text": "じゃあまた明日のエピソードで会いましょう！"
    },
    {
      "startSec": 714.3,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 716.4,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
