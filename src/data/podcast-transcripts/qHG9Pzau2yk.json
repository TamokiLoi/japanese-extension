{
  "episodeId": "qHG9Pzau2yk",
  "segments": [
    {
      "startSec": 0,
      "text": "皆さんこんにちは！レイラです。"
    },
    {
      "startSec": 3.5,
      "text": "今日もききに来てくれてありがとうございます。"
    },
    {
      "startSec": 7.3,
      "text": "えっと、今日は、何について話すっけ..."
    },
    {
      "startSec": 12.4,
      "text": "そうそう！先週、京都に帰りました。"
    },
    {
      "startSec": 17,
      "text": "二日だけね。"
    },
    {
      "startSec": 18.3,
      "text": "京都に2回目のワクチンのために"
    },
    {
      "startSec": 22.1,
      "text": "帰りました。"
    },
    {
      "startSec": 23.3,
      "text": "で、その時の話を"
    },
    {
      "startSec": 25.2,
      "text": "ちょっとしようかなと思います。"
    },
    {
      "startSec": 28.1,
      "text": "皆さんは、日本語の勉強どんな感じですか？"
    },
    {
      "startSec": 33.3,
      "text": "毎日少しずつ勉強できていますか？やっぱりね"
    },
    {
      "startSec": 38.6,
      "text": "言語、言葉の勉強は"
    },
    {
      "startSec": 41.2,
      "text": "毎日続けることが大切ですよね。"
    },
    {
      "startSec": 45,
      "text": "なんか、私も本当は"
    },
    {
      "startSec": 46.5,
      "text": "もっと英語を勉強しないとダメだと思うけど、"
    },
    {
      "startSec": 52,
      "text": "やっぱりなんか..."
    },
    {
      "startSec": 52.8,
      "text": "やっぱり皆さんとか、私の英語みたいに"
    },
    {
      "startSec": 59,
      "text": "ちょっとなんかintermediateとか"
    },
    {
      "startSec": 61.8,
      "text": "ちょっとアドバンスになると"
    },
    {
      "startSec": 64.2,
      "text": "もう教科書は使いたくないよね？"
    },
    {
      "startSec": 67.1,
      "text": "教科書を使いたくないし、"
    },
    {
      "startSec": 69.6,
      "text": "なんかまあ、細かい"
    },
    {
      "startSec": 71.9,
      "text": "小さな間違いとか"
    },
    {
      "startSec": 74.3,
      "text": "文法とか、もうなんか"
    },
    {
      "startSec": 76.5,
      "text": "そんなに気にしたくないし、"
    },
    {
      "startSec": 79.8,
      "text": "やっぱりたくさん話す練習"
    },
    {
      "startSec": 82.5,
      "text": "楽しい！楽しい勉強がしたいですよね？"
    },
    {
      "startSec": 86.5,
      "text": "でも、なんか楽しい"
    },
    {
      "startSec": 88.8,
      "text": "勉強ばっかりしてたら"
    },
    {
      "startSec": 91.2,
      "text": "やっぱり私はまだ、例えば"
    },
    {
      "startSec": 93.9,
      "text": "aとか、theとか、in、at、for 、of とか"
    },
    {
      "startSec": 100.7,
      "text": "withとかの使い方が全然わかってないし、"
    },
    {
      "startSec": 105.6,
      "text": "やっぱり...."
    },
    {
      "startSec": 108.9,
      "text": "やっぱり、長くね、長ーい道ですね"
    },
    {
      "startSec": 114.4,
      "text": "長い道。言葉は本当に"
    },
    {
      "startSec": 117.4,
      "text": "言葉の勉強は長い道です。"
    },
    {
      "startSec": 121.4,
      "text": "これからも少しずつね。頑張っていきましょうね"
    },
    {
      "startSec": 127,
      "text": "そうそうそう"
    },
    {
      "startSec": 127.7,
      "text": "podcastに私のpodcastに"
    },
    {
      "startSec": 131.4,
      "text": "これからビデオができます。"
    },
    {
      "startSec": 135.1,
      "text": "このpodcastのyoutubeチャンネルを作りました。"
    },
    {
      "startSec": 139.6,
      "text": "ま、だから、私が話している時に"
    },
    {
      "startSec": 143.8,
      "text": "じまくサブタイトルを読みたい人は"
    },
    {
      "startSec": 149.5,
      "text": "ぜひyoutubeでこのビデオを見て下さい。"
    },
    {
      "startSec": 154,
      "text": "私の話している顔も見ることができます。"
    },
    {
      "startSec": 158.6,
      "text": "もしもね、もしもし見たかったらぜひ見てみてください。"
    },
    {
      "startSec": 164.6,
      "text": "見なくてもいいけどね、"
    },
    {
      "startSec": 166.3,
      "text": "うん。はい。で、実は先週"
    },
    {
      "startSec": 169.6,
      "text": "京都に帰りました。"
    },
    {
      "startSec": 172.6,
      "text": "2回目のワクチンのために"
    },
    {
      "startSec": 175.3,
      "text": "京都に帰りました。"
    },
    {
      "startSec": 177.9,
      "text": "その時は、えっとね、土曜日じゃなかった"
    },
    {
      "startSec": 182,
      "text": "日曜日の朝早く、５時に起きて"
    },
    {
      "startSec": 188,
      "text": "岡山に行って、"
    },
    {
      "startSec": 189.7,
      "text": "岡山駅から京都まで"
    },
    {
      "startSec": 193.1,
      "text": "新幹線で帰りました。"
    },
    {
      "startSec": 196.8,
      "text": "結構ね、近い。"
    },
    {
      "startSec": 198.4,
      "text": "岡山駅から京都まで"
    },
    {
      "startSec": 202.2,
      "text": "一時間？5０分？"
    },
    {
      "startSec": 204.1,
      "text": "50分くらい！１時間もかからない"
    },
    {
      "startSec": 207.7,
      "text": "50分くらいですごく近くて"
    },
    {
      "startSec": 212.5,
      "text": "日曜日の朝、家出て"
    },
    {
      "startSec": 214.7,
      "text": "日曜日の11時に"
    },
    {
      "startSec": 218.1,
      "text": "ワクチンの場所に行って、ワクチンして"
    },
    {
      "startSec": 222.1,
      "text": "その後は、大学の友達が"
    },
    {
      "startSec": 225.4,
      "text": "京都に来ていたので、"
    },
    {
      "startSec": 228.5,
      "text": "京都の比叡山（ひえいざん）、聞いたことありますか？"
    },
    {
      "startSec": 233.5,
      "text": "すごく有名な山なんだけど、"
    },
    {
      "startSec": 237.2,
      "text": "比叡山（ひえいざん）に行きました。"
    },
    {
      "startSec": 239.2,
      "text": "でもね、これが失敗したの。"
    },
    {
      "startSec": 244.5,
      "text": "何もリサーチ、検索とか"
    },
    {
      "startSec": 248,
      "text": "調べないで行っちゃったから"
    },
    {
      "startSec": 253.3,
      "text": "まじでね、何にも見れなかった。"
    },
    {
      "startSec": 258.1,
      "text": "「比叡山 Hieizan」って、ちょっと良かったら"
    },
    {
      "startSec": 260.4,
      "text": "googleで検索してください"
    },
    {
      "startSec": 263.7,
      "text": "めっちゃ有名な観光地です。"
    },
    {
      "startSec": 268.8,
      "text": "多分、多分というか"
    },
    {
      "startSec": 270.1,
      "text": "まあ、私もずっと前にテレビで見たんだけど"
    },
    {
      "startSec": 274.1,
      "text": "比叡山って大きな山"
    },
    {
      "startSec": 276,
      "text": "比叡山の山は山。"
    },
    {
      "startSec": 278.6,
      "text": "比叡山っていう"
    },
    {
      "startSec": 279.4,
      "text": "すごく大きな山に、お坊さん"
    },
    {
      "startSec": 283.6,
      "text": "priests、お坊さんがたくさん住んでいて"
    },
    {
      "startSec": 287.6,
      "text": "修行（しゅぎょう）しています。"
    },
    {
      "startSec": 290,
      "text": "修行（しゅぎょう）は英語で何て言うかな？"
    },
    {
      "startSec": 292.7,
      "text": "その...毎日だから"
    },
    {
      "startSec": 294.9,
      "text": "お坊さんが住んでいて毎日"
    },
    {
      "startSec": 297.1,
      "text": "トレーニングしていますね・"
    },
    {
      "startSec": 300.4,
      "text": "トレーニングしてるし"
    },
    {
      "startSec": 303.8,
      "text": "たくさん神社とか"
    },
    {
      "startSec": 306.7,
      "text": "多分、お寺とか建物があります。"
    },
    {
      "startSec": 312,
      "text": "で、山の中にちょんちょんちょんちょんちょんて"
    },
    {
      "startSec": 316.9,
      "text": "バラバラにあるから"
    },
    {
      "startSec": 321,
      "text": "その... たくさんお寺とか神社が見たかったら"
    },
    {
      "startSec": 327.3,
      "text": "たくさん歩くとか"
    },
    {
      "startSec": 330.4,
      "text": "バスを使って移動（いどう）しないといけない"
    },
    {
      "startSec": 335.8,
      "text": "たくさんパスとかを使って見ないといけない。"
    },
    {
      "startSec": 339.7,
      "text": "だから、比叡山を見たかったら"
    },
    {
      "startSec": 343.6,
      "text": "多分、1日、朝から夜まで"
    },
    {
      "startSec": 347.4,
      "text": "しっかり時間をとって"
    },
    {
      "startSec": 351.3,
      "text": "しっかり時間を...なんだろうな"
    },
    {
      "startSec": 354.7,
      "text": "余裕（よゆう）を持って！"
    },
    {
      "startSec": 356.2,
      "text": "余裕をもって、比叡山に行くといいです！"
    },
    {
      "startSec": 363.3,
      "text": "私は午後から行ったから"
    },
    {
      "startSec": 368.9,
      "text": "で、私の友達は5時に東京に行く"
    },
    {
      "startSec": 375.4,
      "text": "新幹線のチケットを買っていたから、"
    },
    {
      "startSec": 379.5,
      "text": "午後の１時からご５時までしか"
    },
    {
      "startSec": 383.1,
      "text": "時間がなくて、何も見れなかった"
    },
    {
      "startSec": 387.3,
      "text": "本当に比叡山の一番上"
    },
    {
      "startSec": 391.4,
      "text": "山の上に行くまでに、"
    },
    {
      "startSec": 394.5,
      "text": "１時間半ぐらいかかってて、でも"
    },
    {
      "startSec": 398,
      "text": "ロープウェイ！"
    },
    {
      "startSec": 401.7,
      "text": "山を登るmachine、ロープウェイ使ったけど"
    },
    {
      "startSec": 408.3,
      "text": "それでもすっごくたくさん"
    },
    {
      "startSec": 410.1,
      "text": "人がいたから、めっちゃ時間かかったかな。"
    },
    {
      "startSec": 417.1,
      "text": "しかも、ロープウェイが高くて"
    },
    {
      "startSec": 419,
      "text": "下から上に行くまで"
    },
    {
      "startSec": 422.1,
      "text": "1000円。で帰りも1000円。そう、だから"
    },
    {
      "startSec": 426.1,
      "text": "本当にその日曜日は、もう、なんだろう"
    },
    {
      "startSec": 432,
      "text": "交通費。交通費は transportation fee?"
    },
    {
      "startSec": 443.1,
      "text": "交通費に4000円から5000円使いました。"
    },
    {
      "startSec": 452.3,
      "text": "高かった。"
    },
    {
      "startSec": 452.8,
      "text": "で、何も見えなかった。"
    },
    {
      "startSec": 456,
      "text": "だから、皆さんが次、京都に行って"
    },
    {
      "startSec": 460,
      "text": "比叡山を見たいと思ったら、"
    },
    {
      "startSec": 465.1,
      "text": "多分、朝、８時とか"
    },
    {
      "startSec": 468.3,
      "text": "9時から夕方の5時、６時とかに"
    },
    {
      "startSec": 473.1,
      "text": "しっかり時間を持って、余裕（よゆう）を持って"
    },
    {
      "startSec": 478.2,
      "text": "そしてお金も必要ね！"
    },
    {
      "startSec": 480,
      "text": "お金を持って、観光に行ってください！"
    },
    {
      "startSec": 484.7,
      "text": "私みたいに失敗しないでください。"
    },
    {
      "startSec": 487.8,
      "text": "ま、でも、比叡山は本当におすすめかな。"
    },
    {
      "startSec": 492.4,
      "text": "山の中にあるから"
    },
    {
      "startSec": 495.7,
      "text": "他の京都の街の中にある神社とか"
    },
    {
      "startSec": 501.2,
      "text": "お寺の観光とは少し違うね。"
    },
    {
      "startSec": 506.9,
      "text": "そんな感じかな〜だから、おすすめで"
    },
    {
      "startSec": 511.1,
      "text": "やっぱり秋は秋は紅葉（こうよう）"
    },
    {
      "startSec": 514.5,
      "text": "紅葉は、赤い葉っぱとか"
    },
    {
      "startSec": 517.9,
      "text": "黄色い葉っぱ、茶色い葉っぱのことです。"
    },
    {
      "startSec": 522.6,
      "text": "だから、日本の秋は"
    },
    {
      "startSec": 525.1,
      "text": "本当に、山とか木が黄色とか"
    },
    {
      "startSec": 529.7,
      "text": "オレンジとか赤とか茶色になって、"
    },
    {
      "startSec": 533.9,
      "text": "すごく綺麗。"
    },
    {
      "startSec": 535.3,
      "text": "でも、だから、観光客お客さんがとても多いです。"
    },
    {
      "startSec": 543.1,
      "text": "だから、まあ比叡山に行く時とか"
    },
    {
      "startSec": 546.2,
      "text": "京都に行く時は、紅葉の時はおすすめだけど"
    },
    {
      "startSec": 553.8,
      "text": "でもちょっと人が多すぎるから、"
    },
    {
      "startSec": 558,
      "text": "私はオススメしないかな。"
    },
    {
      "startSec": 561.2,
      "text": "紅葉が見たかったら、"
    },
    {
      "startSec": 563.8,
      "text": "京都とか大きな観光地じゃなくて、"
    },
    {
      "startSec": 567.4,
      "text": "普通の田舎に行ったらいいと思います。"
    },
    {
      "startSec": 571.9,
      "text": "田舎に行ったら山があるからね。"
    },
    {
      "startSec": 574.6,
      "text": "例えば、私が今住んでる"
    },
    {
      "startSec": 576.7,
      "text": "これは岡山県の田舎なんですけど、"
    },
    {
      "startSec": 582,
      "text": "ここはめっちゃ綺麗ね今。"
    },
    {
      "startSec": 585.4,
      "text": "本当に。観光客とか誰もいないけど、"
    },
    {
      "startSec": 592.7,
      "text": "もうめっちゃ綺麗、本当におすすめ"
    },
    {
      "startSec": 595.5,
      "text": "今日も朝のyoutubeライブが終わった後に"
    },
    {
      "startSec": 600.9,
      "text": "ちょっと散歩に行ったんですけど、"
    },
    {
      "startSec": 605.3,
      "text": "感動する。綺麗ですっごく感動する。"
    },
    {
      "startSec": 609.3,
      "text": "やっぱり、あと、古い家も多いから"
    },
    {
      "startSec": 613.9,
      "text": "多いし、大きな建物がないから、なんか"
    },
    {
      "startSec": 618.7,
      "text": "200年前に、とか100年前に住んでいた"
    },
    {
      "startSec": 623.3,
      "text": "日本人の気持ちが"
    },
    {
      "startSec": 628.5,
      "text": "なんか分かる気がします。"
    },
    {
      "startSec": 632.7,
      "text": "そんな気がします！"
    },
    {
      "startSec": 634.3,
      "text": "だから、ちょっとタイムトラベルした"
    },
    {
      "startSec": 635.8,
      "text": "気分になりますね。"
    },
    {
      "startSec": 638.7,
      "text": "本当に、だからおすすめ。"
    },
    {
      "startSec": 641.3,
      "text": "田舎おすすめですよ。"
    },
    {
      "startSec": 643.1,
      "text": "日本の田舎、ぜひ"
    },
    {
      "startSec": 644.8,
      "text": "日本に来た時は、"
    },
    {
      "startSec": 647.1,
      "text": "京都とか東京とかだけじゃなくて、"
    },
    {
      "startSec": 651.7,
      "text": "なんか、もうちょっと田舎に"
    },
    {
      "startSec": 655.4,
      "text": "ぜひ遊びに行ってください。"
    },
    {
      "startSec": 658.8,
      "text": "とてもお勧めです！"
    },
    {
      "startSec": 661.2,
      "text": "はい、今日はなんかぺちゃぺちゃこんな"
    },
    {
      "startSec": 662.8,
      "text": "感じで喋っちゃったんだけど、"
    },
    {
      "startSec": 665.4,
      "text": "今日こんな感じで終わろうと思います。"
    },
    {
      "startSec": 668.2,
      "text": "はい。ぜひ、これからビデオができたので"
    },
    {
      "startSec": 671.2,
      "text": "ビデオもチェックしてみてください。"
    },
    {
      "startSec": 674.9,
      "text": "はい。で、もし何か話してほしいこととか"
    },
    {
      "startSec": 679.5,
      "text": "まあ、ちょっと早すぎ"
    },
    {
      "startSec": 682.3,
      "text": "しゃべるの早すぎて思ったら"
    },
    {
      "startSec": 686.4,
      "text": "コメントにyoutubeの"
    },
    {
      "startSec": 688.1,
      "text": "このビデオの下のコメントに書いてください。"
    },
    {
      "startSec": 693.3,
      "text": "よろしくお願いします！"
    },
    {
      "startSec": 694.9,
      "text": "じゃあ、今日はこんな感じで"
    },
    {
      "startSec": 696.1,
      "text": "今日も最後まで聞いてくれてありがとう。"
    },
    {
      "startSec": 698.7,
      "text": "お仕事とか勉強、頑張ってください！"
    },
    {
      "startSec": 703.2,
      "text": "じゃあね！"
    },
    {
      "startSec": 704.2,
      "text": "バイバイ！"
    }
  ]
}
