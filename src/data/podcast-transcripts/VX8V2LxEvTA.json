{
  "episodeId": "VX8V2LxEvTA",
  "segments": [
    {
      "startSec": 0.8,
      "text": "皆さん、こんにちは。"
    },
    {
      "startSec": 2.1,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.4,
      "text": "皆さんはどんな人になりたいですか？"
    },
    {
      "startSec": 10.6,
      "text": "今の自分が理想(ideal)、"
    },
    {
      "startSec": 16.2,
      "text": "理想の自分ですか？"
    },
    {
      "startSec": 19.2,
      "text": "こんな人になりたいとか"
    },
    {
      "startSec": 21.6,
      "text": "こういう人を尊敬する(to respect)とかありますか？"
    },
    {
      "startSec": 28.6,
      "text": "私はあります。"
    },
    {
      "startSec": 30.9,
      "text": "今日はそれについて話したいと思います。"
    },
    {
      "startSec": 35.9,
      "text": "私はこの前のエピソードでも話しましたが"
    },
    {
      "startSec": 41,
      "text": "尾道に行った時に"
    },
    {
      "startSec": 43.3,
      "text": "すごい人と会うことができました。"
    },
    {
      "startSec": 47.2,
      "text": "その人は、園山春二さんと言います。"
    },
    {
      "startSec": 52.1,
      "text": "アーティストです。"
    },
    {
      "startSec": 53.7,
      "text": "お寺の天井(ceiling)の絵を描く人です。"
    },
    {
      "startSec": 60.6,
      "text": "良かったら検索、Googleで探してみてください。"
    },
    {
      "startSec": 65.6,
      "text": "その人と山の中で会うことが"
    },
    {
      "startSec": 72,
      "text": "偶然(coincidence)会うことができました。"
    },
    {
      "startSec": 74.6,
      "text": "で、少しお話をすることができて"
    },
    {
      "startSec": 78.2,
      "text": "もう本当に何だろう…その人に憧れました。"
    },
    {
      "startSec": 84.2,
      "text": "その人みたいになりたいなとすごく思いました。"
    },
    {
      "startSec": 89.7,
      "text": "園山さんも私は尊敬しているし"
    },
    {
      "startSec": 94.7,
      "text": "大学の先生もすごく尊敬しているし"
    },
    {
      "startSec": 98.8,
      "text": "お父さんも大好きです。"
    },
    {
      "startSec": 101.4,
      "text": "すごく尊敬しています。"
    },
    {
      "startSec": 103.8,
      "text": "で、今日の朝ウォーキングをしている時に"
    },
    {
      "startSec": 109.6,
      "text": "私が尊敬する人のことを考えていて"
    },
    {
      "startSec": 116.2,
      "text": "なんか共通点があるなと気がつきました。"
    },
    {
      "startSec": 123.5,
      "text": "共通点がある(to have something in common)"
    },
    {
      "startSec": 127.8,
      "text": "共通することがある、"
    },
    {
      "startSec": 130.5,
      "text": "それをちょっとノートに書いてみました。"
    },
    {
      "startSec": 135.1,
      "text": "私が憧れる人、その人みたいになりたいと思う人は"
    },
    {
      "startSec": 142,
      "text": "何かにパッションがある人です。"
    },
    {
      "startSec": 145.6,
      "text": "園山さんは、絵とか猫とかにすごくパッションがあります。"
    },
    {
      "startSec": 152.2,
      "text": "私の大学の先生は"
    },
    {
      "startSec": 155.1,
      "text": "昔の日本の建築の専門家、スペシャリストで"
    },
    {
      "startSec": 161.1,
      "text": "すっごく頭がいい人です。"
    },
    {
      "startSec": 164.2,
      "text": "私の父は哲学、フィロソフィー(philosophy)です。"
    },
    {
      "startSec": 168.9,
      "text": "本当にみんなすごく1つのことを勉強して"
    },
    {
      "startSec": 175.2,
      "text": "自分の考えを、意見を"
    },
    {
      "startSec": 178.1,
      "text": "持つことができるようになった人たちです。"
    },
    {
      "startSec": 182.8,
      "text": "「あ、かっこいいな、すごくかっこいいな」って思います。"
    },
    {
      "startSec": 187,
      "text": "なかなかそういう人はいないです。"
    },
    {
      "startSec": 191.9,
      "text": "で、やっぱりみんな寛容です。"
    },
    {
      "startSec": 196.1,
      "text": "寛容、これは優しいという意味です。"
    },
    {
      "startSec": 200,
      "text": "他の色んな人も物も、認めることができる優しい人。"
    },
    {
      "startSec": 206.9,
      "text": "寛容な人と言います。"
    },
    {
      "startSec": 209.7,
      "text": "すごく寛容で、もうみんなその人達は"
    },
    {
      "startSec": 215.2,
      "text": "他の人にすごく優しいです。"
    },
    {
      "startSec": 219.8,
      "text": "私は今こうやって、ビジネスかな？"
    },
    {
      "startSec": 224.1,
      "text": "日本語でビジネスができたらいいなと思っていますが"
    },
    {
      "startSec": 229.8,
      "text": "やっぱりビジネスの情報をGoogleで探す時とか"
    },
    {
      "startSec": 236,
      "text": "やっぱり自分のお金、自分の利益(profit)ばかり"
    },
    {
      "startSec": 242.9,
      "text": "気にする人が多いです。"
    },
    {
      "startSec": 246.4,
      "text": "そういうことをずっと見ていると"
    },
    {
      "startSec": 249.3,
      "text": "私はすごく、しんどくなります。"
    },
    {
      "startSec": 252.9,
      "text": "でも私が尊敬する人はみんな、"
    },
    {
      "startSec": 257.1,
      "text": "自分のお金とかじゃなくて"
    },
    {
      "startSec": 261.3,
      "text": "他の人のため、家族のためとか、動物のために"
    },
    {
      "startSec": 267.1,
      "text": "自分の時間を使うことができる人です。"
    },
    {
      "startSec": 271.9,
      "text": "私もそうなりたいです。"
    },
    {
      "startSec": 274.6,
      "text": "あとはみんなその地域(local)のため、"
    },
    {
      "startSec": 284.3,
      "text": "地域の人のために何かをしています。"
    },
    {
      "startSec": 289.5,
      "text": "私の大学の先生は"
    },
    {
      "startSec": 292,
      "text": "すっごく古い日本のwarehouse、蔵と言います。"
    },
    {
      "startSec": 298.9,
      "text": "蔵を買いました。"
    },
    {
      "startSec": 302.1,
      "text": "買ってこれから直します。"
    },
    {
      "startSec": 305,
      "text": "傷んでいる(damaged)場所があったので"
    },
    {
      "startSec": 310.8,
      "text": "これから直したりします。"
    },
    {
      "startSec": 313.6,
      "text": "先生がその家を買わなかったら"
    },
    {
      "startSec": 317.3,
      "text": "きっと壊されていたと思います。"
    },
    {
      "startSec": 320.6,
      "text": "無くなってしまったと思います。"
    },
    {
      "startSec": 323.7,
      "text": "でも先生がその家を買ったから"
    },
    {
      "startSec": 328.2,
      "text": "これからもきっと100年、200年、300年"
    },
    {
      "startSec": 333.8,
      "text": "次の時代へ残ります、その蔵は。"
    },
    {
      "startSec": 340,
      "text": "これってすごいことですよね。"
    },
    {
      "startSec": 343.7,
      "text": "私もまだまだ本当に力はないし"
    },
    {
      "startSec": 348.2,
      "text": "ちょっとバカなんですが"
    },
    {
      "startSec": 349.9,
      "text": "これから私もそういうことができる"
    },
    {
      "startSec": 353.2,
      "text": "大人になりたいなと思っています。"
    },
    {
      "startSec": 357.6,
      "text": "皆さんはどんな風になりたいですか？"
    },
    {
      "startSec": 361.7,
      "text": "もしよかったらYouTubeのコメントに"
    },
    {
      "startSec": 364.6,
      "text": "書いてくれると嬉しいです。"
    },
    {
      "startSec": 367.6,
      "text": "いつもコメントくれて本当にありがとうございます。"
    },
    {
      "startSec": 372.4,
      "text": "ポッドキャストのコメントが本当に一番嬉しいです。"
    },
    {
      "startSec": 377.8,
      "text": "本当に最後まで聞いてくれて、ありがとうございます。"
    },
    {
      "startSec": 383.1,
      "text": "じゃあ、今日も良い一日を！"
    },
    {
      "startSec": 386.8,
      "text": "これで終わります。"
    },
    {
      "startSec": 388.5,
      "text": "また明日、バイバイ！"
    }
  ]
}
