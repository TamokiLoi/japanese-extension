{
  "episodeId": "jAbSD3gkcUc",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.5,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.2,
      "text": "元気ですか？私は元気です。"
    },
    {
      "startSec": 6.2,
      "text": "今日は金曜日なんですけど"
    },
    {
      "startSec": 9.5,
      "text": "7時からジャックの友達の"
    },
    {
      "startSec": 12.9,
      "text": "JETプログラムのメンバーがこのアパートに来て"
    },
    {
      "startSec": 17.4,
      "text": "ちょっとご飯を食べたり"
    },
    {
      "startSec": 19.5,
      "text": "お酒を飲んだりして"
    },
    {
      "startSec": 21.3,
      "text": "ちょっとパーティーをしたいと思っています。"
    },
    {
      "startSec": 24.8,
      "text": "だからすごく楽しみで。"
    },
    {
      "startSec": 27.1,
      "text": "朝はずっと掃除をして"
    },
    {
      "startSec": 30.3,
      "text": "部屋をデコレーション、飾ったりしていました。"
    },
    {
      "startSec": 36.2,
      "text": "時間かかったね。"
    },
    {
      "startSec": 37.7,
      "text": "いっぱい飲み物も買ったし"
    },
    {
      "startSec": 40.8,
      "text": "オレンジジュースとかトロピカーナとか"
    },
    {
      "startSec": 44.3,
      "text": "ウィスキーもお酒も焼酎もウォッカも"
    },
    {
      "startSec": 48.4,
      "text": "もう全部たくさん買いました。"
    },
    {
      "startSec": 52.5,
      "text": "手巻き寿司をみんなで作るつもりです。"
    },
    {
      "startSec": 56.6,
      "text": "もうすごく楽しみです。"
    },
    {
      "startSec": 59.9,
      "text": "で、今日のエピソードは後悔(regret)"
    },
    {
      "startSec": 65.7,
      "text": "後悔を表す五つのフレーズです。"
    },
    {
      "startSec": 70.9,
      "text": "皆さんの文法の勉強にもなるし"
    },
    {
      "startSec": 75,
      "text": "皆さんがもっとナチュラルに色んなことを"
    },
    {
      "startSec": 79.3,
      "text": "日本語で言えるようになると思います。"
    },
    {
      "startSec": 83.3,
      "text": "ぜひ楽しんで聞いてください。"
    },
    {
      "startSec": 87.3,
      "text": "じゃあ、後悔、昔、前したことを"
    },
    {
      "startSec": 92.5,
      "text": "「ああ、しなかったらよかったな」って"
    },
    {
      "startSec": 96,
      "text": "そういう気持ち、後悔を表わすフレーズ一つ目。"
    },
    {
      "startSec": 101.9,
      "text": "一つ目は、動詞の普通形(plain form) + んじゃなかった"
    },
    {
      "startSec": 111.3,
      "text": "Like「あっ言うんじゃなかった」"
    },
    {
      "startSec": 115,
      "text": "I shouldn't have said that."
    },
    {
      "startSec": 117.1,
      "text": "「言うんじゃなかった」とか。"
    },
    {
      "startSec": 121,
      "text": "めっちゃチョコレートを十個、二十個食べて"
    },
    {
      "startSec": 126,
      "text": "お腹が痛くなった時に"
    },
    {
      "startSec": 130.3,
      "text": "「はー、食べるんじゃなかったぁ」"
    },
    {
      "startSec": 133.8,
      "text": "I shouldn't have eaten all the chocolate."
    },
    {
      "startSec": 136.7,
      "text": "「食べるんじゃなかったぁ」よく使います。"
    },
    {
      "startSec": 141.6,
      "text": "とか、何か高い物を買って"
    },
    {
      "startSec": 147.9,
      "text": "例えばコップを買って、すごく高くて"
    },
    {
      "startSec": 153,
      "text": "で、すぐに壊れてしまった、割れてしまった。"
    },
    {
      "startSec": 158.4,
      "text": "その時に「はぁ、買うんじゃなかった」"
    },
    {
      "startSec": 166.1,
      "text": "I shouldn't have bought it、みたいな感じで使えます。"
    },
    {
      "startSec": 171.5,
      "text": "便利ですね。"
    },
    {
      "startSec": 173.2,
      "text": "じゃあ二つ目。"
    },
    {
      "startSec": 175.4,
      "text": "二つ目は、…ばよかった。"
    },
    {
      "startSec": 181.5,
      "text": "例えば、あなたが好きな人がいます。"
    },
    {
      "startSec": 186.9,
      "text": "好きな人がいました。"
    },
    {
      "startSec": 189.4,
      "text": "でもその人は引っ越して他の場所に行ってしまった。"
    },
    {
      "startSec": 199.2,
      "text": "そしたらあなたは「あー、好きって言っておけばよかった」"
    },
    {
      "startSec": 206.3,
      "text": "I should have said that I liked him."
    },
    {
      "startSec": 209,
      "text": "Like, 告白(confess)しておけばよかった。"
    },
    {
      "startSec": 213.9,
      "text": "「もう好きって言っとけばよかった」"
    },
    {
      "startSec": 217.7,
      "text": "「言っておけばよかった」みたいなです。"
    },
    {
      "startSec": 222,
      "text": "あとは、指輪を買いたかった。"
    },
    {
      "startSec": 229.4,
      "text": "すごく欲しい指輪があった。"
    },
    {
      "startSec": 232.5,
      "text": "でも買わなかった。"
    },
    {
      "startSec": 234.7,
      "text": "お金がなかったから。"
    },
    {
      "startSec": 236.7,
      "text": "でも金を貯めて、お金を用意して"
    },
    {
      "startSec": 241.4,
      "text": "やっとその指輪を買いに行きました。"
    },
    {
      "startSec": 246.5,
      "text": "でも、もうその指輪は売り切れ(sold out)、なかったです。"
    },
    {
      "startSec": 254.9,
      "text": "もうその時にあなたは、"
    },
    {
      "startSec": 257.4,
      "text": "「あ、指輪、買っておけばよかった」"
    },
    {
      "startSec": 263.9,
      "text": "「ああ…」後悔(regret)です。"
    },
    {
      "startSec": 267,
      "text": "とても便利です。"
    },
    {
      "startSec": 268.7,
      "text": "「…んじゃなかった」「…ばよかった」です。"
    },
    {
      "startSec": 274.1,
      "text": "じゃあ三つ目。"
    },
    {
      "startSec": 276.6,
      "text": "三つ目は「悪かった」"
    },
    {
      "startSec": 281.9,
      "text": "Like私が悪かった(That's my fault)"
    },
    {
      "startSec": 286.3,
      "text": "That's my bad, sorry、悪かった。"
    },
    {
      "startSec": 291.5,
      "text": "例えば、あなたが友達の待ち合わせに一時間遅れました。"
    },
    {
      "startSec": 302.4,
      "text": "すると友達は、"
    },
    {
      "startSec": 304.4,
      "text": "「ちょっと何で一時間も遅れたの？」"
    },
    {
      "startSec": 309.7,
      "text": "「なんで一時間も待たせたの？」って言いました。"
    },
    {
      "startSec": 314.5,
      "text": "そしたらあなたは「ああ、ごめんごめん、悪かった悪かった」"
    },
    {
      "startSec": 318.3,
      "text": "「もう今からケーキおごるから許して」"
    },
    {
      "startSec": 322.7,
      "text": "おごる(my treat)　私が買う、おごる。"
    },
    {
      "startSec": 328.4,
      "text": "許して(forgive me)"
    },
    {
      "startSec": 331.4,
      "text": "「悪かった悪かった、許して」はよく使います。"
    },
    {
      "startSec": 336.6,
      "text": "で後悔のフレーズ四つ目。"
    },
    {
      "startSec": 340.7,
      "text": "四つ目は「何で〇〇〇んだろ」"
    },
    {
      "startSec": 346.4,
      "text": "Like「何でこれ食べちゃったんだろう」"
    },
    {
      "startSec": 352.9,
      "text": "「何でこれ食べたんだろう」Why did I eat this?"
    },
    {
      "startSec": 357.6,
      "text": "Like「何で食べたんだろう」とか"
    },
    {
      "startSec": 360.6,
      "text": "「何でこんな高いコップ買っちゃったんだろう」"
    },
    {
      "startSec": 369,
      "text": "買っちゃった＝買ってしまった"
    },
    {
      "startSec": 373.3,
      "text": "後悔を表わす「買ってしまった」"
    },
    {
      "startSec": 377.3,
      "text": "このカジュアルの言い方が「買っちゃった」"
    },
    {
      "startSec": 383,
      "text": "「何でこんな高い物を買っちゃったんだろう」"
    },
    {
      "startSec": 387.8,
      "text": "みたいな感じで使います。"
    },
    {
      "startSec": 390.9,
      "text": "で「何で買っちゃったのかな」これもよく使います。"
    },
    {
      "startSec": 398.3,
      "text": "「何でこんな高い物買っちゃったのかな」"
    },
    {
      "startSec": 403.2,
      "text": "「買っちゃったのかな」長いですけどよく使います。"
    },
    {
      "startSec": 408.7,
      "text": "例えばあなたが好きな人を見つけて告白しました。"
    },
    {
      "startSec": 415.5,
      "text": "告白する(confess your feeling for him/her)"
    },
    {
      "startSec": 420.8,
      "text": "でも振られました。"
    },
    {
      "startSec": 423.6,
      "text": "「振られる」は、好きじゃないって言われたんです。"
    },
    {
      "startSec": 428.6,
      "text": "そしたらあなたは、"
    },
    {
      "startSec": 429.9,
      "text": "「ああ、好きって言わなかったらよかった」"
    },
    {
      "startSec": 435.5,
      "text": "「好きって言わなければよかった」"
    },
    {
      "startSec": 439,
      "text": "「何で好きって言っちゃったんだろう」"
    },
    {
      "startSec": 443.3,
      "text": "みたいな感じです。"
    },
    {
      "startSec": 447.4,
      "text": "で最後のフレーズ五つ目、これは「反省しています」"
    },
    {
      "startSec": 454.6,
      "text": "「すいません、反省してます」かな。"
    },
    {
      "startSec": 458,
      "text": "反省(to reflect)、反省しています。"
    },
    {
      "startSec": 463.3,
      "text": "「すいません、私が悪かったと思ってます」"
    },
    {
      "startSec": 468.2,
      "text": "「もうしません」みたいな意味。"
    },
    {
      "startSec": 471.3,
      "text": "例えばあなたが浮気をしました。"
    },
    {
      "startSec": 476.4,
      "text": "浮気をする(to cheat on your girlfriend/boyfriend)"
    },
    {
      "startSec": 483.9,
      "text": "でも、その浮気がばれた(come to light)。"
    },
    {
      "startSec": 487.8,
      "text": "「ばれる」はあなたの彼氏・彼女がそれを見つけた、"
    },
    {
      "startSec": 494.6,
      "text": "ばれてしまった。"
    },
    {
      "startSec": 496.7,
      "text": "するとあなたは「すいません、もう二度と浮気はしません」"
    },
    {
      "startSec": 504.5,
      "text": "「もう二度としません」＝I will never do it again."
    },
    {
      "startSec": 509.6,
      "text": "「もう絶対しません。二度としません。反省しています」"
    },
    {
      "startSec": 517.9,
      "text": "みたいな感じかな。"
    },
    {
      "startSec": 522.1,
      "text": "よく使いますし、もしあなたが、"
    },
    {
      "startSec": 525.3,
      "text": "他の友達とか彼女・彼氏と"
    },
    {
      "startSec": 528.4,
      "text": "日本語でよく話すことがあったら"
    },
    {
      "startSec": 532,
      "text": "とても便利だと思うので、是非使ってみてください。"
    },
    {
      "startSec": 537.7,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 540.4,
      "text": "最近はPatreonでDiscordも始めました。"
    },
    {
      "startSec": 545.1,
      "text": "水曜日はいつもYouTubeで"
    },
    {
      "startSec": 547.6,
      "text": "このポッドキャストのライブをしています。"
    },
    {
      "startSec": 551.3,
      "text": "よかったらライブにも来てください。"
    },
    {
      "startSec": 555.1,
      "text": "Patreonでサポートしてくれると嬉しいです。"
    },
    {
      "startSec": 559,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 561.6,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
