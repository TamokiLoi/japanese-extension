{
  "episodeId": "lA6qVQIzd44",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.5,
      "text": "皆さん、お金節約していますか？"
    },
    {
      "startSec": 9.7,
      "text": "節約する(to save money)"
    },
    {
      "startSec": 14.1,
      "text": "お金を節約していますか？"
    },
    {
      "startSec": 17.6,
      "text": "今日は私のお金節約の方法、どんなことをしているか"
    },
    {
      "startSec": 24.8,
      "text": "ちょっと皆さんとシェアしたいなと思います。"
    },
    {
      "startSec": 29.6,
      "text": "結構私はお金は使うけど、使わない。"
    },
    {
      "startSec": 35.8,
      "text": "私がよくお金を使うのは食べ物とテクノロジーです。"
    },
    {
      "startSec": 43,
      "text": "やっぱり食べたいものは食べたいし。"
    },
    {
      "startSec": 46.3,
      "text": "野菜とか高いけどたくさん買って"
    },
    {
      "startSec": 50.7,
      "text": "いろんな調味料(spicies)買っていろんな料理したり。"
    },
    {
      "startSec": 58.1,
      "text": "だから食べ物はすごくお金、ジャックと使ってます。"
    },
    {
      "startSec": 63.8,
      "text": "いつもスーパーに行ったら"
    },
    {
      "startSec": 65.7,
      "text": "三千円から五千円買います。"
    },
    {
      "startSec": 68.9,
      "text": "で、週に三回くらいかな。"
    },
    {
      "startSec": 73.3,
      "text": "これは多いかな、少ないかな？"
    },
    {
      "startSec": 75.3,
      "text": "でも結構食べ物はお金使います。"
    },
    {
      "startSec": 80.1,
      "text": "あとはテクノロジー。"
    },
    {
      "startSec": 82,
      "text": "パソコンとかカメラとかマイク。"
    },
    {
      "startSec": 87.8,
      "text": "あと電気、ライトとかは最初は"
    },
    {
      "startSec": 93,
      "text": "安いものを買っていたんですが"
    },
    {
      "startSec": 95.7,
      "text": "やっぱり安いものは結構長く使えないですし"
    },
    {
      "startSec": 101.5,
      "text": "クオリティが低くなります。"
    },
    {
      "startSec": 104.9,
      "text": "だからパソコンとかもすぐ止まったら"
    },
    {
      "startSec": 108.2,
      "text": "もうイライラしますよね。"
    },
    {
      "startSec": 110.1,
      "text": "だからそういうのはできるだけ"
    },
    {
      "startSec": 113.6,
      "text": "いいものを買うようにします。"
    },
    {
      "startSec": 116.8,
      "text": "だから結構、お金がかかりますよね。"
    },
    {
      "startSec": 121.1,
      "text": "でも結構、節約もちゃんとしてます。"
    },
    {
      "startSec": 127.1,
      "text": "節約の方法、まず一つ目は"
    },
    {
      "startSec": 130.6,
      "text": "私、服を普通のお店で買わないんですよね。"
    },
    {
      "startSec": 136.5,
      "text": "普通の店で服買ったのは三年とか四年前です。"
    },
    {
      "startSec": 143.8,
      "text": "全部セカンドハンドショップ、古着屋さんで買います。"
    },
    {
      "startSec": 150,
      "text": "で、ビデオを見たら分かると思うんですけど"
    },
    {
      "startSec": 153.2,
      "text": "私、いつもほぼ同じ服ですよね。"
    },
    {
      "startSec": 157.9,
      "text": "あんまり服も多くないし。"
    },
    {
      "startSec": 162,
      "text": "いつも服は、これも三百円とか安い服買います。"
    },
    {
      "startSec": 170.1,
      "text": "でもセカンドハンドショップに行って"
    },
    {
      "startSec": 173.9,
      "text": "いい服を探すんです、頑張って。"
    },
    {
      "startSec": 176.9,
      "text": "安い服だけどクオリティが高い、"
    },
    {
      "startSec": 180.6,
      "text": "本当は高い値段の服を頑張って探して買います。"
    },
    {
      "startSec": 186.4,
      "text": "すると結構長く着ることができるんですね。"
    },
    {
      "startSec": 191.5,
      "text": "あとはお母さんとかおばあちゃんの"
    },
    {
      "startSec": 194.9,
      "text": "服も着ていたりします。"
    },
    {
      "startSec": 197.1,
      "text": "で、あとは散髪。"
    },
    {
      "startSec": 199.5,
      "text": "髪、ヘアカットは半年に一回くらい。"
    },
    {
      "startSec": 204.5,
      "text": "あんまりヘアカットしないです。"
    },
    {
      "startSec": 206.8,
      "text": "ずっと長いので全然いいんですが"
    },
    {
      "startSec": 210.1,
      "text": "一ヶ月とか二ヶ月ごとに髪を切りに行ったら"
    },
    {
      "startSec": 217.1,
      "text": "お金、かかりますよね。"
    },
    {
      "startSec": 219.7,
      "text": "だから私は今、全然行っていないです。"
    },
    {
      "startSec": 224.1,
      "text": "で彼氏、私、ジャックさんの髪切ってます。"
    },
    {
      "startSec": 229.6,
      "text": "日本に来てから全部私が切ってます。"
    },
    {
      "startSec": 234.5,
      "text": "ちょっといいハサミをAmazonで三千円で買って、"
    },
    {
      "startSec": 239.2,
      "text": "あとバリカンで。"
    },
    {
      "startSec": 240.4,
      "text": "これはね本当に節約になります。"
    },
    {
      "startSec": 244.4,
      "text": "男の人は一ヶ月とか一ヶ月半に一回"
    },
    {
      "startSec": 251.2,
      "text": "ヘアカット必要ですよね。"
    },
    {
      "startSec": 254.3,
      "text": "だからこれは本当に節約になります。"
    },
    {
      "startSec": 259.7,
      "text": "あとは楽しいね。"
    },
    {
      "startSec": 261.9,
      "text": "結構ドキドキしますよね、"
    },
    {
      "startSec": 264.7,
      "text": "「失敗したらどうしよう」みたいな。"
    },
    {
      "startSec": 267,
      "text": "それが結構楽しい。"
    },
    {
      "startSec": 271.8,
      "text": "いやこれは、もし皆さんもできるならお勧めです。"
    },
    {
      "startSec": 277.1,
      "text": "あとは髪の毛を染めない。"
    },
    {
      "startSec": 279.4,
      "text": "これもすごく節約になります。"
    },
    {
      "startSec": 282.8,
      "text": "日本では染めてる女の人すごく多い。"
    },
    {
      "startSec": 287.3,
      "text": "私が大学生の時は後ろから教室を見たら"
    },
    {
      "startSec": 293.2,
      "text": "八十パーセントの女の子が"
    },
    {
      "startSec": 296.8,
      "text": "髪の毛染めていました。"
    },
    {
      "startSec": 299.3,
      "text": "私のみたいなこの黒い髪の毛は結構珍しいです。"
    },
    {
      "startSec": 305.2,
      "text": "でも髪を染めるとアフターケアが"
    },
    {
      "startSec": 310.9,
      "text": "すごく大変なんですよね。"
    },
    {
      "startSec": 313.6,
      "text": "一回染めたらもう一回染めないと"
    },
    {
      "startSec": 316.6,
      "text": "ここら辺、髪の頭の近くが変な色、形になるので"
    },
    {
      "startSec": 323.6,
      "text": "だから髪を染めないのも大切、節約です。"
    },
    {
      "startSec": 328.5,
      "text": "あとは…結構あるな。"
    },
    {
      "startSec": 330.9,
      "text": "これ次のエピソードで話そうかな。"
    },
    {
      "startSec": 333.8,
      "text": "とりあえず私は服は全然もう買わない、"
    },
    {
      "startSec": 337.4,
      "text": "全部セカンドハンド。"
    },
    {
      "startSec": 339.7,
      "text": "で、テクノロジーにはお金を使って"
    },
    {
      "startSec": 343.5,
      "text": "食べ物にもお金使います。"
    },
    {
      "startSec": 346.4,
      "text": "で、最近は、あとは布団・ベッドとか。"
    },
    {
      "startSec": 350.6,
      "text": "これはちゃんとしないといけないなと思って"
    },
    {
      "startSec": 356.4,
      "text": "実は先週マットレスを買いました。"
    },
    {
      "startSec": 360.7,
      "text": "今この部屋の私の後ろに"
    },
    {
      "startSec": 363.9,
      "text": "クイーンサイズのマットレスがあります。"
    },
    {
      "startSec": 367.4,
      "text": "やっぱりちゃんと寝ないと体が痛くなって"
    },
    {
      "startSec": 372.9,
      "text": "一日アンハッピーになりますよね。"
    },
    {
      "startSec": 377.3,
      "text": "それは嫌だなと思って、"
    },
    {
      "startSec": 380.6,
      "text": "ベッドをちゃんと買いました。"
    },
    {
      "startSec": 382.9,
      "text": "じゃあ次回もちょっと節約のエピソード"
    },
    {
      "startSec": 385.7,
      "text": "皆さんとシェアしたいなと思います。"
    },
    {
      "startSec": 388.9,
      "text": "最後まで聞いてくれてありがとうございました。"
    },
    {
      "startSec": 393.2,
      "text": "じゃあお仕事・勉強、今日も頑張ってください。"
    },
    {
      "startSec": 398,
      "text": "そして一週間に一回、水曜日"
    },
    {
      "startSec": 402.2,
      "text": "日本の九時半からYouTubeで"
    },
    {
      "startSec": 405.9,
      "text": "日本語でライブをしています。"
    },
    {
      "startSec": 409.5,
      "text": "もし時間がある人は遊びに来てください。"
    },
    {
      "startSec": 413.8,
      "text": "待っています！"
    },
    {
      "startSec": 414.9,
      "text": "じゃあまたね、バイバイ！"
    }
  ]
}
