{
  "episodeId": "_9EoFlIwc-o",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.2,
      "text": "私はポッドキャストが大好きです。"
    },
    {
      "startSec": 8.4,
      "text": "英語もポッドキャストでめっちゃ勉強して"
    },
    {
      "startSec": 13.2,
      "text": "結構ちょっと話せるようになりました。"
    },
    {
      "startSec": 18.4,
      "text": "二年くらい、毎日絶対一時間はポッドキャストで"
    },
    {
      "startSec": 25.5,
      "text": "英語を勉強していました。"
    },
    {
      "startSec": 28.7,
      "text": "ポッドキャストで英語を聞いていました。"
    },
    {
      "startSec": 32,
      "text": "今日は、私は本当にポッドキャストに"
    },
    {
      "startSec": 35,
      "text": "すごくパッションがあるので"
    },
    {
      "startSec": 38.1,
      "text": "それについてちょっと話したいと思います。"
    },
    {
      "startSec": 42.1,
      "text": "やっぱり言語を勉強する時に"
    },
    {
      "startSec": 47.4,
      "text": "ポッドキャストは本当に一番"
    },
    {
      "startSec": 51.2,
      "text": "いい方法だと私は思います。"
    },
    {
      "startSec": 55,
      "text": "本当にそう信じています。"
    },
    {
      "startSec": 58.8,
      "text": "私がポッドキャストというのは"
    },
    {
      "startSec": 61.4,
      "text": "その言語の先生のポッドキャストです。"
    },
    {
      "startSec": 64.7,
      "text": "例えば日本人の、日本人のためのポッドキャスト、"
    },
    {
      "startSec": 69,
      "text": "これはちょっと難しすぎると思います。"
    },
    {
      "startSec": 72.9,
      "text": "皆さんが中級レベルになったら"
    },
    {
      "startSec": 77.2,
      "text": "必ず日本語の先生の日本語のポッドキャストで"
    },
    {
      "startSec": 84,
      "text": "リスニングの練習をすることをお勧めします。"
    },
    {
      "startSec": 89.3,
      "text": "もう本当に。"
    },
    {
      "startSec": 90,
      "text": "理由は、やっぱりポッドキャストを聞くと"
    },
    {
      "startSec": 96,
      "text": "文と文を上手にナチュラルにつなげる(to connect)"
    },
    {
      "startSec": 105,
      "text": "つなげることをができるようになります。"
    },
    {
      "startSec": 109.3,
      "text": "でも教科書で文法だけ勉強していると"
    },
    {
      "startSec": 113.7,
      "text": "文Ａと文Ｂ、これを会話の中で"
    },
    {
      "startSec": 120.5,
      "text": "うまく上手につなげる方法は勉強できないです。"
    },
    {
      "startSec": 128.3,
      "text": "やっぱり会話をうまくつなげるためには"
    },
    {
      "startSec": 133.2,
      "text": "うまくつなげている人の日本語を聞いて"
    },
    {
      "startSec": 138,
      "text": "自分も真似することが大切です。"
    },
    {
      "startSec": 141.1,
      "text": "それがやっぱり"
    },
    {
      "startSec": 143.5,
      "text": "日本語の先生のポッドキャストを使って"
    },
    {
      "startSec": 147.3,
      "text": "真似できます。"
    },
    {
      "startSec": 150.5,
      "text": "やっぱりあとは、ナチュラルなイントネーションも"
    },
    {
      "startSec": 154.8,
      "text": "勉強できます。"
    },
    {
      "startSec": 157,
      "text": "教科書の音声はちょっとロボットみたい。"
    },
    {
      "startSec": 161.9,
      "text": "きれいだけど本当にスタンダードな日本語。"
    },
    {
      "startSec": 165.7,
      "text": "ニュースの日本語みたい。"
    },
    {
      "startSec": 168.7,
      "text": "でも誰もそんな風に普通話しません。"
    },
    {
      "startSec": 175.6,
      "text": "もっと普通はもう、ウォ～↗↘"
    },
    {
      "startSec": 178.4,
      "text": "こんな風にすごく色々深くなったり"
    },
    {
      "startSec": 181.9,
      "text": "高くなったり低くなったり、"
    },
    {
      "startSec": 184.6,
      "text": "「えー↗」って伸ばしたり「えっ」と短く言ったり"
    },
    {
      "startSec": 189.4,
      "text": "もう本当に言語は気持ちを表すものです。"
    },
    {
      "startSec": 196,
      "text": "だからその人の気持ちが"
    },
    {
      "startSec": 199,
      "text": "言語に、イントネーションに現れます。"
    },
    {
      "startSec": 203.8,
      "text": "だから日本語の先生のポッドキャストで"
    },
    {
      "startSec": 208,
      "text": "その先生の気持ちが"
    },
    {
      "startSec": 210.4,
      "text": "どんな風に言語に出ているかなって"
    },
    {
      "startSec": 214.5,
      "text": "考えながらぜひ聞いて"
    },
    {
      "startSec": 217.1,
      "text": "皆さんもそのイントネーションを真似してみてください。"
    },
    {
      "startSec": 223,
      "text": "それが本当にめっちゃいいと思う。"
    },
    {
      "startSec": 226.8,
      "text": "そこですよね、自分の気持ちを"
    },
    {
      "startSec": 229.3,
      "text": "その言語で上手に表すことができたら"
    },
    {
      "startSec": 234.8,
      "text": "もう本当にペラペラに聞こえます。"
    },
    {
      "startSec": 237.2,
      "text": "You will sound almost fluent."
    },
    {
      "startSec": 239.5,
      "text": "上手に聞こえる。"
    },
    {
      "startSec": 241.1,
      "text": "それが大切。"
    },
    {
      "startSec": 242.8,
      "text": "もちろん、日本語の先生は"
    },
    {
      "startSec": 246.1,
      "text": "皆さんの日本語のレベルを知っているので"
    },
    {
      "startSec": 250.9,
      "text": "皆さんが知っている日本語で話してくれます。"
    },
    {
      "startSec": 256.4,
      "text": "なので日本語の先生のポッドキャストは"
    },
    {
      "startSec": 260,
      "text": "皆さんが今までに勉強した日本語の復習になるんです。"
    },
    {
      "startSec": 268.8,
      "text": "まずは知っている日本語を"
    },
    {
      "startSec": 272.6,
      "text": "聞けるようにすることが一番大切です。"
    },
    {
      "startSec": 278.2,
      "text": "それが日本語のポッドキャストでできます。"
    },
    {
      "startSec": 282.9,
      "text": "なので、これからも皆さんが私のポッドキャストで"
    },
    {
      "startSec": 288.3,
      "text": "頑張ってリスニングの練習をしてくれると"
    },
    {
      "startSec": 292,
      "text": "本当に嬉しいです。"
    },
    {
      "startSec": 294.7,
      "text": "この私のポッドキャストがほとんど分かるようになったら"
    },
    {
      "startSec": 300.2,
      "text": "是非日本人の日本人のためのポッドキャストとかも"
    },
    {
      "startSec": 307.1,
      "text": "聞いてリスニングの勉強頑張ってください。"
    },
    {
      "startSec": 313.3,
      "text": "また明日も新しいエピソードが出るので"
    },
    {
      "startSec": 317.1,
      "text": "是非聞いてください。"
    },
    {
      "startSec": 320.1,
      "text": "じゃあ今日はここまで、いつもありがとう。"
    },
    {
      "startSec": 322.8,
      "text": "お仕事・勉強頑張ってね。"
    },
    {
      "startSec": 324.9,
      "text": "バイバイ！"
    }
  ]
}
