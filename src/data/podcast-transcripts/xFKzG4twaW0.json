{
  "episodeId": "xFKzG4twaW0",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.8,
      "text": "今日は「言語(language)の壁」です。"
    },
    {
      "startSec": 9,
      "text": "言葉の壁(wall)です。"
    },
    {
      "startSec": 15,
      "text": "これについて話をしたいと思います。"
    },
    {
      "startSec": 19.4,
      "text": "私の彼氏、ジャックさんが"
    },
    {
      "startSec": 22.2,
      "text": "今日本で英語の先生をしているんですね。"
    },
    {
      "startSec": 29.5,
      "text": "よく彼の話を聞いて思うことがあります。"
    },
    {
      "startSec": 36.8,
      "text": "やっぱり彼はまだ日本語が上手じゃない。"
    },
    {
      "startSec": 41,
      "text": "今、N4勉強してます。"
    },
    {
      "startSec": 44.7,
      "text": "で、自信がないからスピーキングが"
    },
    {
      "startSec": 49.7,
      "text": "本当に難しいです。"
    },
    {
      "startSec": 53,
      "text": "彼は本当にスピーキングが苦手なんですね。"
    },
    {
      "startSec": 58.5,
      "text": "学校で、オフィスで言語の壁を感じることが"
    },
    {
      "startSec": 66.1,
      "text": "本当にもう毎日、毎日何回もあるらしいです。"
    },
    {
      "startSec": 73.9,
      "text": "本当にこれは…ちょっと悲しいです。"
    },
    {
      "startSec": 79.2,
      "text": "ジャックは中学校と小学校で働いているので"
    },
    {
      "startSec": 84.2,
      "text": "オフィスには先生がいます、日本人の先生が。"
    },
    {
      "startSec": 90.1,
      "text": "でもその日本人の先生たちは本当に"
    },
    {
      "startSec": 94.1,
      "text": "外国の人とどうやって"
    },
    {
      "startSec": 97.6,
      "text": "コミュニケーションをしたらいいのか"
    },
    {
      "startSec": 101.8,
      "text": "わからないです。"
    },
    {
      "startSec": 104.2,
      "text": "で、私だったら…まぁ私はもちろん"
    },
    {
      "startSec": 109.2,
      "text": "もうジャックと話したことがあるし"
    },
    {
      "startSec": 112.1,
      "text": "外国の人と話したことがあるので"
    },
    {
      "startSec": 115.9,
      "text": "私だったら多分コミュニケーションできます。"
    },
    {
      "startSec": 121.8,
      "text": "簡単な英語か簡単な日本語で"
    },
    {
      "startSec": 126.2,
      "text": "その人のことを考えて"
    },
    {
      "startSec": 130.5,
      "text": "もうフレンドリーに明るく話す、"
    },
    {
      "startSec": 135,
      "text": "それだけでオッケーですよね。"
    },
    {
      "startSec": 138.3,
      "text": "でもその日本人の先生は"
    },
    {
      "startSec": 142.5,
      "text": "ジャックが日本語少しだけ分かる、"
    },
    {
      "startSec": 147.8,
      "text": "それだけでもう話ができないって"
    },
    {
      "startSec": 151.8,
      "text": "なっちゃうんですよね。"
    },
    {
      "startSec": 153.4,
      "text": "だからジャックがその先生たちに"
    },
    {
      "startSec": 158.9,
      "text": "簡単な日本語で話したら"
    },
    {
      "startSec": 162,
      "text": "その先生たちはネイティブの敬語とかで"
    },
    {
      "startSec": 167,
      "text": "ジャックに話すんです。"
    },
    {
      "startSec": 169.1,
      "text": "で、もちろんジャック、わからないです。"
    },
    {
      "startSec": 172.2,
      "text": "だからジャックは「えぇ…？」ってなりますよね。"
    },
    {
      "startSec": 177.2,
      "text": "そしたらその日本人の先生はもう逃げるみたいな。"
    },
    {
      "startSec": 183.2,
      "text": "「あ、すいません」みたいな。"
    },
    {
      "startSec": 185,
      "text": "で、もう違う場所に行っちゃう。"
    },
    {
      "startSec": 189.1,
      "text": "こういうことが本当に毎日あるみたいなんです。"
    },
    {
      "startSec": 196.4,
      "text": "その日本人の先生たちに、私はもっと頑張ってほしい。"
    },
    {
      "startSec": 201.8,
      "text": "もうちょっと時間を使ってほしいです。"
    },
    {
      "startSec": 205.9,
      "text": "ジャックがその先生の日本語わからなかったら"
    },
    {
      "startSec": 212.1,
      "text": "もう単語でもいいですよね。"
    },
    {
      "startSec": 215.3,
      "text": "単語でもコミュニケーションできます。"
    },
    {
      "startSec": 222.7,
      "text": "まあ多分パニックになったら"
    },
    {
      "startSec": 225.1,
      "text": "そういう簡単なこともできないんです。"
    },
    {
      "startSec": 237.7,
      "text": "でもやっぱり優しい、フレンドリーな"
    },
    {
      "startSec": 241.8,
      "text": "日本人の先生もいて、"
    },
    {
      "startSec": 244.4,
      "text": "その先生は英語はできないけど"
    },
    {
      "startSec": 248,
      "text": "シンプルな英語の単語をジャックに言って"
    },
    {
      "startSec": 253,
      "text": "で、ジャックも日本語の単語で"
    },
    {
      "startSec": 255.8,
      "text": "その先生に話す、みたいな"
    },
    {
      "startSec": 258.3,
      "text": "そういう優しい先生もいます。"
    },
    {
      "startSec": 262,
      "text": "でもそういう先生は本当に少ない。"
    },
    {
      "startSec": 266.5,
      "text": "もうほとんどの日本人は、英語とか外国語に"
    },
    {
      "startSec": 273.7,
      "text": "慣れていない(not used to it)"
    },
    {
      "startSec": 277.4,
      "text": "だからパニくるんですよね。"
    },
    {
      "startSec": 280.6,
      "text": "パニックになるんですね。"
    },
    {
      "startSec": 285.1,
      "text": "難しいね。"
    },
    {
      "startSec": 286.2,
      "text": "でもこういうことも、やっぱりオフィスだから"
    },
    {
      "startSec": 291.1,
      "text": "パニックになるかもしれません。"
    },
    {
      "startSec": 294.6,
      "text": "もしかして、例えばジャックが"
    },
    {
      "startSec": 298.4,
      "text": "日本人と何か一緒にアクティビティをしたら"
    },
    {
      "startSec": 304.6,
      "text": "そしたらもしかして言語の壁は"
    },
    {
      "startSec": 308.8,
      "text": "小さくなるんじゃないかな。"
    },
    {
      "startSec": 311.5,
      "text": "小さくなると私は思います。"
    },
    {
      "startSec": 314.5,
      "text": "例えば一緒に自転車に乗って"
    },
    {
      "startSec": 319.8,
      "text": "観光に行くとか、自転車に乗ってる時とか"
    },
    {
      "startSec": 324.4,
      "text": "あんまり言葉は、会話はしなくていいし"
    },
    {
      "startSec": 328.6,
      "text": "リラックスできるし"
    },
    {
      "startSec": 331,
      "text": "あとは一緒にボートをこぐとか"
    },
    {
      "startSec": 336.2,
      "text": "猫をなでる、一緒に猫と遊ぶとか"
    },
    {
      "startSec": 342.4,
      "text": "一緒にバーベキューをするとか"
    },
    {
      "startSec": 345.7,
      "text": "一緒に何かをするとやっぱり、言葉の、言語の壁は"
    },
    {
      "startSec": 352.3,
      "text": "本当に小さくなると思います。"
    },
    {
      "startSec": 356.8,
      "text": "オフィスでこうやって、ワン・ツー・ワンで"
    },
    {
      "startSec": 360.4,
      "text": "仕事の話とかすると、やっぱり緊張するし"
    },
    {
      "startSec": 365.8,
      "text": "完璧な日本語とか完璧な英語を"
    },
    {
      "startSec": 370.2,
      "text": "話さないといけないって思いますよね。"
    },
    {
      "startSec": 377.8,
      "text": "やっぱり言語の壁は、私は一緒に何かをする"
    },
    {
      "startSec": 382.8,
      "text": "アクティビティをする"
    },
    {
      "startSec": 384.6,
      "text": "なんかそれで言語の壁は小さくなって"
    },
    {
      "startSec": 390.2,
      "text": "友達になることができると思います。"
    },
    {
      "startSec": 395.5,
      "text": "それがやっぱり友達を作る方法ですよね。"
    },
    {
      "startSec": 400.8,
      "text": "一緒に何かして、趣味を一緒にするとか"
    },
    {
      "startSec": 408.8,
      "text": "なんて、最近思っていました。"
    },
    {
      "startSec": 412.5,
      "text": "じゃあ今日はここまでかな。"
    },
    {
      "startSec": 414.4,
      "text": "皆さんは言語の壁、感じたことはありますか？"
    },
    {
      "startSec": 419.9,
      "text": "あるよね、多分あるよね。"
    },
    {
      "startSec": 421.8,
      "text": "日本語を勉強したらあるよね。"
    },
    {
      "startSec": 424.8,
      "text": "私もあります。"
    },
    {
      "startSec": 426.3,
      "text": "やっぱり言語の勉強は"
    },
    {
      "startSec": 428.9,
      "text": "楽しいことばっかりじゃないけど"
    },
    {
      "startSec": 431.6,
      "text": "楽しいこともあるし、世界が広がります。"
    },
    {
      "startSec": 435.9,
      "text": "大きい世界に気が付く、だけど"
    },
    {
      "startSec": 440,
      "text": "それと同じに「あ、人間ってみんな似てるんだ」"
    },
    {
      "startSec": 445.4,
      "text": "みたいなそういうことにも気が付く。"
    },
    {
      "startSec": 448.5,
      "text": "「あ、人間ってみんな一緒」みたいな、"
    },
    {
      "startSec": 451.7,
      "text": "それも気が付きますよね。"
    },
    {
      "startSec": 454.6,
      "text": "だから他の文化、勉強することは"
    },
    {
      "startSec": 459.4,
      "text": "本当にいいことだと思います。"
    },
    {
      "startSec": 463.9,
      "text": "ということで"
    },
    {
      "startSec": 464.9,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 468.2,
      "text": "もしポッドキャスト気に入ったら"
    },
    {
      "startSec": 471.5,
      "text": "レビューを書いてくれると本当に嬉しいです。"
    },
    {
      "startSec": 476.1,
      "text": "よろしくお願いします。"
    },
    {
      "startSec": 478,
      "text": "じゃ良い一日を！"
    },
    {
      "startSec": 479.9,
      "text": "また明日会いましょう！バイバイ！"
    }
  ]
}
