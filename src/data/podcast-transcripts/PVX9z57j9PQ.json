{
  "episodeId": "PVX9z57j9PQ",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.1,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日は「スマホ中毒」の話をしたいと思います。"
    },
    {
      "startSec": 11.4,
      "text": "中毒は、意味はto be addicted。"
    },
    {
      "startSec": 14.9,
      "text": "スマホの中毒、アルコール中毒、"
    },
    {
      "startSec": 19.6,
      "text": "タバコ中毒…これ言うかな…"
    },
    {
      "startSec": 22.7,
      "text": "中毒(addicted to something)、そういう意味です。"
    },
    {
      "startSec": 27.3,
      "text": "だから中毒はよくないね。"
    },
    {
      "startSec": 31.1,
      "text": "毒…この漢字はポイズンという意味なので"
    },
    {
      "startSec": 36.4,
      "text": "怖いことですよね、中毒。"
    },
    {
      "startSec": 40.2,
      "text": "「依存」という言葉も"
    },
    {
      "startSec": 42.5,
      "text": "スマホの話をするときによく使います。"
    },
    {
      "startSec": 47.2,
      "text": "スマホに依存する。"
    },
    {
      "startSec": 51.1,
      "text": "「依存」(to rely on something too much)"
    },
    {
      "startSec": 57.2,
      "text": "よく彼氏に依存し過ぎるとか、彼氏依存症とか"
    },
    {
      "startSec": 63.1,
      "text": "そういうこともよく言います。"
    },
    {
      "startSec": 65.7,
      "text": "皆さんはスマホ、スマートフォン"
    },
    {
      "startSec": 70.5,
      "text": "毎日どれくらい使いますか？"
    },
    {
      "startSec": 75.7,
      "text": "どれくらい使いますか？"
    },
    {
      "startSec": 78,
      "text": "使う時は、何のために使っていますか？"
    },
    {
      "startSec": 84.6,
      "text": "私は大学生の時、あんまり友達もいないのに"
    },
    {
      "startSec": 89.9,
      "text": "結構InstagramとかTwitterを見て"
    },
    {
      "startSec": 94.7,
      "text": "よくチェックしてしんどくなっていました。"
    },
    {
      "startSec": 99.5,
      "text": "でも今はなんか…"
    },
    {
      "startSec": 102.5,
      "text": "使わなくなりました。"
    },
    {
      "startSec": 104.7,
      "text": "InstagramとTwitterのログインの"
    },
    {
      "startSec": 108.6,
      "text": "パスワードを忘れてしまって、"
    },
    {
      "startSec": 111.7,
      "text": "もう友達の投稿・写真・ビデオは"
    },
    {
      "startSec": 115.9,
      "text": "見ることができなくなりました。"
    },
    {
      "startSec": 119.2,
      "text": "でも見なくなったら、本当にすっきりしました。"
    },
    {
      "startSec": 124.7,
      "text": "「あ、全然私の人生には必要なかったんだ」って"
    },
    {
      "startSec": 131,
      "text": "今ようやく、やっとわかりました。"
    },
    {
      "startSec": 135.7,
      "text": "でもやっぱりスマホ、"
    },
    {
      "startSec": 138.1,
      "text": "InstagramとかTwitter使っている時は"
    },
    {
      "startSec": 142.5,
      "text": "自分だけ友達から仲間外れにされているような"
    },
    {
      "startSec": 149.7,
      "text": "グループに入れてもらえないような"
    },
    {
      "startSec": 153,
      "text": "そういう寂しい気持ちによくなっていました。"
    },
    {
      "startSec": 158.1,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 160.3,
      "text": "もしそういう気持ちになっているなら"
    },
    {
      "startSec": 164.5,
      "text": "ぜひもうInstagram、Twitter、"
    },
    {
      "startSec": 169.9,
      "text": "アカウントを消しちゃって"
    },
    {
      "startSec": 172.5,
      "text": "アプリもスマホから消しちゃって"
    },
    {
      "startSec": 175.9,
      "text": "自分の、あなたの人生を、生活を大切にしてください。"
    },
    {
      "startSec": 183.3,
      "text": "本当に…\"It's not worth it.\""
    },
    {
      "startSec": 189,
      "text": "そうだと思います。"
    },
    {
      "startSec": 191.1,
      "text": "でも私は今Instagram、YouTubeで"
    },
    {
      "startSec": 197.1,
      "text": "たくさんビデオ作っているので"
    },
    {
      "startSec": 200.2,
      "text": "皆さんは多分、私は結構Instagramにいる時間が"
    },
    {
      "startSec": 206.6,
      "text": "長いんじゃないかなと思っていると思います。"
    },
    {
      "startSec": 211.7,
      "text": "本当に前はそうでした。"
    },
    {
      "startSec": 213.8,
      "text": "一年前は、一日に一時間とか二時間ぐらい"
    },
    {
      "startSec": 219.2,
      "text": "Instagram見ていた時があります。"
    },
    {
      "startSec": 223.4,
      "text": "でも今は見ない日もありますよ。"
    },
    {
      "startSec": 228.1,
      "text": "で、見る日があっても五分とか。"
    },
    {
      "startSec": 233.2,
      "text": "本当にそれくらいになりました。"
    },
    {
      "startSec": 236.4,
      "text": "やっぱり他の人の投稿(posts)を見ていても"
    },
    {
      "startSec": 244.4,
      "text": "本当にいいことはないです。"
    },
    {
      "startSec": 246.9,
      "text": "私にとってはね。"
    },
    {
      "startSec": 248.8,
      "text": "やっぱり自分と比べてしまうので。"
    },
    {
      "startSec": 252.7,
      "text": "でも比べて、何かいいことがあったかな…"
    },
    {
      "startSec": 257.7,
      "text": "と思うとないんですよね。"
    },
    {
      "startSec": 260.4,
      "text": "何もいいことはなかったです。"
    },
    {
      "startSec": 263,
      "text": "だから、最初はもちろん勇気がいると思います。"
    },
    {
      "startSec": 268.3,
      "text": "でも一回、そういう風に見ないように自分で決めて"
    },
    {
      "startSec": 273.6,
      "text": "一回自分をコントロールできたら"
    },
    {
      "startSec": 277.4,
      "text": "ちゃんとその中毒とか依存から"
    },
    {
      "startSec": 281.5,
      "text": "逃げることができるので、もし皆さんが今"
    },
    {
      "startSec": 286.8,
      "text": "「自分ちょっと中毒かな、依存かな」とか思っていたら"
    },
    {
      "startSec": 292.4,
      "text": "是非一回、ちょっと自分でルールを決めて"
    },
    {
      "startSec": 296.4,
      "text": "アプリ全部消して、自分の生活大切にしてください。"
    },
    {
      "startSec": 301.8,
      "text": "そうするとやっぱり、"
    },
    {
      "startSec": 303.6,
      "text": "もっとハッピーになります、本当に。"
    },
    {
      "startSec": 307.1,
      "text": "本当にそう思います。"
    },
    {
      "startSec": 309.8,
      "text": "で、さっきとちょっとGoogleで"
    },
    {
      "startSec": 313,
      "text": "若い人のスマホの依存、"
    },
    {
      "startSec": 316.9,
      "text": "どれくらいかなって調べていたんですが"
    },
    {
      "startSec": 321,
      "text": "大学生は本当に依存している人が多いみたいです。"
    },
    {
      "startSec": 328.3,
      "text": "学生の四十パーセント位が"
    },
    {
      "startSec": 332,
      "text": "スマートフォンに依存している"
    },
    {
      "startSec": 335.6,
      "text": "という研究もありました。"
    },
    {
      "startSec": 339.2,
      "text": "四十パーセント、ほとんどの人が"
    },
    {
      "startSec": 342.1,
      "text": "一日に何時間もスマホを使って、"
    },
    {
      "startSec": 345.8,
      "text": "悲しい、寂しい思いになって…"
    },
    {
      "startSec": 349.3,
      "text": "これはちょっと悲しいことですよね。"
    },
    {
      "startSec": 353.3,
      "text": "私は今もう二十四歳で"
    },
    {
      "startSec": 357.1,
      "text": "大学生よりはちょっと大人になった気がしていますが"
    },
    {
      "startSec": 361.8,
      "text": "今の私から、五年前とか十年前の私に"
    },
    {
      "startSec": 368.1,
      "text": "もしアドバイスが出来るなら、"
    },
    {
      "startSec": 371.9,
      "text": "私は、テレビとかスマホじゃなくて"
    },
    {
      "startSec": 376.3,
      "text": "もっと外の世界に、外に行ってごらんって"
    },
    {
      "startSec": 380.3,
      "text": "外に行ってみてって言いたいですね。"
    },
    {
      "startSec": 384.1,
      "text": "本当にスマホとか別にいいけど、"
    },
    {
      "startSec": 387.9,
      "text": "映画とか他の人のビデオから"
    },
    {
      "startSec": 390.8,
      "text": "勉強できることもたくさんあるけど"
    },
    {
      "startSec": 394,
      "text": "それはなんか今じゃなくてもいい気がする。"
    },
    {
      "startSec": 398.3,
      "text": "もっとそれより何か、外に行って遊んだりとか"
    },
    {
      "startSec": 403.3,
      "text": "太陽の光を浴びたり、他の人と話したり"
    },
    {
      "startSec": 407.5,
      "text": "そういう経験の方が今ずっと私の中に残っています。"
    },
    {
      "startSec": 414.6,
      "text": "何時間もたくさんスクロールして読んだり見たりした"
    },
    {
      "startSec": 420,
      "text": "Instagram、Twitter、YouTubeのこと"
    },
    {
      "startSec": 423.5,
      "text": "もう全然覚えてないです、本当に。"
    },
    {
      "startSec": 426.9,
      "text": "でも昔話していた隣のおばさんとの会話とか"
    },
    {
      "startSec": 433.7,
      "text": "昔遊んでいた公園、"
    },
    {
      "startSec": 436,
      "text": "そういうことの方が大切な思い出になってます。"
    },
    {
      "startSec": 441.4,
      "text": "本当に。"
    },
    {
      "startSec": 443.4,
      "text": "昔の自分に何かメッセージが送れたらいいですよね。"
    },
    {
      "startSec": 450.2,
      "text": "今日はちょっとそういう話をしてみました。"
    },
    {
      "startSec": 454.4,
      "text": "でもこれを見てる皆さんは"
    },
    {
      "startSec": 456.2,
      "text": "きっとYouTubeとかポッドキャスト、"
    },
    {
      "startSec": 458.9,
      "text": "スマートフォンを使って"
    },
    {
      "startSec": 460.9,
      "text": "見てくれていると思うんですが、"
    },
    {
      "startSec": 464.3,
      "text": "本当に難しいですよね。"
    },
    {
      "startSec": 466.7,
      "text": "いいスマートフォンの使い方もあるし"
    },
    {
      "startSec": 470.9,
      "text": "ちょっと体に良くない使い方もあるし。"
    },
    {
      "startSec": 475.2,
      "text": "そういうバランスは、本当に皆さんが"
    },
    {
      "startSec": 478.1,
      "text": "自分達で考えないといけないことですよね。"
    },
    {
      "startSec": 488.8,
      "text": "このポッドキャスト、楽しんでくれたら"
    },
    {
      "startSec": 491.7,
      "text": "私はそれが一番うれしいです。"
    },
    {
      "startSec": 495.8,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 497,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 499,
      "text": "リクエストとか感想・レビューがあったら"
    },
    {
      "startSec": 503.5,
      "text": "コメントに書いてくれると嬉しいです。"
    },
    {
      "startSec": 507.3,
      "text": "もしよかったら"
    },
    {
      "startSec": 508.8,
      "text": "Appleポッドキャストのレビューを残してくれると"
    },
    {
      "startSec": 512.9,
      "text": "本当に嬉しいです。"
    },
    {
      "startSec": 515,
      "text": "是非よろしくお願いします。"
    },
    {
      "startSec": 517.7,
      "text": "じゃあまた明日聞いてください。"
    },
    {
      "startSec": 519.9,
      "text": "ありがとう！バイバイ！"
    }
  ]
}
