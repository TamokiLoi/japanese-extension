{
  "episodeId": "-8rs-NgykLI",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.1,
      "text": "元気ですか？"
    },
    {
      "startSec": 6.6,
      "text": "今日は3月の14日です。"
    },
    {
      "startSec": 11.4,
      "text": "多分皆さんは、このエピソードを聞くのは"
    },
    {
      "startSec": 14.6,
      "text": "もっと後になると思うんですけど"
    },
    {
      "startSec": 18.2,
      "text": "日本は今日めっちゃ暖かいです。"
    },
    {
      "startSec": 22.7,
      "text": "春が来ました。"
    },
    {
      "startSec": 24.5,
      "text": "さっきも、窓とカーテンも全部開けて"
    },
    {
      "startSec": 29,
      "text": "太陽の光が家の中に入ってくるようにしています。"
    },
    {
      "startSec": 34.1,
      "text": "私は、やっぱり太陽の光がなかったら"
    },
    {
      "startSec": 41.3,
      "text": "生きていけないです。"
    },
    {
      "startSec": 43.3,
      "text": "やっぱりしんどくなるし、ネガティブになるし。"
    },
    {
      "startSec": 48.3,
      "text": "太陽の光があるだけで、なんか幸せを感じます。"
    },
    {
      "startSec": 53.3,
      "text": "家で仕事をする一番いいことは、"
    },
    {
      "startSec": 57,
      "text": "やっぱりいい場所で仕事ができることですよね。"
    },
    {
      "startSec": 61.9,
      "text": "家の中をきれいにして"
    },
    {
      "startSec": 64.1,
      "text": "窓の横にデスクを置いて"
    },
    {
      "startSec": 68.1,
      "text": "窓を開けて仕事ができる、これは最高です。"
    },
    {
      "startSec": 73,
      "text": "で、散歩する時間も"
    },
    {
      "startSec": 75.7,
      "text": "自由に決めることができます。"
    },
    {
      "startSec": 78.9,
      "text": "例えば、昼の12時くらいに"
    },
    {
      "startSec": 81.5,
      "text": "「ああ、なんか外をきれいだし、散歩に行きたいな」と思って"
    },
    {
      "startSec": 88.3,
      "text": "散歩に行くことができます。"
    },
    {
      "startSec": 91.2,
      "text": "会社で仕事をしていたら、それはできないですよね。"
    },
    {
      "startSec": 96.1,
      "text": "これが家で仕事をする一番いいことだと思います。"
    },
    {
      "startSec": 102.1,
      "text": "ちょっと長くなりましたが、"
    },
    {
      "startSec": 104.8,
      "text": "今日は、妹とジャックが昨日尾道で初めて会いました"
    },
    {
      "startSec": 114.8,
      "text": "という話をしたいと思います。"
    },
    {
      "startSec": 118,
      "text": "私の家族、妹に、彼氏ジャックさんが会うのは"
    },
    {
      "startSec": 124.7,
      "text": "これが初めてです。"
    },
    {
      "startSec": 127.2,
      "text": "で、昨日尾道、これは広島にあります。"
    },
    {
      "startSec": 132,
      "text": "とてもきれいな場所です。"
    },
    {
      "startSec": 134.5,
      "text": "そこで初めて会いました。"
    },
    {
      "startSec": 140.6,
      "text": "2人ともすっごく緊張していました。"
    },
    {
      "startSec": 145.3,
      "text": "私は全然緊張しなかったけど"
    },
    {
      "startSec": 149.5,
      "text": "妹もジャックもすごくシャイなので"
    },
    {
      "startSec": 153.3,
      "text": "2人ともすっごく緊張していて。"
    },
    {
      "startSec": 157,
      "text": "妹は今まで、中学校・高校・大学、"
    },
    {
      "startSec": 162.7,
      "text": "英語の勉強をしてきたので"
    },
    {
      "startSec": 165.9,
      "text": "英語の知識(knowledge)はあります。"
    },
    {
      "startSec": 171.2,
      "text": "でも、いやマジで、話せませんでした。"
    },
    {
      "startSec": 178.2,
      "text": "全然英語話せなくて、"
    },
    {
      "startSec": 180.8,
      "text": "ジャックとも全然話さなかったです。"
    },
    {
      "startSec": 185.3,
      "text": "ちょっと、すごく気まずかったです。"
    },
    {
      "startSec": 188.7,
      "text": "気まずい(awkward)"
    },
    {
      "startSec": 191.4,
      "text": "で、妹が英語が話せなかったのは"
    },
    {
      "startSec": 195,
      "text": "一番の理由は、私がそこにいたからだと思います。"
    },
    {
      "startSec": 202.6,
      "text": "私はもちろん、ジャックと一緒に住んでいるし"
    },
    {
      "startSec": 207.5,
      "text": "英語もちょっと話せるので"
    },
    {
      "startSec": 210.7,
      "text": "私に間違えた英語を聞かれるのが"
    },
    {
      "startSec": 216.3,
      "text": "恥ずかしかった。"
    },
    {
      "startSec": 217.8,
      "text": "妹は恥ずかしかった、失敗をすることが。"
    },
    {
      "startSec": 222.6,
      "text": "それで全然話さなかったです。"
    },
    {
      "startSec": 227.7,
      "text": "で、私はその時に"
    },
    {
      "startSec": 229.5,
      "text": "ちょっと彼氏の英語を英語にしたり"
    },
    {
      "startSec": 234.7,
      "text": "妹の日本語を英語にしたり"
    },
    {
      "startSec": 238.1,
      "text": "通訳(to translate)していたので"
    },
    {
      "startSec": 245.1,
      "text": "通訳する人がいたら"
    },
    {
      "startSec": 247.6,
      "text": "英語は話さなくてもいいですよね。"
    },
    {
      "startSec": 252.8,
      "text": "こういう理由で、妹は全然英語が話せなくて"
    },
    {
      "startSec": 258.5,
      "text": "もう「サンキュー」しか言わなかったです。"
    },
    {
      "startSec": 263.5,
      "text": "すっごく気まずかったです。"
    },
    {
      "startSec": 267.8,
      "text": "でもジャックも優しくて"
    },
    {
      "startSec": 271.2,
      "text": "バナナケーキを妹のために作ってきてくれて"
    },
    {
      "startSec": 276.8,
      "text": "尾道の山の上で一緒にみんなで食べました。"
    },
    {
      "startSec": 281.9,
      "text": "すっごくおいしいケーキでナッツが入ってる"
    },
    {
      "startSec": 286.7,
      "text": "もう一回食べたいですね。"
    },
    {
      "startSec": 288.2,
      "text": "すっごくおいしいケーキを焼いてきてくれました。"
    },
    {
      "startSec": 292.8,
      "text": "妹は全然話せなかったけど"
    },
    {
      "startSec": 296.4,
      "text": "後でメールで「もうジャックさんいい人だったね」"
    },
    {
      "startSec": 300.4,
      "text": "「また会いたい」って言ってくれました。"
    },
    {
      "startSec": 303.6,
      "text": "で、私のお父さんは"
    },
    {
      "startSec": 306.1,
      "text": "まだジャックさんに会ったことがないので"
    },
    {
      "startSec": 309.1,
      "text": "今度ジャックと私が"
    },
    {
      "startSec": 311.5,
      "text": "京都に行く時に会いたいなと思っています。"
    },
    {
      "startSec": 316.3,
      "text": "尾道は、広島にある有名な観光地(sightseeing place)です。"
    },
    {
      "startSec": 326.7,
      "text": "他に似た町はないです。京都とも全然違います。"
    },
    {
      "startSec": 333,
      "text": "低い山があって、その山に"
    },
    {
      "startSec": 336.5,
      "text": "古いお寺とか昔の家とか、たくさんあって"
    },
    {
      "startSec": 342.4,
      "text": "で、その細い道を上まで登っていきます。"
    },
    {
      "startSec": 347.2,
      "text": "本当に1000年以上前のお寺があります。"
    },
    {
      "startSec": 351.9,
      "text": "たくさんありますよ。"
    },
    {
      "startSec": 353.9,
      "text": "なので、日本の歴史とか文化が好きな人"
    },
    {
      "startSec": 358.9,
      "text": "古いものが好きな人は、是非行ってみてください。"
    },
    {
      "startSec": 362.7,
      "text": "すっごくおすすめです。"
    },
    {
      "startSec": 366,
      "text": "もう多分東京よりもいいと思いますよ。"
    },
    {
      "startSec": 370.4,
      "text": "じゃあ、こんな感じで今日は終わります。"
    },
    {
      "startSec": 373.4,
      "text": "このポッドキャストには"
    },
    {
      "startSec": 375.2,
      "text": "トランスクリプトがあって"
    },
    {
      "startSec": 377.5,
      "text": "そのトランスクリプトには"
    },
    {
      "startSec": 379.6,
      "text": "漢字の上にふりがなも付いています。"
    },
    {
      "startSec": 384.1,
      "text": "なので、漢字の読み方が勉強したい人とか"
    },
    {
      "startSec": 388.6,
      "text": "トランスクリプトが見たい人は"
    },
    {
      "startSec": 391.2,
      "text": "是非Patreonでサポートしてください。"
    },
    {
      "startSec": 396.1,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 397.9,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
