{
  "episodeId": "H9bJtZW6Nto",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日のトピックは「習い事」です。"
    },
    {
      "startSec": 9.2,
      "text": "「習い事」…習い(習う=to learn)、事(thing)"
    },
    {
      "startSec": 14.9,
      "text": "だから習い事は、特に子供ですね。"
    },
    {
      "startSec": 19.3,
      "text": "子供が学校の外で何か勉強すること。"
    },
    {
      "startSec": 26.5,
      "text": "勉強じゃなくても、ピアノとか水泳、スイミングとか"
    },
    {
      "startSec": 33.3,
      "text": "習字、カリグラフィーとか"
    },
    {
      "startSec": 36.4,
      "text": "学校の外で習う事、勉強すること"
    },
    {
      "startSec": 41.6,
      "text": "これをよく「習い事」と言います。"
    },
    {
      "startSec": 46.8,
      "text": "クラブみたいな感じですね。"
    },
    {
      "startSec": 50,
      "text": "で、なんでこれについて話したかったかと言うと"
    },
    {
      "startSec": 56.2,
      "text": "日本人はすごく習い事をする人が多いです。"
    },
    {
      "startSec": 64.6,
      "text": "私も小学生の時、友達のほとんどが"
    },
    {
      "startSec": 69.4,
      "text": "この「習い事」をしていたのを覚えています。"
    },
    {
      "startSec": 74.3,
      "text": "実は私は習い事は一つもしなかったです。"
    },
    {
      "startSec": 78.9,
      "text": "だから友達が習い事の話をしているのを見て"
    },
    {
      "startSec": 84,
      "text": "私だけちょっと何かみんなと違う。"
    },
    {
      "startSec": 87.9,
      "text": "「仲間はずれ」と言います。"
    },
    {
      "startSec": 90.5,
      "text": "グループに入れない、仲間はずれみたいに"
    },
    {
      "startSec": 95,
      "text": "感じたことを覚えています。"
    },
    {
      "startSec": 98.4,
      "text": "でも私は習い事は別にいいこと、とは思ってないです。"
    },
    {
      "startSec": 105.5,
      "text": "もちろんその習い事が、その子どもにとって"
    },
    {
      "startSec": 110.8,
      "text": "いいことになることもありますが、"
    },
    {
      "startSec": 114.1,
      "text": "私は全然、習い事はしなくてもいいと思ってます。"
    },
    {
      "startSec": 120.2,
      "text": "でもほとんどの親は多分子どもを"
    },
    {
      "startSec": 124.9,
      "text": "習い事に行かせないと、とか"
    },
    {
      "startSec": 128.4,
      "text": "学校の後で塾(cram school)に行って勉強させないと、"
    },
    {
      "startSec": 133,
      "text": "こういう風に思っている親は日本にはすごく多いです。"
    },
    {
      "startSec": 140.5,
      "text": "でも、私の親はその考えにはちょっと反対でした。"
    },
    {
      "startSec": 148.1,
      "text": "私の親はそういうことは"
    },
    {
      "startSec": 151.2,
      "text": "子どもが決めることと考えていました。"
    },
    {
      "startSec": 155.3,
      "text": "親が、子どもにピアノ勉強してほしいから"
    },
    {
      "startSec": 160.6,
      "text": "「ピアノの教室、ピアノの習い事に行きなさい」"
    },
    {
      "startSec": 165.3,
      "text": "これは親の都合ですよね。"
    },
    {
      "startSec": 168.5,
      "text": "親が子どもにしてほしいから行かせる。"
    },
    {
      "startSec": 173.3,
      "text": "でもこういう風にして育てられた子どもは"
    },
    {
      "startSec": 179.7,
      "text": "なんか私はそういう子どもは、自分で選ぶ力が"
    },
    {
      "startSec": 187.1,
      "text": "弱くなってしまうんじゃないかなと思ってます。"
    },
    {
      "startSec": 192.2,
      "text": "いつも親にやることを決められたり"
    },
    {
      "startSec": 197,
      "text": "「他の子がやってるから、私もこの習い事しよう」"
    },
    {
      "startSec": 202.2,
      "text": "みたいに自分を基準に、じゃなくて"
    },
    {
      "startSec": 207.1,
      "text": "他の人、親の基準で選んでしまう、"
    },
    {
      "startSec": 211.8,
      "text": "なんかそういう気が私はするんですよね。"
    },
    {
      "startSec": 215.5,
      "text": "でも私の親はいつも私に「自分で決めなさい」"
    },
    {
      "startSec": 221.5,
      "text": "と言っていました。"
    },
    {
      "startSec": 223.7,
      "text": "私が小学生の時、することがなくて暇だった時"
    },
    {
      "startSec": 229.9,
      "text": "よく私はお父さんに"
    },
    {
      "startSec": 232.1,
      "text": "「パパ、暇～」って言ってたんですね。"
    },
    {
      "startSec": 236.1,
      "text": "でもそういう時も私の親は、"
    },
    {
      "startSec": 239.7,
      "text": "テレビとかゲームとか習い事は私にさせなかったです。"
    },
    {
      "startSec": 247.9,
      "text": "だから私はいつも外で遊んだり、絵を描いたり"
    },
    {
      "startSec": 253.9,
      "text": "何か料理…実験じゃないけど、変な料理を作ったり"
    },
    {
      "startSec": 259.4,
      "text": "結構そうやって体とか手を動かすことが多かったです。"
    },
    {
      "startSec": 266.5,
      "text": "でもなんか今はそれが"
    },
    {
      "startSec": 269.3,
      "text": "すごくいいことだったなと思います。"
    },
    {
      "startSec": 274.3,
      "text": "そういう自分で好きなことをする、自分で選んでする。"
    },
    {
      "startSec": 280.2,
      "text": "そういう経験が今の私を作っているなとよく思います。"
    },
    {
      "startSec": 287.7,
      "text": "だから多分私は今、クラスメイトとは違って"
    },
    {
      "startSec": 292.9,
      "text": "こうやってソーシャルメディアやったり"
    },
    {
      "startSec": 296.9,
      "text": "会社で働きたくないとか"
    },
    {
      "startSec": 299.5,
      "text": "結構わがままになってしまったんですが、"
    },
    {
      "startSec": 303.9,
      "text": "まあそれも別にいいんじゃないかなと"
    },
    {
      "startSec": 307.6,
      "text": "最近思えるようになりました。"
    },
    {
      "startSec": 311.6,
      "text": "皆さんは習い事、したことはありますか？"
    },
    {
      "startSec": 316.9,
      "text": "他の国ではとても珍しいと思うんですよね。"
    },
    {
      "startSec": 322.4,
      "text": "よかったらこの習い事への皆さんの意見、"
    },
    {
      "startSec": 328.5,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 331.2,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 332.9,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 335.7,
      "text": "このポッドキャストの"
    },
    {
      "startSec": 337.5,
      "text": "トランスクリプトが読みたかったら、"
    },
    {
      "startSec": 341.3,
      "text": "私のPatreonのメンバーになってください。"
    },
    {
      "startSec": 346.2,
      "text": "全てのエピソードにトランスクリプト作っています。"
    },
    {
      "startSec": 351.1,
      "text": "最近メンバーさんのためだけのエピソード、"
    },
    {
      "startSec": 356.3,
      "text": "Patreonで一週間に一回作っています。"
    },
    {
      "startSec": 361.2,
      "text": "そっちも興味があったら"
    },
    {
      "startSec": 363.4,
      "text": "是非聞いてくれると嬉しいです。"
    },
    {
      "startSec": 366.8,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 368.2,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 370.2,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
