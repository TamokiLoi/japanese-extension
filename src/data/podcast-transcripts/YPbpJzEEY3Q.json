{
  "episodeId": "YPbpJzEEY3Q",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.8,
      "text": "今日は暗記のコツについて話したいと思います。"
    },
    {
      "startSec": 11.4,
      "text": "暗記、暗記する(to memorize)です。"
    },
    {
      "startSec": 16.3,
      "text": "Anki deckとか有名なアプリがあります。"
    },
    {
      "startSec": 21.6,
      "text": "私は結構高校生の時とか、大学生の時"
    },
    {
      "startSec": 28.1,
      "text": "暗記はとてもよくできました。"
    },
    {
      "startSec": 31.6,
      "text": "テストとかはいつも90点以上取ることができました。"
    },
    {
      "startSec": 38.1,
      "text": "暗記は本当に得意で、"
    },
    {
      "startSec": 40.6,
      "text": "数学みたいに頭を使う科目(subject)は全然。"
    },
    {
      "startSec": 46.6,
      "text": "数学は本当に…"
    },
    {
      "startSec": 48.2,
      "text": "数学も暗記で勉強していました。"
    },
    {
      "startSec": 52.1,
      "text": "なので、大学に入るテストの時に"
    },
    {
      "startSec": 56.6,
      "text": "数学は40点を取るという大きな失敗をしました。"
    },
    {
      "startSec": 63.4,
      "text": "が、暗記はよくできました。"
    },
    {
      "startSec": 66.3,
      "text": "もちろん暗記が全てではない。"
    },
    {
      "startSec": 69.9,
      "text": "暗記よりも、考える力のほうがもちろん大切なんですが"
    },
    {
      "startSec": 76.9,
      "text": "やっぱり日本語の勉強とか"
    },
    {
      "startSec": 79.6,
      "text": "暗記がまず最初に必要な時はもちろんあります。"
    },
    {
      "startSec": 87,
      "text": "なので今日は、私の得意な暗記のコツについて"
    },
    {
      "startSec": 92.7,
      "text": "話したいと思います。"
    },
    {
      "startSec": 95,
      "text": "私が高校生の時は、毎朝学校で"
    },
    {
      "startSec": 101.2,
      "text": "英語の単語のテストがありました。"
    },
    {
      "startSec": 105.2,
      "text": "私はいつもちゃんと"
    },
    {
      "startSec": 107.5,
      "text": "全部の問題に答えることができました。"
    },
    {
      "startSec": 112,
      "text": "その時どんな風に勉強していたかと言うと"
    },
    {
      "startSec": 119.6,
      "text": "大体一週間くらい前からテストの範囲(range)、"
    },
    {
      "startSec": 127.3,
      "text": "テストに出る単語の場所です。"
    },
    {
      "startSec": 132.3,
      "text": "単語を一週間前から全部ノートに書いて勉強しました。"
    },
    {
      "startSec": 139.4,
      "text": "全部の単語を日本語を見て"
    },
    {
      "startSec": 143,
      "text": "英語がノートに書けるようになるまで"
    },
    {
      "startSec": 147.2,
      "text": "全部の英語の単語を何回もノートに書いて、"
    },
    {
      "startSec": 151.8,
      "text": "もうスペルもちゃんと覚えるまで"
    },
    {
      "startSec": 154.3,
      "text": "一つの単語を何回も書いて練習しました。"
    },
    {
      "startSec": 158.6,
      "text": "これを大体テストの一週間前にやります。"
    },
    {
      "startSec": 163.5,
      "text": "全部の英語の単語を覚えたら"
    },
    {
      "startSec": 166.6,
      "text": "その後は復習(review)、これにフォーカスします。"
    },
    {
      "startSec": 175.6,
      "text": "でコツは、毎日復習すること。"
    },
    {
      "startSec": 181.6,
      "text": "私は朝、学校に行く電車の中で"
    },
    {
      "startSec": 187.3,
      "text": "復習をしていました。"
    },
    {
      "startSec": 189.4,
      "text": "この復習は"
    },
    {
      "startSec": 192.5,
      "text": "正直時間はかけなくて全然良くて"
    },
    {
      "startSec": 196.9,
      "text": "時間よりも復習する回数を増やすことの方が大切です。"
    },
    {
      "startSec": 205.7,
      "text": "なので私は、英語の単語帳を"
    },
    {
      "startSec": 209.1,
      "text": "朝電車の中で読んでいました。"
    },
    {
      "startSec": 212.1,
      "text": "本みたいに単語帳を読んで"
    },
    {
      "startSec": 215,
      "text": "テストの英語を復習していました。"
    },
    {
      "startSec": 219.7,
      "text": "で、これを絶対に毎日します。"
    },
    {
      "startSec": 223.7,
      "text": "毎日復習します。"
    },
    {
      "startSec": 226.4,
      "text": "この「毎日する」ことが一番大切。"
    },
    {
      "startSec": 230.9,
      "text": "一分でも大丈夫。"
    },
    {
      "startSec": 233.5,
      "text": "読むだけでも本当に効果があります。"
    },
    {
      "startSec": 238.2,
      "text": "ここがコツかな。"
    },
    {
      "startSec": 239.8,
      "text": "友達とかは一回に勉強する時間は長いけど"
    },
    {
      "startSec": 246.2,
      "text": "復習はあんまりしない。"
    },
    {
      "startSec": 248.9,
      "text": "で、復習する時はめっちゃ時間をかける友達がいましたが"
    },
    {
      "startSec": 254.9,
      "text": "それはあんまり効率が良くない(not so effective, efficient)。"
    },
    {
      "startSec": 264.4,
      "text": "効率の良い暗記の方法は復習です。"
    },
    {
      "startSec": 270.2,
      "text": "リピート、何回もリピートすること。"
    },
    {
      "startSec": 274.1,
      "text": "読むだけでオッケー。"
    },
    {
      "startSec": 275.9,
      "text": "私はこの方法で"
    },
    {
      "startSec": 277.9,
      "text": "もう全部の科目(subject)を勉強しました。"
    },
    {
      "startSec": 283.5,
      "text": "そんな感じなので"
    },
    {
      "startSec": 285.8,
      "text": "皆さんも日本語の勉強ですが"
    },
    {
      "startSec": 289.9,
      "text": "例えば毎朝もう五分でも大丈夫。"
    },
    {
      "startSec": 294.2,
      "text": "昨日勉強したことを次の日の朝"
    },
    {
      "startSec": 298.5,
      "text": "読むだけでいいので、復習すると"
    },
    {
      "startSec": 302.1,
      "text": "しっかり暗記できます。"
    },
    {
      "startSec": 305,
      "text": "頭に残りやすい、覚えやすいです。"
    },
    {
      "startSec": 309.5,
      "text": "多分コツは勉強した次の日の朝、"
    },
    {
      "startSec": 314.5,
      "text": "しっかり復習することだと思います。"
    },
    {
      "startSec": 319.5,
      "text": "私の場合は、朝復習する方が良かった。"
    },
    {
      "startSec": 326.1,
      "text": "夜は結構、疲れているので"
    },
    {
      "startSec": 328.8,
      "text": "朝、何も頭がまだ考えていない時に復習をすると"
    },
    {
      "startSec": 335.9,
      "text": "ハッと昨日覚えた単語が頭の中に戻ってきて"
    },
    {
      "startSec": 341.8,
      "text": "もうそれでしっかり覚えられます。"
    },
    {
      "startSec": 345.1,
      "text": "もうこれがコツです。"
    },
    {
      "startSec": 347.2,
      "text": "是非皆さんもやってみてください。"
    },
    {
      "startSec": 352,
      "text": "今日のエピソードはここまでです。"
    },
    {
      "startSec": 354.3,
      "text": "いつもありがとう。また明日ね！"
    },
    {
      "startSec": 357.3,
      "text": "毎日エピソード作ってるよ！"
    },
    {
      "startSec": 359.4,
      "text": "また聞いてね～バイバイ！"
    }
  ]
}
