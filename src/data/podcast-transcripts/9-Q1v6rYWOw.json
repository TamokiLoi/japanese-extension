{
  "episodeId": "9-Q1v6rYWOw",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日は、日本の小学生のなりたい職業(occupation)"
    },
    {
      "startSec": 14.3,
      "text": "小学生が今一番なりたいもの、"
    },
    {
      "startSec": 18.5,
      "text": "なりたい人、職業トップテン"
    },
    {
      "startSec": 22.2,
      "text": "これを皆さんに紹介したいと思います。"
    },
    {
      "startSec": 27,
      "text": "すごくこれ面白いなと思ったんですね。"
    },
    {
      "startSec": 31,
      "text": "これは2021年、去年のアンケートの結果です。"
    },
    {
      "startSec": 38,
      "text": "結構面白くて男子と女子、"
    },
    {
      "startSec": 42,
      "text": "男の子と女の子で違います。"
    },
    {
      "startSec": 45.6,
      "text": "グラフを見つけたのでちょっと読んでいきます。"
    },
    {
      "startSec": 51.8,
      "text": "まずは男の子。"
    },
    {
      "startSec": 56.5,
      "text": "一位、何だと思いますか？"
    },
    {
      "startSec": 61.7,
      "text": "男の子、一位。"
    },
    {
      "startSec": 64.7,
      "text": "これサッカー選手(player)です。"
    },
    {
      "startSec": 70.5,
      "text": "サッカー選手、これは夢があっていいですね。"
    },
    {
      "startSec": 74.8,
      "text": "皆さんは小学生の時何になりたかったですか？"
    },
    {
      "startSec": 81.3,
      "text": "覚えてますか？"
    },
    {
      "startSec": 85.2,
      "text": "ちょっと懐かしい気持ちになりませんか？"
    },
    {
      "startSec": 89.3,
      "text": "夢のことを考えたりとか、ちょっと。"
    },
    {
      "startSec": 94.3,
      "text": "じゃ二番目。"
    },
    {
      "startSec": 95.4,
      "text": "二番目は、野球選手(baseball player)です。"
    },
    {
      "startSec": 100.1,
      "text": "野球選手、夢があります。"
    },
    {
      "startSec": 102.6,
      "text": "そして三番目、これは夢じゃなくて"
    },
    {
      "startSec": 109,
      "text": "親の影響(influence)かなと思います。"
    },
    {
      "startSec": 115.8,
      "text": "医者(doctor)です。"
    },
    {
      "startSec": 120.4,
      "text": "いや確かに、お金がもらえますよね。"
    },
    {
      "startSec": 124.9,
      "text": "はい、わかります。"
    },
    {
      "startSec": 126.5,
      "text": "でも勉強難しいぞって、頑張ってねって感じです。"
    },
    {
      "startSec": 131.1,
      "text": "そして四つ目、YouTuber。"
    },
    {
      "startSec": 134.8,
      "text": "私が小学生の時、YouTuberいなかったです。"
    },
    {
      "startSec": 141.2,
      "text": "本当にもう変わりましたね。"
    },
    {
      "startSec": 144.2,
      "text": "そして五つ目、これはゲーム作り。"
    },
    {
      "startSec": 148.7,
      "text": "ゲームを作ること。"
    },
    {
      "startSec": 150.9,
      "text": "確かにYouTubeとスマホのゲームとか"
    },
    {
      "startSec": 155.5,
      "text": "すっごく人気になりましたよね、最近急に。"
    },
    {
      "startSec": 161.1,
      "text": "そして六つ目。"
    },
    {
      "startSec": 165.5,
      "text": "これはみんなびっくりすると思うんだけど…"
    },
    {
      "startSec": 170.8,
      "text": "会社員です。"
    },
    {
      "startSec": 175.1,
      "text": "サラリーマン、会社員。"
    },
    {
      "startSec": 180.3,
      "text": "これは今までこの小学生のなりたい職業トップテンには"
    },
    {
      "startSec": 189,
      "text": "入ってなかったと思います。"
    },
    {
      "startSec": 192,
      "text": "で多分、2020年のコロナの影響で"
    },
    {
      "startSec": 199.3,
      "text": "多分なんか、そんなに仕事が難しいなら"
    },
    {
      "startSec": 205.6,
      "text": "普通の会社員でいいかなみたいな、"
    },
    {
      "startSec": 209.3,
      "text": "そういう考えの人が"
    },
    {
      "startSec": 212.1,
      "text": "増えたんじゃないかなと思います。"
    },
    {
      "startSec": 215.2,
      "text": "びっくりしました。"
    },
    {
      "startSec": 216.8,
      "text": "会社員は…何の会社員？"
    },
    {
      "startSec": 222.2,
      "text": "何をしたいの？ってちょっとわかんないですよね。"
    },
    {
      "startSec": 225.2,
      "text": "何の会社員かな？"
    },
    {
      "startSec": 227.2,
      "text": "ちょっとここが私はとても不思議。"
    },
    {
      "startSec": 231.5,
      "text": "不思議、分からなかったですね。"
    },
    {
      "startSec": 234.5,
      "text": "で次、七番目は二つ、プロゲーマー。"
    },
    {
      "startSec": 241,
      "text": "こっちもまたゲームが来ましたね。"
    },
    {
      "startSec": 243.4,
      "text": "ゲーマーと、これは意外だ。"
    },
    {
      "startSec": 246.5,
      "text": "建築士は英語でarchitectですね。"
    },
    {
      "startSec": 253.1,
      "text": "これはびっくりしました。"
    },
    {
      "startSec": 254.8,
      "text": "なんでかな？結構大変だと思うけどね。"
    },
    {
      "startSec": 259.2,
      "text": "そして九番目は、動物をお世話する人。"
    },
    {
      "startSec": 265.4,
      "text": "動物園とかペットショップとかで動物を世話する人。"
    },
    {
      "startSec": 270.4,
      "text": "これはなんかいいですね。"
    },
    {
      "startSec": 272.2,
      "text": "私も動物好きなので。"
    },
    {
      "startSec": 274.8,
      "text": "そして十番目は、料理人、シェフ。"
    },
    {
      "startSec": 281.4,
      "text": "料理をする人でした。"
    },
    {
      "startSec": 288.3,
      "text": "会社員、会社員。何の会社員ですかって"
    },
    {
      "startSec": 295.2,
      "text": "すごく聞きたいですね。"
    },
    {
      "startSec": 297.8,
      "text": "で、ゲームの仕事が多かったこと"
    },
    {
      "startSec": 302.1,
      "text": "これはちょっと最近のYouTubeとかの影響で"
    },
    {
      "startSec": 307.7,
      "text": "増えているのは分かります。"
    },
    {
      "startSec": 310.4,
      "text": "これすごく面白いですね。"
    },
    {
      "startSec": 312.1,
      "text": "皆さんの子どもの時の夢、"
    },
    {
      "startSec": 314.5,
      "text": "ぜひコメントで教えてください。"
    },
    {
      "startSec": 317.6,
      "text": "私は…私の夢は小学生の時は画家、絵を描く人"
    },
    {
      "startSec": 327.9,
      "text": "画家になりたかったかな。"
    },
    {
      "startSec": 330.8,
      "text": "絵を描くのが大好きで、でも中学生くらいになって"
    },
    {
      "startSec": 336.3,
      "text": "勉強が忙しくなって"
    },
    {
      "startSec": 339.1,
      "text": "絵を描くのはちょっとやめてしまいました。"
    },
    {
      "startSec": 343,
      "text": "次のエピソードでは"
    },
    {
      "startSec": 346.2,
      "text": "女子のなりたい職業ランキング発表します。"
    },
    {
      "startSec": 351.8,
      "text": "是非また明日も聞いてください。"
    },
    {
      "startSec": 355.4,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 357.1,
      "text": "じゃあお仕事・勉強頑張ってください。"
    },
    {
      "startSec": 360.6,
      "text": "じゃあまたね、バイバイ！"
    }
  ]
}
