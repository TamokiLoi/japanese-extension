{
  "episodeId": "h2GPCCqZADg",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.3,
      "text": "今日は「私の好きなタイプの人」の話を"
    },
    {
      "startSec": 11.9,
      "text": "したいなと思います。"
    },
    {
      "startSec": 15.6,
      "text": "好きなタイプの人、好きな男の人のタイプです。"
    },
    {
      "startSec": 22,
      "text": "もちろん今ジャックさんと付き合ってるので"
    },
    {
      "startSec": 26.6,
      "text": "本当に彼は私のタイプの人です。"
    },
    {
      "startSec": 31.1,
      "text": "実はジャックと友達になった時に"
    },
    {
      "startSec": 35.3,
      "text": "私は日本人の彼氏と付き合っていたんです。"
    },
    {
      "startSec": 41.6,
      "text": "彼と六年くらい付き合っていて"
    },
    {
      "startSec": 45.1,
      "text": "でもなんかちょっと、"
    },
    {
      "startSec": 47.1,
      "text": "「彼は私の運命の人じゃないなー」って"
    },
    {
      "startSec": 54.4,
      "text": "思っていたんですね。"
    },
    {
      "startSec": 56.2,
      "text": "で、その時にジャックと出会って"
    },
    {
      "startSec": 59.9,
      "text": "彼に「すいません、ごめんなさい」って言って"
    },
    {
      "startSec": 63.2,
      "text": "ジャックさんと付き合い始めたんです。"
    },
    {
      "startSec": 65.6,
      "text": "で、私の好きなタイプの人は"
    },
    {
      "startSec": 71.1,
      "text": "多分私のお父さんの影響(influence)だと思いますが"
    },
    {
      "startSec": 79.4,
      "text": "やっぱり…繊細な人(sensitive person)"
    },
    {
      "startSec": 86.7,
      "text": "繊細な人、好きですね。"
    },
    {
      "startSec": 91.8,
      "text": "繊細と言うか、心が豊か。"
    },
    {
      "startSec": 96.9,
      "text": "他の人が感じないことを感じることができる。"
    },
    {
      "startSec": 102.7,
      "text": "例えば、外の景色を見て、"
    },
    {
      "startSec": 107.3,
      "text": "草の素敵なところをわかったりとか"
    },
    {
      "startSec": 113.3,
      "text": "草の綺麗な姿に感動したりとか、何だろう…"
    },
    {
      "startSec": 118.6,
      "text": "映画を見て、他の人があまり気にしないポイントを"
    },
    {
      "startSec": 125.2,
      "text": "「あの映画のシーンは何々だったよね」みたいに"
    },
    {
      "startSec": 129.9,
      "text": "なんかそういうところが私は好きです。"
    },
    {
      "startSec": 137.4,
      "text": "そういう人と話す方が面白いです。"
    },
    {
      "startSec": 142.5,
      "text": "私はちょっと変わってる人が好きです。"
    },
    {
      "startSec": 147,
      "text": "普通の人よりはパッション、"
    },
    {
      "startSec": 151.4,
      "text": "何か好きなことがあって、そのために勉強したり"
    },
    {
      "startSec": 156.5,
      "text": "自分で何かアクションを起こしたりしてる人かな。"
    },
    {
      "startSec": 161.9,
      "text": "まああとは、あまり…何だろう…"
    },
    {
      "startSec": 166.4,
      "text": "マスキュリンで男みたいな人、めっちゃ男"
    },
    {
      "startSec": 170.5,
      "text": "「ターミネーター」の"
    },
    {
      "startSec": 173.2,
      "text": "シュワルツェネッガーさんみたいな"
    },
    {
      "startSec": 177.4,
      "text": "ああいう人じゃなくて"
    },
    {
      "startSec": 180.3,
      "text": "もうちょっとなんだろう"
    },
    {
      "startSec": 182.9,
      "text": "あんまり、めっちゃ男じゃないけど"
    },
    {
      "startSec": 186.4,
      "text": "男と女の間みたいな"
    },
    {
      "startSec": 189.5,
      "text": "どっちの気持ちもちゃんと分かる人"
    },
    {
      "startSec": 192.4,
      "text": "そういう人が私は好きです。"
    },
    {
      "startSec": 199.4,
      "text": "ごめんね、私のタイプばかり話して。"
    },
    {
      "startSec": 202.6,
      "text": "皆さんのタイプはありますか？"
    },
    {
      "startSec": 206.7,
      "text": "最近結構、コメディアン、芸人のビデオを"
    },
    {
      "startSec": 214.2,
      "text": "YouTubeで見たりするんですけど"
    },
    {
      "startSec": 217.5,
      "text": "全部のコメディアンは好きじゃないけど"
    },
    {
      "startSec": 221.2,
      "text": "やっぱりコメディアンって"
    },
    {
      "startSec": 223.7,
      "text": "賢い人が多いなーって思うんです。"
    },
    {
      "startSec": 227.9,
      "text": "本当に話す、スピーキングのプロですよね。"
    },
    {
      "startSec": 232.8,
      "text": "いろんな知識を持っていて"
    },
    {
      "startSec": 235.5,
      "text": "そして人をバカにするんじゃなくて"
    },
    {
      "startSec": 240.2,
      "text": "自分がバカになる、そういうことができる人は"
    },
    {
      "startSec": 245.9,
      "text": "私は尊敬します、好きです。"
    },
    {
      "startSec": 250.2,
      "text": "あの「Singin' in the Rain」のコスモって"
    },
    {
      "startSec": 255.3,
      "text": "キャラクター知ってますか？"
    },
    {
      "startSec": 257.7,
      "text": "Make 'Em Laugh x 3みたいな。"
    },
    {
      "startSec": 261.2,
      "text": "あのコスモのキャラクターは私は好きです。"
    },
    {
      "startSec": 268.3,
      "text": "自分をバカにして、何か変なことをして"
    },
    {
      "startSec": 272.7,
      "text": "人を笑わすことができる人って"
    },
    {
      "startSec": 277.1,
      "text": "なんか素敵だなと思います。"
    },
    {
      "startSec": 281.5,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 284.2,
      "text": "よかったらコメントで教えてください。"
    },
    {
      "startSec": 287.9,
      "text": "好きな人のタイプ。"
    },
    {
      "startSec": 290.1,
      "text": "私、ファッションは好きなので"
    },
    {
      "startSec": 295.4,
      "text": "もし私のパートナーがめっちゃ変な服"
    },
    {
      "startSec": 300.9,
      "text": "めっちゃダサい、汚い服を着ていたら"
    },
    {
      "startSec": 305.3,
      "text": "私は「ちょっとやめて」って言うと思います。"
    },
    {
      "startSec": 309.7,
      "text": "「こっちの方がかっこいいからこっち着て」みたいな。"
    },
    {
      "startSec": 313.7,
      "text": "それは私は言うと思います。"
    },
    {
      "startSec": 318.2,
      "text": "服もトレンドよりはちょっと昔の"
    },
    {
      "startSec": 324.7,
      "text": "ジェントルマンみたいな服が私は好きです。"
    },
    {
      "startSec": 331,
      "text": "今日はすいません、私のタイプをたくさん話して。"
    },
    {
      "startSec": 335.1,
      "text": "でもすごく楽しかったです。"
    },
    {
      "startSec": 338.9,
      "text": "またリクエストあったら"
    },
    {
      "startSec": 341.3,
      "text": "コメントに書いてください。"
    },
    {
      "startSec": 345.2,
      "text": "トランスクリプト、読みたかったら"
    },
    {
      "startSec": 348.8,
      "text": "私のPatreonに入ってください。"
    },
    {
      "startSec": 353.4,
      "text": "今「Japanese IO」というウェブサイトで"
    },
    {
      "startSec": 357,
      "text": "トランスクリプトを書いています。"
    },
    {
      "startSec": 360.3,
      "text": "それはすごく良くて"
    },
    {
      "startSec": 362.2,
      "text": "トランスクリプトの日本語を押したら"
    },
    {
      "startSec": 365.8,
      "text": "ふりがなが出てくるし"
    },
    {
      "startSec": 368.9,
      "text": "英語の意味もすぐ分かるし"
    },
    {
      "startSec": 372.1,
      "text": "本当に便利なトランスクリプトです。"
    },
    {
      "startSec": 376.5,
      "text": "是非使ってください。"
    },
    {
      "startSec": 379.4,
      "text": "今日はここで終わります。"
    },
    {
      "startSec": 382.3,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 384.6,
      "text": "良い一日を！"
    },
    {
      "startSec": 385.6,
      "text": "勉強・お仕事頑張ってください。"
    },
    {
      "startSec": 388.7,
      "text": "じゃあまたね、バイバイ！"
    }
  ]
}
