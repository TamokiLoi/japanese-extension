{
  "episodeId": "nObTFjAvQJM",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.9,
      "text": "私最近、ハマっていることがあります。"
    },
    {
      "startSec": 9.9,
      "text": "それは太陽の光の下にいることです。"
    },
    {
      "startSec": 16.9,
      "text": "光の下でリラックスすることです。"
    },
    {
      "startSec": 21.1,
      "text": "今もう日本では春が来てすごく暖かくなって、"
    },
    {
      "startSec": 28.1,
      "text": "緑も、もうどんどんどんどん成長していて"
    },
    {
      "startSec": 32.5,
      "text": "どんどん周りが緑になって"
    },
    {
      "startSec": 35.7,
      "text": "本当にきれいな季節です。"
    },
    {
      "startSec": 39.5,
      "text": "で、もう外にいることが気持ち良すぎて"
    },
    {
      "startSec": 44.6,
      "text": "最近キャンピングチェアを買いました。"
    },
    {
      "startSec": 49.7,
      "text": "キャンピングチェアを狭いベランダに持っていって"
    },
    {
      "startSec": 54.6,
      "text": "ちょっと仕事で疲れた時とかに"
    },
    {
      "startSec": 58.2,
      "text": "外でこう太陽の光の下に座って"
    },
    {
      "startSec": 62.1,
      "text": "「はぁ～」ってリラックスしています。"
    },
    {
      "startSec": 67.1,
      "text": "温かいお茶とかコーヒーを作って"
    },
    {
      "startSec": 70.5,
      "text": "外で飲んだりとか"
    },
    {
      "startSec": 72.5,
      "text": "もうこれが最近私の一番幸せな時間です。"
    },
    {
      "startSec": 80.4,
      "text": "やっぱり太陽の光って"
    },
    {
      "startSec": 83.7,
      "text": "本当に私達を幸せにしてくれますよね。"
    },
    {
      "startSec": 90.8,
      "text": "結構疲れていたり、色々悩んだり"
    },
    {
      "startSec": 95.4,
      "text": "しんどい時とか、太陽の光を浴びて"
    },
    {
      "startSec": 100.3,
      "text": "自然の音を聞くだけで"
    },
    {
      "startSec": 102.6,
      "text": "本当に私はもう幸せになるんですね。"
    },
    {
      "startSec": 107.4,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 109.6,
      "text": "疲れた時とか、ちょっと休憩したいなぁという時"
    },
    {
      "startSec": 116.5,
      "text": "何をしますか？"
    },
    {
      "startSec": 118.8,
      "text": "私はあったかいコーヒーとか紅茶を作って外に行く"
    },
    {
      "startSec": 124.6,
      "text": "もうこれが最近大好きですね。"
    },
    {
      "startSec": 128.4,
      "text": "で、週末土曜日・日曜日は"
    },
    {
      "startSec": 132.9,
      "text": "よくビーチに、海に行きます最近。"
    },
    {
      "startSec": 138,
      "text": "多分毎週行っていると思います。"
    },
    {
      "startSec": 142.5,
      "text": "私が今住んでいる場所は浅口市という"
    },
    {
      "startSec": 147.6,
      "text": "岡山にある田舎なんですけど"
    },
    {
      "startSec": 151.5,
      "text": "自転車で一時間ぐらい行ったらビーチがあります。"
    },
    {
      "startSec": 157.4,
      "text": "なので、週末はよく自転車に乗ってビーチに行って"
    },
    {
      "startSec": 163.2,
      "text": "で、ビーチのところでおにぎりを食べて"
    },
    {
      "startSec": 168.5,
      "text": "ちょっと目をつぶってリラックスして"
    },
    {
      "startSec": 173.7,
      "text": "帰るみたいな感じです。"
    },
    {
      "startSec": 176.8,
      "text": "本当に最近それが一番いいです。"
    },
    {
      "startSec": 180.7,
      "text": "リラックスできる幸せな時間です。"
    },
    {
      "startSec": 185.3,
      "text": "あとは映画をよく見ます。"
    },
    {
      "startSec": 188.6,
      "text": "最近見たのは…あ、思い出せないけど"
    },
    {
      "startSec": 193.2,
      "text": "古いイギリス映画の『フライト』っていう"
    },
    {
      "startSec": 196.8,
      "text": "『Airplane』かな？忘れた。"
    },
    {
      "startSec": 198.8,
      "text": "コメディのむっちゃ面白いやつを見ました。"
    },
    {
      "startSec": 202.9,
      "text": "それも面白かったし、"
    },
    {
      "startSec": 205.1,
      "text": "『カメラを止めるな！』っていう日本の映画、"
    },
    {
      "startSec": 208.8,
      "text": "あれも面白かった。"
    },
    {
      "startSec": 211.4,
      "text": "で、その前はジャックが見たかったので"
    },
    {
      "startSec": 215.8,
      "text": "『バトル・ロワイヤル』という"
    },
    {
      "startSec": 218.1,
      "text": "すごく怖い映画を観ました。"
    },
    {
      "startSec": 220.9,
      "text": "確か『ハンガー・ゲーム』とかの元、"
    },
    {
      "startSec": 225.4,
      "text": "オリジナルになった映画だと思います。"
    },
    {
      "startSec": 230.1,
      "text": "なんか『イカゲーム(Squid Game)』と"
    },
    {
      "startSec": 233.5,
      "text": "ちょっと似てるなぁと思いました。"
    },
    {
      "startSec": 237.9,
      "text": "『バトル・ロワイアル』は、もう二十年くらい前の"
    },
    {
      "startSec": 241.4,
      "text": "映画だと思うんですけど、"
    },
    {
      "startSec": 244.4,
      "text": "『イカゲーム(Squid Game)』で使われていた音楽が"
    },
    {
      "startSec": 248.4,
      "text": "『バトル・ロワイヤル』で使われていたりとかして"
    },
    {
      "startSec": 253,
      "text": "結構この映画って色んな他の映画に"
    },
    {
      "startSec": 258.9,
      "text": "影響を与えたんだなって思いました。"
    },
    {
      "startSec": 265.1,
      "text": "今日もこの後ちょっと外でリラックスします。"
    },
    {
      "startSec": 269.4,
      "text": "皆さんはこれから仕事ですか？勉強ですか？"
    },
    {
      "startSec": 273.9,
      "text": "また今日も一日、無理しないで頑張ってください。"
    },
    {
      "startSec": 278.3,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 282,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
