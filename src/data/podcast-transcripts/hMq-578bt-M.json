{
  "episodeId": "hMq-578bt-M",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "「日本は男性、男の社会だ」"
    },
    {
      "startSec": 9.9,
      "text": "皆さんこれを聞いてどう思いますか？"
    },
    {
      "startSec": 14.2,
      "text": "最近はフェミニズムの運動もよくありますし、"
    },
    {
      "startSec": 19.6,
      "text": "それを聞いて怒る人も私はいると思うんですよね。"
    },
    {
      "startSec": 25.1,
      "text": "でも特に日本の古い人にとって"
    },
    {
      "startSec": 31.4,
      "text": "男性社会は本当に大切らしいです。"
    },
    {
      "startSec": 35.8,
      "text": "今日はそれについて、日本の男性社会について"
    },
    {
      "startSec": 40,
      "text": "皆さんにちょっと話したいと思います。"
    },
    {
      "startSec": 44.4,
      "text": "でこの話は、私がおばあちゃんから聞いた話です。"
    },
    {
      "startSec": 51,
      "text": "先週おばあちゃんの家に帰って色々話をしました。"
    },
    {
      "startSec": 59,
      "text": "でその時にちょっと結婚の話もしたんですね。"
    },
    {
      "startSec": 64.1,
      "text": "私がちょっとジャックさんと"
    },
    {
      "startSec": 66.6,
      "text": "いつか結婚したいって言ったら"
    },
    {
      "startSec": 70.2,
      "text": "おばあちゃんは今回は"
    },
    {
      "startSec": 72.6,
      "text": "ジャックさんのパーソナリティー、"
    },
    {
      "startSec": 75.3,
      "text": "人柄については何も言わなかったけど"
    },
    {
      "startSec": 80,
      "text": "私が結婚する時のルールかな、"
    },
    {
      "startSec": 84.7,
      "text": "結婚する時に絶対気を付けてほしいこと、"
    },
    {
      "startSec": 90.3,
      "text": "これを教えてくれました。"
    },
    {
      "startSec": 93.9,
      "text": "それは、私は苗字(family name)は井本です。"
    },
    {
      "startSec": 100.3,
      "text": "もし私が男の人と結婚して"
    },
    {
      "startSec": 104.2,
      "text": "この「井本」の苗字を使うなら"
    },
    {
      "startSec": 107.7,
      "text": "つまり男の人が、この私の苗字の"
    },
    {
      "startSec": 111.3,
      "text": "この「井本」の家に来るなら、"
    },
    {
      "startSec": 115.3,
      "text": "気を付けないといけないことがあります。"
    },
    {
      "startSec": 119.5,
      "text": "それは、もしそのまま男の人が"
    },
    {
      "startSec": 123.5,
      "text": "この「井本」の家に来たら"
    },
    {
      "startSec": 126.8,
      "text": "「井本」の家の代表=トップ、"
    },
    {
      "startSec": 131.3,
      "text": "一番…何だろう…偉い人かな。"
    },
    {
      "startSec": 134.9,
      "text": "これは私になるんですね、私がその名字の人だから。"
    },
    {
      "startSec": 140.3,
      "text": "これはつまり、例えば銀行とか土地のこととか"
    },
    {
      "startSec": 147.6,
      "text": "何かとても大切なこと、"
    },
    {
      "startSec": 150.7,
      "text": "国に書類を出さないといけないこと"
    },
    {
      "startSec": 156.5,
      "text": "そういう時は私のサインとハンコが必要になります。"
    },
    {
      "startSec": 163.9,
      "text": "相手の男性、ジャックじゃなくて"
    },
    {
      "startSec": 166.8,
      "text": "私のサインとかが必要になる。"
    },
    {
      "startSec": 170.9,
      "text": "でもおばあちゃんは、"
    },
    {
      "startSec": 172.3,
      "text": "これは絶対にダメと言いました。"
    },
    {
      "startSec": 181.4,
      "text": "理由は日本が男性の社会だから。"
    },
    {
      "startSec": 186.4,
      "text": "特に昔、何十年か前は"
    },
    {
      "startSec": 190.6,
      "text": "やっぱり家のリーダーは男、これが基本。"
    },
    {
      "startSec": 197.6,
      "text": "男じゃないと恥ずかしいかな。"
    },
    {
      "startSec": 202.6,
      "text": "だからおばあちゃんは"
    },
    {
      "startSec": 204.6,
      "text": "これからもし私が色んな他の、会社で働いたりとかして"
    },
    {
      "startSec": 211.4,
      "text": "何か大切な事を決めないといけなくなった時に"
    },
    {
      "startSec": 218.1,
      "text": "私がトップだったら恥ずかしい。"
    },
    {
      "startSec": 220.9,
      "text": "私の夫、旦那にトップでいてもらわないとダメ。"
    },
    {
      "startSec": 228.3,
      "text": "そういうことです。"
    },
    {
      "startSec": 231.9,
      "text": "なので、ここでどうしたらいいかと言うと、"
    },
    {
      "startSec": 237.2,
      "text": "私と、例えばジャックさんが結婚する前に"
    },
    {
      "startSec": 241.6,
      "text": "ジャックさんを私のお父さんの養子(adopted child)"
    },
    {
      "startSec": 251.9,
      "text": "養子にするそうです。"
    },
    {
      "startSec": 254.4,
      "text": "もちろん法律の上で、です。"
    },
    {
      "startSec": 258.1,
      "text": "勿論これでジャックがオーストラリアの家族と"
    },
    {
      "startSec": 262.9,
      "text": "関係がなくなることはないです。"
    },
    {
      "startSec": 268,
      "text": "でも、もしジャックが私のお父さんの養子になって"
    },
    {
      "startSec": 275.1,
      "text": "それから私と結婚をしたら"
    },
    {
      "startSec": 281.1,
      "text": "ジャックさんが、男がこの家のリーダーに"
    },
    {
      "startSec": 285.7,
      "text": "なることができるそうです。"
    },
    {
      "startSec": 288.7,
      "text": "で、おばあちゃんはこれをしないと"
    },
    {
      "startSec": 291.5,
      "text": "絶対に結婚はダメと言いました。"
    },
    {
      "startSec": 299.2,
      "text": "まあびっくりしましたね、私は。"
    },
    {
      "startSec": 303.3,
      "text": "確かに十年くらい前、二十年くらい前は"
    },
    {
      "startSec": 308.5,
      "text": "本当にそういう考えの人が多かったかなと思います。"
    },
    {
      "startSec": 315.5,
      "text": "皆さんはどう思いますか？"
    },
    {
      "startSec": 318,
      "text": "私は誰がトップか、気にするような社会は"
    },
    {
      "startSec": 322.2,
      "text": "本当に苦しいなと思います、正直。"
    },
    {
      "startSec": 327.1,
      "text": "なので日本の家庭、家では"
    },
    {
      "startSec": 330.8,
      "text": "やっぱり特に昔の家庭では"
    },
    {
      "startSec": 334.9,
      "text": "男の人がよく威張っていて"
    },
    {
      "startSec": 337.5,
      "text": "トップでリーダーで、そういう家が多いです。"
    },
    {
      "startSec": 343,
      "text": "で、女の人は料理とか家事をしたり。"
    },
    {
      "startSec": 347.7,
      "text": "でも私のおじいちゃんとおばあちゃんをよく見ると"
    },
    {
      "startSec": 353.6,
      "text": "本当に賢くてみんなをこうまとめて"
    },
    {
      "startSec": 359,
      "text": "一番頑張ってパワーがあるのはおばあちゃんです。"
    },
    {
      "startSec": 364.3,
      "text": "表、表向き人に会う時は"
    },
    {
      "startSec": 369,
      "text": "おじいちゃんがトップに見えるけど"
    },
    {
      "startSec": 372.6,
      "text": "本当は多分おばあちゃんの方が"
    },
    {
      "startSec": 375.7,
      "text": "パワーがあってちょっと賢いですよね。"
    },
    {
      "startSec": 380.1,
      "text": "日本語で「尻に敷かれる」という言葉があります。"
    },
    {
      "startSec": 386.9,
      "text": "尻は、お尻の尻、だから"
    },
    {
      "startSec": 389.5,
      "text": "お尻に敷かれる、お尻の下にある"
    },
    {
      "startSec": 393.8,
      "text": "これはよく「夫が妻の尻に敷かれる」"
    },
    {
      "startSec": 400.9,
      "text": "こういう言い方をする時に使います。"
    },
    {
      "startSec": 405.3,
      "text": "私とジャックなら"
    },
    {
      "startSec": 407.6,
      "text": "「ジャックは私の尻に敷かれています」"
    },
    {
      "startSec": 411.6,
      "text": "意味は私の方が…何だろう、口が強い"
    },
    {
      "startSec": 416.8,
      "text": "ジャックが私のことをよく聞いてくれる、"
    },
    {
      "startSec": 421.2,
      "text": "こういう意味です。"
    },
    {
      "startSec": 423.9,
      "text": "私は女の人が男の人よりもなんか強い、"
    },
    {
      "startSec": 429.1,
      "text": "例えば「男の人が女の人の尻に敷かれている」"
    },
    {
      "startSec": 434.4,
      "text": "この方がかわいくて、バランスが取れて"
    },
    {
      "startSec": 438.7,
      "text": "なんかいいなあと思ったりします。"
    },
    {
      "startSec": 442.2,
      "text": "ちょっとセンシティブなトピックでしたが"
    },
    {
      "startSec": 446.1,
      "text": "良かったら皆さんの意見、"
    },
    {
      "startSec": 449.2,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 451.8,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 454.7,
      "text": "レビューを書いてくれると本当に喜びます。"
    },
    {
      "startSec": 458,
      "text": "お願いします。"
    },
    {
      "startSec": 459.3,
      "text": "じゃあお仕事・勉強頑張ってください。"
    },
    {
      "startSec": 463,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
