{
  "episodeId": "A3mpa9yA61E",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは"
    },
    {
      "startSec": 1.5,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.3,
      "text": "今日はね、ちょっと"
    },
    {
      "startSec": 5.5,
      "text": "ダイエットについて話したいと思います。"
    },
    {
      "startSec": 9,
      "text": "日本語でダイエットと言うと"
    },
    {
      "startSec": 13.3,
      "text": "体重を減らすという意味です。"
    },
    {
      "startSec": 17.7,
      "text": "ダイエットは英語だと"
    },
    {
      "startSec": 20.3,
      "text": "食事の意味もありますよね。"
    },
    {
      "startSec": 23.9,
      "text": "でも日本語で「今ダイエットしてる」と言うと"
    },
    {
      "startSec": 28.1,
      "text": "あまり食べないで体重を減らす"
    },
    {
      "startSec": 31.8,
      "text": "減らそうとしているという意味です。"
    },
    {
      "startSec": 36.9,
      "text": "皆さんはダイエットしたことはありますか？"
    },
    {
      "startSec": 43.5,
      "text": "私はね、今からもう12年くらい前かな。"
    },
    {
      "startSec": 48.4,
      "text": "私が何歳？12歳、13歳くらいの時に"
    },
    {
      "startSec": 53.8,
      "text": "もうすっごくヤバイダイエットをしたことがあります。"
    },
    {
      "startSec": 59.8,
      "text": "その時はね、15キロやせました。"
    },
    {
      "startSec": 65.7,
      "text": "体重は、35キロになりました。"
    },
    {
      "startSec": 70.5,
      "text": "私の身長、背は今大体154cmぐらいなので"
    },
    {
      "startSec": 77.3,
      "text": "まあ35キロはヤバイですよね。"
    },
    {
      "startSec": 81.5,
      "text": "まあ、その時の理由とかを"
    },
    {
      "startSec": 84.4,
      "text": "ちょっと皆さんと話したいと思います。"
    },
    {
      "startSec": 88.1,
      "text": "何でダイエットを始めたかと言うと"
    },
    {
      "startSec": 92.3,
      "text": "私は小学生の時はちょっとぽっちゃりでした。"
    },
    {
      "startSec": 99.4,
      "text": "正直、今と全然体重は変わっていません。"
    },
    {
      "startSec": 105.3,
      "text": "でも私の周りの友達が"
    },
    {
      "startSec": 110,
      "text": "やせている友達が多かったです。"
    },
    {
      "startSec": 113.3,
      "text": "すっごくやせてる、skinnyな友達ね。"
    },
    {
      "startSec": 116.8,
      "text": "なので、よく「太ってるなあ」って"
    },
    {
      "startSec": 122.1,
      "text": "みんなから言われていました。"
    },
    {
      "startSec": 126.3,
      "text": "私はね、すごくそれを気にしていて"
    },
    {
      "startSec": 131.6,
      "text": "中学校に入った時、入る少し前に"
    },
    {
      "startSec": 136.4,
      "text": "ダイエットを始めました。"
    },
    {
      "startSec": 139.7,
      "text": "その時は、もう毎日しっかり運動してジョギングして"
    },
    {
      "startSec": 146.9,
      "text": "カロリーの計算もしていました。"
    },
    {
      "startSec": 150.5,
      "text": "最初はね、ちょっとカロリーを少なくしただけだけど"
    },
    {
      "startSec": 158.7,
      "text": "もうどんどんどんどん、食べる食事の量(amount)"
    },
    {
      "startSec": 165.4,
      "text": "量を減らしてしまって。"
    },
    {
      "startSec": 168.6,
      "text": "で…ヤバイね。"
    },
    {
      "startSec": 171.7,
      "text": "私が40キロ、35キロになった時は"
    },
    {
      "startSec": 178.1,
      "text": "多分一日に、400カロリーくらいしか"
    },
    {
      "startSec": 183,
      "text": "食べていなかったと思います。"
    },
    {
      "startSec": 186.8,
      "text": "プラス毎日ジョギングをして、クラブの活動"
    },
    {
      "startSec": 194.7,
      "text": "その時は私は、バレーボールクラブに入っていたので"
    },
    {
      "startSec": 199.4,
      "text": "学校でバレーボールを1時間、2時間毎日して"
    },
    {
      "startSec": 205.2,
      "text": "家に帰ってジョギングをしていました。"
    },
    {
      "startSec": 208.6,
      "text": "でも400カロリーしか食べなかった。"
    },
    {
      "startSec": 212.7,
      "text": "でね、ヤバいんだけどその時の私は"
    },
    {
      "startSec": 217.6,
      "text": "まだ太っていると思っていたんですよね。"
    },
    {
      "startSec": 222.8,
      "text": "うん、35キロで自分は太ってると思っていました。"
    },
    {
      "startSec": 228.3,
      "text": "もう本当に心が、"
    },
    {
      "startSec": 230.9,
      "text": "もう本当に病気になっていましたね。"
    },
    {
      "startSec": 234.1,
      "text": "でもある日、なんか"
    },
    {
      "startSec": 237.1,
      "text": "「あ、私このままだったら死ぬかもしれない」って"
    },
    {
      "startSec": 245.6,
      "text": "思いました。"
    },
    {
      "startSec": 247.1,
      "text": "でその日から突然(suddenly)"
    },
    {
      "startSec": 252.3,
      "text": "急にご飯を食べることができるようになりました。"
    },
    {
      "startSec": 259.3,
      "text": "なのでね、私はもう大体半年、6ヶ月の間に"
    },
    {
      "startSec": 264.7,
      "text": "15キロやせて35キロになって"
    },
    {
      "startSec": 269.3,
      "text": "もう本当にね"
    },
    {
      "startSec": 270.3,
      "text": "髪も本当にパサパサ・ボロボロ、悪くなったし"
    },
    {
      "startSec": 274.9,
      "text": "走ることも全然できなくなったし"
    },
    {
      "startSec": 278.1,
      "text": "もうヤバイ時がありました。"
    },
    {
      "startSec": 282.9,
      "text": "でも今はもう元気になって"
    },
    {
      "startSec": 286.8,
      "text": "もう10年も前の話なのでね。"
    },
    {
      "startSec": 289.8,
      "text": "今はもう元気だし、たくさん食べるし"
    },
    {
      "startSec": 294.2,
      "text": "ウォーキングも毎日するし"
    },
    {
      "startSec": 297.1,
      "text": "体重も今はもう50キロくらいになって"
    },
    {
      "startSec": 300.5,
      "text": "ハッピーな毎日です。"
    },
    {
      "startSec": 303.8,
      "text": "でもねやっぱりダイエットは危険ですよね。"
    },
    {
      "startSec": 309.2,
      "text": "危ない、うん。"
    },
    {
      "startSec": 311,
      "text": "皆さんも、もしダイエットしたいと思っているなら"
    },
    {
      "startSec": 315.6,
      "text": "気を付けてくださいね。"
    },
    {
      "startSec": 317.6,
      "text": "やっぱりやせてることがいいっていうのは"
    },
    {
      "startSec": 321.6,
      "text": "私は違うと思います。"
    },
    {
      "startSec": 324,
      "text": "その人にはその人に合った"
    },
    {
      "startSec": 327.1,
      "text": "パーフェクトな体重があります。"
    },
    {
      "startSec": 329.8,
      "text": "それはもう普通の人よりは"
    },
    {
      "startSec": 333,
      "text": "重いかもしれないし軽いかもしれない。"
    },
    {
      "startSec": 336.2,
      "text": "でもね、そんなのね"
    },
    {
      "startSec": 338.3,
      "text": "他の人の意見なんて聞かないで。"
    },
    {
      "startSec": 342.1,
      "text": "ぜひ皆さんが一番ハッピーでいることができる"
    },
    {
      "startSec": 347.8,
      "text": "体重を見つけて"
    },
    {
      "startSec": 349.9,
      "text": "ぜひ、おいしいご飯をたくさん食べて"
    },
    {
      "startSec": 353.4,
      "text": "たくさん笑って"
    },
    {
      "startSec": 355.3,
      "text": "ハッピーな毎日にしてください。"
    },
    {
      "startSec": 359.1,
      "text": "やっぱり美味しいご飯は、毎日食べたいですよね。"
    },
    {
      "startSec": 366.6,
      "text": "今日の話はこんな感じです。"
    },
    {
      "startSec": 368.9,
      "text": "もし何かリクエストとかあったら"
    },
    {
      "startSec": 371.8,
      "text": "ぜひコメントで教えてください。"
    },
    {
      "startSec": 374.7,
      "text": "あのPatreonでは、このポッドキャストのサブタイトル"
    },
    {
      "startSec": 379.8,
      "text": "あ、ごめんトランスクリプトに"
    },
    {
      "startSec": 383.1,
      "text": "漢字にふりがなを付けて"
    },
    {
      "startSec": 385.9,
      "text": "PDFで皆さんとシェアしています。"
    },
    {
      "startSec": 389.5,
      "text": "もしね、漢字の読み方が難しいなと思ったら"
    },
    {
      "startSec": 394.3,
      "text": "Patreonもチェックしてみてください。"
    },
    {
      "startSec": 397.8,
      "text": "じゃあ今日はこんな感じで終わります。"
    },
    {
      "startSec": 400.4,
      "text": "いつもありがとう！"
    },
    {
      "startSec": 401.3,
      "text": "本当に良い一日を！バイバイ！"
    }
  ]
}
