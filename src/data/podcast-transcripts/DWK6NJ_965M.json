{
  "episodeId": "DWK6NJ_965M",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.4,
      "text": "今日は私の友達の話をしたいと思います。"
    },
    {
      "startSec": 10.8,
      "text": "結構私、友達を選ぶのがうまいと"
    },
    {
      "startSec": 16.3,
      "text": "自分で思うんですよね。"
    },
    {
      "startSec": 18.4,
      "text": "こういうことを言うと、ちょっとすごく上から目線の"
    },
    {
      "startSec": 23.7,
      "text": "嫌な人みたいな感じですが、"
    },
    {
      "startSec": 26.9,
      "text": "友達を「あの人は嫌い」「あの人はいや」"
    },
    {
      "startSec": 29.7,
      "text": "「この人はいい」みたいに"
    },
    {
      "startSec": 32.1,
      "text": "選んでるっていう意味じゃなくて"
    },
    {
      "startSec": 35.9,
      "text": "もっと…自分が好きになる友達が"
    },
    {
      "startSec": 42.6,
      "text": "本当に自分と同じような価値観"
    },
    {
      "startSec": 47.6,
      "text": "価値観(view, value)、価値観があったり"
    },
    {
      "startSec": 54.1,
      "text": "本当に心から尊敬できたり"
    },
    {
      "startSec": 58.3,
      "text": "ずっと長く連絡をすることができたり"
    },
    {
      "startSec": 64.4,
      "text": "本当にいい友達が多いと思うんです。"
    },
    {
      "startSec": 70.9,
      "text": "でも数は少ない、すごく少ない。"
    },
    {
      "startSec": 74.4,
      "text": "多分…五人いるかな？っていうくらい少ないです。"
    },
    {
      "startSec": 82.8,
      "text": "で、なんで今日この友達のエピソード作ろうかなと"
    },
    {
      "startSec": 89.2,
      "text": "思ったかと言うと"
    },
    {
      "startSec": 91.6,
      "text": "昨日古い友達から電話があって"
    },
    {
      "startSec": 96.5,
      "text": "その子とはもう一年くらい"
    },
    {
      "startSec": 99.6,
      "text": "話していなかったんですけど、昨日電話をくれて。"
    },
    {
      "startSec": 105.6,
      "text": "で、電話の話は、"
    },
    {
      "startSec": 109.9,
      "text": "「レイちゃん、私ちょっと小学生からの夢だった"
    },
    {
      "startSec": 114.9,
      "text": "パン屋さんをやりたいと思ってるから"
    },
    {
      "startSec": 118.1,
      "text": "まあちょっとお願いしたいことがあるんだけど"
    },
    {
      "startSec": 121.2,
      "text": "いいかな？」っていう内容でした。"
    },
    {
      "startSec": 125.5,
      "text": "彼女も私と同い年、"
    },
    {
      "startSec": 130.2,
      "text": "同じ年は「おない年」「おない」と言います。"
    },
    {
      "startSec": 135.3,
      "text": "同じ(おなじ)じゃなくて、同い(おない)年。"
    },
    {
      "startSec": 138.9,
      "text": "彼女も同い年で、で自分で会社じゃなくて"
    },
    {
      "startSec": 143.8,
      "text": "自分のパッションをちゃんと持っていて"
    },
    {
      "startSec": 148.3,
      "text": "パン屋さんを自分で作りたいと思って"
    },
    {
      "startSec": 152.3,
      "text": "そのためにもう色々始めているんですよね。"
    },
    {
      "startSec": 157,
      "text": "もう私すっごく嬉しくて"
    },
    {
      "startSec": 159.9,
      "text": "そうやって自分の意見があって"
    },
    {
      "startSec": 163.5,
      "text": "自分のパッションをちゃんと理解していて、"
    },
    {
      "startSec": 168.5,
      "text": "それに向けて真面目に頑張ることができる友達、"
    },
    {
      "startSec": 174.2,
      "text": "もう私は本当にすごいなと思って、尊敬して"
    },
    {
      "startSec": 178.9,
      "text": "すっごく嬉しかったです。"
    },
    {
      "startSec": 182.8,
      "text": "結構私の友達で"
    },
    {
      "startSec": 186.2,
      "text": "自分でビジネスを作りたいと思っている子とか"
    },
    {
      "startSec": 190.6,
      "text": "外国人の彼氏・彼女がいる子はすごく多いです。"
    },
    {
      "startSec": 195.8,
      "text": "で、もう一人私のすごく仲がいい"
    },
    {
      "startSec": 200.1,
      "text": "私が大好きな友達は、自分でカフェをしたいらしくて"
    },
    {
      "startSec": 206.9,
      "text": "今は少しずつアルバイトをしながら"
    },
    {
      "startSec": 211.1,
      "text": "カフェ、料理の勉強とかすごく頑張っています。"
    },
    {
      "startSec": 217.2,
      "text": "でもう一人私の友達、"
    },
    {
      "startSec": 219.8,
      "text": "これは私の先生の娘さんなんですけど"
    },
    {
      "startSec": 223.8,
      "text": "彼女もビジネスに興味があって"
    },
    {
      "startSec": 227,
      "text": "すごく色々勉強していたけど、"
    },
    {
      "startSec": 230.9,
      "text": "今は小学校の先生になって子供達に色々教えています。"
    },
    {
      "startSec": 237.8,
      "text": "私は友達のこと、みんなのことを"
    },
    {
      "startSec": 240.7,
      "text": "すごく尊敬していて、本当に。"
    },
    {
      "startSec": 244.6,
      "text": "でもなんかそういう友達に共通点、"
    },
    {
      "startSec": 249.6,
      "text": "共通点(to have something in common)"
    },
    {
      "startSec": 253.3,
      "text": "共通点があると思います。"
    },
    {
      "startSec": 256.5,
      "text": "やっぱりみんな自分の意見をしっかり持っていて"
    },
    {
      "startSec": 262.5,
      "text": "で、他の人の事をあまり気にしないですね。"
    },
    {
      "startSec": 267.5,
      "text": "いつもたくさんの人のグループの中にいないと"
    },
    {
      "startSec": 272.5,
      "text": "自分で一人で行動ができない子ってよくいますよね。"
    },
    {
      "startSec": 280.3,
      "text": "私はちょっとそういう人が苦手で、"
    },
    {
      "startSec": 283.7,
      "text": "私が好きな人は、もう他の人のことは気にしないで"
    },
    {
      "startSec": 288.5,
      "text": "自分の意見を持ってちゃんと、"
    },
    {
      "startSec": 291.8,
      "text": "自分がいいと思うことをできる人が"
    },
    {
      "startSec": 296.4,
      "text": "すごく好きで、すごく尊敬します。"
    },
    {
      "startSec": 302.6,
      "text": "ま、これかな、もうこれ、"
    },
    {
      "startSec": 304.3,
      "text": "これが本当に私の好きな人の共通点"
    },
    {
      "startSec": 308.6,
      "text": "だと思う、本当にそう思う。"
    },
    {
      "startSec": 310.9,
      "text": "まあ皆さんはどんな人が好きですか？"
    },
    {
      "startSec": 314.2,
      "text": "どんな人と友達になりたいですか？"
    },
    {
      "startSec": 319.3,
      "text": "私の父から聞いたんですけど"
    },
    {
      "startSec": 322.6,
      "text": "私のお母さんは、友達を選ぶ時は"
    },
    {
      "startSec": 327.9,
      "text": "その友達が家族のことを"
    },
    {
      "startSec": 332.5,
      "text": "すごく大切にしているかどうか"
    },
    {
      "startSec": 337.9,
      "text": "これを一番、よく気にしていたと私は聞きました。"
    },
    {
      "startSec": 343.3,
      "text": "やっぱり家族をすごく大切にできる人は"
    },
    {
      "startSec": 348.1,
      "text": "友達でグループを作って"
    },
    {
      "startSec": 350.6,
      "text": "友達を中心に行動しないで"
    },
    {
      "startSec": 355.2,
      "text": "自分や家族のために頑張る人が多いので、"
    },
    {
      "startSec": 359.3,
      "text": "だからお母さんは、家族を大切にする人が"
    },
    {
      "startSec": 364.1,
      "text": "好きだったんだと思います。"
    },
    {
      "startSec": 368.5,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 370.5,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 374,
      "text": "リクエストとか質問とか、感想、レビューがあったら"
    },
    {
      "startSec": 378.9,
      "text": "是非YouTubeのコメントで教えてください。"
    },
    {
      "startSec": 383.1,
      "text": "いつも本当にありがとうございます。"
    },
    {
      "startSec": 385.4,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 388.1,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
