{
  "episodeId": "beVlcsAi6Qk",
  "segments": [
    {
      "startSec": 2.3,
      "text": "はい皆さん、こんにちは"
    },
    {
      "startSec": 3.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 6.3,
      "text": "昨日は嬉しい、感謝、"
    },
    {
      "startSec": 10.7,
      "text": "ありがとうの気持ちを表す日本語教えました。"
    },
    {
      "startSec": 15.9,
      "text": "今日は怒った時の、イライラした時の"
    },
    {
      "startSec": 21.6,
      "text": "フレーズを教えたいと思います。"
    },
    {
      "startSec": 24.8,
      "text": "結構たくさんあります。"
    },
    {
      "startSec": 28,
      "text": "是非楽しんで、エピソードを聞いて"
    },
    {
      "startSec": 32.1,
      "text": "もっと日本語が上手に使えるようになってください。"
    },
    {
      "startSec": 37.6,
      "text": "はい、じゃあいきましょう！"
    },
    {
      "startSec": 41.5,
      "text": "最初のフレーズは「何それ？」「え、何それ？」です。"
    },
    {
      "startSec": 50,
      "text": "「何、それ？」(What's that?)"
    },
    {
      "startSec": 53.6,
      "text": "これはイントネーションが大切。"
    },
    {
      "startSec": 56.3,
      "text": "「何、それ？↘」「これは、それは何？何ですか？」"
    },
    {
      "startSec": 61.8,
      "text": "普通の質問ですよね。"
    },
    {
      "startSec": 65.1,
      "text": "でも「何それ？↗」って言ったら怒ってる"
    },
    {
      "startSec": 70.9,
      "text": "Like「What's that!? I can't believe it!!」みたいな感じです"
    },
    {
      "startSec": 76.9,
      "text": "例えば、私は結構、雑、大雑把、"
    },
    {
      "startSec": 84.6,
      "text": "つまり小さいことは気にしない性格です。"
    },
    {
      "startSec": 91.3,
      "text": "だから結構、食器を洗う時にちゃんと洗わないです。"
    },
    {
      "startSec": 100,
      "text": "で食器を洗った後に、その食器にまだ"
    },
    {
      "startSec": 105.1,
      "text": "ご飯がついていることがあります。"
    },
    {
      "startSec": 109.3,
      "text": "それを見た私の彼氏が「レイラ、何それ？」みたいな"
    },
    {
      "startSec": 115.3,
      "text": "こんな感じで使えます。"
    },
    {
      "startSec": 117.3,
      "text": "「レイラ、何それ、まだご飯付いてるよ」みたいな感じです。"
    },
    {
      "startSec": 123.5,
      "text": "私は関西弁を話します。京都出身です。"
    },
    {
      "startSec": 129.7,
      "text": "京都では「何なん？」と言います。"
    },
    {
      "startSec": 133.6,
      "text": "「何それ？」よりも「え、何なん？」「は？何なん？」って"
    },
    {
      "startSec": 139.6,
      "text": "「何なん」多分「何なの？」が"
    },
    {
      "startSec": 143.7,
      "text": "「何なん？」になったと思います。"
    },
    {
      "startSec": 147.2,
      "text": "じゃあ次、二つ目のフレーズは「イラッとする」です。"
    },
    {
      "startSec": 152.8,
      "text": "イライラする(to be annoyed)、イラッとするです。"
    },
    {
      "startSec": 157.5,
      "text": "最近すごくイラっとしたことがあって"
    },
    {
      "startSec": 162,
      "text": "それは京都にある、バーに行った時のお話です。"
    },
    {
      "startSec": 168,
      "text": "清水五条かな、清水を歩いていた時に"
    },
    {
      "startSec": 173.2,
      "text": "お腹が空いていました。"
    },
    {
      "startSec": 175.8,
      "text": "夜の六時くらいで、お腹空いていて"
    },
    {
      "startSec": 180.6,
      "text": "でもジャックはお酒も飲みたかった。"
    },
    {
      "startSec": 185.6,
      "text": "で、バーのポスターを見つけました。"
    },
    {
      "startSec": 190.9,
      "text": "でそのポスターに、"
    },
    {
      "startSec": 192.7,
      "text": "ピザとかウィンナーとかの写真も載っていました。"
    },
    {
      "startSec": 198.1,
      "text": "そのポスターの真ん中に"
    },
    {
      "startSec": 200.5,
      "text": "ハッピーアワーはお昼の時間で"
    },
    {
      "startSec": 204,
      "text": "その時はドリンクとお酒と食べ物、"
    },
    {
      "startSec": 208.5,
      "text": "千円でサービスしますっていうポスター。"
    },
    {
      "startSec": 212.8,
      "text": "でそれを見て「あ、お酒も飲めるし、ご飯も食べれるな」"
    },
    {
      "startSec": 219.4,
      "text": "と思ってバーに行きました。"
    },
    {
      "startSec": 223.7,
      "text": "でも、そのバーに入るとご飯のメニューがなかったです。"
    },
    {
      "startSec": 233.3,
      "text": "で、ウエイトレスさんに、"
    },
    {
      "startSec": 235.8,
      "text": "「すみません、ご飯のメニューありますか？」って聞いたら"
    },
    {
      "startSec": 242.9,
      "text": "「ここバーですよ、ご飯屋さんじゃないです。"
    },
    {
      "startSec": 247.1,
      "text": "レストランじゃないです」って言われました。"
    },
    {
      "startSec": 252,
      "text": "めっちゃイラッとしました。"
    },
    {
      "startSec": 253.7,
      "text": "だってポスターに、食べ物の写真があったから"
    },
    {
      "startSec": 260.1,
      "text": "お昼にピザとかウィンナーをサービスしてるバーなんだから"
    },
    {
      "startSec": 266.4,
      "text": "お酒だけをサービスしてる訳じゃないし。"
    },
    {
      "startSec": 271.7,
      "text": "すごくバカにされました(He made fun of me)。"
    },
    {
      "startSec": 277.7,
      "text": "だから私はめっちゃイラッとしました。"
    },
    {
      "startSec": 280.8,
      "text": "じゃあ、あのポスターやめてって"
    },
    {
      "startSec": 283.8,
      "text": "すごく分かりにくいポスターでした。"
    },
    {
      "startSec": 287.9,
      "text": "もしご飯がお昼の時間だけだったら"
    },
    {
      "startSec": 293.1,
      "text": "ちゃんとそれをポスターに書かないと分からないです。"
    },
    {
      "startSec": 299.4,
      "text": "だから私はすごくイラッとして帰りました。"
    },
    {
      "startSec": 306.3,
      "text": "次、三つ目のフレーズです。"
    },
    {
      "startSec": 308.7,
      "text": "これは「よく言うなぁ」「よくゆうなぁ」"
    },
    {
      "startSec": 313.2,
      "text": "言うは、言う(to say)の違う発音です。"
    },
    {
      "startSec": 319.8,
      "text": "英語ではWho's talking, Don't make me laughです。"
    },
    {
      "startSec": 325.1,
      "text": "「よく言う」ちょっと皮肉(sarcasm)みたいな感じです."
    },
    {
      "startSec": 332,
      "text": "例えばジャックが私に、"
    },
    {
      "startSec": 335.4,
      "text": "「レイラ、ちゃんと掃除して」と言いました。"
    },
    {
      "startSec": 342.6,
      "text": "すると私は、"
    },
    {
      "startSec": 344.3,
      "text": "「いやいやいや、よく言うな。ジャックも掃除してないやん」"
    },
    {
      "startSec": 349.3,
      "text": "Like「ジャックも掃除してないでしょ」みたいに使います。"
    },
    {
      "startSec": 354.8,
      "text": "「よく言うなぁ、じゃあ言わんといて。言わないで。」"
    },
    {
      "startSec": 359.2,
      "text": "みたいな感じです。"
    },
    {
      "startSec": 360.8,
      "text": "で、次のフレーズは、"
    },
    {
      "startSec": 362.8,
      "text": "「それはない」「これはない」「あれはない」"
    },
    {
      "startSec": 367.9,
      "text": "どれでもいいです。"
    },
    {
      "startSec": 369.5,
      "text": "意味は「もう絶対ない」"
    },
    {
      "startSec": 372.8,
      "text": "「絶対ありえない(definitely not)」という意味です。"
    },
    {
      "startSec": 379.2,
      "text": "例えば友達Aちゃん、Aちゃんがアルバイトに一回遅れました。"
    },
    {
      "startSec": 388.4,
      "text": "一回遅れただけなのに、クビにされました。"
    },
    {
      "startSec": 395.3,
      "text": "クビにされる(to get fired)"
    },
    {
      "startSec": 398.9,
      "text": "クビにする、クビにされる。"
    },
    {
      "startSec": 402,
      "text": "でも一回遅れただけなのに、それはおかしいです。"
    },
    {
      "startSec": 409.1,
      "text": "よくないです。"
    },
    {
      "startSec": 410.9,
      "text": "じゃあ、あなたは「えっ！それはないでしょう」"
    },
    {
      "startSec": 415.8,
      "text": "「それはダメでしょ」みたいに使えます。"
    },
    {
      "startSec": 420.1,
      "text": "「それはないでしょう、意味わからん」"
    },
    {
      "startSec": 425.8,
      "text": "「意味わからん」これが最後のフレーズです。"
    },
    {
      "startSec": 429.2,
      "text": "意味が分からない、意味わからん(That doesn't make sense)"
    },
    {
      "startSec": 437.7,
      "text": "「意味わからんわ」みたいな感じ。"
    },
    {
      "startSec": 441.8,
      "text": "よく私が高校の時にクラスメートが使っていました"
    },
    {
      "startSec": 449.3,
      "text": "「あの先生、意味わからんなぁ」「あの先生意味わからんわ」"
    },
    {
      "startSec": 455.6,
      "text": "よく生徒を怒る先生に「あの先生意味わからんわ」"
    },
    {
      "startSec": 462.9,
      "text": "みたいに使っていました。"
    },
    {
      "startSec": 465.9,
      "text": "怒った時フレーズ、今日はたくさん紹介しました。"
    },
    {
      "startSec": 471.7,
      "text": "「何それ、何なん」と「イラッとする」「よく言うなあ」"
    },
    {
      "startSec": 480.2,
      "text": "「それはない」「意味わからん」"
    },
    {
      "startSec": 485.7,
      "text": "どれもよく使います。"
    },
    {
      "startSec": 488.8,
      "text": "是非皆さんも会話で使ってみてください。"
    },
    {
      "startSec": 493.4,
      "text": "リスニングの練習、いつも頑張ってえらいです。"
    },
    {
      "startSec": 498.8,
      "text": "これからも毎日このポッドキャストを聞いて"
    },
    {
      "startSec": 503.3,
      "text": "皆さんの日本語をどんどんどんどん良くしてください。"
    },
    {
      "startSec": 509,
      "text": "じゃあ今日はここで終わります。"
    },
    {
      "startSec": 511.2,
      "text": "いつもありがとう。"
    },
    {
      "startSec": 512.5,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
