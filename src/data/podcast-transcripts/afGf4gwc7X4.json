{
  "episodeId": "afGf4gwc7X4",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.4,
      "text": "今日は、私の好きな映画の話をしたいと思います。"
    },
    {
      "startSec": 10.5,
      "text": "昨日のエピソードでTSUTAYAで"
    },
    {
      "startSec": 14,
      "text": "映画のDVDをレンタルするのが"
    },
    {
      "startSec": 18.1,
      "text": "私の楽しみ、趣味だったみたいな話をしました。"
    },
    {
      "startSec": 25.1,
      "text": "で、今日は私の好きな映画を"
    },
    {
      "startSec": 28,
      "text": "皆さんに紹介したいと思います。"
    },
    {
      "startSec": 31.6,
      "text": "正直たくさんあって選べなくて、で、結構忘れてる。"
    },
    {
      "startSec": 38.2,
      "text": "今思い出せない映画もすごくたくさんあると思います。"
    },
    {
      "startSec": 44.3,
      "text": "でもとりあえずちょっとリストを作ってみました。"
    },
    {
      "startSec": 48.8,
      "text": "ちょっと皆さんに紹介しますが、"
    },
    {
      "startSec": 52.1,
      "text": "これだけが「私が好きな映画」とは"
    },
    {
      "startSec": 57.1,
      "text": "思わないでください。"
    },
    {
      "startSec": 59.1,
      "text": "もっと他に好きな映画、"
    },
    {
      "startSec": 61.3,
      "text": "好きなジャンルたくさんあります。"
    },
    {
      "startSec": 64.1,
      "text": "これは本当に、もう例(exapmle)です。"
    },
    {
      "startSec": 68.6,
      "text": "だからそういう感じで聞いてください。"
    },
    {
      "startSec": 72,
      "text": "じゃあ好きな映画一つ目「シザーハンズ」"
    },
    {
      "startSec": 79.1,
      "text": "これ泣けるよね。"
    },
    {
      "startSec": 80.9,
      "text": "本当にもう今考えただけで涙が出そう。"
    },
    {
      "startSec": 84.9,
      "text": "本当に大好きな映画。"
    },
    {
      "startSec": 88.1,
      "text": "心が温かくなりますよね。"
    },
    {
      "startSec": 91.8,
      "text": "スタイルもすごく好き。"
    },
    {
      "startSec": 94.4,
      "text": "ちょっとユニークで、エドワードね。"
    },
    {
      "startSec": 97.3,
      "text": "本当に彼の優しい心、本当にもう何て言うんだろう、"
    },
    {
      "startSec": 103.1,
      "text": "ちょっと悲しくなる、切なくなる。"
    },
    {
      "startSec": 105.9,
      "text": "大好きな映画です。"
    },
    {
      "startSec": 108,
      "text": "あんまりちょっと時間がないので"
    },
    {
      "startSec": 112,
      "text": "サラっとリスト、言います。"
    },
    {
      "startSec": 116.4,
      "text": "そして「ビック・フィッシュ」これも大好き。"
    },
    {
      "startSec": 120,
      "text": "やっぱりユニークで面白いしスタイルがいいですね。"
    },
    {
      "startSec": 125.1,
      "text": "見たことありますか？"
    },
    {
      "startSec": 127.6,
      "text": "皆さんもコメントで好きな映画とか"
    },
    {
      "startSec": 131.9,
      "text": "良かったら教えてください。"
    },
    {
      "startSec": 135.3,
      "text": "そして次「アメリ」"
    },
    {
      "startSec": 139.2,
      "text": "「アメリ」大好きです。"
    },
    {
      "startSec": 140.5,
      "text": "やっぱりそのスタイルが好き。"
    },
    {
      "startSec": 144.1,
      "text": "やっぱり彼女もちょっと変わっていて"
    },
    {
      "startSec": 148.9,
      "text": "ちょっと変なところがあって"
    },
    {
      "startSec": 151.8,
      "text": "それが何だろう…愛おしい。"
    },
    {
      "startSec": 155.7,
      "text": "愛おしいって英語で難しいな。"
    },
    {
      "startSec": 159.1,
      "text": "愛おしいは、何か本当に好きだけど"
    },
    {
      "startSec": 163.4,
      "text": "その彼女が、アメリが頑張っているのが好き。"
    },
    {
      "startSec": 169.1,
      "text": "何だろう？"
    },
    {
      "startSec": 170.2,
      "text": "健気、ちょっと調べてください。"
    },
    {
      "startSec": 172.7,
      "text": "健気(amirable)で愛おしい(adorable)"
    },
    {
      "startSec": 174.9,
      "text": "もうとりあえずね大好きなんです。"
    },
    {
      "startSec": 177.6,
      "text": "で、多分皆さんここまで聞いて"
    },
    {
      "startSec": 179.8,
      "text": "私が好きなスタイルわかったかなと思います。"
    },
    {
      "startSec": 185.3,
      "text": "こういうとちょっと変わっていて"
    },
    {
      "startSec": 188.8,
      "text": "そしてアーティスティックでユニークで"
    },
    {
      "startSec": 193.2,
      "text": "心が優しい話が好きです。"
    },
    {
      "startSec": 198.5,
      "text": "「キンキーブーツ」これも大好き。"
    },
    {
      "startSec": 201.5,
      "text": "黒人のちょっとゲイのお兄さんが頑張って"
    },
    {
      "startSec": 205.1,
      "text": "靴、みんなで一緒に作る話、これも涙が出ますね。"
    },
    {
      "startSec": 211.3,
      "text": "であと…「レオン」"
    },
    {
      "startSec": 215.1,
      "text": "イタリア人の鼻が高い俳優さんと"
    },
    {
      "startSec": 220.7,
      "text": "あとナタリー・ポートマンの小さい時ね。"
    },
    {
      "startSec": 224.3,
      "text": "こういう、何だろう"
    },
    {
      "startSec": 228.5,
      "text": "殺し屋の男の人、年上の男の人、"
    },
    {
      "startSec": 234.2,
      "text": "そしてすごく小さい女の子。"
    },
    {
      "startSec": 237,
      "text": "これギャップがすごくありますよね。"
    },
    {
      "startSec": 240.1,
      "text": "私こういうギャップが大好きなんです。"
    },
    {
      "startSec": 244.9,
      "text": "だから例えば違う種(species)"
    },
    {
      "startSec": 249.7,
      "text": "違う種のラブストーリーとか大好き。"
    },
    {
      "startSec": 254.1,
      "text": "人間とエルフの恋とか、人間と犬、動物の愛とか"
    },
    {
      "startSec": 263.4,
      "text": "そういうのがすごく好きですね。"
    },
    {
      "startSec": 267.4,
      "text": "で、あとは「ビフォア・サンライズ」"
    },
    {
      "startSec": 271.2,
      "text": "これも素敵。"
    },
    {
      "startSec": 273.6,
      "text": "とても素敵な二人、恋人の一日のストーリーね。"
    },
    {
      "startSec": 279.6,
      "text": "大好き。"
    },
    {
      "startSec": 280.7,
      "text": "そしてこれは古い映画です。"
    },
    {
      "startSec": 284.5,
      "text": "「ペーパー・ムーン」見たことありますか？"
    },
    {
      "startSec": 288.3,
      "text": "これもレオンみたいに泥棒、"
    },
    {
      "startSec": 292,
      "text": "Thiefと若い小さい女の子の優しい話。"
    },
    {
      "startSec": 299.2,
      "text": "あとは古い映画なら…"
    },
    {
      "startSec": 304.9,
      "text": "「Singn' in the Rain」かな？"
    },
    {
      "startSec": 307.2,
      "text": "英語のタイトル合ってる？"
    },
    {
      "startSec": 309.6,
      "text": "「雨に唄えば」日本語のタイトルです。"
    },
    {
      "startSec": 315.1,
      "text": "あれは本当にもう心が温かくなる"
    },
    {
      "startSec": 318.9,
      "text": "ミュージカルですよね。"
    },
    {
      "startSec": 321.8,
      "text": "であとは「ショコラ」"
    },
    {
      "startSec": 324.1,
      "text": "「ショコラ」英語のタイトルなんだっけ？"
    },
    {
      "startSec": 326.6,
      "text": "ショコラじゃなくって…"
    },
    {
      "startSec": 331,
      "text": "ジョニー・デップと"
    },
    {
      "startSec": 332.8,
      "text": "あとチョコレートを作る女の人の話。"
    },
    {
      "startSec": 337.3,
      "text": "あれも素敵。"
    },
    {
      "startSec": 339.2,
      "text": "で、ジャックさんの影響で"
    },
    {
      "startSec": 342.7,
      "text": "今まで見なかったスタイルの映画も"
    },
    {
      "startSec": 346.1,
      "text": "すごく好きになったんですね。"
    },
    {
      "startSec": 349.1,
      "text": "例えば「ベイビー・ドライバー」知ってますか？"
    },
    {
      "startSec": 355.1,
      "text": "アクションシーンがクイーン(Queen)の"
    },
    {
      "startSec": 358.5,
      "text": "♪～Don't stop me now～♪の"
    },
    {
      "startSec": 363,
      "text": "あの音楽とアクションシーンがすごくマッチしてて"
    },
    {
      "startSec": 368.4,
      "text": "あの主人公、メインキャラクターが私は大好き。"
    },
    {
      "startSec": 373.9,
      "text": "でもアクションも結構好きですね。"
    },
    {
      "startSec": 377.8,
      "text": "で「ショーン・オブ・ザ・デッド」"
    },
    {
      "startSec": 380.6,
      "text": "これはイギリスのコッツウォルズじゃないけど"
    },
    {
      "startSec": 386,
      "text": "みたいな小さい村で、"
    },
    {
      "startSec": 389.4,
      "text": "まあカルト的な、カルトじゃないな。"
    },
    {
      "startSec": 391.4,
      "text": "まあ警察官(police officer)と"
    },
    {
      "startSec": 395.8,
      "text": "あと村の人のアクションですよね。"
    },
    {
      "startSec": 399,
      "text": "あのジョークとかも大好きですね、私は。"
    },
    {
      "startSec": 404.4,
      "text": "テンポがいい。"
    },
    {
      "startSec": 405.6,
      "text": "すごくパッパッパッと映画が進みます。"
    },
    {
      "startSec": 411.1,
      "text": "その、何だろう、リズムが大好きです。"
    },
    {
      "startSec": 417.3,
      "text": "あとは最近見た映画で、すごくインパクトがあった"
    },
    {
      "startSec": 424.6,
      "text": "すごくショックだったのは"
    },
    {
      "startSec": 428.4,
      "text": "「ジャンゴ」と「イングロリアス・バスターズ」です。"
    },
    {
      "startSec": 433,
      "text": "二つとも同じ監督です。"
    },
    {
      "startSec": 436.2,
      "text": "で「ジャンゴ」"
    },
    {
      "startSec": 437.5,
      "text": "あれはもうなんか…"
    },
    {
      "startSec": 441.8,
      "text": "もうずっと「ハッハッ」みたいな感じでした。"
    },
    {
      "startSec": 446.1,
      "text": "私はすごく好き。"
    },
    {
      "startSec": 448.8,
      "text": "リベンジ、日本語でリベンジの映画です。"
    },
    {
      "startSec": 453.7,
      "text": "いやこういう映画、結構好きです。"
    },
    {
      "startSec": 457.7,
      "text": "心になんかきますね。"
    },
    {
      "startSec": 462.3,
      "text": "で「イングロリアス・バスターズ」"
    },
    {
      "startSec": 464.5,
      "text": "これもすごかったね。"
    },
    {
      "startSec": 466.1,
      "text": "なんかあの…結構きつい。"
    },
    {
      "startSec": 471,
      "text": "見るのが難しい。"
    },
    {
      "startSec": 472.3,
      "text": "時々こうやって見たくなくなりますよね。"
    },
    {
      "startSec": 477.4,
      "text": "でも私はとても気に入りました。"
    },
    {
      "startSec": 481.5,
      "text": "ストーリーがすごく好き。"
    },
    {
      "startSec": 484.4,
      "text": "あの監督(director)すごいですね。"
    },
    {
      "startSec": 487.5,
      "text": "また見たいです。"
    },
    {
      "startSec": 489.6,
      "text": "ちょっといっぱい話してしまったので"
    },
    {
      "startSec": 492,
      "text": "そろそろ終わります。"
    },
    {
      "startSec": 493.8,
      "text": "最後に一つ、私が好きな映画。"
    },
    {
      "startSec": 497.8,
      "text": "これはフランス映画で"
    },
    {
      "startSec": 502,
      "text": "英語のタイトルは「Serial(Bad)weddings」"
    },
    {
      "startSec": 508.4,
      "text": "フランス映画です。"
    },
    {
      "startSec": 511.6,
      "text": "日本語は「最高の花婿(はなむこ)」"
    },
    {
      "startSec": 516.9,
      "text": "いやこれはもうめっちゃ面白いコメディですね。"
    },
    {
      "startSec": 522.1,
      "text": "とてもきれいなフランス人の"
    },
    {
      "startSec": 525.5,
      "text": "四人の姉妹(sisters)の話です。"
    },
    {
      "startSec": 530.9,
      "text": "その四人のお父さんお母さんは"
    },
    {
      "startSec": 534.3,
      "text": "白人、白い肌の人で、もちろんカトリックです。"
    },
    {
      "startSec": 540,
      "text": "でもその四人の娘達が連れて来た"
    },
    {
      "startSec": 547.1,
      "text": "夫(husband)はみんなちょっと違うんです。"
    },
    {
      "startSec": 552.3,
      "text": "カトリックじゃない。"
    },
    {
      "startSec": 553.5,
      "text": "例えばイスラムの人、中国人、ユダヤの人かな？"
    },
    {
      "startSec": 560.8,
      "text": "あと黒人、みんな全然違う。"
    },
    {
      "startSec": 565,
      "text": "で、その人達のすごく面白いコメディです。"
    },
    {
      "startSec": 570.4,
      "text": "日本だったらこんなジョークの映画作れないです。"
    },
    {
      "startSec": 576.6,
      "text": "フランスすごいなと思いました。"
    },
    {
      "startSec": 579.7,
      "text": "めっちゃ笑えるのでぜひ見てみてください。"
    },
    {
      "startSec": 586.4,
      "text": "私が一つすごく好きなその映画のフレーズがあって"
    },
    {
      "startSec": 592,
      "text": "フランスの女の子と黒人の彼氏が"
    },
    {
      "startSec": 597.5,
      "text": "黒人の彼氏が女の子のことを"
    },
    {
      "startSec": 601.1,
      "text": "「私のヨーグルト」って言うんですね。"
    },
    {
      "startSec": 604.9,
      "text": "で女の子がこの黒人の彼氏を"
    },
    {
      "startSec": 611.1,
      "text": "なんかチョコレートかな？"
    },
    {
      "startSec": 612.2,
      "text": "チョコレート、ヨーグルト。"
    },
    {
      "startSec": 614.8,
      "text": "で、もうかわいいと思って。"
    },
    {
      "startSec": 617.6,
      "text": "あ～、素敵だなぁと思って見てました。"
    },
    {
      "startSec": 620.9,
      "text": "皆さんも是非見てみてください。"
    },
    {
      "startSec": 624.4,
      "text": "じゃあ今日は長くなりましたがここで終わります。"
    },
    {
      "startSec": 628.4,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 633.2,
      "text": "で、実はもう一つポッドキャストを始めました。"
    },
    {
      "startSec": 639.7,
      "text": "これは「The Japanglish Podcast」という名前です。"
    },
    {
      "startSec": 645.7,
      "text": "これは彼氏と一緒に作っています。"
    },
    {
      "startSec": 650.6,
      "text": "私が日本語、で彼が英語で話す"
    },
    {
      "startSec": 656.6,
      "text": "カジュアルなポッドキャストです。"
    },
    {
      "startSec": 660.1,
      "text": "初級の人、N5、N4位の人にぴったり。"
    },
    {
      "startSec": 665.5,
      "text": "とてもいいと思うので"
    },
    {
      "startSec": 668.2,
      "text": "是非日本語を勉強している友達がいたら"
    },
    {
      "startSec": 673.5,
      "text": "このポッドキャスト、お勧めしてくれると嬉しいです。"
    },
    {
      "startSec": 680.4,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 682,
      "text": "ありがとうございました。"
    },
    {
      "startSec": 683.7,
      "text": "また明日も聞いてください。"
    },
    {
      "startSec": 686,
      "text": "じゃあまたねバイバイ！"
    }
  ]
}
