{
  "episodeId": "uVtQ7D2zqUQ",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.2,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 7.5,
      "text": "今日は楽しいを表わすオノマトペを一緒に勉強しましょう。"
    },
    {
      "startSec": 16.7,
      "text": "もう楽しい、嬉しいだけじゃなくて他にも"
    },
    {
      "startSec": 22.1,
      "text": "楽しい嬉しいを表わすオノマトペがたくさんあります。"
    },
    {
      "startSec": 28.7,
      "text": "今日はそのオノマトペを…五個勉強しましょう。"
    },
    {
      "startSec": 35.1,
      "text": "皆さんも気分が上がるといいですね。"
    },
    {
      "startSec": 38.7,
      "text": "じゃあ一つ目。"
    },
    {
      "startSec": 40.8,
      "text": "一つ目は「わくわく、ワクワク」"
    },
    {
      "startSec": 45.2,
      "text": "これは知っている人も多いと思います。"
    },
    {
      "startSec": 49.5,
      "text": "これは楽しいこと、楽しいイベントを待っている時"
    },
    {
      "startSec": 56.1,
      "text": "「なんか心がワクワクする」みたいな感じです。"
    },
    {
      "startSec": 61.3,
      "text": "「あ～もうちょっとで映画が始まる、やばいワクワクする、"
    },
    {
      "startSec": 67.8,
      "text": "どんな映画かな」みたいな感じです。"
    },
    {
      "startSec": 72.7,
      "text": "で、よくワクワクとセットで使われるのが「ドキドキ」です。"
    },
    {
      "startSec": 81,
      "text": "「ワクワクドキドキする」みたいに。"
    },
    {
      "startSec": 85.1,
      "text": "このドキドキは、心臓(heart)がドキドキする感じです。"
    },
    {
      "startSec": 96.9,
      "text": "で、このドキドキはちょっと緊張している時に使うかな。"
    },
    {
      "startSec": 105.6,
      "text": "「初めてのデートの前にドキドキする」みたいな感じ。"
    },
    {
      "startSec": 112.3,
      "text": "で四月は、日本は新しい月です。"
    },
    {
      "startSec": 118.7,
      "text": "学校とか会社は四月から新しい年が始まります。"
    },
    {
      "startSec": 127,
      "text": "なので日本の四月は、ワクワクドキドキする季節です。"
    },
    {
      "startSec": 135.5,
      "text": "で、次三つ目は「ウキウキする」です。"
    },
    {
      "startSec": 143.9,
      "text": "これはウキウキ、なんかちょっと浮いている感じ。"
    },
    {
      "startSec": 148.9,
      "text": "水の上に浮いているイメージかな。"
    },
    {
      "startSec": 153.6,
      "text": "なんか楽しみで、楽しくて落ち着かない感じ。"
    },
    {
      "startSec": 160.5,
      "text": "「楽しみ～ウキウキする～！」みたいな感じです。"
    },
    {
      "startSec": 165.1,
      "text": "例えば「今日はデートがあるからウキウキするな～」"
    },
    {
      "startSec": 172.1,
      "text": "「もう気分がウキウキするな～」みたいな感じで使います。"
    },
    {
      "startSec": 178.4,
      "text": "あとは春になると、桜がたくさん咲いて、鳥も歌うから"
    },
    {
      "startSec": 187.8,
      "text": "私も気分がウキウキするみたいな感じですか。"
    },
    {
      "startSec": 194.6,
      "text": "これもよく使います。"
    },
    {
      "startSec": 197.7,
      "text": "で四つ目、四つ目は「ルンルン」です。"
    },
    {
      "startSec": 204.9,
      "text": "ルンルンこれはちょっとおどっている感じ。"
    },
    {
      "startSec": 209.3,
      "text": "おどる(to dance)、おどっている感じ。"
    },
    {
      "startSec": 212.5,
      "text": "心が躍っている、ルンルンです。"
    },
    {
      "startSec": 217.2,
      "text": "これも楽しいことの前に"
    },
    {
      "startSec": 220.8,
      "text": "心が、気分が、気持ちがルンルンする、"
    },
    {
      "startSec": 226.1,
      "text": "ルンルンになるみたいな感じです。"
    },
    {
      "startSec": 230.7,
      "text": "例えばゴールデンウィーク、もうすぐです。"
    },
    {
      "startSec": 235.3,
      "text": "「明日からゴールデンウィーク、だから気分がもうルンルンする」"
    },
    {
      "startSec": 242.5,
      "text": "みたいな感じですか、よく使います。"
    },
    {
      "startSec": 246,
      "text": "ルンルン、ちょっとかわいい音です。"
    },
    {
      "startSec": 249.6,
      "text": "で、最後が「胸がキュンする」です。"
    },
    {
      "startSec": 258.5,
      "text": "キューンはなんか、胸がちょっと小さくなる"
    },
    {
      "startSec": 265.8,
      "text": "一瞬ちょっと小さくなる、ギュッとなる、説明が難しいけど。"
    },
    {
      "startSec": 272.5,
      "text": "よくこれは恋愛、好きな人を見つけた時とかに使います。"
    },
    {
      "startSec": 280.7,
      "text": "「胸がキュンとする」"
    },
    {
      "startSec": 285.8,
      "text": "例えば、私は女ですけど私が男だったら"
    },
    {
      "startSec": 292.2,
      "text": "「いや、昨日レイラが眼鏡を外しているのを見て"
    },
    {
      "startSec": 299.7,
      "text": "なんかキュンとした」"
    },
    {
      "startSec": 303.1,
      "text": "レイラが眼鏡をしていないのを見て"
    },
    {
      "startSec": 306.7,
      "text": "なんかめっちゃ可愛いと思った。"
    },
    {
      "startSec": 309.4,
      "text": "私、眼鏡しないですけど"
    },
    {
      "startSec": 311.4,
      "text": "そんな感じで使うことができます。"
    },
    {
      "startSec": 314.7,
      "text": "「いつも胸がキュンとする」"
    },
    {
      "startSec": 318.1,
      "text": "何か…好きな人を見て"
    },
    {
      "startSec": 322.1,
      "text": "「えっ、かっこいい」「えっ、かわいい」みたいな、"
    },
    {
      "startSec": 328,
      "text": "その「えっ、ヤバイ」みたいな感じが「胸キュン」です。"
    },
    {
      "startSec": 333.3,
      "text": "「胸キュン」よく使います。"
    },
    {
      "startSec": 336.8,
      "text": "じゃあ今日はこれだけです。"
    },
    {
      "startSec": 339.8,
      "text": "五つ勉強しました。"
    },
    {
      "startSec": 342.4,
      "text": "「ワクワク」「ドキドキ」「ウキウキ」「ルンルン」"
    },
    {
      "startSec": 347.8,
      "text": "そして「胸キュン」です。"
    },
    {
      "startSec": 351.7,
      "text": "皆さんも使ってみてください。"
    },
    {
      "startSec": 354.7,
      "text": "もしリクエストがあったら、コメントに書いてください。"
    },
    {
      "startSec": 359.4,
      "text": "いつもポッドキャスト作っているので"
    },
    {
      "startSec": 363.4,
      "text": "時々何を話したらいいか分からなくなります。"
    },
    {
      "startSec": 369.7,
      "text": "是非アドバイス・リクエスト待っています。"
    },
    {
      "startSec": 373.7,
      "text": "いつもありがとう。"
    },
    {
      "startSec": 374.7,
      "text": "じゃあ勉強、お仕事頑張ってください。"
    },
    {
      "startSec": 377.9,
      "text": "今日も良い一日を！じゃあまたね！バイバイ！"
    }
  ]
}
