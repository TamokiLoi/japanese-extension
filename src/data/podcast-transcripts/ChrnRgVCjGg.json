{
  "episodeId": "ChrnRgVCjGg",
  "segments": [
    {
      "startSec": 0,
      "text": "皆さんこんにちは、レイラです"
    },
    {
      "startSec": 3.2,
      "text": "今日はゲストに来てもらっています。"
    },
    {
      "startSec": 7,
      "text": "instagramのケン先生です"
    },
    {
      "startSec": 12.8,
      "text": "ケン：皆さんこんにちは！ レイラ：ひさしぶりです〜 Instagramで友達になったケン先生です。"
    },
    {
      "startSec": 24.4,
      "text": "よろしくお願いします！"
    },
    {
      "startSec": 28.2,
      "text": "今日のトピックは「2021年振り返り」"
    },
    {
      "startSec": 35.3,
      "text": "振り返り means looking back on ~"
    },
    {
      "startSec": 41.2,
      "text": "we will look back on 2021! 今年。"
    },
    {
      "startSec": 47.2,
      "text": "みなさんはどんな年でしたか？"
    },
    {
      "startSec": 50.3,
      "text": "そうね、あとは"
    },
    {
      "startSec": 52,
      "text": "ケン先生にもたくさん質問したいと思います。"
    },
    {
      "startSec": 59.3,
      "text": "よろしくお願いします！よろしくお願います！"
    },
    {
      "startSec": 63.5,
      "text": "まずは、ケン先生から2021年"
    },
    {
      "startSec": 67.7,
      "text": "どんな年でしたか？"
    },
    {
      "startSec": 70.5,
      "text": "2021年は、まあ楽しかった。"
    },
    {
      "startSec": 77.4,
      "text": "本当ですか？"
    },
    {
      "startSec": 80,
      "text": "今年は初めて、初めてじゃないごめん"
    },
    {
      "startSec": 85.7,
      "text": "今のアカウント、instagramのアカウントを始めて"
    },
    {
      "startSec": 90,
      "text": "8月からはじめて...."
    },
    {
      "startSec": 94.8,
      "text": "８月から？ じゃあ、まだ若いか！めっちゃ！まだ４か月！ヶ月"
    },
    {
      "startSec": 104.3,
      "text": "まだベイビー！その前のアカウントは1月からだから"
    },
    {
      "startSec": 112.9,
      "text": "それでもなんか、そうね"
    },
    {
      "startSec": 116.6,
      "text": "今年に入ってから、だから、レイラン"
    },
    {
      "startSec": 119.9,
      "text": "とあったのも"
    },
    {
      "startSec": 121.9,
      "text": "いつかな？4月とか？"
    },
    {
      "startSec": 125.8,
      "text": "結構じゃあ早い...早かったね！"
    },
    {
      "startSec": 129.3,
      "text": "そうそうそう。会ったのは！"
    },
    {
      "startSec": 132.9,
      "text": "レイランと友達になったりとか、"
    },
    {
      "startSec": 136.3,
      "text": "他の日本語の先生とか"
    },
    {
      "startSec": 139.4,
      "text": "いろんななんか、インスタグラムを初めて"
    },
    {
      "startSec": 142.6,
      "text": "いろんなこういう出会い、meeting people 出会いがあったかな"
    },
    {
      "startSec": 150.1,
      "text": "私もそうだったかも。本当？"
    },
    {
      "startSec": 153.9,
      "text": "なんかやっぱりね"
    },
    {
      "startSec": 155.7,
      "text": "intagramしてたら"
    },
    {
      "startSec": 157.5,
      "text": "なんか、いい人と"
    },
    {
      "startSec": 160.5,
      "text": "考え方が似ている人と出会えると思う。"
    },
    {
      "startSec": 165.7,
      "text": "うん。いろんな今"
    },
    {
      "startSec": 167.8,
      "text": "先生がね、たくさんいるから。日本語の先生。"
    },
    {
      "startSec": 172.5,
      "text": "私はあんまり何か"
    },
    {
      "startSec": 174.4,
      "text": "他の人にメッセージを送るのが苦手だけど、"
    },
    {
      "startSec": 179.3,
      "text": "なんかケンケンはたくさんメッセージを送ってそうw"
    },
    {
      "startSec": 185.4,
      "text": "あ、俺から？うん、ケンケンから。"
    },
    {
      "startSec": 192.2,
      "text": "いや〜でもそんなことないかな。"
    },
    {
      "startSec": 197.1,
      "text": "俺、けっこう、なんていうんだろう、選ぶから"
    },
    {
      "startSec": 206.5,
      "text": "なんかその人のポストとか"
    },
    {
      "startSec": 211,
      "text": "インスタライブとかを見て"
    },
    {
      "startSec": 213.9,
      "text": "この人なんか良さそうとか"
    },
    {
      "startSec": 215.8,
      "text": "っていうのをだいたい"
    },
    {
      "startSec": 218,
      "text": "1ヶ月ぐらいかけて.... 1ヶ月？！リサーチが長い！笑"
    },
    {
      "startSec": 232.5,
      "text": "もう最近は全然自分からメッセージすることはないかな〜"
    },
    {
      "startSec": 240.4,
      "text": "そうなんだ。レイランはする？"
    },
    {
      "startSec": 243.1,
      "text": "私もねあんまりしないかも、てか全然しない。"
    },
    {
      "startSec": 247,
      "text": "あんまりしたことないかな。"
    },
    {
      "startSec": 249.9,
      "text": "ほんと？くる？"
    },
    {
      "startSec": 253.8,
      "text": "時々ね"
    },
    {
      "startSec": 255,
      "text": "でも最近ちょっと、なんか忙しくてあまりDMを確認"
    },
    {
      "startSec": 261.1,
      "text": "チェックできてないから、"
    },
    {
      "startSec": 264.2,
      "text": "でも前は、時々来てた。メッセージ。"
    },
    {
      "startSec": 270.7,
      "text": "コラボしましょうとか？"
    },
    {
      "startSec": 274,
      "text": "とか、そんな感じ、うん。"
    },
    {
      "startSec": 279.4,
      "text": "なんか他にはさ、"
    },
    {
      "startSec": 280.9,
      "text": "プライベートな変わったこととか"
    },
    {
      "startSec": 284.6,
      "text": "今年何か、新しいこととかある？"
    },
    {
      "startSec": 287.2,
      "text": "新しいことは〜、私のリスナーさんは知ってると思うけど"
    },
    {
      "startSec": 295.7,
      "text": "11月に岡山に引越ししました。"
    },
    {
      "startSec": 303,
      "text": "どうして引っ越したの　岡山に？"
    },
    {
      "startSec": 306.5,
      "text": "ジャックさんが仕事で岡山に引っ越してきたので、"
    },
    {
      "startSec": 312.3,
      "text": "一緒に住むためにこっちに来ました。"
    },
    {
      "startSec": 317.5,
      "text": "一緒に住むは日本語で何て言いますか？"
    },
    {
      "startSec": 321,
      "text": "同棲（どうせい）ともいうよね。"
    },
    {
      "startSec": 322.3,
      "text": "確かに！どうせいするって言いますね！"
    },
    {
      "startSec": 328.6,
      "text": "同棲するために... そうなんだ！"
    },
    {
      "startSec": 334.3,
      "text": "big stepだね！ほんとに！3年待ってたから！"
    },
    {
      "startSec": 340,
      "text": "めっちゃ嬉しい！"
    },
    {
      "startSec": 342,
      "text": "今年それが一番大きいイベント？"
    },
    {
      "startSec": 346,
      "text": "一番大きいイベントかな？ぜったいそう！"
    },
    {
      "startSec": 354.1,
      "text": "じゃあケンケンの一番大きなイベントは何？"
    },
    {
      "startSec": 360.2,
      "text": "今年は、1番大きいのは"
    },
    {
      "startSec": 363.9,
      "text": "ヨーロッパに旅行したことかな"
    },
    {
      "startSec": 367,
      "text": "つい最近ですね〜"
    },
    {
      "startSec": 369.6,
      "text": "そうそうそう！11月の終わり、"
    },
    {
      "startSec": 373.3,
      "text": "あとはキャンプを今年、始めたりとか"
    },
    {
      "startSec": 379.3,
      "text": "どうしてキャンプ始めたの？"
    },
    {
      "startSec": 382.8,
      "text": "コロナがあるから"
    },
    {
      "startSec": 386.6,
      "text": "旅行はやっぱり難しかった"
    },
    {
      "startSec": 390.3,
      "text": "ま、ヨーロッパ旅行したけど、前ね、難しかったから"
    },
    {
      "startSec": 398.4,
      "text": "なんかまあ今"
    },
    {
      "startSec": 400.6,
      "text": "サンフランシスコに住んでるんだけど"
    },
    {
      "startSec": 402.9,
      "text": "サンフランシスコって"
    },
    {
      "startSec": 404.5,
      "text": "たくさんキャンプ場"
    },
    {
      "startSec": 406.5,
      "text": "キャンプエリアがたくさんあるし"
    },
    {
      "startSec": 409.3,
      "text": "綺麗なところがたくさん"
    },
    {
      "startSec": 412.8,
      "text": "あるから、キャンプしようと思って始めました。"
    },
    {
      "startSec": 418.1,
      "text": "いいですね〜いいなきれいなところは！"
    },
    {
      "startSec": 424.5,
      "text": "私もキャンプしたいな。え、したことある？"
    },
    {
      "startSec": 428.2,
      "text": "いや、小さい時に何回かしたことがある。"
    },
    {
      "startSec": 433.1,
      "text": "昔ね！もう10年前とか"
    },
    {
      "startSec": 435.7,
      "text": "最近は全然!"
    },
    {
      "startSec": 437.7,
      "text": "だからジャックさんと二人で"
    },
    {
      "startSec": 441.1,
      "text": "まあ夏になったら、"
    },
    {
      "startSec": 443.2,
      "text": "だと思うけど寒いからね今"
    },
    {
      "startSec": 445.6,
      "text": "確かに〜車がないからね"
    },
    {
      "startSec": 448.9,
      "text": "ちょっと難しい今は。"
    },
    {
      "startSec": 452.4,
      "text": "そっかそっか。そうだね、キャンプの荷物重いからさあー"
    },
    {
      "startSec": 458.7,
      "text": "そっかそっか"
    },
    {
      "startSec": 459.4,
      "text": "車があったほうがもっと楽だね。"
    },
    {
      "startSec": 462.9,
      "text": "レンタカーすればね！"
    },
    {
      "startSec": 464.6,
      "text": "あーレンタカーかそっか！"
    },
    {
      "startSec": 467.2,
      "text": "私運転できなくて、ジャックさんにお願いします。 いいかもね、それ。"
    },
    {
      "startSec": 474.9,
      "text": "ケンケンはどれぐらいキャンプする？"
    },
    {
      "startSec": 478.8,
      "text": "一ヶ月に１回キャンプする？それか。。。"
    },
    {
      "startSec": 485,
      "text": "夏は1ヶ月に2回ぐらいだ？けっこうじゃあ！２週間に１回だよね！"
    },
    {
      "startSec": 492,
      "text": "そうそう！"
    },
    {
      "startSec": 492.9,
      "text": "一回に大体、"
    },
    {
      "startSec": 496.8,
      "text": "2日、3日とか？泊まって、 長い！"
    },
    {
      "startSec": 506.8,
      "text": "めっちゃ長い！いいですね〜"
    },
    {
      "startSec": 510.8,
      "text": "その時はもう"
    },
    {
      "startSec": 512,
      "text": "スマホはもう全部オフにして"
    },
    {
      "startSec": 517.1,
      "text": "最高！ 完全にデトックスする！それはすごいよかった"
    },
    {
      "startSec": 522.8,
      "text": "もう完全にこう、なんだろう隔離（かくり）じゃないけど"
    },
    {
      "startSec": 526.5,
      "text": "なんかisolatedされてる"
    },
    {
      "startSec": 529.1,
      "text": "こう離れてる感じの、現実世界から"
    },
    {
      "startSec": 534,
      "text": "すごく大切ですよね！"
    },
    {
      "startSec": 538.6,
      "text": "すごいいいよ！おすすめ！"
    },
    {
      "startSec": 539.4,
      "text": "instagramとかの仕事をしてたら"
    },
    {
      "startSec": 544.9,
      "text": "やっぱり、すごくストレスになるから"
    },
    {
      "startSec": 549.1,
      "text": "すごく大切だと思う！そうね〜"
    },
    {
      "startSec": 554,
      "text": "私も次の夏はキャンプに行きます。"
    },
    {
      "startSec": 557.7,
      "text": "デトックスをしたいですね〜おすすめ！"
    },
    {
      "startSec": 564.7,
      "text": "じゃあ、結構もう長く話したので"
    },
    {
      "startSec": 569.9,
      "text": "ケン先生、そろそろバイバイの時間です"
    },
    {
      "startSec": 575.6,
      "text": "ありがとうございました！こちらこそありがとうございました"
    },
    {
      "startSec": 579.8,
      "text": "じゃあバイバイの前に....."
    },
    {
      "startSec": 583.2,
      "text": "待って待って！ケン先生のインスタグラムの話を！"
    },
    {
      "startSec": 590.6,
      "text": "うんと僕のinstagramの名前は"
    },
    {
      "startSec": 594.4,
      "text": "@japanesespeakingclub"
    },
    {
      "startSec": 611.3,
      "text": "本当にとても便利です!"
    },
    {
      "startSec": 613.7,
      "text": "だからまたチェックしてくださいね。"
    },
    {
      "startSec": 616.3,
      "text": "ケン先生のpodcastも"
    },
    {
      "startSec": 618.9,
      "text": "とてもわかりやすいので"
    },
    {
      "startSec": 621,
      "text": "是非チェックして下さい！"
    },
    {
      "startSec": 624.4,
      "text": "ありがとうございます"
    },
    {
      "startSec": 626.3,
      "text": "ありがとうございます。"
    },
    {
