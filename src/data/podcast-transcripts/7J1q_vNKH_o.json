{
  "episodeId": "7J1q_vNKH_o",
  "segments": [
    {
      "startSec": 0.3,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.5,
      "text": "今日は、日本で生活するメリット"
    },
    {
      "startSec": 11.6,
      "text": "日本で暮らしていて、いいなと思うことを"
    },
    {
      "startSec": 18,
      "text": "紹介したいと思います。"
    },
    {
      "startSec": 20.9,
      "text": "日本に旅行で来たことがある人とかは"
    },
    {
      "startSec": 25.4,
      "text": "「あ、そうだそうだ！日本は本当にそういう メリットがあっていい国だ」って"
    },
    {
      "startSec": 31.8,
      "text": "思うかもしれないですね。"
    },
    {
      "startSec": 34.1,
      "text": "今日は日本のいいところをたくさん紹介して"
    },
    {
      "startSec": 40,
      "text": "皆さんが日本に住みたくなるような"
    },
    {
      "startSec": 43.6,
      "text": "そんなポッドキャストにします。"
    },
    {
      "startSec": 47,
      "text": "まず1つ目ね。"
    },
    {
      "startSec": 49,
      "text": "まず私が思うのは、日本で生活する「生活費」"
    },
    {
      "startSec": 55.7,
      "text": "「ひ」＝費用の「費」ね。"
    },
    {
      "startSec": 59,
      "text": "「費用」は値段・お金…だから「生活費」は 生活に必要なお金。"
    },
    {
      "startSec": 68.5,
      "text": "日本は生活費が安いと思います。"
    },
    {
      "startSec": 72.9,
      "text": "本当に安いと思う。"
    },
    {
      "startSec": 75.3,
      "text": "例えば、保険。"
    },
    {
      "startSec": 78,
      "text": "みんな病気になったりケガをした時のために"
    },
    {
      "startSec": 82.2,
      "text": "保険(insurance)に入りますよね。"
    },
    {
      "startSec": 85.8,
      "text": "もちろん会社で仕事をしていたら"
    },
    {
      "startSec": 89.6,
      "text": "会社が保険の半分を払ってくれるんですが"
    },
    {
      "startSec": 94.6,
      "text": "自分でビジネスをしている人"
    },
    {
      "startSec": 97.4,
      "text": "会社で仕事をしていない人が入る"
    },
    {
      "startSec": 100.6,
      "text": "国の保険があります。"
    },
    {
      "startSec": 103.7,
      "text": "で、1ヶ月のその保険のお金が1万6000円くらいです。"
    },
    {
      "startSec": 112.5,
      "text": "私は、これはすごくいいなと思ってます。"
    },
    {
      "startSec": 116.5,
      "text": "このお金を払うと病院に行ったら"
    },
    {
      "startSec": 122,
      "text": "70%のお金を国が払ってくれる。"
    },
    {
      "startSec": 126.7,
      "text": "だから私たちが払うのは30%ですね。"
    },
    {
      "startSec": 132.9,
      "text": "この1万6000円っていう、もちろん"
    },
    {
      "startSec": 136.4,
      "text": "めちゃくちゃ安いわけじゃないけど"
    },
    {
      "startSec": 139,
      "text": "他の高い国に比べたらめっちゃ安いんじゃないかなと 思います。"
    },
    {
      "startSec": 145.1,
      "text": "あとは電気代とか水道・ガスに使うお金も結構安い。"
    },
    {
      "startSec": 151.8,
      "text": "例えば私はこの冬、毎日エアコン、ヒーターを 使っていましたが"
    },
    {
      "startSec": 161.9,
      "text": "電気代は1ヶ月で1万円でした。"
    },
    {
      "startSec": 166.5,
      "text": "もっと高い国、あるんじゃないかなって思う。"
    },
    {
      "startSec": 169.8,
      "text": "あとは家が結構安い、特に田舎。"
    },
    {
      "startSec": 175.2,
      "text": "日本って、日本だけじゃないけど"
    },
    {
      "startSec": 178.3,
      "text": "日本はやっぱり今どんどん人が少なくなってきて"
    },
    {
      "startSec": 183.6,
      "text": "田舎では特に人が少なくなって"
    },
    {
      "startSec": 188.7,
      "text": "家がたくさん余っている感じなんですね。"
    },
    {
      "startSec": 193.3,
      "text": "だからもしそういう田舎に住んでもいいよっていう 人だったら"
    },
    {
      "startSec": 200.9,
      "text": "家が安く買える、本当に安い。"
    },
    {
      "startSec": 204.4,
      "text": "本当に、例えばもう300万円とか"
    },
    {
      "startSec": 209,
      "text": "500万円くらいで買えるんですね。"
    },
    {
      "startSec": 213.3,
      "text": "で、多分今皆さん、300万円って自分たちの、 例えばドルだったら"
    },
    {
      "startSec": 218.3,
      "text": "いくらだろうとか多分今計算していると思うんだけど"
    },
    {
      "startSec": 222,
      "text": "私もお金の計算は今も全然できないです。"
    },
    {
      "startSec": 227.6,
      "text": "300万円とか500万円くらいで家が普通に買えます。"
    },
    {
      "startSec": 234.9,
      "text": "家賃もそんなに高くないです。"
    },
    {
      "startSec": 238.6,
      "text": "今私が住んでいるこのアパートは"
    },
    {
      "startSec": 243.1,
      "text": "カウンターキッチンと広いダイニングとリビングが 1つになった部屋"
    },
    {
      "startSec": 250.2,
      "text": "あと寝室、ベッドルーム。"
    },
    {
      "startSec": 253.5,
      "text": "で、大きいトイレとかお風呂とかがあって"
    },
    {
      "startSec": 257.4,
      "text": "4万5000円くらいかな。"
    },
    {
      "startSec": 262.8,
      "text": "もちろんここは田舎だけど"
    },
    {
      "startSec": 265.4,
      "text": "東京はもちろんもう少し高いし、狭いけど"
    },
    {
      "startSec": 272.2,
      "text": "本当に多分10万円、9万円くらいで"
    },
    {
      "startSec": 277.3,
      "text": "アパートが借りられると思います。"
    },
    {
      "startSec": 280.9,
      "text": "結構安いよね。"
    },
    {
      "startSec": 282.4,
      "text": "もちろん日本のお給料はやっぱり低いなと 思うんだけど"
    },
    {
      "startSec": 290,
      "text": "でもそれは例えば、フルリモートをして"
    },
    {
      "startSec": 294.8,
      "text": "お給料をたくさんもらいながら"
    },
    {
      "startSec": 297.4,
      "text": "日本の田舎で生活するということができたりしたら"
    },
    {
      "startSec": 302.3,
      "text": "もう本当に天国だと思います。"
    },
    {
      "startSec": 305.3,
      "text": "私もそんな生活がしてみたいです。"
    },
    {
      "startSec": 309,
      "text": "だから日本は結構安い。"
    },
    {
      "startSec": 312.4,
      "text": "あと他の日本のいいところはきれい、清潔ですね。"
    },
    {
      "startSec": 318.9,
      "text": "ゴミが少ないかな。"
    },
    {
      "startSec": 322.6,
      "text": "もちろん私が住んでる場所でも"
    },
    {
      "startSec": 327.5,
      "text": "川とかにペットボトルとかゴミとかがよく落ちてます。"
    },
    {
      "startSec": 333,
      "text": "そういうのを捨てるのは"
    },
    {
      "startSec": 334.5,
      "text": "大体おじいちゃん おばあちゃんとかなんだけど"
    },
    {
      "startSec": 339.3,
      "text": "だけど大きな町に行った時とかも"
    },
    {
      "startSec": 344,
      "text": "ゴミはやっぱり少ないし"
    },
    {
      "startSec": 346.8,
      "text": "東京の歌舞伎町とかそういう本当に"
    },
    {
      "startSec": 351.4,
      "text": "ヤバいところに行ったら"
    },
    {
      "startSec": 353.6,
      "text": "本当にゴミも多いし臭いけど"
    },
    {
      "startSec": 356.9,
      "text": "ほとんどの町はそんなことはないです。"
    },
    {
      "startSec": 360.4,
      "text": "ゴミが少ないから、あんまり臭いと思わないですね。"
    },
    {
      "startSec": 366.4,
      "text": "はい、そう思います。"
    },
    {
      "startSec": 367.9,
      "text": "あとはトイレがほとんど、どこに行ってもきれい。"
    },
    {
      "startSec": 373.8,
      "text": "町のトイレは本当にきれいです。"
    },
    {
      "startSec": 377.5,
      "text": "前に私、ベトナムに行ってお店のトイレに入ったら"
    },
    {
      "startSec": 382.6,
      "text": "トイレの床にトイレットペーパーが たくさん落ちていたり"
    },
    {
      "startSec": 388.3,
      "text": "なんか濡(ぬ)れていたり、臭かったりしたんだけど"
    },
    {
      "startSec": 392.2,
      "text": "そんなことはほとんどないですね。"
    },
    {
      "startSec": 395.2,
      "text": "日本のトイレはどこに行ってもきれいかな。"
    },
    {
      "startSec": 400.3,
      "text": "あと悪いヤクザとかはいるけど、でも町を歩いていて"
    },
    {
      "startSec": 407.1,
      "text": "危ない思いをしたこととかは、私はないですね。"
    },
    {
      "startSec": 413.7,
      "text": "もちろん痴漢とか"
    },
    {
      "startSec": 416,
      "text": "痴漢って電車とか人が多いところで"
    },
    {
      "startSec": 421.9,
      "text": "若い人の体を触ったりとかあるけど"
    },
    {
      "startSec": 426.5,
      "text": "まあでも、そうだな…あるんだけど"
    },
    {
      "startSec": 430.7,
      "text": "例えばナイフを持ってとか、銃を持ってみたいな"
    },
    {
      "startSec": 434.2,
      "text": "そういう怖い人って本当にいないですね。"
    },
    {
      "startSec": 438.8,
      "text": "私の彼氏が15歳くらいまで"
    },
    {
      "startSec": 443.1,
      "text": "イギリスのリーズという町に住んでいたんですが"
    },
    {
      "startSec": 449,
      "text": "その町にいる時は本当に"
    },
    {
      "startSec": 452.2,
      "text": "ナイフを持った人に追いかけられたこととか"
    },
    {
      "startSec": 455.7,
      "text": "あと花火を向けられたこととか"
    },
    {
      "startSec": 461.9,
      "text": "なんか本当にいろんな怖いことがあって"
    },
    {
      "startSec": 465.3,
      "text": "いつも安心していられなかったと言ってましたね。"
    },
    {
      "startSec": 469.3,
      "text": "そういう思いをしたことは、私は日本ではないです。"
    },
    {
      "startSec": 475.9,
      "text": "で、人も大体優しい。"
    },
    {
      "startSec": 479.1,
      "text": "めっちゃ面白い人が多いとか明るい人が多い"
    },
    {
      "startSec": 483.8,
      "text": "ということはないかもしれないけど"
    },
    {
      "startSec": 488.2,
      "text": "お店に行ったりレストランに行った時に"
    },
    {
      "startSec": 492,
      "text": "大体みんなすごく丁寧で、助けてくれるかな。"
    },
    {
      "startSec": 498.7,
      "text": "そういう意地悪な悪い人って本当に 少ないような気がします。"
    },
    {
      "startSec": 505.8,
      "text": "電車とかバスも絶対に時間通りに来るんですよね。"
    },
    {
      "startSec": 511.7,
      "text": "だから本当に電車が1分とか2分でも遅れていたら"
    },
    {
      "startSec": 515.6,
      "text": "私も「えっウソ？なんで？ヤバっ！なんで来ないの？」 とか思うし"
    },
    {
      "startSec": 522,
      "text": "だから結構生活はしやすい国だと思うんだけど"
    },
    {
      "startSec": 527.2,
      "text": "皆さんはどう思いますか？どうかな？"
    },
    {
      "startSec": 533.5,
      "text": "これぐらいかな、日本のいいところ。"
    },
    {
      "startSec": 536.4,
      "text": "さっきちょっと考えてみて、私が思ったことを"
    },
    {
      "startSec": 541.1,
      "text": "このエピソードで話してみたんだけど"
    },
    {
      "startSec": 544.4,
      "text": "皆さんはどう思いますか？"
    },
    {
      "startSec": 546.5,
      "text": "他にも日本のいいところとかありますか？"
    },
    {
      "startSec": 551.2,
      "text": "日本の食べ物が好きな人は嬉しいかもしれないよね。"
    },
    {
      "startSec": 556.5,
      "text": "レストランとかも結構安いと思います。"
    },
    {
      "startSec": 561.5,
      "text": "大体1000円くらいでおいしいランチも食べられるし"
    },
    {
      "startSec": 567.3,
      "text": "生活しやすい国だと私は思っています。"
    },
    {
      "startSec": 572.2,
      "text": "なので、私も昔は外国に住んでみたいと思ったことも あったけど"
    },
    {
      "startSec": 579.7,
      "text": "最近思うのは、例えば仕事は"
    },
    {
      "startSec": 583.9,
      "text": "いつか日本じゃない国の仕事を"
    },
    {
      "startSec": 586.9,
      "text": "リモートでやってみたいなと思ったりしていて"
    },
    {
      "startSec": 591.3,
      "text": "で、旅行にもたくさん行きたいけど"
    },
    {
      "startSec": 594.6,
      "text": "私の家は日本にあったらいいなと"
    },
    {
      "startSec": 600.9,
      "text": "最近よく思うんですね。"
    },
    {
      "startSec": 604.3,
      "text": "皆さんもどう思うかわからないけど"
    },
    {
      "startSec": 606.6,
      "text": "ぜひ今度日本に旅行に来てみて"
    },
    {
      "startSec": 611.1,
      "text": "ちょっと日本の生活を体験してみてください。"
    },
    {
      "startSec": 615.1,
      "text": "で、ぜひ皆さんの考えとかを教えてください。"
    },
    {
      "startSec": 620.3,
      "text": "今日はこんな感じで終わろうかな。"
    },
    {
      "startSec": 622.2,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 624.9,
      "text": "もしこのポッドキャストが気に入ったら"
    },
    {
      "startSec": 627.7,
      "text": "トランスクリプトを作っているので"
    },
    {
      "startSec": 631.5,
      "text": "私のメンバーシップのPatreonから"
    },
    {
      "startSec": 634.3,
      "text": "ダウンロードして使うことができます。"
    },
    {
      "startSec": 637.5,
      "text": "結構便利なトランスクリプトなので"
    },
    {
      "startSec": 640.7,
      "text": "もし興味があったらぜひ使ってみてください。"
    },
    {
      "startSec": 644.9,
      "text": "お願いします。"
    },
    {
      "startSec": 646,
      "text": "じゃあ以上です。"
    },
    {
      "startSec": 647.7,
      "text": "お疲れ様でした！"
    },
    {
      "startSec": 649.4,
      "text": "またね、バイバイ！"
    }
  ]
}
