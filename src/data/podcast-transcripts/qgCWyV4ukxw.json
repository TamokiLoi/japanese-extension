{
  "episodeId": "qgCWyV4ukxw",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "昨日は「人生百年生きるなら」という"
    },
    {
      "startSec": 9.4,
      "text": "マインドセットの話をしました。"
    },
    {
      "startSec": 12.9,
      "text": "人生を春・夏・秋・冬と考えて"
    },
    {
      "startSec": 19.4,
      "text": "「その季節を大切に生きたらいいよ」"
    },
    {
      "startSec": 23.7,
      "text": "「焦らなくてもいんじゃない」という話でした。"
    },
    {
      "startSec": 29.2,
      "text": "で、今日もちょっと似た話をしたいと思います。"
    },
    {
      "startSec": 34.1,
      "text": "今日は中国の昔の偉い人、"
    },
    {
      "startSec": 38.4,
      "text": "「孔子」さんの言葉を借りて"
    },
    {
      "startSec": 42.2,
      "text": "ここで皆さんにちょっと説明したいと思います。"
    },
    {
      "startSec": 48.6,
      "text": "これ本当に素敵な言葉。"
    },
    {
      "startSec": 51.3,
      "text": "「吾十有五にして学問に志す」という言葉です。"
    },
    {
      "startSec": 58.6,
      "text": "ちょっと昔の言葉なので"
    },
    {
      "startSec": 61.4,
      "text": "わかりやすく訳しながら(訳す=translate)"
    },
    {
      "startSec": 66,
      "text": "訳しながら説明したいと思います。"
    },
    {
      "startSec": 70.4,
      "text": "もう本当に私の大好きな言葉です。"
    },
    {
      "startSec": 74.5,
      "text": "はい、こんな言葉です。"
    },
    {
      "startSec": 76.7,
      "text": "「我十有五にして学に志す」"
    },
    {
      "startSec": 82.1,
      "text": "これは、私は十五歳の時に学ぶこと"
    },
    {
      "startSec": 88.6,
      "text": "学問、学ぶことをやりたい、"
    },
    {
      "startSec": 92.3,
      "text": "やろうと決めたという意味です。"
    },
    {
      "startSec": 96.1,
      "text": "だから十五歳の時に"
    },
    {
      "startSec": 98.8,
      "text": "学ぶことを決めた、始めたんですね。"
    },
    {
      "startSec": 103.9,
      "text": "次です、「三十にして立つ」"
    },
    {
      "startSec": 108.4,
      "text": "これは三十歳の時に、"
    },
    {
      "startSec": 112,
      "text": "この「立つ」は「自立する」という意味かな。"
    },
    {
      "startSec": 116.4,
      "text": "自立する(to be independent)"
    },
    {
      "startSec": 119,
      "text": "だから十五歳から三十歳までずっと学び続けて、"
    },
    {
      "startSec": 126.4,
      "text": "やっと三十歳でその学びの意味が"
    },
    {
      "startSec": 132.2,
      "text": "ベーシックがやっと三十歳でわかって"
    },
    {
      "startSec": 136.8,
      "text": "だから自立できた。"
    },
    {
      "startSec": 139.4,
      "text": "こんな意味です。"
    },
    {
      "startSec": 141.8,
      "text": "そして「四十にして惑はず」"
    },
    {
      "startSec": 146.2,
      "text": "四十歳の時に惑わない、"
    },
    {
      "startSec": 150.7,
      "text": "意味は迷うことがなくなった。"
    },
    {
      "startSec": 154.6,
      "text": "今までは「あれ、自分こうしたらいいのかな」"
    },
    {
      "startSec": 158.3,
      "text": "「ああしたらいいのかな」「あれはどうかな」って"
    },
    {
      "startSec": 161,
      "text": "たくさん悩んでいたけど、"
    },
    {
      "startSec": 164.6,
      "text": "四十歳でやっと迷わなくなった、こんな意味です。"
    },
    {
      "startSec": 171.6,
      "text": "はい次「五十にして天命を知る」"
    },
    {
      "startSec": 175.5,
      "text": "意味は五十歳で、やっと自分の運命(destiny)"
    },
    {
      "startSec": 182.8,
      "text": "それがやっとわかった。"
    },
    {
      "startSec": 185.4,
      "text": "自分が何をしたらいいか五十歳でやっとわかった。"
    },
    {
      "startSec": 192,
      "text": "そして次「六十にして耳順ふ(したがう)」"
    },
    {
      "startSec": 197,
      "text": "この意味は、六十歳でやっと他の人の意見、"
    },
    {
      "startSec": 204.8,
      "text": "他の人の話を、素直に聞くことができるようになった。"
    },
    {
      "startSec": 211,
      "text": "今までは他の人にアドバイスをもらったり"
    },
    {
      "startSec": 215.2,
      "text": "他の人があなたの為に話してくれたことを"
    },
    {
      "startSec": 219.6,
      "text": "ちゃんと聞けなかった。"
    },
    {
      "startSec": 221.9,
      "text": "でも六十歳で素直に人の話を聞けるようになった。"
    },
    {
      "startSec": 228.6,
      "text": "こういう意味です。"
    },
    {
      "startSec": 230,
      "text": "そして「七十にして心の欲する所に従へども 矩（のり）を踰えず（こえず）」"
    },
    {
      "startSec": 239.2,
      "text": "難しいけどこの意味は、"
    },
    {
      "startSec": 242.2,
      "text": "七十歳で自分がしたいことをしても"
    },
    {
      "startSec": 246.8,
      "text": "間違ったことをしなくなった。"
    },
    {
      "startSec": 249.8,
      "text": "やばいことはしなくなった。"
    },
    {
      "startSec": 252.3,
      "text": "いつも他の人のために"
    },
    {
      "startSec": 254.8,
      "text": "きっと行動ができるようになった。"
    },
    {
      "startSec": 258.2,
      "text": "こういう意味の言葉です。"
    },
    {
      "startSec": 260.5,
      "text": "ちょっと長かったんですが、皆さんどう思いますか？"
    },
    {
      "startSec": 266.7,
      "text": "私はやっぱり今の自分にすごく焦りがあるんですが、"
    },
    {
      "startSec": 273.3,
      "text": "この孔子さんも言っているように"
    },
    {
      "startSec": 277,
      "text": "十五歳から三十歳まではまだ学ぶ時です、勉強する時。"
    },
    {
      "startSec": 285.4,
      "text": "だからまだ焦って自分の道を決めなくても大丈夫。"
    },
    {
      "startSec": 293.2,
      "text": "色々やってみなさい、色々やってみて"
    },
    {
      "startSec": 297.4,
      "text": "それで決めたらいいよみたいな、"
    },
    {
      "startSec": 300.1,
      "text": "そういう言葉かなと思います。"
    },
    {
      "startSec": 303.8,
      "text": "でやっぱり、これは私の心の薬みたいな感じです。"
    },
    {
      "startSec": 310.5,
      "text": "この言葉を思い出すと、"
    },
    {
      "startSec": 313.2,
      "text": "「あ、もうちょっとゆっくり毎日大切にしよう」とか"
    },
    {
      "startSec": 320,
      "text": "もうちょっと自分を"
    },
    {
      "startSec": 322,
      "text": "大切にできる言葉です、私にとって。"
    },
    {
      "startSec": 326.3,
      "text": "皆さんはどう思いましたか？"
    },
    {
      "startSec": 329.4,
      "text": "自分の運命(Destiny)がわかるのは五十歳ですよ。"
    },
    {
      "startSec": 334.2,
      "text": "私はまだ時間があります。"
    },
    {
      "startSec": 337.2,
      "text": "六十歳で他の人の言うことを"
    },
    {
      "startSec": 342.1,
      "text": "聞くことができるようになる。"
    },
    {
      "startSec": 345.8,
      "text": "まだ時間はある。"
    },
    {
      "startSec": 347.9,
      "text": "まだ完璧じゃなくてもいいんだ、そういう風に思える"
    },
    {
      "startSec": 352.8,
      "text": "私が大好きな言葉でした。"
    },
    {
      "startSec": 357.9,
      "text": "良かったら皆さんの意見"
    },
    {
      "startSec": 360.7,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 363.6,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 367.1,
      "text": "また次のエピソードも聞いてくださいね。"
    },
    {
      "startSec": 370.3,
      "text": "じゃあまたね！バイバイ！"
    }
  ]
}
