{
  "episodeId": "h2L_JB1GqtE",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.1,
      "text": "私は、日本の学校で英語を勉強した時に"
    },
    {
      "startSec": 10.9,
      "text": "先生が、母音(vowel sound)、a・i・u・e・o"
    },
    {
      "startSec": 20,
      "text": "母音の前の\"the\"は"
    },
    {
      "startSec": 25.6,
      "text": "「ジ」と発音してくださいって言いました。"
    },
    {
      "startSec": 31.8,
      "text": "そういう風に英語は勉強しました。"
    },
    {
      "startSec": 35.9,
      "text": "これって本当ですか？"
    },
    {
      "startSec": 41.4,
      "text": "皆さんは母音の前は「ジ」って発音しますか？"
    },
    {
      "startSec": 47.7,
      "text": "例えば\"the apple\"・\"the eggs\"・\"the ink\""
    },
    {
      "startSec": 55.5,
      "text": "って発音しますか？"
    },
    {
      "startSec": 60.5,
      "text": "彼氏にこの話をした時に"
    },
    {
      "startSec": 63.6,
      "text": "彼氏は「いや、あまり考えたことがなかった」"
    },
    {
      "startSec": 68.7,
      "text": "と言っていました。"
    },
    {
      "startSec": 71,
      "text": "これは私ちょっとびっくりして"
    },
    {
      "startSec": 73.6,
      "text": "ええ？「ジ」じゃなかったの？"
    },
    {
      "startSec": 76.1,
      "text": "えっでも「じ」って習ったよ、「ジ アップル」「ジ エッグ」"
    },
    {
      "startSec": 83.2,
      "text": "「ジ インク」って勉強したよってね。"
    },
    {
      "startSec": 88.1,
      "text": "ちょっと「え!?えっ!?」と、分かりますか、なりました。"
    },
    {
      "startSec": 94.9,
      "text": "これはちょっとびっくり、本当に。"
    },
    {
      "startSec": 97.1,
      "text": "あ、やっぱり日本の英語の勉強は"
    },
    {
      "startSec": 103.5,
      "text": "まだまだ良くないなと。"
    },
    {
      "startSec": 106,
      "text": "もっとネイティブの本当に英語を話す人が"
    },
    {
      "startSec": 112.2,
      "text": "教科書を作らないといけないなって"
    },
    {
      "startSec": 115.7,
      "text": "すごく思いました。"
    },
    {
      "startSec": 117.8,
      "text": "あともう一つ"
    },
    {
      "startSec": 119.4,
      "text": "日本の学校で"
    },
    {
      "startSec": 122,
      "text": "英語を勉強する時のよく…何だろう？"
    },
    {
      "startSec": 125.7,
      "text": "勉強する時に…勉強したのは、すいません変な日本語で"
    },
    {
      "startSec": 133.1,
      "text": "Vの発音の時は、唇をかむ(bite)"
    },
    {
      "startSec": 142.3,
      "text": "唇(lip)をかむと勉強しました。"
    },
    {
      "startSec": 147.7,
      "text": "でもこれもちょっと違いますよね。"
    },
    {
      "startSec": 152.8,
      "text": "私も彼氏が英語を話しているのを見ますが、かんでないです。"
    },
    {
      "startSec": 160.8,
      "text": "唇はかんでない。"
    },
    {
      "startSec": 162.5,
      "text": "唇を多分振動させる、振動する(to vibrate)"
    },
    {
      "startSec": 171,
      "text": "振動させる…ですよね。"
    },
    {
      "startSec": 176.9,
      "text": "私も全然発音が上手くないんですが"
    },
    {
      "startSec": 180.5,
      "text": "これも学校で勉強したことです。"
    },
    {
      "startSec": 186.3,
      "text": "でもちょっと違う。"
    },
    {
      "startSec": 188.9,
      "text": "本当の英語じゃないです。"
    },
    {
      "startSec": 193.1,
      "text": "日本の英語の勉強は"
    },
    {
      "startSec": 196.4,
      "text": "本当にもっと文法とか単語がメインで"
    },
    {
      "startSec": 203.4,
      "text": "「ハロー、ハウアーユー？アイムファイン、サンキュー"
    },
    {
      "startSec": 207.3,
      "text": "アンド　ユー？」みたいな感じの"
    },
    {
      "startSec": 209.5,
      "text": "そういう英語を勉強します。"
    },
    {
      "startSec": 213.4,
      "text": "でジャックも今、日本の小学校・中学校で"
    },
    {
      "startSec": 219.1,
      "text": "英語を教えていますが、"
    },
    {
      "startSec": 221.5,
      "text": "本当に教科書の英語が"
    },
    {
      "startSec": 226.1,
      "text": "いやちょっとこれは不自然(unnatural)"
    },
    {
      "startSec": 230.8,
      "text": "と思うことが、よくあるそうです。"
    },
    {
      "startSec": 234.9,
      "text": "何で教科書を作る時に"
    },
    {
      "startSec": 237.3,
      "text": "ネイティブの人と一緒に作らなかったのか、"
    },
    {
      "startSec": 241.1,
      "text": "ちょっと分かりませんが"
    },
    {
      "startSec": 243.8,
      "text": "もうちょっと本当の英語を教えてほしいなぁと思います。"
    },
    {
      "startSec": 249.6,
      "text": "やっぱりあとは、英語を教えている"
    },
    {
      "startSec": 253.3,
      "text": "日本の先生が英語はあまり話せないです。"
    },
    {
      "startSec": 259.8,
      "text": "話せない人が多いです。"
    },
    {
      "startSec": 262.5,
      "text": "ジャックと一緒に仕事をしている"
    },
    {
      "startSec": 266,
      "text": "日本人の英語の先生は、"
    },
    {
      "startSec": 268.8,
      "text": "あんまり英語が話せなくて"
    },
    {
      "startSec": 271.3,
      "text": "ジャックが彼女とコミュニケーションを取るのが"
    },
    {
      "startSec": 276.7,
      "text": "すごく難しいって言っていました。"
    },
    {
      "startSec": 281.2,
      "text": "なんかこれはちょっとがっかり。"
    },
    {
      "startSec": 285.1,
      "text": "英語の先生なら、やっぱり英語の勉強はしてほしいし"
    },
    {
      "startSec": 290.2,
      "text": "もっと積極的に(willingly, positively)"
    },
    {
      "startSec": 297.2,
      "text": "ジャックに優しく"
    },
    {
      "startSec": 299.6,
      "text": "たくさんもっと英語で話してほしいなって"
    },
    {
      "startSec": 304,
      "text": "私は思います。"
    },
    {
      "startSec": 305.7,
      "text": "あとジャックが言っていたことは"
    },
    {
      "startSec": 308.9,
      "text": "彼女はあまり英語の"
    },
    {
      "startSec": 311.6,
      "text": "ニュアンスが分からないので"
    },
    {
      "startSec": 314.8,
      "text": "英語もあまりちゃんと分からないので"
    },
    {
      "startSec": 317.7,
      "text": "英語の文をすごくシンプルに言ってしまうので"
    },
    {
      "startSec": 325.4,
      "text": "ジャックは「彼女はすごく冷たく聞こえる」"
    },
    {
      "startSec": 330.5,
      "text": "と言っていました。"
    },
    {
      "startSec": 333.4,
      "text": "とか、彼女がジャックにメールを"
    },
    {
      "startSec": 336.8,
      "text": "送る時もよくピリオドで"
    },
    {
      "startSec": 341.4,
      "text": "文章を終える、終わりにするので"
    },
    {
      "startSec": 346.1,
      "text": "\"I understand.(ピリオド)\"みたいな感じだから"
    },
    {
      "startSec": 352.4,
      "text": "結構冷たく聞こえるとジャックは言っていました。"
    },
    {
      "startSec": 358.4,
      "text": "私はこれを聞いて「あ、私も気を付けないとなあ」"
    },
    {
      "startSec": 363.1,
      "text": "「気を付けないといけないな」と思いました。"
    },
    {
      "startSec": 366.6,
      "text": "今日はそういう日本の英語の話でした。"
    },
    {
      "startSec": 372.5,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 376.2,
      "text": "I hope you find it useful."
    },
    {
      "startSec": 379.1,
      "text": "もしリクエストとかあったら"
    },
    {
      "startSec": 382.4,
      "text": "ぜひコメントで教えてね。"
    },
    {
      "startSec": 384.8,
      "text": "じゃあ良い一日を！バイバイ！"
    },
    {
      "startSec": 387.3,
      "text": "お仕事・勉強頑張ってください！"
    }
  ]
}
