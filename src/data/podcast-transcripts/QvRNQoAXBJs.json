{
  "episodeId": "QvRNQoAXBJs",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.3,
      "text": "今日は、ご飯について話したいと思います。"
    },
    {
      "startSec": 9.9,
      "text": "皆さんはよく料理しますか？"
    },
    {
      "startSec": 14.8,
      "text": "どれくらい料理しますか？"
    },
    {
      "startSec": 18.5,
      "text": "じゃあ、最後にお店で、レストランとかカフェで"
    },
    {
      "startSec": 25.6,
      "text": "ご飯を食べたのはいつですか？"
    },
    {
      "startSec": 30.6,
      "text": "一ヶ月に何回くらい、外でお店でご飯を食べますか？"
    },
    {
      "startSec": 39.6,
      "text": "すみません、たくさん質問をして。"
    },
    {
      "startSec": 42.7,
      "text": "私はあんまり外でご飯は食べないです。"
    },
    {
      "startSec": 49.1,
      "text": "家でご飯を作る方が好きです。"
    },
    {
      "startSec": 54.4,
      "text": "特に私も彼氏も、夜は時間があります。"
    },
    {
      "startSec": 61.7,
      "text": "私も仕事は五時くらいに、できるだけやめますし"
    },
    {
      "startSec": 68.6,
      "text": "彼氏も四時半くらいに家に帰ってきます。"
    },
    {
      "startSec": 74,
      "text": "なので、私達は夜、ちゃんと時間があるので"
    },
    {
      "startSec": 79,
      "text": "いつもご飯を自分で作っています。"
    },
    {
      "startSec": 83.8,
      "text": "で、ご飯を家で作ることを「自炊する」と言います。"
    },
    {
      "startSec": 94.3,
      "text": "自炊の「じ」は自分の「自」で"
    },
    {
      "startSec": 98.6,
      "text": "「すい」はご飯を「炊く」"
    },
    {
      "startSec": 102.2,
      "text": "ご飯を作るという漢字です。"
    },
    {
      "startSec": 106.6,
      "text": "「自炊する」"
    },
    {
      "startSec": 108.8,
      "text": "私は彼氏と一緒に住む前は"
    },
    {
      "startSec": 112.8,
      "text": "あんまりご飯のことを気にしたことがなかった。"
    },
    {
      "startSec": 119.1,
      "text": "あんまりご飯を食べることを"
    },
    {
      "startSec": 123.6,
      "text": "楽しもうとしなかったです。"
    },
    {
      "startSec": 127.8,
      "text": "家族と住んでいた時も"
    },
    {
      "startSec": 130.3,
      "text": "ご飯は自分で作ることが多かったし、"
    },
    {
      "startSec": 134.4,
      "text": "やっぱり一人で作って一人で食べると"
    },
    {
      "startSec": 140.5,
      "text": "どうしてもなんか…手を抜いてしまいます。"
    },
    {
      "startSec": 146.4,
      "text": "手を抜く、抜く(withdraw)、手(hands)"
    },
    {
      "startSec": 151.4,
      "text": "だから、簡単なご飯を作ってしまう。"
    },
    {
      "startSec": 156.5,
      "text": "パソコンで仕事をしながら"
    },
    {
      "startSec": 159.3,
      "text": "食べたりとかよくしていました。"
    },
    {
      "startSec": 162.7,
      "text": "毎日同じものを食べていました。"
    },
    {
      "startSec": 167.2,
      "text": "よくおやつ(snacks)とかも食べていました。"
    },
    {
      "startSec": 173.1,
      "text": "でも彼氏と一緒に住むようになって"
    },
    {
      "startSec": 177.7,
      "text": "毎日、自分達でご飯を作るようになって"
    },
    {
      "startSec": 183.9,
      "text": "今はご飯が大好きになりました。"
    },
    {
      "startSec": 187.3,
      "text": "いつも、夜ご飯が一番幸せな時間。"
    },
    {
      "startSec": 193,
      "text": "もう待てないです。"
    },
    {
      "startSec": 194.2,
      "text": "いつも夜ご飯をすごく楽しみにしています。"
    },
    {
      "startSec": 199.4,
      "text": "やっぱり自分でご飯を作るようになって"
    },
    {
      "startSec": 203.8,
      "text": "自炊するようになって"
    },
    {
      "startSec": 205.8,
      "text": "「健康になったなぁ」とよく思います。"
    },
    {
      "startSec": 210.2,
      "text": "今は結構、添加物(chemicals,additives)"
    },
    {
      "startSec": 216,
      "text": "例えばお弁当をスーパーで買ったら"
    },
    {
      "startSec": 219.9,
      "text": "ちょっと添加物の味がします。"
    },
    {
      "startSec": 224.2,
      "text": "それに敏感になった。敏感(sensitive)。"
    },
    {
      "startSec": 230.4,
      "text": "よく気が付くようになりました。"
    },
    {
      "startSec": 233.8,
      "text": "本当に最近はよく添加物の味に気が付きます。"
    },
    {
      "startSec": 239.1,
      "text": "で、前は、昔は、甘いものは大好きで"
    },
    {
      "startSec": 245,
      "text": "本当にたくさん甘いもの、食べることができました。"
    },
    {
      "startSec": 250.2,
      "text": "ケーキを三個、一回に食べるとか簡単にできました。"
    },
    {
      "startSec": 256.9,
      "text": "簡単にできる、楽にできる=余裕でした。"
    },
    {
      "startSec": 265.9,
      "text": "でも今はちょっと難しくなりました。"
    },
    {
      "startSec": 269.4,
      "text": "やっぱりあんまり、砂糖(sugar)を食べなくなったので"
    },
    {
      "startSec": 275.8,
      "text": "甘いものはたくさん食べることが"
    },
    {
      "startSec": 279.2,
      "text": "できなくなりました。"
    },
    {
      "startSec": 281.7,
      "text": "でも本当に今は、ちゃんとご飯を作って、"
    },
    {
      "startSec": 286.8,
      "text": "自分で作ってたくさん食べるから"
    },
    {
      "startSec": 291.5,
      "text": "一回ご飯を、朝ご飯とか夜ご飯食べたら"
    },
    {
      "startSec": 296.5,
      "text": "五時間とか六時間くらいは"
    },
    {
      "startSec": 300.2,
      "text": "全然大丈夫、お腹が空かない。"
    },
    {
      "startSec": 304.4,
      "text": "おやつを食べなくても大丈夫です。"
    },
    {
      "startSec": 308.2,
      "text": "でも昔は二時間ごとに(every 2hrs)"
    },
    {
      "startSec": 315.3,
      "text": "おやつ食べていました。"
    },
    {
      "startSec": 319.7,
      "text": "もう今はあんまり食べなくなって"
    },
    {
      "startSec": 322.6,
      "text": "でも一回に食べる量は増えました。"
    },
    {
      "startSec": 328.1,
      "text": "本当にもうたくさん、いつも夜ご飯を食べていて"
    },
    {
      "startSec": 333.1,
      "text": "ちょっと体重(weight)も増えました。"
    },
    {
      "startSec": 338.8,
      "text": "で、私が最近よく作るのは手巻き寿司です。"
    },
    {
      "startSec": 345,
      "text": "手巻き寿司、これは海苔巻きと似てるかな。"
    },
    {
      "startSec": 350.9,
      "text": "でもすっごく簡単。"
    },
    {
      "startSec": 352.9,
      "text": "海苔とご飯と、あと野菜と"
    },
    {
      "startSec": 357.1,
      "text": "中に入れたい食べ物があったらできます。"
    },
    {
      "startSec": 361.3,
      "text": "海苔にご飯を置いて"
    },
    {
      "startSec": 364,
      "text": "その上に…私はきゅうりがすごく好きです。"
    },
    {
      "startSec": 367.6,
      "text": "きゅうり(cucumber)を切って、ちょっと入れて"
    },
    {
      "startSec": 370.7,
      "text": "あとツナがおいしいです。"
    },
    {
      "startSec": 373.2,
      "text": "マヨネーズツナとか、あと卵とかを入れて"
    },
    {
      "startSec": 378.2,
      "text": "ちょっとおにぎりみたいにちょっと丸くして"
    },
    {
      "startSec": 381.4,
      "text": "カプッと食べるのが私のお気に入りです。"
    },
    {
      "startSec": 386.1,
      "text": "本当においしいので、皆さんも是非作ってみてください。"
    },
    {
      "startSec": 391.3,
      "text": "もうめっちゃ簡単。"
    },
    {
      "startSec": 392.4,
      "text": "ご飯と海苔と、あときゅうりと、ツナと卵がオススメ。"
    },
    {
      "startSec": 401.4,
      "text": "もうこれがあったら、すぐできます。"
    },
    {
      "startSec": 403.9,
      "text": "で、すっごく楽しい。"
    },
    {
      "startSec": 405.5,
      "text": "作って食べるのが楽しいです。"
    },
    {
      "startSec": 408.1,
      "text": "是非作ってみてください。"
    },
    {
      "startSec": 411.8,
      "text": "じゃ今日のエピソードはここまでです。"
    },
    {
      "startSec": 414.8,
      "text": "いつも聞いてくれて"
    },
    {
      "startSec": 416.5,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 419.3,
      "text": "じゃあまた明日会いましょう。"
    },
    {
      "startSec": 421.4,
      "text": "またね～！また明日！"
    }
  ]
}
