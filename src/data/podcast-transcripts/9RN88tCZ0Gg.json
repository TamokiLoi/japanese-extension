{
  "episodeId": "9RN88tCZ0Gg",
  "segments": [
    {
      "startSec": 1.1,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.9,
      "text": "今日は「あきらめ」を表すフレーズを"
    },
    {
      "startSec": 11.3,
      "text": "五つ、五個教えたいと思います。"
    },
    {
      "startSec": 15.6,
      "text": "あきらめは後悔と違って"
    },
    {
      "startSec": 19.7,
      "text": "後悔は昔の、前にしたことを、"
    },
    {
      "startSec": 24.6,
      "text": "「あ、しなかったらよかったな」って思うこと。"
    },
    {
      "startSec": 29.7,
      "text": "で、あきらめ、これは"
    },
    {
      "startSec": 32.6,
      "text": "これからあること、未来のことを"
    },
    {
      "startSec": 36.6,
      "text": "「はぁ、もうできない。いやもう無理だ」"
    },
    {
      "startSec": 40.1,
      "text": "みたいにギブアップすることです。"
    },
    {
      "startSec": 43.8,
      "text": "じゃあ、あきらめのフレーズ五ついってみましょう。"
    },
    {
      "startSec": 48.6,
      "text": "頑張りましょう。"
    },
    {
      "startSec": 50.6,
      "text": "じゃあ一つ目。"
    },
    {
      "startSec": 52.7,
      "text": "一つ目は「〇〇わけない」です。"
    },
    {
      "startSec": 60.3,
      "text": "または「わけがない」"
    },
    {
      "startSec": 63.5,
      "text": "例えば「私がテストに受かってるわけがない」"
    },
    {
      "startSec": 71.5,
      "text": "「テストに受かってるわけない」"
    },
    {
      "startSec": 74.7,
      "text": "テスト勉強あんまりしなかったし"
    },
    {
      "startSec": 78.7,
      "text": "全然問題がわからなかったから"
    },
    {
      "startSec": 83,
      "text": "「もう私が受かってるわけない」みたいな感じです。"
    },
    {
      "startSec": 88.3,
      "text": "あとは、よく使うのは「そんなわけないでしょ」"
    },
    {
      "startSec": 98.8,
      "text": "これは「それは違う、それは絶対違う」という意味です。"
    },
    {
      "startSec": 108.1,
      "text": "「そんなわけないでしょ」怒った時とかによく使います。"
    },
    {
      "startSec": 116.6,
      "text": "とか、これも怒った時に使います。"
    },
    {
      "startSec": 120.3,
      "text": "「そんなわけあるか！」"
    },
    {
      "startSec": 125.7,
      "text": "これは「そんなわけある？か(いやない)」"
    },
    {
      "startSec": 133.4,
      "text": "いやいやいや、それはない、そんなわけはない。"
    },
    {
      "startSec": 136.7,
      "text": "これがこの「そんなわけあるか」の後に"
    },
    {
      "startSec": 140.7,
      "text": "隠れているんですね。"
    },
    {
      "startSec": 142.8,
      "text": "だから「そんなわけあるか」"
    },
    {
      "startSec": 145.2,
      "text": "つまり「そんなわけがない」という意味です。"
    },
    {
      "startSec": 151.3,
      "text": "例えば友達が私に、"
    },
    {
      "startSec": 153.9,
      "text": "「レイラ、ちょっとお腹大きくなった？えっ妊娠したの？」"
    },
    {
      "startSec": 160.8,
      "text": "妊娠する(pregnant)"
    },
    {
      "startSec": 164,
      "text": "だから妊娠したの？って聞きました。"
    },
    {
      "startSec": 167.5,
      "text": "じゃあ私は妊娠してない、ただ太っただけです。"
    },
    {
      "startSec": 173.2,
      "text": "だから私は「いや、そんなわけあるか」"
    },
    {
      "startSec": 178.2,
      "text": "って友達に言うことができます。"
    },
    {
      "startSec": 181.8,
      "text": "「そんなわけあるか」便利なフレーズです。"
    },
    {
      "startSec": 187.1,
      "text": "じゃあ二つ目。"
    },
    {
      "startSec": 188.8,
      "text": "二つ目は「どうせ」"
    },
    {
      "startSec": 193.7,
      "text": "例えば「どうせ私はダメだよ」"
    },
    {
      "startSec": 198.8,
      "text": "意味は「私は頑張っても絶対に自分を変えることはできない」"
    },
    {
      "startSec": 207.3,
      "text": "「だからどうせ頑張っても、何をしても自分はダメだ」"
    },
    {
      "startSec": 215.7,
      "text": "「自分はダメな人間だ」みたいな意味です。"
    },
    {
      "startSec": 220.3,
      "text": "もう諦めてます。"
    },
    {
      "startSec": 222.8,
      "text": "「どうせ私の人生はダメだよ」悲しいです。"
    },
    {
      "startSec": 229.3,
      "text": "あとは例えば、山田君という人は毎日お酒を飲みに行きます。"
    },
    {
      "startSec": 239.8,
      "text": "あなたが「山田君は毎日飲み歩いているね」"
    },
    {
      "startSec": 245.5,
      "text": "飲み歩く＝飲んで歩く"
    },
    {
      "startSec": 248.4,
      "text": "もう毎日飲みまくってるみたいな意味。"
    },
    {
      "startSec": 252,
      "text": "「山田君は毎日飲み歩いてるね」"
    },
    {
      "startSec": 256.6,
      "text": "そこで私が「どうせまた彼女に振られるよ」"
    },
    {
      "startSec": 264,
      "text": "「どうせ山田君は、また彼女に振られるよ」"
    },
    {
      "startSec": 271,
      "text": "また彼女に別れようって言われる、そういう意味。"
    },
    {
      "startSec": 277.5,
      "text": "あとは、いつもお父さんが帰って来るのが遅かったら"
    },
    {
      "startSec": 283.8,
      "text": "「はぁ～今日は私の誕生日だけど"
    },
    {
      "startSec": 288.1,
      "text": "どうせパパは遅く帰ってくるな」"
    },
    {
      "startSec": 292.5,
      "text": "「どうせパパは遅く帰ってくるよ」みたいな感じで"
    },
    {
      "startSec": 297.4,
      "text": "使うことができます。"
    },
    {
      "startSec": 299.5,
      "text": "じゃあ三つ目。"
    },
    {
      "startSec": 301.5,
      "text": "三つ目は「〇〇とは思えない」"
    },
    {
      "startSec": 310.2,
      "text": "例えば「やっぱりテストに受かってるとは思えない」"
    },
    {
      "startSec": 317.6,
      "text": "「受かっていないと思う」という意味です。"
    },
    {
      "startSec": 321.8,
      "text": "例えば「私はかわいくないから"
    },
    {
      "startSec": 326.9,
      "text": "山田君と付き合えるとは思えない」"
    },
    {
      "startSec": 331.8,
      "text": "ネガティブ、ちょっと悲しいけどこんな感じで使えます。"
    },
    {
      "startSec": 336.4,
      "text": "じゃあ次四つ目。"
    },
    {
      "startSec": 338.8,
      "text": "フレーズ四つ目は「〇〇はずがない」です。"
    },
    {
      "startSec": 346.7,
      "text": "「テストに受かるはずがない」"
    },
    {
      "startSec": 350.4,
      "text": "つまりテストに絶対受からない。"
    },
    {
      "startSec": 354.7,
      "text": "「テストに受かるはずがない」とか"
    },
    {
      "startSec": 359.4,
      "text": "「彼女と付き合えるはずがない」"
    },
    {
      "startSec": 363,
      "text": "彼女と絶対に付き合えないという意味です。"
    },
    {
      "startSec": 368.1,
      "text": "じゃあ最後五つ目。"
    },
    {
      "startSec": 371.1,
      "text": "五つ目は「今更」です。"
    },
    {
      "startSec": 375.3,
      "text": "何かを言う前に一番最初に「今更」を言います。"
    },
    {
      "startSec": 381.7,
      "text": "例えば「今更テスト勉強をしてもテストに受かるはずがない」"
    },
    {
      "startSec": 391.6,
      "text": "「今更」は、今から頑張っても、もう遅いという意味です。"
    },
    {
      "startSec": 399.8,
      "text": "だから「今更謝っても、もう遅いよ」とか"
    },
    {
      "startSec": 407.2,
      "text": "「今更ダイエットしても、もう遅いよ」"
    },
    {
      "startSec": 413.1,
      "text": "「今更学校に行っても、もう遅いよ」"
    },
    {
      "startSec": 418.2,
      "text": "みたいな感じで使います。"
    },
    {
      "startSec": 421.5,
      "text": "今日は「あきらめ」を表す五つの言葉を勉強しました。"
    },
    {
      "startSec": 429.4,
      "text": "一「わけない」"
    },
    {
      "startSec": 431.8,
      "text": "二「どうせ」"
    },
    {
      "startSec": 434,
      "text": "三「とは思えない」"
    },
    {
      "startSec": 437.4,
      "text": "四「はずがない」"
    },
    {
      "startSec": 440,
      "text": "五「今更」です。"
    },
    {
      "startSec": 443.6,
      "text": "どうでしたか？難しかったかな？"
    },
    {
      "startSec": 446.6,
      "text": "皆さんがこのポッドキャストを"
    },
    {
      "startSec": 449.1,
      "text": "楽しんでくれたら嬉しいです。"
    },
    {
      "startSec": 452.3,
      "text": "もしリクエストとかアドバイスがあったら"
    },
    {
      "startSec": 456.2,
      "text": "YouTubeのコメントに書いてください。"
    },
    {
      "startSec": 459.6,
      "text": "それか私にメールを送ってください。"
    },
    {
      "startSec": 463.4,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 465.2,
      "text": "本当に聞いてくれて嬉しいです。"
    },
    {
      "startSec": 468.5,
      "text": "じゃあ今日もお仕事・勉強、頑張ってください。"
    },
    {
      "startSec": 472.4,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
