{
  "episodeId": "OfwCc6teuaw",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "今日は「日本人はあんまり下品な言葉を使わない」"
    },
    {
      "startSec": 11.1,
      "text": "というタイトルで話をしたいと思います。"
    },
    {
      "startSec": 14.7,
      "text": "「下品」これは「上品」の反対(opposite)の言葉。"
    },
    {
      "startSec": 22.1,
      "text": "「下品」は「口が悪い」"
    },
    {
      "startSec": 24.9,
      "text": "「きれいじゃない」「良くない」"
    },
    {
      "startSec": 27.1,
      "text": "「丁寧じゃない」という意味かな。"
    },
    {
      "startSec": 30.3,
      "text": "「上品」は逆です、反対です。"
    },
    {
      "startSec": 33.8,
      "text": "「上品」は「綺麗」「丁寧」「親切」という意味です。"
    },
    {
      "startSec": 41.2,
      "text": "で、日本人は下品な言葉はあんまり使わないです。"
    },
    {
      "startSec": 48.2,
      "text": "特に英語と比べるとそうです。"
    },
    {
      "startSec": 52.1,
      "text": "英語ってすごく下品な言葉めっちゃ多くないですか？"
    },
    {
      "startSec": 60,
      "text": "やっぱり英語を勉強するようになって"
    },
    {
      "startSec": 63.9,
      "text": "本当にそれはよく思うんですよね。"
    },
    {
      "startSec": 68.6,
      "text": "やっぱり映画を見ていると"
    },
    {
      "startSec": 71.9,
      "text": "なんか「いや、すごいな」と思う時が"
    },
    {
      "startSec": 75.4,
      "text": "よくあるんですよね。"
    },
    {
      "startSec": 78.1,
      "text": "下品な言葉ばっかりでしゃべってるような映画も"
    },
    {
      "startSec": 82.9,
      "text": "よくありますよね。"
    },
    {
      "startSec": 85,
      "text": "でも日本ではそれはあまりないです。"
    },
    {
      "startSec": 89.2,
      "text": "あんまりない、全然ない。"
    },
    {
      "startSec": 91.6,
      "text": "あと歌もそうです。"
    },
    {
      "startSec": 93.8,
      "text": "英語の歌は、すごく歌詞(lyrics)が"
    },
    {
      "startSec": 100.3,
      "text": "やばい歌がありますよね。"
    },
    {
      "startSec": 103.3,
      "text": "ニッキー・ミナージュとかの歌とかも"
    },
    {
      "startSec": 105.6,
      "text": "すごい歌がありますよね。"
    },
    {
      "startSec": 108.4,
      "text": "でもそういうのは日本には絶対ないと思います。"
    },
    {
      "startSec": 114.2,
      "text": "でもコンビニに行くと"
    },
    {
      "startSec": 116.8,
      "text": "やばい漫画とかが売っています。"
    },
    {
      "startSec": 120.4,
      "text": "すごく不思議です。"
    },
    {
      "startSec": 124.7,
      "text": "よく分かりません。"
    },
    {
      "startSec": 128.6,
      "text": "でも日本だったらやっぱり「バカ」「バカ野郎」"
    },
    {
      "startSec": 132.8,
      "text": "「アホウ」「お前何言ってんねん」とか"
    },
    {
      "startSec": 136.7,
      "text": "そういう、人を下に言う"
    },
    {
      "startSec": 140.6,
      "text": "上から目線の言葉はあると思う。"
    },
    {
      "startSec": 145,
      "text": "でも英語みたいに…private partsとかを"
    },
    {
      "startSec": 154.4,
      "text": "悪口として使うことはないです。"
    },
    {
      "startSec": 159.4,
      "text": "うん、ないです。"
    },
    {
      "startSec": 163.3,
      "text": "この前ポッドキャストのコメントを読んでいたら"
    },
    {
      "startSec": 167.8,
      "text": "すごく面白くて"
    },
    {
      "startSec": 169.7,
      "text": "「日本語を話した時と英語を話した時で"
    },
    {
      "startSec": 175.1,
      "text": "皆さんの性格が変わりますか？」"
    },
    {
      "startSec": 179.8,
      "text": "と質問をしたんですね。"
    },
    {
      "startSec": 183.2,
      "text": "すると、日本語を話す時は声が小さくなって"
    },
    {
      "startSec": 189.2,
      "text": "丁寧に話すことが多いというコメントを"
    },
    {
      "startSec": 194.3,
      "text": "たくさんもらいました。"
    },
    {
      "startSec": 196.5,
      "text": "結構日本語は丁寧な言語(language)なのかなと、"
    },
    {
      "startSec": 203.3,
      "text": "文化なのかなと思います。"
    },
    {
      "startSec": 206.8,
      "text": "であとは日本人は皮肉(sarcasm)もあんまり言わない。"
    },
    {
      "startSec": 214.1,
      "text": "よくアメリカの映画とかで"
    },
    {
      "startSec": 216.8,
      "text": "例えば人がこうぶつかって"
    },
    {
      "startSec": 219.7,
      "text": "コーヒーが自分のスーツにこぼれて"
    },
    {
      "startSec": 223.8,
      "text": "\"Thank YOU!!\"みたいな…ありますよね。"
    },
    {
      "startSec": 227.1,
      "text": "すごい皮肉。"
    },
    {
      "startSec": 228.5,
      "text": "本当は怒ってるけど"
    },
    {
      "startSec": 230,
      "text": "\"Thank YOU!!\"みたいな、言いますよね。"
    },
    {
      "startSec": 232.7,
      "text": "そういうのは日本にはない。"
    },
    {
      "startSec": 235.6,
      "text": "もし日本で誰かにコーヒーをこぼされて"
    },
    {
      "startSec": 241.1,
      "text": "「ありがとうございます」とか言ったら"
    },
    {
      "startSec": 244.7,
      "text": "すごく変なおかしな人ですよね。"
    },
    {
      "startSec": 248.9,
      "text": "日本人はそういう皮肉は全然言わないです。"
    },
    {
      "startSec": 253.7,
      "text": "なので、私の彼氏はイギリス人で"
    },
    {
      "startSec": 258.7,
      "text": "もちろんブラックジョークを"
    },
    {
      "startSec": 260.5,
      "text": "すごくたくさん言うんですね。"
    },
    {
      "startSec": 263.8,
      "text": "でもジョークを言いすぎて"
    },
    {
      "startSec": 267.5,
      "text": "なんか…何を言ってるのか"
    },
    {
      "startSec": 271.2,
      "text": "分からない時が時々あります。"
    },
    {
      "startSec": 275.2,
      "text": "私はもちろん日本人なので"
    },
    {
      "startSec": 278.8,
      "text": "そういう皮肉なジョークに全然慣れていません。"
    },
    {
      "startSec": 285.1,
      "text": "だから結構ジョークを聞いて信じちゃって"
    },
    {
      "startSec": 291.3,
      "text": "ショックを受けることもよくあります。"
    },
    {
      "startSec": 295.9,
      "text": "1個、すごく恥ずかしかったのが"
    },
    {
      "startSec": 300.4,
      "text": "ジャックのお母さんに初めて会って"
    },
    {
      "startSec": 303.6,
      "text": "ジャックとジャックのお母さんと私で"
    },
    {
      "startSec": 307.4,
      "text": "カフェに行ったことがあります。"
    },
    {
      "startSec": 310.2,
      "text": "その時コンテクストは"
    },
    {
      "startSec": 312.2,
      "text": "ちょっと忘れてしまったんですが"
    },
    {
      "startSec": 315.2,
      "text": "ジャックが「Ta-da! レイラが妊娠しました」"
    },
    {
      "startSec": 319.9,
      "text": "って言った時があって"
    },
    {
      "startSec": 321.9,
      "text": "で、お母さんは笑っていたんですが"
    },
    {
      "startSec": 324.5,
      "text": "私はむちゃくちゃ恥ずかしくて"
    },
    {
      "startSec": 328.4,
      "text": "もうむちゃくちゃ恥ずかしくて顔が赤くなって"
    },
    {
      "startSec": 333.8,
      "text": "笑えなかったという。"
    },
    {
      "startSec": 335.5,
      "text": "本当にそういう変なジョークを"
    },
    {
      "startSec": 338.9,
      "text": "ジャックはよく言います。"
    },
    {
      "startSec": 341.1,
      "text": "私は本当にわかんない、けど"
    },
    {
      "startSec": 344.2,
      "text": "でも最近はちょっと…"
    },
    {
      "startSec": 346.3,
      "text": "いやでもやっぱり慣れないです。"
    },
    {
      "startSec": 350.5,
      "text": "日本人の性格はなかなか変えることが難しいです。"
    },
    {
      "startSec": 356.2,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 357.7,
      "text": "いつも聞いてくれてありがとう。"
    },
    {
      "startSec": 360.5,
      "text": "リクエストとか質問あったら"
    },
    {
      "startSec": 364.8,
      "text": "YouTubeのコメントで教えてください。"
    },
    {
      "startSec": 368.2,
      "text": "レビューを書いてくれると本当に嬉しいです。"
    },
    {
      "startSec": 371.5,
      "text": "いつも言うけど、是非お願いします。"
    },
    {
      "startSec": 374.7,
      "text": "パトレオンでトランスクリプト"
    },
    {
      "startSec": 377.2,
      "text": "皆さんにシェアしています。"
    },
    {
      "startSec": 379.5,
      "text": "よかったらゲットして皆さんの勉強に使ってください。"
    },
    {
      "startSec": 385.2,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 386.6,
      "text": "いつもありがとう！"
    },
    {
      "startSec": 387.9,
      "text": "またね、バイバイ！"
    }
  ]
}
