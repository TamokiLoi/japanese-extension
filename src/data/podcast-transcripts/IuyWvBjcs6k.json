{
  "episodeId": "IuyWvBjcs6k",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "今日は最近、私があまりできていないこと"
    },
    {
      "startSec": 11.5,
      "text": "ちょっともっと自分を変えたい、"
    },
    {
      "startSec": 15.8,
      "text": "変わりたいと思うことがあります。"
    },
    {
      "startSec": 19.4,
      "text": "それについて話してみたいと思います。"
    },
    {
      "startSec": 24.5,
      "text": "それはですね、"
    },
    {
      "startSec": 26.2,
      "text": "ズバリ(to be frank, to be honest)"
    },
    {
      "startSec": 32.4,
      "text": "はっきり言うと、みたいな感じかな。"
    },
    {
      "startSec": 35.9,
      "text": "ずばり今この瞬間(the moment)"
    },
    {
      "startSec": 42.9,
      "text": "時間に集中できない。"
    },
    {
      "startSec": 47.1,
      "text": "いつも次の事、未来の事を考えてしまうんですね。"
    },
    {
      "startSec": 54.2,
      "text": "やっぱりこれはすごく問題で。"
    },
    {
      "startSec": 58.8,
      "text": "だって考えたらわかるんですけど"
    },
    {
      "startSec": 62.3,
      "text": "やっぱり今って今しかないし、"
    },
    {
      "startSec": 66.3,
      "text": "どれだけたくさん未来のことを考えても"
    },
    {
      "startSec": 71.3,
      "text": "それって未来のことなんですよね。"
    },
    {
      "startSec": 74.9,
      "text": "頭の中にだけあることで"
    },
    {
      "startSec": 78.5,
      "text": "やっぱり今を大事にしないと人生は大切にできない、"
    },
    {
      "startSec": 84.6,
      "text": "自分は大切にできないと思うんです。"
    },
    {
      "startSec": 89,
      "text": "でそれは、その通りだと思うし。"
    },
    {
      "startSec": 92.9,
      "text": "やっぱり最近は忙しいのもあるけど"
    },
    {
      "startSec": 96.1,
      "text": "この後はあれをして、この後その後はこれをして、"
    },
    {
      "startSec": 100.4,
      "text": "今日はこれだけ全部終わったから"
    },
    {
      "startSec": 102.5,
      "text": "明日はこれをしてあれをしてみたいに"
    },
    {
      "startSec": 105.6,
      "text": "ずっと、しないといけないことばかり考えていて"
    },
    {
      "startSec": 112.5,
      "text": "やっぱりすごく心が疲れますね。"
    },
    {
      "startSec": 119,
      "text": "すごくしんどくなるし。"
    },
    {
      "startSec": 121.7,
      "text": "やっぱりジャックと一緒にいる時間を"
    },
    {
      "startSec": 125.2,
      "text": "もっと大切にしないといけないなと思っています。"
    },
    {
      "startSec": 131.3,
      "text": "考えたらこのことはわかるんですけど"
    },
    {
      "startSec": 137.5,
      "text": "なんかどうしても"
    },
    {
      "startSec": 138.9,
      "text": "それを変えることが難しいんですよね。"
    },
    {
      "startSec": 142.7,
      "text": "もちろんその理由は、未来のために、"
    },
    {
      "startSec": 146.1,
      "text": "自分やジャックの将来のために"
    },
    {
      "startSec": 149.6,
      "text": "今頑張らないといけないって"
    },
    {
      "startSec": 152.5,
      "text": "思っていることもあります。"
    },
    {
      "startSec": 155.4,
      "text": "だって今頑張らないと、自分がやらないと"
    },
    {
      "startSec": 160.1,
      "text": "目標は達成(achieve)できないですもんね。"
    },
    {
      "startSec": 166,
      "text": "やっぱりそれが頭にあるから"
    },
    {
      "startSec": 168.4,
      "text": "どうしてもタスク、やらないといけないことばかり"
    },
    {
      "startSec": 174.1,
      "text": "気にしてしまっていて…"
    },
    {
      "startSec": 176.2,
      "text": "言葉にできないですね"
    },
    {
      "startSec": 178.4,
      "text": "もうちょっと、何だろう…"
    },
    {
      "startSec": 182.7,
      "text": "今を大事にしないとヤバイなと思っています。"
    },
    {
      "startSec": 188,
      "text": "皆さんはこんな風に思ったことありますか？"
    },
    {
      "startSec": 193.1,
      "text": "その時どうやって、もっと今の時間を"
    },
    {
      "startSec": 197.3,
      "text": "大切にできるようになりましたか？"
    },
    {
      "startSec": 200.9,
      "text": "是非教えてください。"
    },
    {
      "startSec": 204.6,
      "text": "本当に忙しいのもあるし、"
    },
    {
      "startSec": 207.5,
      "text": "スケジュールが多いのもあるし。"
    },
    {
      "startSec": 210.8,
      "text": "でも本当にもっと今の時間を大切にして"
    },
    {
      "startSec": 217.4,
      "text": "楽しくしたいです。"
    },
    {
      "startSec": 220.8,
      "text": "頑張ります。"
    },
    {
      "startSec": 223.6,
      "text": "頑張りたいと思います。"
    },
    {
      "startSec": 226.1,
      "text": "今日はこれについて"
    },
    {
      "startSec": 228.3,
      "text": "ちょっと話してみたかったです。"
    },
    {
      "startSec": 231.4,
      "text": "良かったら皆さんの意見(opinion)"
    },
    {
      "startSec": 236.5,
      "text": "意見をコメントで教えてくれると嬉しいです。"
    },
    {
      "startSec": 242.9,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 245.2,
      "text": "また次のエピソードで会いましょう！バイバイ！"
    }
  ]
}
