{
  "episodeId": "o4vvfOZ2ehY",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4,
      "text": "今日はサイン、例えばCould you sign here please? のサイン。"
    },
    {
      "startSec": 9.6,
      "text": "書類(paper)に自分のサインを書きますよね？"
    },
    {
      "startSec": 14.5,
      "text": "そのサインの話をしたいと思います。"
    },
    {
      "startSec": 20.6,
      "text": "日本のサインについてです。"
    },
    {
      "startSec": 23.9,
      "text": "これもInstagramで、この前ビデオを作りました。"
    },
    {
      "startSec": 29.8,
      "text": "サインについてのビデオです。"
    },
    {
      "startSec": 32.9,
      "text": "その時のビデオの話はもう本当にあった話で"
    },
    {
      "startSec": 39.4,
      "text": "ちょっとその話を皆さんと今日はしたいと思います。"
    },
    {
      "startSec": 45,
      "text": "日本ではよくサインとハンコ(stamp)が必要になります。"
    },
    {
      "startSec": 54.1,
      "text": "例えば私は、最近は大学を休学、"
    },
    {
      "startSec": 60,
      "text": "休学は長く学校を休むことです。"
    },
    {
      "startSec": 63.7,
      "text": "休学するための書類(paper)に"
    },
    {
      "startSec": 67.8,
      "text": "サインをしてハンコを押して、大学に送りました。"
    },
    {
      "startSec": 73.9,
      "text": "日本では、サインは普通に自分の名前、フルネーム、"
    },
    {
      "startSec": 81.6,
      "text": "ファミリーネームとファーストネームを"
    },
    {
      "startSec": 84,
      "text": "普通に漢字で書きます。"
    },
    {
      "startSec": 87.8,
      "text": "これが日本人のサインです。"
    },
    {
      "startSec": 91.5,
      "text": "でも、もちろん外国、海外ではちょっと違いますよね。"
    },
    {
      "startSec": 98.8,
      "text": "皆さんブルース・ブラザーズ見たことありますか？"
    },
    {
      "startSec": 103,
      "text": "ジェイクが刑務所(prison)を出る時に"
    },
    {
      "startSec": 108.1,
      "text": "紙にサインをするんですが、"
    },
    {
      "startSec": 111.2,
      "text": "その時彼はもうＸみたいに、ピシッピシッて"
    },
    {
      "startSec": 115.5,
      "text": "書いただけでした。"
    },
    {
      "startSec": 117.4,
      "text": "あれはとてもよく覚えています。"
    },
    {
      "startSec": 120.6,
      "text": "「あ～面白いな」と思いました"
    },
    {
      "startSec": 123.9,
      "text": "なので、外国のサインと日本のサインは全然違います。"
    },
    {
      "startSec": 131,
      "text": "実はこの前、1週間前にジャックと病院に行きました。"
    },
    {
      "startSec": 138.3,
      "text": "ジャックの3回目の"
    },
    {
      "startSec": 140.8,
      "text": "コロナのワクチンのために行きました。"
    },
    {
      "startSec": 146.2,
      "text": "その時は私は一応通訳するために(to translate his English)"
    },
    {
      "startSec": 152.2,
      "text": "彼と一緒にお医者さんに会いました。"
    },
    {
      "startSec": 156.7,
      "text": "その時に先生がジャックに、"
    },
    {
      "startSec": 159.7,
      "text": "「じゃあこの紙を全部読んだらサインしてください」"
    },
    {
      "startSec": 164.9,
      "text": "と言いました。"
    },
    {
      "startSec": 167.3,
      "text": "その時に私が一応(just in case)"
    },
    {
      "startSec": 172.1,
      "text": "英語でいいですか？って聞きました。"
    },
    {
      "startSec": 176.8,
      "text": "で、お医者さんは「いいですよ」と言ったので"
    },
    {
      "startSec": 180.8,
      "text": "私はジャックに「あ、ジャック、英語でいいよって」と"
    },
    {
      "startSec": 185.6,
      "text": "言ったんですね、ジャックに。"
    },
    {
      "startSec": 187.1,
      "text": "「英語で書いていいよ」って。"
    },
    {
      "startSec": 188.9,
      "text": "そしたらジャックはクシュクシュって読めない"
    },
    {
      "startSec": 192.9,
      "text": "あのシンボルみたいな感じですね。"
    },
    {
      "startSec": 195.7,
      "text": "クシュクシュって何か分からないことを"
    },
    {
      "startSec": 198.6,
      "text": "まあ彼のサインですが、書いて、"
    },
    {
      "startSec": 201.7,
      "text": "そしたらお医者さんが"
    },
    {
      "startSec": 205.6,
      "text": "そのジャックのサインをこうやって見て"
    },
    {
      "startSec": 210.9,
      "text": "「なかなかシンプルですね」と言いました。"
    },
    {
      "startSec": 221.3,
      "text": "いや面白かったですね。"
    },
    {
      "startSec": 223,
      "text": "めっちゃ笑いました。"
    },
    {
      "startSec": 224.9,
      "text": "で、その後、一応サインの横にローマ字で"
    },
    {
      "startSec": 231.4,
      "text": "ジャックの名前をブロックで書きました。"
    },
    {
      "startSec": 235,
      "text": "ジャック・ストーリー、JACKと書きました。"
    },
    {
      "startSec": 241.2,
      "text": "なので、日本ではジャックが書くような"
    },
    {
      "startSec": 246.8,
      "text": "クシュクシュって読めないサインは×です。"
    },
    {
      "startSec": 250.6,
      "text": "これはNGです。"
    },
    {
      "startSec": 252.7,
      "text": "NGって皆さん分かりますか？"
    },
    {
      "startSec": 255.5,
      "text": "NGは日本語なんですけど"
    },
    {
      "startSec": 257.9,
      "text": "ノット・グッド(Not Good)の略(abbreviation)、"
    },
    {
      "startSec": 262.6,
      "text": "ノット・グッド＝NGと言います。"
    },
    {
      "startSec": 266.5,
      "text": "なので、ジャックのサインは、日本ではNGです。"
    },
    {
      "startSec": 271.8,
      "text": "なので、皆さんも日本に来た時は気を付けてください。"
    },
    {
      "startSec": 277.3,
      "text": "あと、日本はハンコの文化もあります。"
    },
    {
      "startSec": 282.1,
      "text": "ハンコ＝スタンプを本当によく使います。"
    },
    {
      "startSec": 286.7,
      "text": "なので、ジャックが日本に来た時は"
    },
    {
      "startSec": 289.9,
      "text": "まず最初ハンコを作りました。"
    },
    {
      "startSec": 295,
      "text": "普通は日本人のハンコは漢字で"
    },
    {
      "startSec": 298.3,
      "text": "その人の苗字、ファミリーネームですが"
    },
    {
      "startSec": 302.8,
      "text": "ジャックの時は「ジャック」と"
    },
    {
      "startSec": 305.8,
      "text": "片仮名で書いてありました。"
    },
    {
      "startSec": 309.7,
      "text": "ちょっと変わっていて面白かったです。"
    },
    {
      "startSec": 313.1,
      "text": "と言うことで、今日はここまでです。"
    },
    {
      "startSec": 316.1,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 318,
      "text": "じゃあね、また明日かな？会いましょう！"
    },
    {
      "startSec": 322.2,
      "text": "良かったらPatreonをもチェックしてくれると嬉しいです。"
    },
    {
      "startSec": 325.3,
      "text": "じゃまたね！バイバイ！"
    }
  ]
}
