{
  "episodeId": "MCTRFcZ-d9U",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "今日は「日本人が発音できない英語の音」"
    },
    {
      "startSec": 11.1,
      "text": "について話したいと思います。"
    },
    {
      "startSec": 14.5,
      "text": "私はよくInstagramとか他のYouTubeで"
    },
    {
      "startSec": 19.7,
      "text": "英語で動画を作っているんですが、"
    },
    {
      "startSec": 23.8,
      "text": "やっぱり全然発音出来ない音があります。"
    },
    {
      "startSec": 30,
      "text": "多分皆さんも知ってると思うんですけど"
    },
    {
      "startSec": 34.6,
      "text": "「th」の音がめちゃくちゃ難しい。"
    },
    {
      "startSec": 40.5,
      "text": "あとは「r」の音…難しいですよね。"
    },
    {
      "startSec": 48,
      "text": "今日はちょっとその理由と"
    },
    {
      "startSec": 52.1,
      "text": "何で日本人は英語の発音が下手なのか"
    },
    {
      "startSec": 59.4,
      "text": "という話をしたいと思います。"
    },
    {
      "startSec": 63.1,
      "text": "まず「th」これは本当に無理です。"
    },
    {
      "startSec": 68.8,
      "text": "Three(三)、これも私できない。"
    },
    {
      "startSec": 74.5,
      "text": "「Three」できてますか？"
    },
    {
      "startSec": 91,
      "text": "難しい！"
    },
    {
      "startSec": 92.2,
      "text": "ホント練習するんだけど、"
    },
    {
      "startSec": 98.4,
      "text": "やっぱり日本ではあんまり唇を使って"
    },
    {
      "startSec": 105.6,
      "text": "発音しないです、日本語は。"
    },
    {
      "startSec": 109.5,
      "text": "英語はなんかすごく日本語と違って"
    },
    {
      "startSec": 114.9,
      "text": "口を動かしている感じがします。"
    },
    {
      "startSec": 120.8,
      "text": "よく私が昔思っていたことは"
    },
    {
      "startSec": 125.7,
      "text": "英語の、アメリカとかの映画を見た時に"
    },
    {
      "startSec": 131.6,
      "text": "英語を話す人は、顔の表情(facial expression)"
    },
    {
      "startSec": 138.5,
      "text": "顔の表情がすごく豊か。"
    },
    {
      "startSec": 143.1,
      "text": "豊かというのは"
    },
    {
      "startSec": 144.4,
      "text": "すごくリアクションが大きい感じがします。"
    },
    {
      "startSec": 150.4,
      "text": "もう目とか、おでことかいっぱい動かして"
    },
    {
      "startSec": 155.4,
      "text": "口もすごく大きく開ける感じがしました。"
    },
    {
      "startSec": 161.6,
      "text": "でも日本人は結構みんな口は大きく開けないし"
    },
    {
      "startSec": 167.7,
      "text": "あまりおでこも目とかも、動かさないし"
    },
    {
      "startSec": 172.7,
      "text": "英語を話す人に比べて"
    },
    {
      "startSec": 175.7,
      "text": "結構、顔の表情が静かな感じがするんですね、私には。"
    },
    {
      "startSec": 183.3,
      "text": "皆さんはどう思いますか？"
    },
    {
      "startSec": 186,
      "text": "で、あと日本人が英語、"
    },
    {
      "startSec": 192.1,
      "text": "あんまり上手に発音できない理由、"
    },
    {
      "startSec": 196,
      "text": "これはやっぱり学校での"
    },
    {
      "startSec": 200.1,
      "text": "英語の授業、クラスに問題があります。"
    },
    {
      "startSec": 207.9,
      "text": "私が中学校で英語を勉強した時は"
    },
    {
      "startSec": 213.7,
      "text": "カタカナで発音を覚えていました。"
    },
    {
      "startSec": 218.1,
      "text": "例えば「Thank you(ありがとう)」は"
    },
    {
      "startSec": 221.2,
      "text": "「センキュー」って英語の上に"
    },
    {
      "startSec": 224.9,
      "text": "カタカナで書きました。"
    },
    {
      "startSec": 229,
      "text": "で、「Think」は「ティンク」って"
    },
    {
      "startSec": 234.6,
      "text": "「Think」の英語の上に書いていました。"
    },
    {
      "startSec": 237.9,
      "text": "本当にこういう覚え方をするから"
    },
    {
      "startSec": 241.6,
      "text": "カタカナの発音が英語の発音とミックスしちゃう。"
    },
    {
      "startSec": 247.5,
      "text": "カタカナで覚えてしまうんです。"
    },
    {
      "startSec": 251.4,
      "text": "これはよくないです。"
    },
    {
      "startSec": 254.4,
      "text": "勿論英語には、発音の記号"
    },
    {
      "startSec": 258.9,
      "text": "(phonetic symbols)がありますよね。"
    },
    {
      "startSec": 263.1,
      "text": "例えば、a、e、i、b、kみたいな。"
    },
    {
      "startSec": 268.3,
      "text": "その発音のシンボル、あるじゃないですか。"
    },
    {
      "startSec": 272.1,
      "text": "それを勉強しなかったんだよね、確か。"
    },
    {
      "startSec": 279.3,
      "text": "私はそれを勉強した記憶がないです。"
    },
    {
      "startSec": 284.9,
      "text": "覚えていません。"
    },
    {
      "startSec": 287.3,
      "text": "だから多分学校で、そのphonetic(phonics)を"
    },
    {
      "startSec": 291.4,
      "text": "勉強しなかったんだと思います。"
    },
    {
      "startSec": 295.4,
      "text": "で、これは多分良くないです。"
    },
    {
      "startSec": 298.5,
      "text": "だから日本人はとても発音が下手です。"
    },
    {
      "startSec": 305.1,
      "text": "最近は私結構、またこの英語の発音を"
    },
    {
      "startSec": 309.9,
      "text": "ジャックから勉強しています。"
    },
    {
      "startSec": 312,
      "text": "ジャックが小学校・中学校で英語を教えているので"
    },
    {
      "startSec": 318.1,
      "text": "A, æ, apple、B, b, bird, C, k, catみたいな"
    },
    {
      "startSec": 326.2,
      "text": "こうやって最近少しずつまた発音を"
    },
    {
      "startSec": 331.1,
      "text": "頑張りたいなと思って勉強しています。"
    },
    {
      "startSec": 335.5,
      "text": "日本語の発音は皆さんどうですか？"
    },
    {
      "startSec": 340.5,
      "text": "私の彼氏、ジャックさんはイギリス人だけど"
    },
    {
      "startSec": 346.1,
      "text": "「たちつてと」とか「かきくけこ」が難しいみたいです。"
    },
    {
      "startSec": 355,
      "text": "「暖かかった(It was warm)」"
    },
    {
      "startSec": 360.1,
      "text": "これが言えないですね。"
    },
    {
      "startSec": 362.3,
      "text": "皆さんは言えますか？"
    },
    {
      "startSec": 365.1,
      "text": "「暖かかった」「暖かくなかった」言えますか？"
    },
    {
      "startSec": 370.6,
      "text": "発音、結構楽しいですよね。"
    },
    {
      "startSec": 373.8,
      "text": "また発音とか方言(dialect)のビデオも"
    },
    {
      "startSec": 379.9,
      "text": "これから作りたいなあと思ってます。"
    },
    {
      "startSec": 383.6,
      "text": "またリクエストとかあったら"
    },
    {
      "startSec": 386.8,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 389.5,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 391.5,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 395.5,
      "text": "じゃあまた明日！バイバイ！"
    }
  ]
}
