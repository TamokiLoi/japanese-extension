{
  "episodeId": "-zc8kBNgfOE",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.4,
      "text": "私は最近、私の生活をもっと良くしたいなって"
    },
    {
      "startSec": 12.4,
      "text": "思っているんですよね。"
    },
    {
      "startSec": 14.9,
      "text": "今日はちょっとその話、"
    },
    {
      "startSec": 17.7,
      "text": "どうやってもっと生活を楽しくハッピーにできるかな、"
    },
    {
      "startSec": 25.6,
      "text": "もっと健康的に(healthy)"
    },
    {
      "startSec": 29.5,
      "text": "健康的な生活にできるかなと、最近考えていたので"
    },
    {
      "startSec": 35.8,
      "text": "今日はちょっとその話をしたいと思います。"
    },
    {
      "startSec": 40.5,
      "text": "実は私は、昔からそういう生活に"
    },
    {
      "startSec": 44.8,
      "text": "すごく興味があったんですね。"
    },
    {
      "startSec": 48.2,
      "text": "小学生の時から片付けとか"
    },
    {
      "startSec": 52.1,
      "text": "部屋のインテリアとか手作り(DIY)とかすっごく好きで。"
    },
    {
      "startSec": 58.3,
      "text": "だから大学は建築(architecture)の"
    },
    {
      "startSec": 64,
      "text": "学部(department, faculty)に行ったんですが"
    },
    {
      "startSec": 68.6,
      "text": "ちょっと自分の思っていた勉強と違ったんですけど"
    },
    {
      "startSec": 74.5,
      "text": "まあそれはまた他の話で。"
    },
    {
      "startSec": 77.1,
      "text": "私はちょっと生活を良くしたいと思っています。"
    },
    {
      "startSec": 83.2,
      "text": "結構この一年、二年、三年、"
    },
    {
      "startSec": 87.7,
      "text": "自分の生活を無視していたというか、"
    },
    {
      "startSec": 94.7,
      "text": "無視する(ignore)"
    },
    {
      "startSec": 97,
      "text": "無視していた…ちゃんと大切にしなかったんです。"
    },
    {
      "startSec": 102.7,
      "text": "でも、大切にしないとやっぱり"
    },
    {
      "startSec": 107,
      "text": "幸せな人生にならないです。"
    },
    {
      "startSec": 110.9,
      "text": "なのでちょっと今自分が考えていること、プラン"
    },
    {
      "startSec": 116.3,
      "text": "ちょっと皆さんとシェアしたいなと思います。"
    },
    {
      "startSec": 120.6,
      "text": "まず、仕事の時間を短くしたいです、本当に。"
    },
    {
      "startSec": 126.2,
      "text": "で、やっぱり会社で働いたら"
    },
    {
      "startSec": 129,
      "text": "月曜日から金曜日まで、一日八時間で"
    },
    {
      "startSec": 133.3,
      "text": "そして多分会社に行く時間もかかりますよね。"
    },
    {
      "startSec": 139,
      "text": "でも私、これってちょっと"
    },
    {
      "startSec": 141.6,
      "text": "多すぎじゃないかなって思うんですよね。"
    },
    {
      "startSec": 144.8,
      "text": "家にいる時間、全然ないじゃないですか。"
    },
    {
      "startSec": 149.5,
      "text": "休む時間とか、家族と話す時間、何かを作る時間。"
    },
    {
      "startSec": 155.5,
      "text": "こういう時間が、人生を楽しくハッピーにします。"
    },
    {
      "startSec": 161.7,
      "text": "でもそれがないのは"
    },
    {
      "startSec": 164.9,
      "text": "体に、心によくないと私は思うんですね。"
    },
    {
      "startSec": 170,
      "text": "できたら私は、働くのは一週間に三日か四日。"
    },
    {
      "startSec": 177.9,
      "text": "そして一日、五時間か六時間がいいですね。"
    },
    {
      "startSec": 184.8,
      "text": "でも別に仕事をしていない時間は"
    },
    {
      "startSec": 190.2,
      "text": "例えば家でゴロゴロしてるだけとか"
    },
    {
      "startSec": 193.4,
      "text": "ゲームしてるだけとか、そうじゃないです。"
    },
    {
      "startSec": 196.9,
      "text": "仕事以外の時間で、好きなことを勉強したり。"
    },
    {
      "startSec": 204.1,
      "text": "私はジャックさんといつか"
    },
    {
      "startSec": 206.7,
      "text": "ブルワリー(brewery)をオープンしたいな"
    },
    {
      "startSec": 209.7,
      "text": "なんて思っているので、それについて調べたり"
    },
    {
      "startSec": 214.9,
      "text": "運動したり、手作りして、DIYして"
    },
    {
      "startSec": 219.6,
      "text": "家をもっと快適に(comfortable)したり"
    },
    {
      "startSec": 225.4,
      "text": "おいしいご飯を作ったり、野菜を育ててみたり"
    },
    {
      "startSec": 230.5,
      "text": "そういうことが私はしたいんです。"
    },
    {
      "startSec": 235.7,
      "text": "そういうことがしたくて、会社で働きたくなくて、"
    },
    {
      "startSec": 241.2,
      "text": "だからソーシャルメディアで"
    },
    {
      "startSec": 242.7,
      "text": "コンテンツを作ったりしているんですけど"
    },
    {
      "startSec": 246.5,
      "text": "私はそういう、色んなこと、"
    },
    {
      "startSec": 249.1,
      "text": "手作りとかそういうことをしたいです。"
    },
    {
      "startSec": 254.1,
      "text": "それは本当に私の人生、生活を楽しく"
    },
    {
      "startSec": 259.7,
      "text": "ハッピーに豊かにしてくれると思います。"
    },
    {
      "startSec": 265.6,
      "text": "で、やっぱりあとは食べるものに気を付けたい。"
    },
    {
      "startSec": 270.5,
      "text": "おいしそうなお菓子とかあったら"
    },
    {
      "startSec": 273.4,
      "text": "私はすぐ買ってしまうんですが、"
    },
    {
      "startSec": 276.9,
      "text": "結構、砂糖と油、体に良くない油、オイル、"
    },
    {
      "startSec": 285,
      "text": "それに気をつけたいなと思っています。"
    },
    {
      "startSec": 289.9,
      "text": "やっぱり砂糖と油が多いと"
    },
    {
      "startSec": 293.2,
      "text": "私はすぐニキビ(spot, pimple)ができるんですよね。"
    },
    {
      "startSec": 300.9,
      "text": "でも今まであまり食事を変えようと"
    },
    {
      "startSec": 305.8,
      "text": "したことがなかったので、"
    },
    {
      "startSec": 308.1,
      "text": "ちょっとこれから食事に気を付けて"
    },
    {
      "startSec": 311.9,
      "text": "体にいい物だけ食べて"
    },
    {
      "startSec": 314.7,
      "text": "ちょっと私の肌が良くなるかどうか"
    },
    {
      "startSec": 320.5,
      "text": "見ていきたいなと思っています。"
    },
    {
      "startSec": 323.4,
      "text": "あとスキンケアもそうですね。"
    },
    {
      "startSec": 326.7,
      "text": "やり過ぎは良くないですよね。"
    },
    {
      "startSec": 330.5,
      "text": "でも今まで私は、肌をきれいにしたくて"
    },
    {
      "startSec": 336.6,
      "text": "五種類とか六種類の化粧品(skin care products)"
    },
    {
      "startSec": 341.7,
      "text": "薬とか顔にたくさんつけていました。"
    },
    {
      "startSec": 346.6,
      "text": "でもよく考えたら、それって全然自然じゃない。"
    },
    {
      "startSec": 351.7,
      "text": "多分、体とか肌とか心の一番いい、ベストの状態、"
    },
    {
      "startSec": 361.8,
      "text": "これは多分自然でいることなんですよね。"
    },
    {
      "startSec": 366.4,
      "text": "自然に近い状態がベストだと思います。"
    },
    {
      "startSec": 371.9,
      "text": "だからやり過ぎも、やらなさすぎもどっちも良くない。"
    },
    {
      "startSec": 378.6,
      "text": "バランスが良いこと、"
    },
    {
      "startSec": 380.2,
      "text": "自然に近いことがベストだと思うので"
    },
    {
      "startSec": 384.9,
      "text": "スキンケアもできるだけシンプルに、"
    },
    {
      "startSec": 388.7,
      "text": "食べる物とかも結構シンプルにして"
    },
    {
      "startSec": 392.1,
      "text": "自分の心と体、生活のバランスを"
    },
    {
      "startSec": 397.1,
      "text": "ちょっと気を付けたいなと最近思っています。"
    },
    {
      "startSec": 402.8,
      "text": "皆さんは生活のためとか健康のために"
    },
    {
      "startSec": 407.9,
      "text": "何かしていることはありますか？"
    },
    {
      "startSec": 412.1,
      "text": "良かったらコメントで教えてください。"
    },
    {
      "startSec": 415.4,
      "text": "私も皆さんのコメントを読んで"
    },
    {
      "startSec": 418.9,
      "text": "「あ、みんなこういうことしてるんだ」とか"
    },
    {
      "startSec": 422.3,
      "text": "考えるのがすごく好きなので"
    },
    {
      "startSec": 425.4,
      "text": "良かったらコメント書いてください。"
    },
    {
      "startSec": 429,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 430.8,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 434.9,
      "text": "また明日も聞いてくださいね。"
    },
    {
      "startSec": 438.2,
      "text": "じゃあまたお仕事・勉強頑張ってください。"
    },
    {
      "startSec": 442.5,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
