{
  "episodeId": "YugHWgtcKDU",
  "segments": [
    {
      "startSec": 0,
      "text": "みなさん、こんにちは。"
    },
    {
      "startSec": 1.4,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.8,
      "text": "今日は私が、プロダクティブな毎日のために"
    },
    {
      "startSec": 10,
      "text": "していることを話したいと思います。"
    },
    {
      "startSec": 14.7,
      "text": "私は、今家で働いていて"
    },
    {
      "startSec": 19.1,
      "text": "働いてると言っても、もう全然ね、"
    },
    {
      "startSec": 22.9,
      "text": "今のお金は全部Patreonから来ています。"
    },
    {
      "startSec": 27.6,
      "text": "なので、全然たくさんお金があるわけじゃないし"
    },
    {
      "startSec": 33,
      "text": "会社で働いているわけでもないです。"
    },
    {
      "startSec": 36.8,
      "text": "だけど、今は自分のビジネスのため"
    },
    {
      "startSec": 42,
      "text": "自分の将来(しょうらい=future)のために"
    },
    {
      "startSec": 47.7,
      "text": "毎日がんばっています。"
    },
    {
      "startSec": 50.5,
      "text": "1日結構働いていて、8時間くらいかな。"
    },
    {
      "startSec": 56,
      "text": "いや、10時間くらいかも…？"
    },
    {
      "startSec": 60.3,
      "text": "結構働いています。"
    },
    {
      "startSec": 63.5,
      "text": "毎日がんばっていて"
    },
    {
      "startSec": 66.8,
      "text": "1年前に比べて、すごくプロダクティブに"
    },
    {
      "startSec": 71.5,
      "text": "仕事ができるようになりました。"
    },
    {
      "startSec": 74.9,
      "text": "で、たくさん心がしんどくなった時もありました。"
    },
    {
      "startSec": 81.8,
      "text": "でもなんとかそれを乗り越えて(のりこえて)"
    },
    {
      "startSec": 85.6,
      "text": "乗り越える(=to overcome)　乗り越えて、"
    },
    {
      "startSec": 89.9,
      "text": "今は結構毎日、プロダクティブで"
    },
    {
      "startSec": 95.3,
      "text": "楽しい日を過ごしています。"
    },
    {
      "startSec": 97.8,
      "text": "なので、今日は"
    },
    {
      "startSec": 99.7,
      "text": "どうやって私が毎日を"
    },
    {
      "startSec": 102.9,
      "text": "プロダクティブに楽しくしているかについて"
    },
    {
      "startSec": 107.1,
      "text": "話したいと思います。"
    },
    {
      "startSec": 109.6,
      "text": "もし参考にできることがあったらうれしいです。"
    },
    {
      "startSec": 115.9,
      "text": "まずは朝のルーティンからね、朝から。"
    },
    {
      "startSec": 121.8,
      "text": "私は大体朝7時20分に起きます。"
    },
    {
      "startSec": 129.2,
      "text": "彼氏が8時から仕事に行くので"
    },
    {
      "startSec": 134.1,
      "text": "私は7時、彼氏も7時20分に起きて"
    },
    {
      "startSec": 139.3,
      "text": "急いで朝ご飯を食べて準備をします。"
    },
    {
      "startSec": 143.9,
      "text": "で、彼が8時に仕事に行くので"
    },
    {
      "startSec": 148.1,
      "text": "その時に私も朝散歩に行きます。"
    },
    {
      "startSec": 152.6,
      "text": "ウォーキングをします。"
    },
    {
      "startSec": 154.5,
      "text": "大体30分から40分くらい。"
    },
    {
      "startSec": 160.1,
      "text": "ここは、田舎なので自然がたくさんあって"
    },
    {
      "startSec": 165.9,
      "text": "天気もとてもいいので"
    },
    {
      "startSec": 168.6,
      "text": "本当に朝の散歩は気持ちがいいです。"
    },
    {
      "startSec": 172.8,
      "text": "目が覚めるし、なんか何だろう…"
    },
    {
      "startSec": 178.1,
      "text": "色々忘れることができる。"
    },
    {
      "startSec": 180.7,
      "text": "結構、ソーシャルメディアの仕事をしてると"
    },
    {
      "startSec": 185.2,
      "text": "ちょっと心が、よくしんどくなるし"
    },
    {
      "startSec": 188.2,
      "text": "頭も結構いっぱいになるけど"
    },
    {
      "startSec": 191.2,
      "text": "それを忘れることができます。"
    },
    {
      "startSec": 195.1,
      "text": "だから朝のウォーキングは大切。"
    },
    {
      "startSec": 198.5,
      "text": "で、朝のウォーキングから家に帰ってきたら"
    },
    {
      "startSec": 203.5,
      "text": "朝ご飯の食器(しょっき)を洗ったり"
    },
    {
      "startSec": 208.4,
      "text": "洗濯(せんたく)をしたり"
    },
    {
      "startSec": 210.7,
      "text": "掃除機(そうじき)をかけたり"
    },
    {
      "startSec": 212.9,
      "text": "掃除機をかける(=to vacuum)したりします。"
    },
    {
      "startSec": 218.2,
      "text": "で、掃除が大体9時15分くらいに終わります。"
    },
    {
      "startSec": 225.6,
      "text": "めっちゃ急いで掃除をします。"
    },
    {
      "startSec": 228.4,
      "text": "やっぱり朝掃除をすると"
    },
    {
      "startSec": 231.7,
      "text": "仕事を始める時に"
    },
    {
      "startSec": 234.7,
      "text": "周り(まわり)がすっごく気持ちが良くなる。"
    },
    {
      "startSec": 239,
      "text": "リフレッシュできますよね。"
    },
    {
      "startSec": 241.4,
      "text": "だから朝がんばって部屋をきれいにして"
    },
    {
      "startSec": 246.2,
      "text": "心が楽しくなるようにします。"
    },
    {
      "startSec": 249.7,
      "text": "それも朝のコツですね。"
    },
    {
      "startSec": 253.7,
      "text": "そして掃除の後に、その日のToDoリスト書きます。"
    },
    {
      "startSec": 260.2,
      "text": "「することリスト」書きます"
    },
    {
      "startSec": 264.2,
      "text": "私は1週間のToDoリストも書いているので"
    },
    {
      "startSec": 270.2,
      "text": "それを見ながら、今日やることを"
    },
    {
      "startSec": 273.9,
      "text": "30分とか1時間、しっかり分けて"
    },
    {
      "startSec": 279.1,
      "text": "スケジュールに書いていきます。"
    },
    {
      "startSec": 282.5,
      "text": "それが大切かも。"
    },
    {
      "startSec": 284.6,
      "text": "例えば、30分で終える、終わらせることができるもの"
    },
    {
      "startSec": 292.5,
      "text": "例えばライブレッスンの準備とか"
    },
    {
      "startSec": 296.4,
      "text": "もうそれは絶対に30分ですると決めます、絶対に。"
    },
    {
      "startSec": 303.4,
      "text": "しっかりスケジュール帳(ちょう)に書いていきます。"
    },
    {
      "startSec": 307.9,
      "text": "で、ToDoリストを書くと"
    },
    {
      "startSec": 310.3,
      "text": "ちょっと何か私は安心できますね。"
    },
    {
      "startSec": 315.5,
      "text": "ToDoリスト以外のことは"
    },
    {
      "startSec": 317.8,
      "text": "以外(いがい=except for)"
    },
    {
      "startSec": 320,
      "text": "だから、except for my ToDo list, except for my list"
    },
    {
      "startSec": 323.9,
      "text": "ToDoリスト以外のことは考えないようにします。"
    },
    {
      "startSec": 330.1,
      "text": "I try not to think about it, think about that."
    },
    {
      "startSec": 335.7,
      "text": "考えないようにします。"
    },
    {
      "startSec": 339.3,
      "text": "その時に私は読書を始めます、読書(どくしょ)。"
    },
    {
      "startSec": 345.4,
      "text": "今読んでいる本は"
    },
    {
      "startSec": 347.6,
      "text": "広島の「鞆の浦(とものうら)」という場所の本です。"
    },
    {
      "startSec": 353.1,
      "text": "私は大学で、建築を(けんちく=architecture)"
    },
    {
      "startSec": 357.3,
      "text": "勉強したので、それ…そうね"
    },
    {
      "startSec": 362.7,
      "text": "とものうらの歴史とか、建物の話の本"
    },
    {
      "startSec": 367.7,
      "text": "建物(たてもの=building)の本を読んでいます。"
    },
    {
      "startSec": 371.9,
      "text": "多分ね、来年はまた大学に"
    },
    {
      "startSec": 376,
      "text": "戻りたい(もどりたい)と思っているので"
    },
    {
      "startSec": 379,
      "text": "ちょっと忘れないように、本も読んでいます。"
    },
    {
      "startSec": 383.1,
      "text": "大体本は、30分くらい読みます。"
    },
    {
      "startSec": 386.9,
      "text": "で、本も読んでる時は"
    },
    {
      "startSec": 389.1,
      "text": "またソーシャルメディアのことを"
    },
    {
      "startSec": 391.7,
      "text": "忘れることができますよね。"
    },
    {
      "startSec": 393.9,
      "text": "で、本を読み終わってからToDoリストを使って"
    },
    {
      "startSec": 398.3,
      "text": "ToDoリストを見ながら、仕事を始めます。"
    },
    {
      "startSec": 403.3,
      "text": "これが朝のルーティンかな。"
    },
    {
      "startSec": 407.2,
      "text": "そんな感じ。"
    },
    {
      "startSec": 408.8,
      "text": "で、土曜日とか日曜日はできるだけ"
    },
    {
      "startSec": 413.8,
      "text": "ジャック、彼氏と一緒にいるために"
    },
    {
      "startSec": 417.4,
      "text": "仕事はしないようにがんばっています。"
    },
    {
      "startSec": 422,
      "text": "これもね、多分私の心にすごく大切だと思うかな。"
    },
    {
      "startSec": 428.7,
      "text": "あとは…彼氏が4時半くらいに帰ってくるので"
    },
    {
      "startSec": 436.2,
      "text": "その時に2人でもう1回散歩に行きます。"
    },
    {
      "startSec": 443.2,
      "text": "この時は1時間くらいかな。"
    },
    {
      "startSec": 446.4,
      "text": "散歩に行って、その日にあったこととか"
    },
    {
      "startSec": 451.1,
      "text": "色々、色んなことを話しますね。"
    },
    {
      "startSec": 454.5,
      "text": "これも私にとって、すごく大切な時間です。"
    },
    {
      "startSec": 461.7,
      "text": "そんな感じかな…"
    },
    {
      "startSec": 464.7,
      "text": "あと夜はできるだけ早く寝るように、"
    },
    {
      "startSec": 469.1,
      "text": "毎日絶対8時間寝るようにしています。"
    },
    {
      "startSec": 475.4,
      "text": "ご飯もたくさん食べて"
    },
    {
      "startSec": 478.1,
      "text": "ウォーキングでしっかり体を動かして"
    },
    {
      "startSec": 483.4,
      "text": "ストレスをね、できるだけストレスがないように"
    },
    {
      "startSec": 487,
      "text": "自分にできるだけ優しくするようにしています。"
    },
    {
      "startSec": 493,
      "text": "これが多分、私のプロダクティブになるための"
    },
    {
      "startSec": 498.4,
      "text": "コツだと思います。"
    },
    {
      "startSec": 501.3,
      "text": "今話していて、私が気がついたんだけど"
    },
    {
      "startSec": 506.1,
      "text": "もう全部がんばって"
    },
    {
      "startSec": 508.5,
      "text": "私の心を安定(あんてい)"
    },
    {
      "startSec": 511.1,
      "text": "安定する(=to become stable)"
    },
    {
      "startSec": 513.6,
      "text": "心を安定するようにしていますね。"
    },
    {
      "startSec": 518.5,
      "text": "ちょっとびっくりしたけど"
    },
    {
      "startSec": 520.2,
      "text": "多分それが一番大切だと思う。"
    },
    {
      "startSec": 525.5,
      "text": "やっぱり心が安定していないと"
    },
    {
      "startSec": 531.1,
      "text": "ちゃんと仕事はできないし"
    },
    {
      "startSec": 534.2,
      "text": "ストレスがたまりますよね。"
    },
    {
      "startSec": 536.5,
      "text": "多分それが一番良くないと思う。"
    },
    {
      "startSec": 540.2,
      "text": "ストレスが大きくなると、やっぱりどこかで"
    },
    {
      "startSec": 545.5,
      "text": "仕事をストップしちゃうことになるし"
    },
    {
      "startSec": 550.1,
      "text": "やっぱり継続(けいぞく=to be consistent)"
    },
    {
      "startSec": 554.5,
      "text": "継続することが一番大切なので"
    },
    {
      "startSec": 559.1,
      "text": "がんばってできるだけ自分に優しく"
    },
    {
      "startSec": 564.6,
      "text": "継続できるようにがんばっています。"
    },
    {
      "startSec": 569.3,
      "text": "私のプロダクティブになるコツはこんな感じです。"
    },
    {
      "startSec": 573.9,
      "text": "もしみなさんが、"
    },
    {
      "startSec": 575.2,
      "text": "ここから何か学んでくれたらうれしいです。"
    },
    {
      "startSec": 580.4,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 582.4,
      "text": "また次のエピソードで会いましょう。"
    },
    {
      "startSec": 585.2,
      "text": "ぜひPatreonもチェックしてね。"
    },
    {
      "startSec": 588,
      "text": "ありがとう！じゃ今日はここまでです！"
    },
    {
      "startSec": 590.2,
      "text": "バイバイ！"
    }
  ]
}
