{
  "episodeId": "XxpE-kRfwtQ",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.1,
      "text": "今日本は3月ですが、もうすぐ4月になります。"
    },
    {
      "startSec": 10.8,
      "text": "4月は、日本の学校が新しく始まる季節です。"
    },
    {
      "startSec": 20.1,
      "text": "1年生だった学生、生徒は"
    },
    {
      "startSec": 24,
      "text": "4月になると、2年生になります。"
    },
    {
      "startSec": 28,
      "text": "もうドキドキする新しい季節です、日本は。"
    },
    {
      "startSec": 33.7,
      "text": "で、私は実はまだ学生です。"
    },
    {
      "startSec": 39.3,
      "text": "大学院生、大学院(graduate schoo)は大学の1つ次です。"
    },
    {
      "startSec": 47.8,
      "text": "1年前に休学すると決めて、休学していました。"
    },
    {
      "startSec": 55.2,
      "text": "休学は学校を長く休むことです。"
    },
    {
      "startSec": 60.4,
      "text": "休学していて、Instagramとか"
    },
    {
      "startSec": 64,
      "text": "YouTubeとかポッドキャストをしていました。"
    },
    {
      "startSec": 68.1,
      "text": "今年も休学しようと思います。"
    },
    {
      "startSec": 72.4,
      "text": "休学すると決めました。"
    },
    {
      "startSec": 75.6,
      "text": "今日はその理由について"
    },
    {
      "startSec": 78.9,
      "text": "皆さんと話したいなと思います。"
    },
    {
      "startSec": 83.1,
      "text": "私は大学で建築(architecture)の勉強をしていました。"
    },
    {
      "startSec": 91.9,
      "text": "でもその建築の勉強を続けても"
    },
    {
      "startSec": 98.2,
      "text": "何か自分が好きな仕事とか"
    },
    {
      "startSec": 103.3,
      "text": "働き方、生活ができないと思いました。"
    },
    {
      "startSec": 109.4,
      "text": "建築士(architect)になることはすごく難しいし"
    },
    {
      "startSec": 115.9,
      "text": "残業が多いです。"
    },
    {
      "startSec": 117.9,
      "text": "すっごく残業が大変です。"
    },
    {
      "startSec": 121,
      "text": "私の友達、もう仕事を見つけた友達ですが"
    },
    {
      "startSec": 127.2,
      "text": "夜の12時まで仕事をしていたりします。"
    },
    {
      "startSec": 131.6,
      "text": "すっごく大変です。"
    },
    {
      "startSec": 134.6,
      "text": "もちろんまだ若い時は"
    },
    {
      "startSec": 137.6,
      "text": "クリエイティブな仕事はできないです。"
    },
    {
      "startSec": 141.7,
      "text": "ボスに言われたことを頑張って頑張って"
    },
    {
      "startSec": 145.2,
      "text": "図面(drawing, blueprint)とか書いたりして"
    },
    {
      "startSec": 148.5,
      "text": "それで毎日夜遅くまで仕事をします。"
    },
    {
      "startSec": 153.7,
      "text": "でもお給料は良くないです。"
    },
    {
      "startSec": 158,
      "text": "私はやっぱり残業は絶対嫌だったんですね。"
    },
    {
      "startSec": 162.6,
      "text": "それにもっとクリエイティブなことがしたかった。"
    },
    {
      "startSec": 167.1,
      "text": "自分で色んなことをやりたかったです。"
    },
    {
      "startSec": 171.3,
      "text": "なので、絶対に会社で働きたくなかったです。"
    },
    {
      "startSec": 176.6,
      "text": "と言うことは、やっぱり会社で働きたくなかったら"
    },
    {
      "startSec": 182,
      "text": "自分で仕事を作るしかないですよね。"
    },
    {
      "startSec": 187.8,
      "text": "そう思って去年休学をして"
    },
    {
      "startSec": 191.9,
      "text": "Instagramで日本語を教えました。"
    },
    {
      "startSec": 196.1,
      "text": "それに、大学の授業は"
    },
    {
      "startSec": 198.2,
      "text": "私はあまり好きじゃなかったんですね。"
    },
    {
      "startSec": 202.4,
      "text": "好きな授業もあるし、今も大好きな先生もいます。"
    },
    {
      "startSec": 207.1,
      "text": "でも何だろう…"
    },
    {
      "startSec": 209.2,
      "text": "家の図(drawing)、"
    },
    {
      "startSec": 212.6,
      "text": "家の設計をすることがすごく難しかった、私は。"
    },
    {
      "startSec": 219.7,
      "text": "私は、絵を描くのが好きだったんですが"
    },
    {
      "startSec": 222.7,
      "text": "やっぱり絵を描くことと、"
    },
    {
      "startSec": 225.6,
      "text": "家を建てること(to build a house)は全然違います。"
    },
    {
      "startSec": 234.1,
      "text": "違うんですね。"
    },
    {
      "startSec": 235.3,
      "text": "でも建築の学校に入ってしまったので"
    },
    {
      "startSec": 239.2,
      "text": "大学の時はちょっとしんどかったです。"
    },
    {
      "startSec": 243.2,
      "text": "でも私はやっぱり、日本の古い建築は大好きです。"
    },
    {
      "startSec": 252.1,
      "text": "特に、普通の人が住んでいた昔の家が本当に好きで"
    },
    {
      "startSec": 260.3,
      "text": "皆さんも多分、日本の京都とか奈良に行ったら"
    },
    {
      "startSec": 265.8,
      "text": "昔の古い家をたくさん見ることができると思います。"
    },
    {
      "startSec": 272.2,
      "text": "やっぱりそういう家は"
    },
    {
      "startSec": 274.2,
      "text": "すごくハイセンスだと思いませんか？"
    },
    {
      "startSec": 278.3,
      "text": "すっごくハイセンスですよね。"
    },
    {
      "startSec": 280.6,
      "text": "最近の新しい家と比べると、もう全然違う。"
    },
    {
      "startSec": 286.4,
      "text": "すっごくスタイリッシュでお洒落で"
    },
    {
      "startSec": 289.9,
      "text": "でもなんかとちょっと懐かしい感じがします。"
    },
    {
      "startSec": 294.5,
      "text": "私はそういう家は、本当に大好きです。"
    },
    {
      "startSec": 298.8,
      "text": "だから、今大学は休んでいますが"
    },
    {
      "startSec": 303.9,
      "text": "いつか(somday)、日本の古い家を守る(to preserve)"
    },
    {
      "startSec": 313,
      "text": "守る仕事がしたいと思っています。"
    },
    {
      "startSec": 317.2,
      "text": "と言うわけで、今年も休学して"
    },
    {
      "startSec": 320.6,
      "text": "このポッドキャストとかYouTube頑張りたいと思います。"
    },
    {
      "startSec": 325.6,
      "text": "これからもよろしくお願いします。"
    },
    {
      "startSec": 328.4,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 330.9,
      "text": "いつも聞いてくれて、本当にありがとうございます。"
    },
    {
      "startSec": 334.7,
      "text": "今日も頑張ってください。"
    },
    {
      "startSec": 336.3,
      "text": "また明日会いましょう！バイバイ！"
    }
  ]
}
