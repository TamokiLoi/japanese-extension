{
  "episodeId": "UmK74KHq_Yo",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.2,
      "text": "元気ですか？"
    },
    {
      "startSec": 6.5,
      "text": "はい、よかった、元気ですか。よかったです。"
    },
    {
      "startSec": 9.3,
      "text": "はい、ということで"
    },
    {
      "startSec": 11.1,
      "text": "今日はパン屋さんの話をしたいと思います。"
    },
    {
      "startSec": 16.7,
      "text": "私パン大好きです。"
    },
    {
      "startSec": 19.3,
      "text": "やっぱりパン屋さんのパン、"
    },
    {
      "startSec": 22.4,
      "text": "美味しいですよね、本当に。"
    },
    {
      "startSec": 24.9,
      "text": "スーパーで買う安いパンと全然違いますよね。"
    },
    {
      "startSec": 30.1,
      "text": "やっぱりパン屋さんのパンが好きになったら"
    },
    {
      "startSec": 33.7,
      "text": "もうスーパーでパンが買えなくなりました。"
    },
    {
      "startSec": 38.2,
      "text": "で、日本のパン屋さんってそんなに高くないです。"
    },
    {
      "startSec": 45.5,
      "text": "二百円くらいでパン買えます。"
    },
    {
      "startSec": 50.2,
      "text": "で、スーパーで買っても百円くらいなので"
    },
    {
      "startSec": 53.9,
      "text": "じゃあパン屋さんでパンを買って"
    },
    {
      "startSec": 57.3,
      "text": "パン屋さんをサポートして美味しいパンを食べる。"
    },
    {
      "startSec": 61.4,
      "text": "こっちのほうがなんか私も幸せだなと思って。"
    },
    {
      "startSec": 66.8,
      "text": "最近はよくパン屋さんに行っています。"
    },
    {
      "startSec": 72.6,
      "text": "やっぱりどんな町にも、"
    },
    {
      "startSec": 77.2,
      "text": "パン屋さん一つ欲しいですよね。"
    },
    {
      "startSec": 81.4,
      "text": "パン屋さんがない町…"
    },
    {
      "startSec": 90.9,
      "text": "本当にパン屋さんは、みんなを幸せにしてくれます。"
    },
    {
      "startSec": 96.6,
      "text": "その匂いとか、見た目もかわいいし、もう全部が好き。"
    },
    {
      "startSec": 101.9,
      "text": "手作りというところも大好きです。"
    },
    {
      "startSec": 107,
      "text": "で今日は、ちょっと"
    },
    {
      "startSec": 108,
      "text": "日本のパン屋さんの話をしたいと思います。"
    },
    {
      "startSec": 113.5,
      "text": "私はあまり外国に行ったことはないけど"
    },
    {
      "startSec": 119.6,
      "text": "オーストラリアとイギリスのパン屋さんに"
    },
    {
      "startSec": 123.7,
      "text": "行ったことはあります。"
    },
    {
      "startSec": 126.2,
      "text": "で、何か、日本のパン屋さんと違うと思ったのは、"
    },
    {
      "startSec": 133.8,
      "text": "日本のパン屋さんではあまり"
    },
    {
      "startSec": 136.3,
      "text": "パンは売ってないんですよね。"
    },
    {
      "startSec": 138.8,
      "text": "何て言う…普通のパンはあまり売ってない。"
    },
    {
      "startSec": 143,
      "text": "よくあるとても固いパン、"
    },
    {
      "startSec": 145.9,
      "text": "小麦粉(flour)と水だけのパンみたいな"
    },
    {
      "startSec": 149.8,
      "text": "そういうパンはあまりないです。"
    },
    {
      "startSec": 155.1,
      "text": "そうじゃなくていろんな味がついたパンが多いです。"
    },
    {
      "startSec": 162.1,
      "text": "例えばメロンパン、有名ですよね。"
    },
    {
      "startSec": 168.2,
      "text": "クッキーみたいな、パンの上にあって。"
    },
    {
      "startSec": 171.8,
      "text": "メロンパンとか、クリームパン、"
    },
    {
      "startSec": 175.4,
      "text": "カスタードクリームが入ったパンとか"
    },
    {
      "startSec": 179.4,
      "text": "あとはカレーパンね。"
    },
    {
      "startSec": 181.4,
      "text": "食べたことありますか？美味しいですよ。"
    },
    {
      "startSec": 184.6,
      "text": "もうパンの中にカレーがたくさん入ってて"
    },
    {
      "startSec": 189.5,
      "text": "野菜とかお肉も。"
    },
    {
      "startSec": 191.4,
      "text": "で、ドーナツみたいに油で揚げます(deep fry)"
    },
    {
      "startSec": 197.2,
      "text": "いや～、カレーパン、美味しいね。"
    },
    {
      "startSec": 200,
      "text": "カロリーやばいよね。"
    },
    {
      "startSec": 202.9,
      "text": "でも日本のパン屋さんは、そういう味がついた"
    },
    {
      "startSec": 207.6,
      "text": "いろんな種類のパンが多い。"
    },
    {
      "startSec": 211.3,
      "text": "めっちゃシンプルなパンはあまりないです。"
    },
    {
      "startSec": 215.9,
      "text": "まあもちろんカレーパン、美味しいけど"
    },
    {
      "startSec": 219,
      "text": "私は結構シンプルで固いパンが大好きで、"
    },
    {
      "startSec": 226.1,
      "text": "そういうパンももっと売って欲しい、"
    },
    {
      "startSec": 229.7,
      "text": "作って欲しいなと思います。"
    },
    {
      "startSec": 233.5,
      "text": "皆さんはどういうパンが好きですか？"
    },
    {
      "startSec": 237.9,
      "text": "私はナッツとかが入った"
    },
    {
      "startSec": 240.5,
      "text": "固いシンプルなパンが一番好き。"
    },
    {
      "startSec": 244.9,
      "text": "で、日本のパン屋さん"
    },
    {
      "startSec": 247.1,
      "text": "是非日本に来た時は行ってみてください。"
    },
    {
      "startSec": 252.1,
      "text": "とても安い。"
    },
    {
      "startSec": 253.9,
      "text": "本当に美味しいけど、二百円くらいでパン買えるので"
    },
    {
      "startSec": 259.3,
      "text": "すごく安いし、美味しいし。"
    },
    {
      "startSec": 262.5,
      "text": "確かオーストラリアのパン屋さんに行った時に"
    },
    {
      "startSec": 267.3,
      "text": "ケーキとか売っていたと思うんですね。"
    },
    {
      "startSec": 271.1,
      "text": "でも日本のパン屋さんにはケーキは売ってないです。"
    },
    {
      "startSec": 277.1,
      "text": "デニッシュにカスタードクリームがのった"
    },
    {
      "startSec": 281,
      "text": "甘いパンとかもちろんあります。"
    },
    {
      "startSec": 285.3,
      "text": "でもプリンとかケーキとか、"
    },
    {
      "startSec": 290.2,
      "text": "シュクリームとかはほとんど無いです。"
    },
    {
      "startSec": 293.6,
      "text": "普通カレーパン、クリームパン、ピザパンとか"
    },
    {
      "startSec": 298.8,
      "text": "フランスのバゲット(baguette)に"
    },
    {
      "startSec": 302.2,
      "text": "ガーリックのバターとか、明太子のバターとか塗った"
    },
    {
      "startSec": 309.1,
      "text": "味が楽しいパンが多いです。"
    },
    {
      "startSec": 314.7,
      "text": "お腹空いてきた。"
    },
    {
      "startSec": 317.3,
      "text": "いや本当、美味しいパンって人を幸せにしますよね。"
    },
    {
      "startSec": 324.9,
      "text": "やばい、口の中がすごく今、水が出てきました。"
    },
    {
      "startSec": 330.9,
      "text": "じゃあ今日はここで終わりにしようかな。"
    },
    {
      "startSec": 334.2,
      "text": "もしこのポッドキャスト気に入ったら"
    },
    {
      "startSec": 337.6,
      "text": "レビューを書いてくれると、とても嬉しいです。"
    },
    {
      "startSec": 342,
      "text": "私はポッドキャスト、大好きで"
    },
    {
      "startSec": 345.1,
      "text": "ポッドキャストで日本語勉強している人の"
    },
    {
      "startSec": 349.3,
      "text": "サポートしたいし"
    },
    {
      "startSec": 352,
      "text": "皆さんがレビューを書いてくれたら"
    },
    {
      "startSec": 355.2,
      "text": "もっとたくさんの人に、このポッドキャストを"
    },
    {
      "startSec": 359.2,
      "text": "見つけてもらうことができるので"
    },
    {
      "startSec": 363.7,
      "text": "是非レビューお願いします。"
    },
    {
      "startSec": 367.3,
      "text": "じゃあ今日もお疲れさまです。"
    },
    {
      "startSec": 369.4,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 372.3,
      "text": "良い一日を！またね、バイバイ！"
    }
  ]
}
