{
  "episodeId": "_pTonw4ZUTU",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.9,
      "text": "今日は日本の「けんそん(謙遜)の文化」について"
    },
    {
      "startSec": 10,
      "text": "お話ししたいと思います。"
    },
    {
      "startSec": 13.3,
      "text": "「けんそん」聞いたことはありますか？"
    },
    {
      "startSec": 17.2,
      "text": "ちょっと英語で、その意味を説明することは難しいかも。"
    },
    {
      "startSec": 24.2,
      "text": "けんそんは「謙虚(to be humble)」と意味が似ています。"
    },
    {
      "startSec": 33.2,
      "text": "でも「けんそん」は、いい意味の時もあるし"
    },
    {
      "startSec": 37.6,
      "text": "ちょっと嫌な意味の時もある。"
    },
    {
      "startSec": 40.8,
      "text": "「けんそん」は相手の人を良く言うために"
    },
    {
      "startSec": 46.6,
      "text": "自分のことをちょっと低く悪く言うことです。"
    },
    {
      "startSec": 53.3,
      "text": "例えば、あなたがすごく素敵な写真を撮りました。"
    },
    {
      "startSec": 59.9,
      "text": "それをあなたのボスに、上司に見せた時に"
    },
    {
      "startSec": 65.4,
      "text": "その上司が「ああ、すごくきれいな写真ですね」"
    },
    {
      "startSec": 70.9,
      "text": "「写真撮るのが上手ですね」ってあなたに言いました。"
    },
    {
      "startSec": 75.8,
      "text": "でもあなたは「いやいやいや、そんなことないです」"
    },
    {
      "startSec": 78.9,
      "text": "「ボスの方が上手です」みたいに"
    },
    {
      "startSec": 82.7,
      "text": "自分のことをちょっと悪く言う。"
    },
    {
      "startSec": 86,
      "text": "これを「けんそんする」と言います。"
    },
    {
      "startSec": 90.3,
      "text": "このけんそんは、自分が本当にそう思っていなくても"
    },
    {
      "startSec": 98.1,
      "text": "けんそんすることがあります。"
    },
    {
      "startSec": 101.1,
      "text": "だから本当は、自分の方がボスよりも写真撮るのが"
    },
    {
      "startSec": 105.5,
      "text": "上手いと思っていても"
    },
    {
      "startSec": 109.1,
      "text": "「いやいやいや、私は全然上手くないです」って言う。"
    },
    {
      "startSec": 112.7,
      "text": "これを「けんそんする」と言います。"
    },
    {
      "startSec": 115.8,
      "text": "で日本には、このけんそんが本当に多いし"
    },
    {
      "startSec": 121.7,
      "text": "けんそんは美徳(virtue)という、"
    },
    {
      "startSec": 127.4,
      "text": "いいことっていう意味です。"
    },
    {
      "startSec": 129.4,
      "text": "「けんそんは美徳」っていう言葉が、"
    },
    {
      "startSec": 132.2,
      "text": "フレーズがちゃんとあります。"
    },
    {
      "startSec": 135.2,
      "text": "だから、けんそんすることは"
    },
    {
      "startSec": 138.2,
      "text": "ルールみたいになっています。"
    },
    {
      "startSec": 142.3,
      "text": "暗黙の了解ですね。"
    },
    {
      "startSec": 147.4,
      "text": "暗黙(silent, quiet)は静か、"
    },
    {
      "startSec": 152.1,
      "text": "了解は、「了解=オッケー」だからunspoken ruleです。"
    },
    {
      "startSec": 157,
      "text": "「みんなが言わないけど知っていること」が、暗黙の了解です。"
    },
    {
      "startSec": 164.6,
      "text": "だから特に昔の人とかは"
    },
    {
      "startSec": 168.3,
      "text": "けんそんすることが、礼儀正しい(polite)と思っています。"
    },
    {
      "startSec": 176.7,
      "text": "で問題は、このけんそんは"
    },
    {
      "startSec": 181.5,
      "text": "自分のことだけけんそんするならいいですよ、別に。"
    },
    {
      "startSec": 186.7,
      "text": "でも日本では、家族のことも"
    },
    {
      "startSec": 193.4,
      "text": "けんそんすることがいいことってみんな思っています。"
    },
    {
      "startSec": 200.1,
      "text": "例えばもし私に子供がいて、友達に"
    },
    {
      "startSec": 205,
      "text": "「まあ、レイラさんの娘さんは"
    },
    {
      "startSec": 208.1,
      "text": "勉強がすごくできて賢い大学に行っていいですね」って"
    },
    {
      "startSec": 213.7,
      "text": "言われました。"
    },
    {
      "startSec": 214.9,
      "text": "そしたら私は「いやいやいやそんなことないです、"
    },
    {
      "startSec": 218.1,
      "text": "もう娘はいつも寝てばかりで"
    },
    {
      "startSec": 222.6,
      "text": "家では全然勉強しないんですよ」みたいに"
    },
    {
      "startSec": 226.9,
      "text": "ちょっと否定する(to deny)、"
    },
    {
      "startSec": 233.9,
      "text": "これはけんそんです。"
    },
    {
      "startSec": 237,
      "text": "だから日本では家族のことも、けんそんします。"
    },
    {
      "startSec": 244.2,
      "text": "私が小学生の時に私のお母さんが"
    },
    {
      "startSec": 248.6,
      "text": "私の友達のお母さんと話をしていたのを覚えています。"
    },
    {
      "startSec": 255.9,
      "text": "そのお母さんは、自分の子供の前で"
    },
    {
      "startSec": 260,
      "text": "「いや、私の子はもう顔が不細工で"
    },
    {
      "startSec": 263.2,
      "text": "サッカーしかできないから、勉強はできないから"
    },
    {
      "startSec": 267.4,
      "text": "もう本当に困ってるの」って言っていました。"
    },
    {
      "startSec": 273.3,
      "text": "子供の目の前で言っていました。"
    },
    {
      "startSec": 276.7,
      "text": "やっぱり子供は親に認めてもらえなかったりしたら"
    },
    {
      "startSec": 283.4,
      "text": "それをずっと覚えています。"
    },
    {
      "startSec": 287.3,
      "text": "小さい時に親に自分は何もできないって言われたら"
    },
    {
      "startSec": 291.8,
      "text": "本当に悲しくなるし、忘れられないし"
    },
    {
      "startSec": 297.9,
      "text": "これは結構問題だと思います。"
    },
    {
      "startSec": 301.3,
      "text": "だから多分、日本人は自己肯定感が低い。"
    },
    {
      "startSec": 307.3,
      "text": "自己肯定感(self-esteem)"
    },
    {
      "startSec": 311.2,
      "text": "だから日本人の自己肯定感は、"
    },
    {
      "startSec": 314.7,
      "text": "他の国に比べてすごく低いです。"
    },
    {
      "startSec": 320.4,
      "text": "私はその理由の一つに"
    },
    {
      "startSec": 325.1,
      "text": "絶対にこの「けんそんの文化」があると思っています。"
    },
    {
      "startSec": 330.6,
      "text": "皆さんの国では家族のことをけんそんしたりしますか？"
    },
    {
      "startSec": 336.3,
      "text": "良かったらYouTubeのコメントで教えてください。"
    },
    {
      "startSec": 341.5,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 343.9,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 348,
      "text": "じゃあまた明日！また明日も聞いてね。"
    },
    {
      "startSec": 351.1,
      "text": "バイバイ！"
    }
  ]
}
