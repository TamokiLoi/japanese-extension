{
  "episodeId": "IM6qwuk4gto",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "もう2022年、半分終わりそうですね。"
    },
    {
      "startSec": 12.1,
      "text": "もう六月になります。"
    },
    {
      "startSec": 15.5,
      "text": "やばくないですか？早くないですか？"
    },
    {
      "startSec": 20.4,
      "text": "この前クリスマスだったような気がします。"
    },
    {
      "startSec": 25.2,
      "text": "いやー、やばいですね。"
    },
    {
      "startSec": 27,
      "text": "なんか最近は本当に、もう一ヶ月があっという間。"
    },
    {
      "startSec": 33.8,
      "text": "これは「早い」という、"
    },
    {
      "startSec": 36.3,
      "text": "「あ！」と言っているうちに"
    },
    {
      "startSec": 40,
      "text": "時間が過ぎてしまう、時間が経つという意味です。"
    },
    {
      "startSec": 44.9,
      "text": "あっという間ですよね。"
    },
    {
      "startSec": 47.3,
      "text": "いや…皆さんはこの半年、"
    },
    {
      "startSec": 51.1,
      "text": "一月から六月までどうでしたか？"
    },
    {
      "startSec": 56.6,
      "text": "多分クリスマスの終わり、一月に"
    },
    {
      "startSec": 60.9,
      "text": "新しいゴールを作ったと思いますが"
    },
    {
      "startSec": 65.1,
      "text": "そのゴールはどうですか？達成できましたか？"
    },
    {
      "startSec": 70.2,
      "text": "まだ頑張っていますか？"
    },
    {
      "startSec": 73.8,
      "text": "私は結構すぐ何でも忘れるので"
    },
    {
      "startSec": 77.7,
      "text": "ゴールも忘れてしまったんですが、"
    },
    {
      "startSec": 81.4,
      "text": "でもこの半年は、去年と一昨年(おとどし、おととし)"
    },
    {
      "startSec": 87.8,
      "text": "一昨年は二年前、去年と一昨年に比べて"
    },
    {
      "startSec": 94.4,
      "text": "心に優しい半年だったと思います。"
    },
    {
      "startSec": 101.2,
      "text": "去年と一昨年は、私結構まあちょっと…"
    },
    {
      "startSec": 105.1,
      "text": "自分を何だろう、見失った？"
    },
    {
      "startSec": 109,
      "text": "なんか自分を忘れちゃって"
    },
    {
      "startSec": 111,
      "text": "ちょっとやり過ぎた感じがしていて"
    },
    {
      "startSec": 115,
      "text": "でも、今年はジャックさんと"
    },
    {
      "startSec": 118.2,
      "text": "一緒に生活をするようになって"
    },
    {
      "startSec": 122,
      "text": "自分の時間ができたのが本当に良かったです。"
    },
    {
      "startSec": 127.2,
      "text": "今まではジャックと一緒に住んでいなかったので"
    },
    {
      "startSec": 132.3,
      "text": "休日も週末も、仕事してて"
    },
    {
      "startSec": 138.4,
      "text": "で、休む時間がなかった、ほぼゼロでしたね。"
    },
    {
      "startSec": 143.2,
      "text": "でもやっぱり休む時間がないと、"
    },
    {
      "startSec": 146.6,
      "text": "一つのことをしか見えなくなって"
    },
    {
      "startSec": 150.9,
      "text": "自分の中のバランスが壊れてしまう、"
    },
    {
      "startSec": 155.4,
      "text": "バランスが良くなくなるんですよね。"
    },
    {
      "startSec": 159,
      "text": "本当にバランスが悪かったです。"
    },
    {
      "startSec": 161.4,
      "text": "結構、私は自然が大好きで"
    },
    {
      "startSec": 166.4,
      "text": "本当の性格は楽観的(optimistic)で"
    },
    {
      "startSec": 171.8,
      "text": "リラックスしてるんですけど、"
    },
    {
      "startSec": 174.5,
      "text": "そういう自分じゃなくなって"
    },
    {
      "startSec": 177.2,
      "text": "本当にもういつもストレスで"
    },
    {
      "startSec": 181.2,
      "text": "「これからどうしよう、どうしよう」"
    },
    {
      "startSec": 183.8,
      "text": "「Instagram頑張らないと」"
    },
    {
      "startSec": 186.2,
      "text": "「ビジネスの勉強しないと」みたいな。"
    },
    {
      "startSec": 188.9,
      "text": "本当にもうちょっと自然とかそういう"
    },
    {
      "startSec": 193.5,
      "text": "本当の私を忘れていた時でした。"
    },
    {
      "startSec": 201.2,
      "text": "で、今は戻ってきた。"
    },
    {
      "startSec": 204,
      "text": "本当の自分に帰ってきた感じがしています。"
    },
    {
      "startSec": 211.2,
      "text": "で、それはやっぱりジャックさんのおかげです。"
    },
    {
      "startSec": 216.6,
      "text": "ちゃんと自分の時間を作るようになったこと。"
    },
    {
      "startSec": 222.7,
      "text": "それが本当に大きいです。"
    },
    {
      "startSec": 226.9,
      "text": "皆さんはちゃんと自分の時間、作っていますか？"
    },
    {
      "startSec": 232,
      "text": "多分去年の私は、休みはいらないと"
    },
    {
      "startSec": 237.3,
      "text": "思っていたと思います。"
    },
    {
      "startSec": 239.4,
      "text": "休む時間があるならコンテンツ作らないととか"
    },
    {
      "startSec": 244.8,
      "text": "休んだら生産的(productive)じゃなくなるとか"
    },
    {
      "startSec": 252.3,
      "text": "思っていたと思います。"
    },
    {
      "startSec": 255,
      "text": "でも今の自分はそうじゃないと思います。"
    },
    {
      "startSec": 261,
      "text": "本当に変わって良かった。"
    },
    {
      "startSec": 264.1,
      "text": "やっぱりプロダクティブも"
    },
    {
      "startSec": 267,
      "text": "本当にそれはすごく狭い基準ですよね。"
    },
    {
      "startSec": 272.2,
      "text": "「何をどうプロダクティブと言うの？」という話です。"
    },
    {
      "startSec": 277.8,
      "text": "自分は本当にたくさんコンテンツを"
    },
    {
      "startSec": 280.9,
      "text": "何本も動画を作っていると思っていても"
    },
    {
      "startSec": 287,
      "text": "どこかその動画から"
    },
    {
      "startSec": 290.2,
      "text": "なくなってしまったものがあるかもしれません。"
    },
    {
      "startSec": 295.9,
      "text": "あとは家族との時間ね。"
    },
    {
      "startSec": 298.7,
      "text": "大切にできていないかもしれません。"
    },
    {
      "startSec": 303.1,
      "text": "なんかそういう風に考えると、"
    },
    {
      "startSec": 305.9,
      "text": "とりあえず働く、たくさん働く、勉強する"
    },
    {
      "startSec": 312.4,
      "text": "それだけがプロダクティブじゃないですよね。"
    },
    {
      "startSec": 317.4,
      "text": "何か自分でもちょっと言ってることが今"
    },
    {
      "startSec": 319.8,
      "text": "わからなくなったんですが、"
    },
    {
      "startSec": 322.5,
      "text": "皆さんはどう思いますか？"
    },
    {
      "startSec": 326.5,
      "text": "やっぱり自分の時間を大切に"
    },
    {
      "startSec": 329.9,
      "text": "すればするほど…意味は、"
    },
    {
      "startSec": 334.5,
      "text": "自分の時間を大切にしたらもっと人生が良くなる。"
    },
    {
      "startSec": 341.9,
      "text": "性格、パーソナリティもきっともっと明るくなって"
    },
    {
      "startSec": 346.4,
      "text": "他の人に優しくできるようになります。"
    },
    {
      "startSec": 352.1,
      "text": "最近、この2022年は"
    },
    {
      "startSec": 355,
      "text": "このことにやっと、また気が付いた私です。"
    },
    {
      "startSec": 361.3,
      "text": "やっと戻ってきた感じがしています。"
    },
    {
      "startSec": 365.7,
      "text": "良かったら皆さんの2022年、"
    },
    {
      "startSec": 369.9,
      "text": "どんな感じかコメントで教えてください。"
    },
    {
      "startSec": 375.5,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 377.5,
      "text": "もしトランスクリプトが読みたい人は"
    },
    {
      "startSec": 382.2,
      "text": "Patreonのメンバーになったら"
    },
    {
      "startSec": 386.6,
      "text": "トランスクリプト読むことができます。"
    },
    {
      "startSec": 389.8,
      "text": "HTML、普通のトランスクリプトと"
    },
    {
      "startSec": 393.4,
      "text": "ふりがなが付いているPDFもあります。"
    },
    {
      "startSec": 399.2,
      "text": "良かったら使ってください。"
    },
    {
      "startSec": 401.9,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 403.7,
      "text": "じゃあ良い一日を！また明日も聞いてください。"
    },
    {
      "startSec": 408.4,
      "text": "またね～バイバイ！"
    }
  ]
}
