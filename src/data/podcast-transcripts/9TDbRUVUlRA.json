{
  "episodeId": "9TDbRUVUlRA",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.5,
      "text": "BITE SIZE JAPANESEのレイラです。"
    },
    {
      "startSec": 3.5,
      "text": "はい、元気ですか？"
    },
    {
      "startSec": 5.3,
      "text": "今日はね、あの自転車のカギを"
    },
    {
      "startSec": 9.3,
      "text": "トイレに流した話をしたいと思います。"
    },
    {
      "startSec": 14.6,
      "text": "でね、すごく大変で2時間ぐらいね"
    },
    {
      "startSec": 19,
      "text": "自転車のカギをピンで頑張って開けようとして"
    },
    {
      "startSec": 23.8,
      "text": "開かなくて、家に3時間かけて帰った話です。"
    },
    {
      "startSec": 31.6,
      "text": "や～疲れましたね…"
    },
    {
      "startSec": 32.9,
      "text": "でもまぁ、今はいい思い出になりました。"
    },
    {
      "startSec": 39,
      "text": "で、Instagramのストーリーズでもね"
    },
    {
      "startSec": 41.4,
      "text": "その話をしたので、知ってる人もいると思います。"
    },
    {
      "startSec": 47.2,
      "text": "まあゼロから話しますね、知らない人のために。"
    },
    {
      "startSec": 51.9,
      "text": "えっと…その日は私はビーチに行きました。"
    },
    {
      "startSec": 58.3,
      "text": "私は今、岡山県の田舎に住んでます。"
    },
    {
      "startSec": 63.4,
      "text": "岡山県は海があるので"
    },
    {
      "startSec": 66.7,
      "text": "私のこのアパートからも海まで行くことができます。"
    },
    {
      "startSec": 72.1,
      "text": "大体8キロくらいかな。"
    },
    {
      "startSec": 75.4,
      "text": "8キロくらい、遠くにあります。"
    },
    {
      "startSec": 78.6,
      "text": "でもここ田舎なので"
    },
    {
      "startSec": 81.4,
      "text": "そのビーチに行くまで"
    },
    {
      "startSec": 84.1,
      "text": "バスとか電車がないです。"
    },
    {
      "startSec": 88.2,
      "text": "でも私はすごくビーチが好きで。"
    },
    {
      "startSec": 93.6,
      "text": "うん、ビーチが好き！"
    },
    {
      "startSec": 96.6,
      "text": "めっちゃ好きなの。"
    },
    {
      "startSec": 98.4,
      "text": "なので、自転車を最近買いました、ビーチに行くために。"
    },
    {
      "startSec": 104.2,
      "text": "やっぱり8キロね、"
    },
    {
      "startSec": 105.6,
      "text": "いつも歩いて帰ってくるのは大変だと思ったので"
    },
    {
      "startSec": 110.9,
      "text": "自転車を買って"
    },
    {
      "startSec": 112.7,
      "text": "ビーチに行くために準備をして"
    },
    {
      "startSec": 115,
      "text": "その日、初めてビーチに行きました。"
    },
    {
      "startSec": 118.3,
      "text": "うん、ジャックさんと2人で自転車で"
    },
    {
      "startSec": 121.5,
      "text": "1時間ぐらいかかったかな。"
    },
    {
      "startSec": 124.1,
      "text": "ビーチに行って、すごくリラックスして"
    },
    {
      "startSec": 128.3,
      "text": "砂(sand)の上で横になって"
    },
    {
      "startSec": 131.9,
      "text": "横になる(to lie down)、寝ると言う意味。"
    },
    {
      "startSec": 137,
      "text": "すごく気持ちよかったんだけど"
    },
    {
      "startSec": 142.2,
      "text": "もちろん、トイレに行きたくなって"
    },
    {
      "startSec": 145,
      "text": "トイレに行きました。"
    },
    {
      "startSec": 149.6,
      "text": "まあ古いビーチなので"
    },
    {
      "startSec": 152.5,
      "text": "1つだけトイレがあって"
    },
    {
      "startSec": 154.9,
      "text": "それは日本の古い、"
    },
    {
      "startSec": 158.1,
      "text": "なに…スクワット(squat)？スクワットトイレかな？"
    },
    {
      "startSec": 161.8,
      "text": "西洋(western style)じゃなくて"
    },
    {
      "startSec": 164.1,
      "text": "まあ床に穴があって"
    },
    {
      "startSec": 166.3,
      "text": "その上にスクワットの形で"
    },
    {
      "startSec": 168.8,
      "text": "座るタイプのトイレがありました。"
    },
    {
      "startSec": 172.5,
      "text": "そこでトイレをして、立って水を流したのね。"
    },
    {
      "startSec": 178.7,
      "text": "トイレの水を流した時に"
    },
    {
      "startSec": 182.5,
      "text": "ズボンのポケットから"
    },
    {
      "startSec": 184.6,
      "text": "自転車のカギが落ちました。"
    },
    {
      "startSec": 188.9,
      "text": "で、カギがトイレの水の中に入って、普通に流れました。"
    },
    {
      "startSec": 199.5,
      "text": "もう本当に一瞬だった。"
    },
    {
      "startSec": 202.6,
      "text": "一瞬、本当にすぐだったので、もう何もできなくて"
    },
    {
      "startSec": 208.4,
      "text": "もうね、先に水を流してしまったので"
    },
    {
      "startSec": 212.2,
      "text": "うん、止められなかったです。"
    },
    {
      "startSec": 215.7,
      "text": "いや～困ったな…"
    },
    {
      "startSec": 217.3,
      "text": "で、すっごく焦って"
    },
    {
      "startSec": 222.3,
      "text": "自転車まで戻って…"
    },
    {
      "startSec": 225.6,
      "text": "もちろんその自転車を家まで"
    },
    {
      "startSec": 229.9,
      "text": "持って帰ることができなかったので"
    },
    {
      "startSec": 232.8,
      "text": "そこでカギを頑張って開けようとしました。"
    },
    {
      "startSec": 237.1,
      "text": "あの…ピンをね"
    },
    {
      "startSec": 239.5,
      "text": "道に落ちていたピンを頑張って探してきて"
    },
    {
      "startSec": 243.5,
      "text": "自転車のカギの穴に入れて"
    },
    {
      "startSec": 246.5,
      "text": "でYouTubeでそのカギを開ける…"
    },
    {
      "startSec": 250.4,
      "text": "ロックピンって言いますかね？"
    },
    {
      "startSec": 252.7,
      "text": "の、ビデオ？レッスン？を頑張って探してきて"
    },
    {
      "startSec": 260.5,
      "text": "2時間ぐらいジャックと2人で頑張りました。"
    },
    {
      "startSec": 265.4,
      "text": "いやでもね、本当に難しかったです。"
    },
    {
      "startSec": 268.5,
      "text": "うーん、できなかった。"
    },
    {
      "startSec": 270.4,
      "text": "で自転車のカギの、カギのなんか構造(structure)も"
    },
    {
      "startSec": 276.2,
      "text": "頑張って勉強したけどできなかった。"
    },
    {
      "startSec": 280.7,
      "text": "だから多分、映画でよくキャラクターが"
    },
    {
      "startSec": 286.6,
      "text": "カギを開けますよね、ピンで。"
    },
    {
      "startSec": 289.6,
      "text": "最近「ミザリー」っていう映画を見たんですが"
    },
    {
      "startSec": 293.8,
      "text": "主人公、メインキャラクターが"
    },
    {
      "startSec": 296.8,
      "text": "ドアをこう、ヘアピンで開けますよね。"
    },
    {
      "startSec": 301.4,
      "text": "怪我して足が動かなくて"
    },
    {
      "startSec": 303.3,
      "text": "カギの穴見えないけど、自分で見えないけど"
    },
    {
      "startSec": 306.9,
      "text": "こうやって手を後にしてカギを開けます。"
    },
    {
      "startSec": 311.3,
      "text": "いや普通、私ね多分それ絶対できないと思う。"
    },
    {
      "startSec": 315.9,
      "text": "2時間も頑張って"
    },
    {
      "startSec": 317.4,
      "text": "カギ開けることができなかったから"
    },
    {
      "startSec": 320.1,
      "text": "普通はカギは開けれないと思います。"
    },
    {
      "startSec": 325.4,
      "text": "2時間頑張ってトライして"
    },
    {
      "startSec": 328.3,
      "text": "暗くなってきたので諦めて歩いて帰りました。"
    },
    {
      "startSec": 333.9,
      "text": "すごく時間がかかって"
    },
    {
      "startSec": 336.5,
      "text": "3時間ぐらいかけて家に帰りました。"
    },
    {
      "startSec": 342,
      "text": "で、次の日は日曜日だったので"
    },
    {
      "startSec": 345.7,
      "text": "朝早くにホームセンターに行って"
    },
    {
      "startSec": 350.3,
      "text": "ノコギリ(saw)、大きなナイフ買って"
    },
    {
      "startSec": 356.1,
      "text": "また3時間かけてビーチに行って"
    },
    {
      "startSec": 359.9,
      "text": "自転車のカギ、ノコギリで切って開けました。"
    },
    {
      "startSec": 368.3,
      "text": "まあでも、すごくジャックが優しくて"
    },
    {
      "startSec": 371.6,
      "text": "もう文句を言わないで"
    },
    {
      "startSec": 374.1,
      "text": "楽しく散歩して帰ってきたので"
    },
    {
      "startSec": 377.5,
      "text": "いい思い出になりましたという話です。"
    },
    {
      "startSec": 382.3,
      "text": "あんまり私は物語を話すのが"
    },
    {
      "startSec": 386,
      "text": "上手じゃないんですが"
    },
    {
      "startSec": 389,
      "text": "皆さんが楽しんでくれたら良かったです。"
    },
    {
      "startSec": 393.6,
      "text": "じゃあ今日はこんな感じで終わりたいと思います。"
    },
    {
      "startSec": 397.3,
      "text": "このポッドキャストにはトランスクリプトがあって"
    },
    {
      "startSec": 402.2,
      "text": "トランスクリプトには"
    },
    {
      "startSec": 404,
      "text": "漢字の上にふりがなもあります。"
    },
    {
      "startSec": 407.6,
      "text": "なので、このYouTubeの字幕が"
    },
    {
      "startSec": 410.8,
      "text": "ちょっと読むのが難しいとか"
    },
    {
      "startSec": 413.3,
      "text": "漢字の読み方を勉強したいとか"
    },
    {
      "startSec": 417.4,
      "text": "もしそういうことだったら"
    },
    {
      "startSec": 419.9,
      "text": "Patreonに入って"
    },
    {
      "startSec": 422.8,
      "text": "ぜひトランスクリプト使って勉強してください。"
    },
    {
      "startSec": 426.8,
      "text": "他にもね、ブログの記事(articles)とか"
    },
    {
      "startSec": 430.9,
      "text": "私のアップデートとか"
    },
    {
      "startSec": 434.1,
      "text": "色々Patreonで皆さんとシェアしているので"
    },
    {
      "startSec": 437.7,
      "text": "参加してくれるとすっごくうれしいです。"
    },
    {
      "startSec": 440.6,
      "text": "もうPatreonで私をサポートしてくれている人達もいます。"
    },
    {
      "startSec": 445.6,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 448.2,
      "text": "本当にうれしいし"
    },
    {
      "startSec": 450.1,
      "text": "やっぱり私のポッドキャストを"
    },
    {
      "startSec": 452.7,
      "text": "応援したいと思ってくれている人がいることは"
    },
    {
      "startSec": 457.4,
      "text": "もう本当に、本当にうれしいし"
    },
    {
      "startSec": 460.4,
      "text": "私の心の支えになっています。"
    },
    {
      "startSec": 464.7,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 467.4,
      "text": "じゃまたこれからもよろしくお願いします。"
    },
    {
      "startSec": 470.5,
      "text": "今日も勉強とか仕事、無理せずに頑張ってください。"
    },
    {
      "startSec": 475.6,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
