{
  "episodeId": "iXT8HemGg8o",
  "segments": [
    {
      "startSec": 0,
      "text": "はい、皆さんこんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4,
      "text": "今日は、1日にどれくらい勉強したらいいかな"
    },
    {
      "startSec": 9.9,
      "text": "という話をしたいと思います。"
    },
    {
      "startSec": 13,
      "text": "皆さんは毎日、どれくらい勉強していますか？"
    },
    {
      "startSec": 18.4,
      "text": "このポッドキャストを聞いているということは"
    },
    {
      "startSec": 21.4,
      "text": "多分皆さんは、すごく日本語が上手だと思います。"
    },
    {
      "startSec": 26.5,
      "text": "今までもきっと、何年も日本語を勉強してきたと思います。"
    },
    {
      "startSec": 32.3,
      "text": "途中でやめちゃう人も多いですが"
    },
    {
      "startSec": 35.8,
      "text": "やめなかった皆さんは本当に素晴らしいし"
    },
    {
      "startSec": 39.6,
      "text": "すっごく多分、真面目な人だと思っています。"
    },
    {
      "startSec": 44.2,
      "text": "皆さんのイメージです。"
    },
    {
      "startSec": 45.8,
      "text": "真面目で、ちょっとなんだろう…？"
    },
    {
      "startSec": 48.4,
      "text": "シャイなのかなとか"
    },
    {
      "startSec": 50,
      "text": "色々ちょっと皆さんのイメージをしてるんですが"
    },
    {
      "startSec": 54.4,
      "text": "毎日どれくらい勉強していますか、日本語の勉強？"
    },
    {
      "startSec": 59.3,
      "text": "やっぱり勉強の時間って大切ですよね。"
    },
    {
      "startSec": 64,
      "text": "例えば、1日5分とか10分だけだったら"
    },
    {
      "startSec": 68.6,
      "text": "多分皆さんの今のレベルまで"
    },
    {
      "startSec": 71.8,
      "text": "日本語が上手になることは"
    },
    {
      "startSec": 74.9,
      "text": "できなかったと思います。"
    },
    {
      "startSec": 77,
      "text": "多分皆さん毎日、何時間も勉強してきましたよね。"
    },
    {
      "startSec": 81.4,
      "text": "で、私は皆さんのゴールによって違うと思いますが、"
    },
    {
      "startSec": 88.3,
      "text": "もしも日本語をスラスラ話せるようになりたい"
    },
    {
      "startSec": 94,
      "text": "ペラペラになりたいと思っていたら"
    },
    {
      "startSec": 98.7,
      "text": "少なくても(at least)、1日2時間くらいは"
    },
    {
      "startSec": 106.9,
      "text": "必要じゃないかなと思っています。"
    },
    {
      "startSec": 110.6,
      "text": "2時間、すっごく集中する必要はないですが"
    },
    {
      "startSec": 114.7,
      "text": "大体2時間かな。"
    },
    {
      "startSec": 118,
      "text": "で、私の友達で3年間で"
    },
    {
      "startSec": 121.9,
      "text": "日本語がほとんどペラペラになった女の子がいます。"
    },
    {
      "startSec": 127.6,
      "text": "その子は1日に何時間だと思いますか？"
    },
    {
      "startSec": 132.4,
      "text": "何時間…6時間！"
    },
    {
      "startSec": 135.4,
      "text": "1日に6時間、3年間毎日勉強していました。"
    },
    {
      "startSec": 141.6,
      "text": "6時間は、さすがに働いていたりすると時間はないですよね。"
    },
    {
      "startSec": 148,
      "text": "でも私は、2時間くらいだったら"
    },
    {
      "startSec": 152.9,
      "text": "皆さんが仕事をしていても2時間"
    },
    {
      "startSec": 157.2,
      "text": "日本語のために準備することはできると思っています。"
    },
    {
      "startSec": 162.8,
      "text": "特にポッドキャストとかリスニングで勉強する場合は"
    },
    {
      "startSec": 169.5,
      "text": "2時間絶対に作ることができます。"
    },
    {
      "startSec": 173.1,
      "text": "例えば、食器を洗っている時とか"
    },
    {
      "startSec": 177,
      "text": "仕事に行く車の中とか、電車の中とか"
    },
    {
      "startSec": 182.2,
      "text": "小さな空いてる時間に"
    },
    {
      "startSec": 185.4,
      "text": "ポッドキャストをプレイする習慣(routine)"
    },
    {
      "startSec": 190.2,
      "text": "習慣を付けたら、私は必ず1日に2時間くらい"
    },
    {
      "startSec": 196.3,
      "text": "しっかりリスニングの勉強をする時間ができると思います。"
    },
    {
      "startSec": 202.5,
      "text": "もし皆さんが今特に、"
    },
    {
      "startSec": 204.4,
      "text": "スピーキングの練習をするチャンスがないとか"
    },
    {
      "startSec": 210.8,
      "text": "スピーキングのお金を払う余裕がないとか"
    },
    {
      "startSec": 216.6,
      "text": "スピーキングの相手を見つけられないとか"
    },
    {
      "startSec": 220.7,
      "text": "そういう風に思っていたら"
    },
    {
      "startSec": 223.3,
      "text": "是非まずは、リスニングから始めてみてください。"
    },
    {
      "startSec": 227.9,
      "text": "私もリスニングで英語は勉強しました。"
    },
    {
      "startSec": 231.8,
      "text": "ポッドキャストを毎日1～2時間くらい"
    },
    {
      "startSec": 235.8,
      "text": "毎日2年くらい聞いて英語を勉強しました。"
    },
    {
      "startSec": 240.2,
      "text": "ポッドキャストは、もう本当に私は大好きで"
    },
    {
      "startSec": 244.3,
      "text": "大切なフレーズとかも勉強できるし"
    },
    {
      "startSec": 248,
      "text": "文の構造(structure)も勉強できるし"
    },
    {
      "startSec": 255,
      "text": "イントネーションとか"
    },
    {
      "startSec": 256.6,
      "text": "発音とかも良くなります。"
    },
    {
      "startSec": 259.4,
      "text": "私はポッドキャストは本当に"
    },
    {
      "startSec": 262.4,
      "text": "一番いい言語の勉強の方法だと思います。"
    },
    {
      "startSec": 268.9,
      "text": "なので、私は毎日エピソードを"
    },
    {
      "startSec": 272.3,
      "text": "アップロードしたいです。"
    },
    {
      "startSec": 275.9,
      "text": "で、皆さんの勉強を本当にサポートしたいと"
    },
    {
      "startSec": 281,
      "text": "心から本当に思っています。"
    },
    {
      "startSec": 283.9,
      "text": "なので、いつも聞いてくれて"
    },
    {
      "startSec": 286.4,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 289.2,
      "text": "頑張ってリスニングでいいので"
    },
    {
      "startSec": 291.8,
      "text": "1日1時間とか2時間くらい時間を用意して"
    },
    {
      "startSec": 296.7,
      "text": "是非日本語ペラペラになってください。"
    },
    {
      "startSec": 300,
      "text": "私もサポートします。"
    },
    {
      "startSec": 303,
      "text": "じゃあ今日も頑張っていきましょう。"
    },
    {
      "startSec": 305.8,
      "text": "いつもありがとうございます！"
    },
    {
      "startSec": 307.7,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
