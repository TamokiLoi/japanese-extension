{
  "episodeId": "NyeCMWWSrxA",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい、みなさんこんにちは。"
    },
    {
      "startSec": 2.1,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.1,
      "text": "今日は、私がどうやって英語を勉強したかについて"
    },
    {
      "startSec": 13.5,
      "text": "話をしたいと思います。"
    },
    {
      "startSec": 16.4,
      "text": "はい、あのYouTubeのコメントで"
    },
    {
      "startSec": 20,
      "text": "リクエストをもらいました。"
    },
    {
      "startSec": 22.7,
      "text": "なので、今日は私がどうやって"
    },
    {
      "startSec": 27.5,
      "text": "今くらいに英語が話せるようになったかについて"
    },
    {
      "startSec": 34.1,
      "text": "話をしたいと思います。"
    },
    {
      "startSec": 37.4,
      "text": "えっと、じゃあ話を始める前にちょっとだけ。"
    },
    {
      "startSec": 42.3,
      "text": "最近ポッドキャストのPatreonを始めました。"
    },
    {
      "startSec": 49.2,
      "text": "今までと、これからのトランスクリプトとか"
    },
    {
      "startSec": 55.1,
      "text": "ポッドキャストで使った"
    },
    {
      "startSec": 57,
      "text": "難しい日本語の単語のリストとか"
    },
    {
      "startSec": 62.4,
      "text": "私のbehind sceneとか、"
    },
    {
      "startSec": 67.4,
      "text": "Quick and easy native phrasesね、"
    },
    {
      "startSec": 70.2,
      "text": "それをみなさんに全部教えます。"
    },
    {
      "startSec": 73.6,
      "text": "はい、ぜひリンクがあるので"
    },
    {
      "startSec": 76.9,
      "text": "そこから興味がある人はチェックしてみてください。"
    },
    {
      "startSec": 81.4,
      "text": "はい、そこでみなさんに会えるのを楽しみにしています。"
    },
    {
      "startSec": 86.5,
      "text": "はい、ありがとう。"
    },
    {
      "startSec": 88,
      "text": "じゃあね、えっと早速英語の話をしたいと思います。"
    },
    {
      "startSec": 94.5,
      "text": "まず私は、中学校と高校、そして大学の2年間"
    },
    {
      "startSec": 104.5,
      "text": "合計（=in total）合計8年間"
    },
    {
      "startSec": 109,
      "text": "8年間、学校で英語を勉強しました。"
    },
    {
      "startSec": 114.6,
      "text": "でもね、学校の英語の勉強って"
    },
    {
      "startSec": 120,
      "text": "文法、文法がメインです。"
    },
    {
      "startSec": 125.4,
      "text": "英語を日本語に翻訳したり"
    },
    {
      "startSec": 129.4,
      "text": "翻訳する(ほんやくする=to translate)、"
    },
    {
      "startSec": 133,
      "text": "訳す(やくす)、これも使います。"
    },
    {
      "startSec": 136,
      "text": "翻訳する、訳す（=to translate）"
    },
    {
      "startSec": 139.1,
      "text": "そう、英語を日本語に翻訳したり"
    },
    {
      "startSec": 143.7,
      "text": "日本語を英語に翻訳したり"
    },
    {
      "startSec": 147.9,
      "text": "こういう勉強がほとんどでした。"
    },
    {
      "startSec": 152.9,
      "text": "で、スピーキングの授業は全然なかったし"
    },
    {
      "startSec": 159.2,
      "text": "で、英語で外国の人と話すチャンス、"
    },
    {
      "startSec": 165.2,
      "text": "チャンスも全然なかったですね。"
    },
    {
      "startSec": 169.1,
      "text": "なので、たくさん学校で英語を勉強して、"
    },
    {
      "startSec": 174.3,
      "text": "難しい単語もたくさん勉強しました。"
    },
    {
      "startSec": 180.1,
      "text": "でも、大学で英語の勉強、全部終わった時に"
    },
    {
      "startSec": 187.8,
      "text": "私は全然英語が話せませんでした。"
    },
    {
      "startSec": 193,
      "text": "はい、もう全然できなくて。"
    },
    {
      "startSec": 195.9,
      "text": "私はずっと外国に興味がありました。"
    },
    {
      "startSec": 201,
      "text": "だから、観光客(かんこうきゃく)の人、外国から来た人を見ると"
    },
    {
      "startSec": 208.2,
      "text": "なんかすごくワクワクして話がしたくなる。"
    },
    {
      "startSec": 214.8,
      "text": "がんばって、勇気を出して、話に"
    },
    {
      "startSec": 219.3,
      "text": "ちょっと話したいなって、話に行くんだけど"
    },
    {
      "startSec": 223.9,
      "text": "全然話せなくて。"
    },
    {
      "startSec": 226.4,
      "text": "なんか頭の中で\"Oh...what should I say...\""
    },
    {
      "startSec": 228.9,
      "text": "あ、\"Do you want, do you want me to take your pictures,"
    },
    {
      "startSec": 238.3,
      "text": "or ah...just picture, eh!?\"みたいなそんな感じでした。"
    },
    {
      "startSec": 243.5,
      "text": "全然話せなくって…うん。"
    },
    {
      "startSec": 246.6,
      "text": "でもテストの点は、すごくよかったです。"
    },
    {
      "startSec": 251.2,
      "text": "でもやっぱりテストの英語と"
    },
    {
      "startSec": 254.2,
      "text": "本当に使う英語って全然違いますよね、うん。"
    },
    {
      "startSec": 260.4,
      "text": "で、大学で英語の勉強が終わった後に"
    },
    {
      "startSec": 265.7,
      "text": "私はジャックさん、今のイギリス人の彼氏と会いました。"
    },
    {
      "startSec": 273.1,
      "text": "その時は、あまりしゃべれなかったけど"
    },
    {
      "startSec": 280.6,
      "text": "本当に下手な英語で"
    },
    {
      "startSec": 283.4,
      "text": "がんばってコミュニケーションを取りました。"
    },
    {
      "startSec": 289.4,
      "text": "\"Do you like Japan? I'm Layla.\""
    },
    {
      "startSec": 292.7,
      "text": "\"I'm from Kyoto.\"みたいな"
    },
    {
      "startSec": 295.2,
      "text": "もうベーシックな英語で話しました。"
    },
    {
      "startSec": 298.1,
      "text": "ジャックもすっごく優しくて"
    },
    {
      "startSec": 301,
      "text": "いつもめっちゃシンプルな英語で"
    },
    {
      "startSec": 304.8,
      "text": "話してくれました。"
    },
    {
      "startSec": 307.3,
      "text": "だから、もう本当に全然英語はできなかったけど"
    },
    {
      "startSec": 313.5,
      "text": "あの自分の言いたいことを英語で"
    },
    {
      "startSec": 317.4,
      "text": "ジャックに言うことができたし、"
    },
    {
      "startSec": 321.1,
      "text": "ジャックの気持ちも分かりました。"
    },
    {
      "startSec": 324.1,
      "text": "で、やっぱりジャックのことが好きになったので"
    },
    {
      "startSec": 329,
      "text": "その時に付き合い始めました。"
    },
    {
      "startSec": 332.4,
      "text": "付き合う(つきあう=to date with someone)"
    },
    {
      "startSec": 335.7,
      "text": "付き合い始めて、ジャックは"
    },
    {
      "startSec": 339.1,
      "text": "その時は全然英語…じゃないじゃない"
    },
    {
      "startSec": 343.6,
      "text": "日本語は話せなかった。"
    },
    {
      "startSec": 346.2,
      "text": "ジャックはまだ勉強を始めていなかったので"
    },
    {
      "startSec": 352,
      "text": "その時は、英語でいつも話をしていました。"
    },
    {
      "startSec": 359.5,
      "text": "遠距離恋愛(えんきょりれんあい=long distance relationship)"
    },
    {
      "startSec": 364.4,
      "text": "遠距離恋愛でした。"
    },
    {
      "startSec": 367.3,
      "text": "なので、毎日電話1時間くらい"
    },
    {
      "startSec": 372.1,
      "text": "毎日電話、寝る前にベッドの中で"
    },
    {
      "startSec": 376.6,
      "text": "1日1回電話をしました。"
    },
    {
      "startSec": 381.4,
      "text": "毎日長いメッセージも、英語でがんばって書きました。"
    },
    {
      "startSec": 387.9,
      "text": "で、これを大体、大体(だいたい=about)"
    },
    {
      "startSec": 392.7,
      "text": "大体3年間続けました。"
    },
    {
      "startSec": 397.5,
      "text": "で、やっぱりこれが一番、私の英語の勉強で大切かな。"
    },
    {
      "startSec": 407.1,
      "text": "一番、私の英語が良くなった(=improved)"
    },
    {
      "startSec": 412.2,
      "text": "良くなった時でした。"
    },
    {
      "startSec": 415.3,
      "text": "やっぱり、英語を使うこと、日本語を使うことって"
    },
    {
      "startSec": 421.8,
      "text": "すごく大切ですよね。"
    },
    {
      "startSec": 424.4,
      "text": "もちろん、教科書で文法、勉強したり"
    },
    {
      "startSec": 428.2,
      "text": "リスニングの勉強も大切、だけど"
    },
    {
      "startSec": 431.8,
      "text": "その、そうじゃなくて、本当に日本語を使う"
    },
    {
      "startSec": 437.3,
      "text": "あなたの生活の中で日本語を使うこと、英語を使うこと"
    },
    {
      "startSec": 444,
      "text": "これが言語(=language)の勉強で"
    },
    {
      "startSec": 448.5,
      "text": "一番大切になります。"
    },
    {
      "startSec": 453.8,
      "text": "たくさん英語を使ったし、"
    },
    {
      "startSec": 456.9,
      "text": "あと大学生の時にジャックと付き合ったんだけど"
    },
    {
      "startSec": 461.8,
      "text": "その時は、私はもうすごく忙しかった。"
    },
    {
      "startSec": 466.8,
      "text": "あの卒業論文(そつぎょうろんぶん=graduation paper)を"
    },
    {
      "startSec": 474.5,
      "text": "書かないといけなかったので"
    },
    {
      "startSec": 477.6,
      "text": "めっちゃ忙しかった。"
    },
    {
      "startSec": 479.9,
      "text": "で、その大学を卒業して、"
    },
    {
      "startSec": 483.7,
      "text": "私は大学院(だいがくいん) graduate...graduate?"
    },
    {
      "startSec": 489.7,
      "text": "gra... I forgot what to say!! Graduate...ヤバイ！"
    },
    {
      "startSec": 495.3,
      "text": "大学の次の大学に行きました(大学院=graduate school)。"
    },
    {
      "startSec": 500.3,
      "text": "で、その時に時間ができたので、ポッドキャストを使って"
    },
    {
      "startSec": 505.7,
      "text": "あの毎日英語の勉強を始めました。"
    },
    {
      "startSec": 509.8,
      "text": "ま、勉強と言うよりは、勉強じゃなくて"
    },
    {
      "startSec": 514.3,
      "text": "もう毎日楽しくてポッドキャストを"
    },
    {
      "startSec": 517.8,
      "text": "英語で聞いていました。"
    },
    {
      "startSec": 519.9,
      "text": "毎日、多分1時間くらいかな。"
    },
    {
      "startSec": 523.7,
      "text": "長く、毎日散歩を、多分1時間か1時間半"
    },
    {
      "startSec": 530.9,
      "text": "散歩をしていたので"
    },
    {
      "startSec": 532.9,
      "text": "その時に聞いていました。"
    },
    {
      "startSec": 536.3,
      "text": "それが多分2年くらい、2年間くらい。"
    },
    {
      "startSec": 540.6,
      "text": "毎日、ジャックに電話して、メッセージも送って、"
    },
    {
      "startSec": 546.2,
      "text": "で、ポッドキャストも1時間くらい聞いていました。"
    },
    {
      "startSec": 551.4,
      "text": "このおかげで、私はずっと日本にいたけど"
    },
    {
      "startSec": 557.2,
      "text": "外国に住んだことはないけど"
    },
    {
      "startSec": 561.5,
      "text": "英語が今のレベルまで"
    },
    {
      "startSec": 565.7,
      "text": "話すことができるようになりました。"
    },
    {
      "startSec": 568.9,
      "text": "でも、今ちょっと思うことは"
    },
    {
      "startSec": 573.1,
      "text": "やっぱりジャックはすごく優しいし"
    },
    {
      "startSec": 576.8,
      "text": "でも英語の先生じゃないから"
    },
    {
      "startSec": 579.7,
      "text": "やっぱり私の英語は、間違って(まちがって)いても"
    },
    {
      "startSec": 584.2,
      "text": "直してくれないです。"
    },
    {
      "startSec": 587.7,
      "text": "なので、なんか間違えて覚えている英語もあるし"
    },
    {
      "startSec": 593.5,
      "text": "なんかまだまだ何て言ったらいいか分からない"
    },
    {
      "startSec": 598.8,
      "text": "あの文章、文とか表現(ひょうげん=expression）とか"
    },
    {
      "startSec": 603.5,
      "text": "たくさんあります。"
    },
    {
      "startSec": 605.3,
      "text": "だからこれはちょっと、どうしたらいいかな？"
    },
    {
      "startSec": 610.1,
      "text": "まだちょっと今の私にも分からないです。"
    },
    {
      "startSec": 615,
      "text": "やっぱり、英語の勉強、日本語の勉強"
    },
    {
      "startSec": 619.4,
      "text": "時間がかかりますね、本当に。"
    },
    {
      "startSec": 623.7,
      "text": "よく、インターネットとかで"
    },
    {
      "startSec": 627.5,
      "text": "もう3ヶ月で、たったの3ヶ月で"
    },
    {
      "startSec": 632.1,
      "text": "ペラペラになる方法とかありますけど"
    },
    {
      "startSec": 636.2,
      "text": "もう絶対ウソですよね。"
    },
    {
      "startSec": 638.5,
      "text": "そんな人いないと思う。"
    },
    {
      "startSec": 641,
      "text": "うん、絶対いない。"
    },
    {
      "startSec": 642.9,
      "text": "私の友達で"
    },
    {
      "startSec": 644.9,
      "text": "日本語がペラペラの女の子がいるんですけど"
    },
    {
      "startSec": 649.9,
      "text": "その子は今、高校生です。"
    },
    {
      "startSec": 653.4,
      "text": "で、その子は本当、まだね"
    },
    {
      "startSec": 656.8,
      "text": "完璧(かんぺき)、日本語は完璧じゃないけど"
    },
    {
      "startSec": 660.3,
      "text": "とってもナチュラルに話すことができます。"
    },
    {
      "startSec": 665.7,
      "text": "で、その子に「どうやって日本語を勉強したの？」と"
    },
    {
      "startSec": 671.1,
      "text": "聞いたことがあります。"
    },
    {
      "startSec": 674,
      "text": "で、彼女は「もう毎日6時間勉強していた」と言いました。"
    },
    {
      "startSec": 682.5,
      "text": "毎日6時間ですよ！"
    },
    {
      "startSec": 685.3,
      "text": "もう本当に、日本の文化とか"
    },
    {
      "startSec": 689,
      "text": "日本語が大好きな女の子です。"
    },
    {
      "startSec": 693,
      "text": "で、毎日6時間、教科書で一人で3年間、"
    },
    {
      "startSec": 700,
      "text": "3年間勉強していました。"
    },
    {
      "startSec": 703.7,
      "text": "はい、なので、やっぱり時間はかかります。"
    },
    {
      "startSec": 709.6,
      "text": "本当にね、でも時間はかかるけど"
    },
    {
      "startSec": 715.5,
      "text": "まあね、話せるようになった時"
    },
    {
      "startSec": 718.5,
      "text": "自分が「あ、ちょっとうまくなったかな」と思う時"
    },
    {
      "startSec": 723.6,
      "text": "すっごくうれしいですよね。"
    },
    {
      "startSec": 726.9,
      "text": "本当に何かを達成(たっせい)した気持ちになります。"
    },
    {
      "startSec": 733.5,
      "text": "You might feel like you have achieved something,"
    },
    {
      "startSec": 735.9,
      "text": "achieved something big!!"
    },
    {
      "startSec": 737.6,
      "text": "分かりますか？"
    },
    {
      "startSec": 739.7,
      "text": "やっぱり、そういうところが"
    },
    {
      "startSec": 742.3,
      "text": "言語の勉強のいいところだと思います。"
    },
    {
      "startSec": 747.2,
      "text": "もうコツコツがんばる力、力がつくこと"
    },
    {
      "startSec": 751.9,
      "text": "がんばる力がつくこととか"
    },
    {
      "startSec": 755.7,
      "text": "継続(けいぞく=to be consistent)"
    },
    {
      "startSec": 758.3,
      "text": "継続の力を知ることができたり"
    },
    {
      "startSec": 764.6,
      "text": "色んな人に優しくなれたり"
    },
    {
      "startSec": 767.9,
      "text": "他の文化を知ることができたり"
    },
    {
      "startSec": 772.8,
      "text": "多分、脳（のう=brain)の、脳の何だろう？"
    },
    {
      "startSec": 779.5,
      "text": "脳にもいいと思います。"
    },
    {
      "startSec": 781.8,
      "text": "よく言語を勉強すると"
    },
    {
      "startSec": 785.4,
      "text": "例えば…I don't know what to say in English,"
    },
    {
      "startSec": 788.8,
      "text": "あの…年を取ると"
    },
    {
      "startSec": 793.1,
      "text": "あの色々忘れてしまう病気がありますよね？"
    },
    {
      "startSec": 797.6,
      "text": "その病気の予防(よぼう=prevent)"
    },
    {
      "startSec": 800.8,
      "text": "You can prevent the disease(dimentia)とか。"
    },
    {
      "startSec": 804.5,
      "text": "本当にいいことがたくさんありますね。"
    },
    {
      "startSec": 808.2,
      "text": "なので、みなさんもこれから"
    },
    {
      "startSec": 812,
      "text": "毎日一日一日を大切にして"
    },
    {
      "startSec": 816.4,
      "text": "日本語の勉強をがんばってください。"
    },
    {
      "startSec": 820.5,
      "text": "そして、本当にポッドキャストは"
    },
    {
      "startSec": 824.7,
      "text": "言語の勉強の中で"
    },
    {
      "startSec": 829.4,
      "text": "一番、多分一番にいい方法だと思います。"
    },
    {
      "startSec": 833.9,
      "text": "一番いい方法だと思います。"
    },
    {
      "startSec": 836.5,
      "text": "なので、これからもたくさんポッドキャストを聞いて"
    },
    {
      "startSec": 843.1,
      "text": "楽しんでください、日本語の勉強。"
    },
    {
