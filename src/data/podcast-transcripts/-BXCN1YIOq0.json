{
  "episodeId": "-BXCN1YIOq0",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.9,
      "text": "皆さんは、日本人は「におい」に厳しいって知ってましたか？"
    },
    {
      "startSec": 13.7,
      "text": "日本人は、においにすごく厳しいです、においにうるさいです。"
    },
    {
      "startSec": 19.4,
      "text": "この場合のうるさいは、noisyのうるさいじゃなくて"
    },
    {
      "startSec": 23.9,
      "text": "においに…「ワヤワヤワヤ」みたいな"
    },
    {
      "startSec": 27.7,
      "text": "色々言う、においに怒る、"
    },
    {
      "startSec": 31.1,
      "text": "においに対してうるさいという意味です。"
    },
    {
      "startSec": 36.6,
      "text": "だからちょっと皆さんが日本に来た時に"
    },
    {
      "startSec": 41.2,
      "text": "においに上手に気をつかって、においをケアして"
    },
    {
      "startSec": 46,
      "text": "楽しく日本の人と過ごせるように"
    },
    {
      "startSec": 50.1,
      "text": "ちょっとアドバイスをします。"
    },
    {
      "startSec": 53.5,
      "text": "日本人はすごく清潔なんです。"
    },
    {
      "startSec": 58.6,
      "text": "清潔、きれいにすることが好き。"
    },
    {
      "startSec": 62.4,
      "text": "で汚いものは良くないと思っています。"
    },
    {
      "startSec": 67.6,
      "text": "だから絶対毎日お風呂に入ります。"
    },
    {
      "startSec": 73.5,
      "text": "私はあまり入らない。"
    },
    {
      "startSec": 75.9,
      "text": "私は二日に一回ぐらいだけど"
    },
    {
      "startSec": 79.5,
      "text": "それを言うと「うわっお前汚い」って言われると思います。"
    },
    {
      "startSec": 87,
      "text": "多分みんな二日に一回ぐらいなんじゃないかな。"
    },
    {
      "startSec": 90.6,
      "text": "でも人の前では普通に"
    },
    {
      "startSec": 94.7,
      "text": "「毎日お風呂に入っています」と言うのがマナー。"
    },
    {
      "startSec": 99.3,
      "text": "そう言ってください。"
    },
    {
      "startSec": 101.8,
      "text": "毎日ちゃんと体を洗って、髪の毛も洗います。"
    },
    {
      "startSec": 107.3,
      "text": "だからかな、あんまり日本人は臭くないです。"
    },
    {
      "startSec": 112.5,
      "text": "男の人はすごい臭い人がいるけど"
    },
    {
      "startSec": 116.9,
      "text": "女の人は大体臭くない、におわないし"
    },
    {
      "startSec": 122.4,
      "text": "すごくにおいに気を付けています。"
    },
    {
      "startSec": 125.7,
      "text": "よくデオドラントスプレーしたりもするし。"
    },
    {
      "startSec": 132.8,
      "text": "であともう一つ、知ってほしいのが"
    },
    {
      "startSec": 136.3,
      "text": "日本人は強い香水、パフュームのにおいもダメなんです。"
    },
    {
      "startSec": 144.5,
      "text": "強い香水はすごく嫌いな人が多いです。"
    },
    {
      "startSec": 150.4,
      "text": "例えば電車の中ですごい強い香水の人がいたら、"
    },
    {
      "startSec": 156.9,
      "text": "「うーん、うん、臭い！」ってなります。"
    },
    {
      "startSec": 160.8,
      "text": "だから結構オーガニックのスプレー、パフュームみたいな"
    },
    {
      "startSec": 166.3,
      "text": "優しいにおいのスプレーが女の人には人気です。"
    },
    {
      "startSec": 173.9,
      "text": "私もそれは賛成です。"
    },
    {
      "startSec": 177.5,
      "text": "やっぱり優しいにおいがいいなと思います。"
    },
    {
      "startSec": 182.8,
      "text": "とか石鹸(soap)のにおいとかが好きな人が多いです。"
    },
    {
      "startSec": 190.9,
      "text": "で、ちょっと違う話だけど…"
    },
    {
      "startSec": 196.1,
      "text": "Did you hear that?"
    },
    {
      "startSec": 198,
      "text": "分かんない、鳥がヤバイ。"
    },
    {
      "startSec": 201.4,
      "text": "日本人は本当に汚いのが好きじゃない人が多い。"
    },
    {
      "startSec": 207,
      "text": "例えば、食べ物は絶対にお箸を使ったり"
    },
    {
      "startSec": 213.6,
      "text": "おにぎりとかは手で食べますけど。"
    },
    {
      "startSec": 216.8,
      "text": "この前ハンバーガー屋さんに行った時に"
    },
    {
      "startSec": 221,
      "text": "びっくりしたのが"
    },
    {
      "startSec": 222.6,
      "text": "すごく大きなハンバーガーで"
    },
    {
      "startSec": 225.8,
      "text": "たくさん中にお肉とか野菜が入っている"
    },
    {
      "startSec": 229.7,
      "text": "大きなハンバーガーで"
    },
    {
      "startSec": 231.3,
      "text": "それをお箸で食べている人がいました。"
    },
    {
      "startSec": 235.1,
      "text": "多分手を使ったら手が汚れる、"
    },
    {
      "startSec": 239.5,
      "text": "汚くなると思ったから"
    },
    {
      "startSec": 242.3,
      "text": "こうハンバーガーをお箸で"
    },
    {
      "startSec": 243.9,
      "text": "ちょっと「ハフハフハフ」みたいな食べてました。"
    },
    {
      "startSec": 249.9,
      "text": "日本人、これが日本人です。"
    },
    {
      "startSec": 254.1,
      "text": "何か皆さんの役に立ったらいいです。"
    },
    {
      "startSec": 259,
      "text": "じゃあ今日のエピソードはここまで。"
    },
    {
      "startSec": 261.7,
      "text": "いつも聞いてくれてありがとうね。"
    },
    {
      "startSec": 264.2,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
