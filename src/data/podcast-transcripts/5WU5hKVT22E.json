{
  "episodeId": "5WU5hKVT22E",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、元気ですか？"
    },
    {
      "startSec": 2.4,
      "text": "こんにちは、Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.9,
      "text": "日本人ってよく言葉を伸ばしますよね。"
    },
    {
      "startSec": 12.5,
      "text": "伸ばす、長く言うよね。"
    },
    {
      "startSec": 15.3,
      "text": "例えば「え！すごーーーい！」とか"
    },
    {
      "startSec": 20.9,
      "text": "「へーーー！」とか言いますよね。"
    },
    {
      "startSec": 27.9,
      "text": "今日はこの話を皆さんとしたいと思います。"
    },
    {
      "startSec": 33.3,
      "text": "私も日本人なので"
    },
    {
      "startSec": 36,
      "text": "自分があまり気が付かないうちに"
    },
    {
      "startSec": 40.3,
      "text": "結構ね、言葉を長く言う、"
    },
    {
      "startSec": 44.1,
      "text": "伸ばして長く言っていると思います。"
    },
    {
      "startSec": 48.6,
      "text": "「上手！」じゃなくて「上手ーー！」とか"
    },
    {
      "startSec": 55,
      "text": "「あ、そうなんだーー」とか"
    },
    {
      "startSec": 59.3,
      "text": "今のはちょっと結構長く言いましたけど"
    },
    {
      "startSec": 62.9,
      "text": "でも皆さん、これどう思いますか？"
    },
    {
      "startSec": 68,
      "text": "何かちょっとイライラしたり"
    },
    {
      "startSec": 70.5,
      "text": "「なんかそれちょっと…」みたいな"
    },
    {
      "startSec": 74.3,
      "text": "日本人がすごく長く言葉を言ったりするのを聞いて"
    },
    {
      "startSec": 79.9,
      "text": "ちょっとなんか「オー…」ってなること「オー、嫌」"
    },
    {
      "startSec": 85.3,
      "text": "「あああ…」みたいになることありませんか？"
    },
    {
      "startSec": 88.5,
      "text": "あんまりちょっと慣れないっていうか"
    },
    {
      "startSec": 91,
      "text": "慣れない(can't get used to it)"
    },
    {
      "startSec": 94.7,
      "text": "そういうことはありませんか？"
    },
    {
      "startSec": 98.4,
      "text": "実は私の周りはあまり言葉を長く伸ばす人は"
    },
    {
      "startSec": 105.5,
      "text": "そんなにいないんですね。"
    },
    {
      "startSec": 107.9,
      "text": "でもこの前、実は私が郵便局(post office)"
    },
    {
      "startSec": 115,
      "text": "郵便局に行った時に"
    },
    {
      "startSec": 117.9,
      "text": "そこにいた女の人のスタッフが"
    },
    {
      "startSec": 121.5,
      "text": "むっちゃくちゃ言葉を伸ばして話していて"
    },
    {
      "startSec": 126.5,
      "text": "一人だけじゃなくてもう"
    },
    {
      "startSec": 128.2,
      "text": "そこにいるおばさん達ですね、"
    },
    {
      "startSec": 131.5,
      "text": "みんなそういう話し方で"
    },
    {
      "startSec": 135.2,
      "text": "私はちょっとイライラしたんですね。"
    },
    {
      "startSec": 139.6,
      "text": "今日はちょっとその話を"
    },
    {
      "startSec": 141.3,
      "text": "皆さんとシェアしたいなと思います。"
    },
    {
      "startSec": 147.1,
      "text": "多分、会話を楽しみたい"
    },
    {
      "startSec": 152,
      "text": "四十歳から五十歳、六十歳くらいの女の人が"
    },
    {
      "startSec": 160.1,
      "text": "すごく言葉を伸ばす。"
    },
    {
      "startSec": 163.5,
      "text": "よく「語尾を伸ばす」と言います。"
    },
    {
      "startSec": 166.5,
      "text": "語尾は「言葉の最後」という意味です。"
    },
    {
      "startSec": 169.8,
      "text": "だから言葉の最後を伸ばして長く言う。"
    },
    {
      "startSec": 173.3,
      "text": "それは結構、年上の女の人に多いかなと思いました。"
    },
    {
      "startSec": 181.2,
      "text": "その人たち、郵便局のおばさんたちは"
    },
    {
      "startSec": 186.8,
      "text": "私は正直、本当にイライラしました。"
    },
    {
      "startSec": 191.2,
      "text": "なぜ郵便局(ゆうびんきょく)に行ったかと言うと"
    },
    {
      "startSec": 195.4,
      "text": "ジャックの家族に"
    },
    {
      "startSec": 197.4,
      "text": "プレゼントを送りたかったんですね。"
    },
    {
      "startSec": 200.5,
      "text": "箱、ボックスを送りたかったんだけど"
    },
    {
      "startSec": 203.7,
      "text": "なんかその人たちは"
    },
    {
      "startSec": 206.2,
      "text": "私にその箱を送ってほしくないみたいな態度"
    },
    {
      "startSec": 212.2,
      "text": "態度(behavior)で"
    },
    {
      "startSec": 214.2,
      "text": "その人たちは"
    },
    {
      "startSec": 215.8,
      "text": "「いやいやいや、日本からオーストラリアまで"
    },
    {
      "startSec": 219.5,
      "text": "船で何ヶ月もかかりますよ」"
    },
    {
      "startSec": 223.4,
      "text": "「船で送ったのにまだ着かない」"
    },
    {
      "startSec": 226.7,
      "text": "「まだプレゼントが着かない、届かない」って"
    },
    {
      "startSec": 230.4,
      "text": "あとで文句を言われても私たちは困ります、"
    },
    {
      "startSec": 237.6,
      "text": "だからちょっと、できたら送らないでみたいな"
    },
    {
      "startSec": 241.5,
      "text": "そういうことを言ったんですね。"
    },
    {
      "startSec": 245.6,
      "text": "語尾を伸ばして、そういうことを言ったんです。"
    },
    {
      "startSec": 249.5,
      "text": "ちょっと真似をするのが難しいんですけど、"
    },
    {
      "startSec": 254.2,
      "text": "「あーでもー、船便で何ヶ月もかかりますねー」"
    },
    {
      "startSec": 259.8,
      "text": "「うーーん。いや、ちょっと考えた方が"
    },
    {
      "startSec": 263.1,
      "text": "いいかもしれませんねーー、うーーん」"
    },
    {
      "startSec": 267.4,
      "text": "みたいな感じで話してました。"
    },
    {
      "startSec": 271,
      "text": "あともう一つ言われた事が"
    },
    {
      "startSec": 273.9,
      "text": "それが一日目で、私は箱を家に持って帰って"
    },
    {
      "startSec": 279,
      "text": "もう一度次の日に郵便局に行きました。"
    },
    {
      "startSec": 283.3,
      "text": "ジャックに時間がかかるよってこと言って。"
    },
    {
      "startSec": 287.5,
      "text": "そしたら二回目は、私、Amazonの箱を"
    },
    {
      "startSec": 293,
      "text": "プレゼントに使ったんですけど"
    },
    {
      "startSec": 295.5,
      "text": "二回目はそのおばさんたちが"
    },
    {
      "startSec": 297.9,
      "text": "「あのー、すいませーん。」"
    },
    {
      "startSec": 299.3,
      "text": "「あの箱は、何も柄がない箱、"
    },
    {
      "startSec": 304.2,
      "text": "シンプルな箱じゃないとー、"
    },
    {
      "startSec": 306.1,
      "text": "えー、私たちも送ることができなくてー」"
    },
    {
      "startSec": 310.6,
      "text": "「多分オーストラリアさんはとても厳しいのでー、"
    },
    {
      "startSec": 315.6,
      "text": "いや、その箱はちょっとできないですねー、うーん」"
    },
    {
      "startSec": 320.1,
      "text": "みたいな感じかな？"
    },
    {
      "startSec": 323,
      "text": "言われて、私はお店に"
    },
    {
      "startSec": 327.4,
      "text": "白い何も字が書いていない箱を買いに行きました。"
    },
    {
      "startSec": 332.8,
      "text": "柄がない箱、柄は、字とか模様(pattern)とか"
    },
    {
      "startSec": 338.9,
      "text": "デザインとかのことを柄と言います。"
    },
    {
      "startSec": 342.6,
      "text": "だから「柄がない」と言ったら"
    },
    {
      "startSec": 345.2,
      "text": "もう何もない真っ白とか茶色、"
    },
    {
      "startSec": 350.9,
      "text": "ダンボールだから、茶色とかシンプルなことです。"
    },
    {
      "startSec": 356.2,
      "text": "だから柄がある箱で"
    },
    {
      "startSec": 359.5,
      "text": "オーストラリアに箱は送れないって"
    },
    {
      "startSec": 364.8,
      "text": "言われたんですね、私。"
    },
    {
      "startSec": 368.6,
      "text": "ちょっとムカついて"
    },
    {
      "startSec": 369.8,
      "text": "何で最初の一日目に言わなかったの？"
    },
    {
      "startSec": 374.4,
      "text": "何で二日目にそれ言うの？と思って。"
    },
    {
      "startSec": 378.6,
      "text": "しかもごめんなさいとか、何も言わずに"
    },
    {
      "startSec": 381.8,
      "text": "語尾を長く伸ばして話すだけで"
    },
    {
      "startSec": 385.5,
      "text": "私が家に帰るのを待ってるみたいな"
    },
    {
      "startSec": 390.2,
      "text": "そういうおばさんたちで、"
    },
    {
      "startSec": 392.8,
      "text": "ちょっとムカつきましたね。"
    },
    {
      "startSec": 395.8,
      "text": "そういう人いますよね。"
    },
    {
      "startSec": 397.4,
      "text": "あんまりいないけど、"
    },
    {
      "startSec": 399.2,
      "text": "最初から私が文句を言うと思って、"
    },
    {
      "startSec": 402.7,
      "text": "そのおばさんたちは、私と話をしているんですよね。"
    },
    {
      "startSec": 407.7,
      "text": "だからなんか私は本当に悪い人"
    },
    {
      "startSec": 411.9,
      "text": "悪い人みたいな自分が、"
    },
    {
      "startSec": 414.2,
      "text": "そういう気がして怒って家に帰りました、"
    },
    {
      "startSec": 417.8,
      "text": "という話です。"
    },
    {
      "startSec": 419.5,
      "text": "皆さんは日本人が語尾を伸ばす、"
    },
    {
      "startSec": 424.4,
      "text": "どう思いますか？"
    },
    {
      "startSec": 427.6,
      "text": "なんか気持ち悪いかな？"
    },
    {
      "startSec": 430.9,
      "text": "普通に優しく語尾を伸ばすのは、私は好きです。"
    },
    {
      "startSec": 436.6,
      "text": "お母さんが子どもに話すみたいにね。"
    },
    {
      "startSec": 440.1,
      "text": "でも語尾を伸ばして"
    },
    {
      "startSec": 443.3,
      "text": "その語尾の中に何か隠れた(hidden)"
    },
    {
      "startSec": 447.6,
      "text": "隠れた意味(meaning)がある"
    },
    {
      "startSec": 449.5,
      "text": "その郵便局のおばさんたちみたいに、"
    },
    {
      "startSec": 453.3,
      "text": "「できないんですよねーーー、うーーん」"
    },
    {
      "startSec": 457.6,
      "text": "まあこれはつまり、できないから"
    },
    {
      "startSec": 461,
      "text": "もうあなたは帰ってください"
    },
    {
      "startSec": 463.4,
      "text": "私たちにできることありません"
    },
    {
      "startSec": 465.2,
      "text": "なんかそういう意味が"
    },
    {
      "startSec": 467.3,
      "text": "この長い「できないんですよねーーー、うーーん」"
    },
    {
      "startSec": 472.5,
      "text": "ここになんか隠れてる感じがしました、私は。"
    },
    {
      "startSec": 479.5,
      "text": "ということで、今日はここで終わりにします。"
    },
    {
      "startSec": 483.4,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 488.3,
      "text": "最後ちょっと本当に思い出したら"
    },
    {
      "startSec": 491.3,
      "text": "また怒ってきたので、腹が立ってきた"
    },
    {
      "startSec": 496,
      "text": "腹が立つ(to get angry)"
    },
    {
      "startSec": 498.7,
      "text": "腹が立ってきたので"
    },
    {
      "startSec": 501.3,
      "text": "腹が立つ(stomach stands up)"
    },
    {
      "startSec": 505.2,
      "text": "腹が立つという日本語ね。"
    },
    {
      "startSec": 508.3,
      "text": "また腹が立ってきたので"
    },
    {
      "startSec": 511.1,
      "text": "ちょっと早く話しちゃったんですが"
    },
    {
      "startSec": 520.1,
      "text": "じゃあ皆さん仕事・勉強頑張ってください。"
    },
    {
      "startSec": 523.8,
      "text": "いつも聞いてくれてありがとう。"
    },
    {
      "startSec": 526.2,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
