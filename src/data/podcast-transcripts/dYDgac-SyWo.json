{
  "episodeId": "dYDgac-SyWo",
  "segments": [
    {
      "startSec": 0.9,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.4,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.1,
      "text": "元気ですか？"
    },
    {
      "startSec": 6.9,
      "text": "皆さんは「ピッチアクセント」"
    },
    {
      "startSec": 9.4,
      "text": "勉強したことはありますか？"
    },
    {
      "startSec": 12.7,
      "text": "日本のアクセント。"
    },
    {
      "startSec": 14.4,
      "text": "例えば「はし」だったら「はし↗」と「はし↘」で"
    },
    {
      "startSec": 21,
      "text": "その意味が変わるんですよね。"
    },
    {
      "startSec": 24.6,
      "text": "今私どっちがどっちか忘れましたけど、すいません。"
    },
    {
      "startSec": 28.5,
      "text": "Bridgeの「橋」とchopsticksの「はし」で"
    },
    {
      "startSec": 32.4,
      "text": "確かアクセントの場所で"
    },
    {
      "startSec": 35.5,
      "text": "「はし」の意味が変わります。"
    },
    {
      "startSec": 40.2,
      "text": "皆さんは勉強したことありますか？"
    },
    {
      "startSec": 43,
      "text": "確かYouTubeでちょっと前に"
    },
    {
      "startSec": 46.5,
      "text": "「ピッチアクセント」は"
    },
    {
      "startSec": 48.1,
      "text": "勉強した方がいいのか？"
    },
    {
      "startSec": 51.7,
      "text": "または勉強しなくてもいいのか？と"
    },
    {
      "startSec": 57.1,
      "text": "みんなが、確か「(Learn) Japanese From Zero」とか"
    },
    {
      "startSec": 60.1,
      "text": "Dogenさんとかが、確か議論"
    },
    {
      "startSec": 62.9,
      "text": "議論する(to debate)"
    },
    {
      "startSec": 65.8,
      "text": "議論していたことがあったと思います。"
    },
    {
      "startSec": 69.6,
      "text": "すごく面白いと思うので"
    },
    {
      "startSec": 71.3,
      "text": "今日はそれについて話してみたいと思います。"
    },
    {
      "startSec": 75.9,
      "text": "皆さんはどうですか？"
    },
    {
      "startSec": 77.7,
      "text": "勉強したことありますか？"
    },
    {
      "startSec": 80.4,
      "text": "私は私の意見として、別に勉強はしなくてもいい。"
    },
    {
      "startSec": 87,
      "text": "楽しかったら勉強したらいいと思います。"
    },
    {
      "startSec": 92.5,
      "text": "普通に、例えば"
    },
    {
      "startSec": 94.3,
      "text": "このポッドキャストを聞くみたいに"
    },
    {
      "startSec": 97,
      "text": "日本語のリスニングをしたら"
    },
    {
      "startSec": 100.7,
      "text": "普通に日本語の音を真似したら、コピーしたら"
    },
    {
      "startSec": 106.2,
      "text": "私は普通に自然に"
    },
    {
      "startSec": 109.8,
      "text": "ピッチアクセントも勉強できると思います。"
    },
    {
      "startSec": 113.6,
      "text": "ピッチアクセントの本とか辞書とか買わなくても"
    },
    {
      "startSec": 118.2,
      "text": "私は普通にリスニングさえすれば"
    },
    {
      "startSec": 123.1,
      "text": "全然ピッチアクセントは"
    },
    {
      "startSec": 126.9,
      "text": "自然と学べると思います。"
    },
    {
      "startSec": 131.5,
      "text": "面白かったのが"
    },
    {
      "startSec": 133.8,
      "text": "ちょっと私の妹に「ピッチアクセントどう思う？」"
    },
    {
      "startSec": 138.3,
      "text": "「勉強した方がいいかな？」って聞いてみました。"
    },
    {
      "startSec": 141.8,
      "text": "妹は日本人なんですけど"
    },
    {
      "startSec": 144.5,
      "text": "ちょっと妹に聞いてみました。"
    },
    {
      "startSec": 147.3,
      "text": "すると妹は、全然日本語の知識とかはないけど"
    },
    {
      "startSec": 153.3,
      "text": "妹の答えが面白くて"
    },
    {
      "startSec": 156.2,
      "text": "妹は、ピッチアクセントの辞書とかは"
    },
    {
      "startSec": 159.6,
      "text": "今はYouTubeとかCDとか"
    },
    {
      "startSec": 162.9,
      "text": "皆さんが日本語を勉強したかったら"
    },
    {
      "startSec": 166.1,
      "text": "日本語の音声オーディオに"
    },
    {
      "startSec": 169.3,
      "text": "普通にアクセスできますよね？"
    },
    {
      "startSec": 171.8,
      "text": "どこにでも日本語のオーディオはあります。"
    },
    {
      "startSec": 175.2,
      "text": "でも例えば50年前とか"
    },
    {
      "startSec": 178.5,
      "text": "日本語の音声にアクセスするのが難しかった時"
    },
    {
      "startSec": 184.1,
      "text": "そういう時は確かに、ピッチアクセントの辞書は"
    },
    {
      "startSec": 189.1,
      "text": "効果があったんじゃないかな"
    },
    {
      "startSec": 191.7,
      "text": "と思いますって妹は言っていました。"
    },
    {
      "startSec": 196.3,
      "text": "それは面白いなと思いました。"
    },
    {
      "startSec": 198.8,
      "text": "で、ピッチアクセントを勉強しなくてもいい理由として"
    },
    {
      "startSec": 204.1,
      "text": "ピッチアクセントは方言(dialect)によって"
    },
    {
      "startSec": 209.3,
      "text": "場所によってちょっとずつ違います。"
    },
    {
      "startSec": 213.2,
      "text": "例えば東京弁、普通の標準語(standard Japanese)では"
    },
    {
      "startSec": 220.3,
      "text": "例えば「大阪(おおさか)」はおおさか(＿ ￣ ￣ ￣)"
    },
    {
      "startSec": 224.9,
      "text": "のアクセントになります。"
    },
    {
      "startSec": 226.9,
      "text": "おおさか(＿ ￣ ￣ ￣)"
    },
    {
      "startSec": 228.9,
      "text": "ビデオ見てる人は今私の手を見ると"
    },
    {
      "startSec": 231.6,
      "text": "分かりやすいんですけど"
    },
    {
      "startSec": 233.2,
      "text": "おおさか(＿ ￣ ￣ ￣)です。"
    },
    {
      "startSec": 235.6,
      "text": "でも私が生まれた関西、"
    },
    {
      "startSec": 239.1,
      "text": "大阪弁がある関西では"
    },
    {
      "startSec": 242.2,
      "text": "おおさか(＿ ￣ ￣ ￣)を、おおさか(￣ ￣ ￣ ￣)"
    },
    {
      "startSec": 246,
      "text": "フラットに言います、おおさか(￣ ￣ ￣ ￣)。"
    },
    {
      "startSec": 250.4,
      "text": "全然違います。"
    },
    {
      "startSec": 252.6,
      "text": "大阪(＿ ￣ ￣ ￣)と、大阪(￣ ￣ ￣ ￣)"
    },
    {
      "startSec": 256.2,
      "text": "これは東京と大阪で、"
    },
    {
      "startSec": 258.8,
      "text": "ピッチアクセントが違うという例(example)です。"
    },
    {
      "startSec": 264.8,
      "text": "で、私もちょっとピッチアクセントの"
    },
    {
      "startSec": 267.5,
      "text": "色々調べてみたんですが"
    },
    {
      "startSec": 270.3,
      "text": "ピッチアクセント、"
    },
    {
      "startSec": 271.4,
      "text": "日本のこのアクセントにも地域、場所によって"
    },
    {
      "startSec": 277,
      "text": "ちょっとルールが違うみたいです。"
    },
    {
      "startSec": 280.5,
      "text": "東京のアクセントには、こういうルールがあって"
    },
    {
      "startSec": 285.1,
      "text": "大阪のアクセントにはこういうルールがあって"
    },
    {
      "startSec": 288.9,
      "text": "鹿児島のアクセントには"
    },
    {
      "startSec": 291,
      "text": "こういうルールがあって、みたいに"
    },
    {
      "startSec": 293.6,
      "text": "不思議ですが、ちょっとルールがあるみたいです。"
    },
    {
      "startSec": 298.5,
      "text": "面白いなと思いました。"
    },
    {
      "startSec": 301.6,
      "text": "どう思いますか、皆さん？"
    },
    {
      "startSec": 304.3,
      "text": "私は京都出身ですけど確かに、"
    },
    {
      "startSec": 308.2,
      "text": "鹿児島の人とかのアクセント、方言を聞いたら"
    },
    {
      "startSec": 312,
      "text": "「あ、なんか違うなぁ」と思うことがあります。"
    },
    {
      "startSec": 316.4,
      "text": "きっとそれは"
    },
    {
      "startSec": 317.7,
      "text": "例えば「～や」の代わりに"
    },
    {
      "startSec": 320.9,
      "text": "「～じゃ」を使ったりとかそういう違いだけじゃなくて"
    },
    {
      "startSec": 324.1,
      "text": "きっとそのアクセントの…、言葉のその…なんだろう"
    },
    {
      "startSec": 327.5,
      "text": "イントネーションみたいな違いも"
    },
    {
      "startSec": 329.4,
      "text": "必ずあると思います。"
    },
    {
      "startSec": 332,
      "text": "面白いなと思ったので、今日はしゃべってみました。"
    },
    {
      "startSec": 336.8,
      "text": "いつも本当にポッドキャストありがとうございます。"
    },
    {
      "startSec": 340.1,
      "text": "Patreonではトランスクリプトを"
    },
    {
      "startSec": 343.3,
      "text": "皆さんとシェアしています。"
    },
    {
      "startSec": 345.7,
      "text": "トランスクリプトには漢字にふりがなもあるので"
    },
    {
      "startSec": 350.9,
      "text": "漢字の読み方の勉強もできます。"
    },
    {
      "startSec": 354.7,
      "text": "私のbehind sceneとか色々、"
    },
    {
      "startSec": 358.1,
      "text": "このポッドキャストのみんなと"
    },
    {
      "startSec": 360,
      "text": "ここではシェアしてないコンテンツを"
    },
    {
      "startSec": 362.8,
      "text": "Patreonではしてるので"
    },
    {
      "startSec": 365,
      "text": "興味があったら是非リンクから"
    },
    {
      "startSec": 367.2,
      "text": "参加してサポートしてくれたら本当に嬉しいです。"
    },
    {
      "startSec": 371.2,
      "text": "もう既にPatreonでサポートしてくれてる人"
    },
    {
      "startSec": 374.4,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 377,
      "text": "皆さんのおかげで"
    },
    {
      "startSec": 378.5,
      "text": "これからも続けていきたいと思います。"
    },
    {
      "startSec": 383,
      "text": "じゃあ、いつもありがとう。"
    },
    {
      "startSec": 384.7,
      "text": "お仕事、勉強頑張ってください。"
    },
    {
      "startSec": 387.3,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
