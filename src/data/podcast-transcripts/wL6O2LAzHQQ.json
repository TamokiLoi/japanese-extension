{
  "episodeId": "wL6O2LAzHQQ",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.4,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.7,
      "text": "今日は「人生百年生きたら」というテーマで"
    },
    {
      "startSec": 9.8,
      "text": "話したいと思います。"
    },
    {
      "startSec": 11.6,
      "text": "人生百年生きる時のマインドセットですね。"
    },
    {
      "startSec": 17,
      "text": "なんでこういう話をするかというと、"
    },
    {
      "startSec": 22,
      "text": "私もよく悩むことがあります。"
    },
    {
      "startSec": 26.1,
      "text": "今、もっと頑張らないとダメじゃないかとか"
    },
    {
      "startSec": 31.9,
      "text": "よく焦ってしまうんですね。"
    },
    {
      "startSec": 34.8,
      "text": "「本当に私がやりたいことって何だろう」とか"
    },
    {
      "startSec": 39.3,
      "text": "「どんな仕事をしたら人を幸せにできるのか」とか"
    },
    {
      "startSec": 45.1,
      "text": "本当によく悩むことがあるんですね。"
    },
    {
      "startSec": 49.7,
      "text": "でもこの悩みを「そんなに急がなくてもいいよ」"
    },
    {
      "startSec": 55.6,
      "text": "みたいに教えてくれる素敵な言葉が二つありました。"
    },
    {
      "startSec": 62.7,
      "text": "今日はそれを皆さんに紹介したいと思います。"
    },
    {
      "startSec": 68.8,
      "text": "一つの言葉は、言葉と言うかマインドセットは、"
    },
    {
      "startSec": 73.6,
      "text": "人生を春・夏・秋・冬と考えることです。"
    },
    {
      "startSec": 81.7,
      "text": "これは私の大好きな友達が言っていました。"
    },
    {
      "startSec": 86.2,
      "text": "実は先週彼女の誕生日だったんですね。"
    },
    {
      "startSec": 92.6,
      "text": "で、彼女は二十五歳になりました。"
    },
    {
      "startSec": 97.5,
      "text": "その時に私が「二十五歳の誕生日どんな気分？」"
    },
    {
      "startSec": 104,
      "text": "って聞いたんです。"
    },
    {
      "startSec": 106.2,
      "text": "そしたら彼女は「やっと夏になったって感じ」"
    },
    {
      "startSec": 112.6,
      "text": "と言っていました。"
    },
    {
      "startSec": 115.2,
      "text": "「夏ってどういう意味？」って私は聞きました。"
    },
    {
      "startSec": 120.1,
      "text": "すると彼女は「もしね、人生百年生きるなら"
    },
    {
      "startSec": 126.2,
      "text": "ゼロ歳から二十四歳までは春、"
    },
    {
      "startSec": 131,
      "text": "二十五歳から五十歳までは夏、"
    },
    {
      "startSec": 135.9,
      "text": "五十歳から七十五歳までは秋、"
    },
    {
      "startSec": 139.7,
      "text": "そして七十五歳から百歳までは冬なんだ」って"
    },
    {
      "startSec": 144.9,
      "text": "言っていました。"
    },
    {
      "startSec": 146.2,
      "text": "私はこれすっごく素敵な言葉だと思ったんです。"
    },
    {
      "startSec": 152.9,
      "text": "二十五歳までは春。"
    },
    {
      "startSec": 155.3,
      "text": "春はもうやっと地面から草の芽が出て"
    },
    {
      "startSec": 160.7,
      "text": "太陽の光を浴びて少しずつゆっくり成長、"
    },
    {
      "startSec": 165.7,
      "text": "育つ時ですよね。"
    },
    {
      "startSec": 167.9,
      "text": "花が咲くし、まだまだ柔らかいピュアな感じかな。"
    },
    {
      "startSec": 174.5,
      "text": "で、やっと二十五歳から夏になって"
    },
    {
      "startSec": 179,
      "text": "この夏には本当にたくさん成長しますよね。"
    },
    {
      "startSec": 184.1,
      "text": "緑がぐんぐん広がって、もう緑になって"
    },
    {
      "startSec": 187.7,
      "text": "草や木も大きく成長します。"
    },
    {
      "startSec": 191.5,
      "text": "で、秋に向けて、秋のために準備をするんですね。"
    },
    {
      "startSec": 197.1,
      "text": "おいしい果物とか野菜とかお米とか"
    },
    {
      "startSec": 201.6,
      "text": "秋に向けてたくさんそういう準備をしていきます。"
    },
    {
      "startSec": 207.4,
      "text": "そう考えると、私は早くその夏をスキップして"
    },
    {
      "startSec": 214.8,
      "text": "秋に行きたいという気持ちが"
    },
    {
      "startSec": 218.2,
      "text": "自分の中にある感じがしました。"
    },
    {
      "startSec": 223.4,
      "text": "でもそれってやっぱりできないですよね。"
    },
    {
      "startSec": 226.2,
      "text": "ちゃんとステップがあります。"
    },
    {
      "startSec": 229.2,
      "text": "夏をスキップしたりできないし、"
    },
    {
      "startSec": 232.3,
      "text": "春も夏も秋も冬も、全部大切な季節。"
    },
    {
      "startSec": 237.3,
      "text": "だからその季節で自分にできることを"
    },
    {
      "startSec": 241,
      "text": "一生懸命やることが大切だと思ったんです。"
    },
    {
      "startSec": 246.1,
      "text": "本当にこれは素敵なアドバイスで、"
    },
    {
      "startSec": 249.9,
      "text": "そんなに焦らなくてもいいよって"
    },
    {
      "startSec": 253.2,
      "text": "言ってくれている感じがしました。"
    },
    {
      "startSec": 257,
      "text": "次のエピソードでは、このマインドセット、言葉と"
    },
    {
      "startSec": 262.5,
      "text": "とてもよく似た「孔子」という"
    },
    {
      "startSec": 266.1,
      "text": "中国の昔の偉い人の言葉、"
    },
    {
      "startSec": 270.8,
      "text": "「吾十有五にして学問に志す」という論語、長い言葉"
    },
    {
      "startSec": 277.6,
      "text": "これをちょっと皆さんに紹介したいと思います。"
    },
    {
      "startSec": 282.8,
      "text": "私も本当に、結構落ち着いているって"
    },
    {
      "startSec": 287.9,
      "text": "他の日本語の先生からも言ってもらえるんですが、"
    },
    {
      "startSec": 294.1,
      "text": "そんなことはなくて。"
    },
    {
      "startSec": 296.3,
      "text": "もちろんこのポッドキャストでは"
    },
    {
      "startSec": 299.4,
      "text": "できるだけゆっくり話しているし、"
    },
    {
      "startSec": 303.5,
      "text": "一人だからあまりこの動画を撮っている時に"
    },
    {
      "startSec": 307.6,
      "text": "ミスもしないですよね。"
    },
    {
      "startSec": 310.3,
      "text": "お茶こぼしたり、コケたりしないですが"
    },
    {
      "startSec": 314,
      "text": "普段は本当にミスをたくさんするし"
    },
    {
      "startSec": 317.8,
      "text": "気分も上がったり下がったりで"
    },
    {
      "startSec": 320.1,
      "text": "本当にぐちゃぐちゃ、めちゃめちゃなんですが…"
    },
    {
      "startSec": 324.3,
      "text": "素敵な言葉を皆さんとシェアしたかったので"
    },
    {
      "startSec": 328.8,
      "text": "このエピソード作りました。"
    },
    {
      "startSec": 333,
      "text": "最近はPatreonのメンバーシップで"
    },
    {
      "startSec": 336.3,
      "text": "一週間に一回、メンバーの人のためだけに"
    },
    {
      "startSec": 341.3,
      "text": "三十分くらいの長いエピソードも作っています。"
    },
    {
      "startSec": 346.6,
      "text": "で、そのエピソードではもっと私らしい話とか、"
    },
    {
      "startSec": 352.7,
      "text": "私の日常生活の話とか、色々しているので"
    },
    {
      "startSec": 358.7,
      "text": "良かったらメンバーになって"
    },
    {
      "startSec": 360.9,
      "text": "聞いてくれると嬉しいです。"
    },
    {
      "startSec": 364.2,
      "text": "じゃあ今日はここまで。ありがとう！"
    },
    {
      "startSec": 366.1,
      "text": "じゃあまた明日も聞いてください。"
    },
    {
      "startSec": 368.6,
      "text": "またね、バイバイ！"
    }
  ]
}
