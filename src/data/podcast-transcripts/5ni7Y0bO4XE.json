{
  "episodeId": "5ni7Y0bO4XE",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日は「～がち」の文法を皆さんに教えます。"
    },
    {
      "startSec": 11.3,
      "text": "例えば「目が疲れがち」「お腹が空きがち」"
    },
    {
      "startSec": 20.1,
      "text": "「色々忘れがち」みたいなです。"
    },
    {
      "startSec": 23.8,
      "text": "この「～がち」これはよく使います、日常会話で。"
    },
    {
      "startSec": 30.2,
      "text": "なので是非このポッドキャストで"
    },
    {
      "startSec": 33.2,
      "text": "「～がち」の使い方覚えて帰ってください。"
    },
    {
      "startSec": 37.8,
      "text": "この「がち」の意味は「～しやすい」"
    },
    {
      "startSec": 43,
      "text": "「～になりやすい」という意味です。"
    },
    {
      "startSec": 48.3,
      "text": "だから「目が疲れがち」"
    },
    {
      "startSec": 52.1,
      "text": "この意味は「目が疲れやすい」という意味。"
    },
    {
      "startSec": 57.8,
      "text": "だから例えば…"
    },
    {
      "startSec": 61.1,
      "text": "「はぁ～最近たくさんパソコンで勉強して"
    },
    {
      "startSec": 66.3,
      "text": "目が疲れがちなんだよね」みたいに使います。"
    },
    {
      "startSec": 72.1,
      "text": "とかあとは「はぁ～最近太ってきたなぁ。"
    },
    {
      "startSec": 77.9,
      "text": "まあでも、外食に頼りがちだからしょうがないな」"
    },
    {
      "startSec": 84.2,
      "text": "みたいなね。"
    },
    {
      "startSec": 85.6,
      "text": "「外食に頼りがち」"
    },
    {
      "startSec": 88.3,
      "text": "外食は家の外で食べることです。"
    },
    {
      "startSec": 94,
      "text": "頼る(to count on something)"
    },
    {
      "startSec": 98.1,
      "text": "だから、たくさん外食に頼って、家で作らないで"
    },
    {
      "startSec": 103.9,
      "text": "外で食べていたから太ったという意味です。"
    },
    {
      "startSec": 111.4,
      "text": "他の例文「はぁ～最近年取ったな。"
    },
    {
      "startSec": 116.9,
      "text": "色々忘れがちになった気がする」"
    },
    {
      "startSec": 122,
      "text": "「年を取る」これは年配になる、お年寄りになる"
    },
    {
      "startSec": 127,
      "text": "年が多くなる、難しいな…"
    },
    {
      "startSec": 129.9,
      "text": "なんかとちょっと…年齢は結構日本では"
    },
    {
      "startSec": 134,
      "text": "センシティブなトピックなんですよね。"
    },
    {
      "startSec": 137.1,
      "text": "だからちゃんとそれを説明できる言葉がない。"
    },
    {
      "startSec": 143,
      "text": "この前コメントでお年寄りの人のことを"
    },
    {
      "startSec": 147.2,
      "text": "「老人」と言っている人がいました。"
    },
    {
      "startSec": 151,
      "text": "でも「老人」はあまり日常会話で使わないです。"
    },
    {
      "startSec": 156.5,
      "text": "老人ホームとか老人ケアセンターみたいに"
    },
    {
      "startSec": 161.9,
      "text": "市役所とかそういう、すごくフォーマルな"
    },
    {
      "startSec": 166.2,
      "text": "政治の中で使うことはあります。"
    },
    {
      "startSec": 170.3,
      "text": "でもお年寄りの人を"
    },
    {
      "startSec": 172.7,
      "text": "「老人」と言うことはほとんどない。"
    },
    {
      "startSec": 176.2,
      "text": "普通は「お年寄りの人」とか「年配の人」と言います。"
    },
    {
      "startSec": 184,
      "text": "なので「最近年を取ったから色々忘れがちだな」"
    },
    {
      "startSec": 190.6,
      "text": "「よく色々忘れるようになったなぁ」という意味です。"
    },
    {
      "startSec": 197.7,
      "text": "他には「はぁ～最近仕事で色々ミスしがちだな」"
    },
    {
      "startSec": 205.8,
      "text": "これも多分よく使います。"
    },
    {
      "startSec": 209,
      "text": "「ミスしがち」＝「よくミスをするようになった」"
    },
    {
      "startSec": 214.7,
      "text": "このミスは英語のミステイクから来ました。"
    },
    {
      "startSec": 219.4,
      "text": "なので「よく間違えるようになったな」"
    },
    {
      "startSec": 223,
      "text": "「間違えがちだな」という意味です。"
    },
    {
      "startSec": 228.6,
      "text": "皆さんに注意してほしいのは"
    },
    {
      "startSec": 232.5,
      "text": "「早い者勝ち」と言うフレーズがありますが"
    },
    {
      "startSec": 237.8,
      "text": "この早い者勝ちの「勝ち」は"
    },
    {
      "startSec": 240.7,
      "text": "この「～しやすくなる」の意味じゃないです。"
    },
    {
      "startSec": 246.1,
      "text": "早い者勝ちの「勝ち」は勝つ(to win)の意味なので"
    },
    {
      "startSec": 254.4,
      "text": "「早い者勝ち」＝早い人が勝つという意味。"
    },
    {
      "startSec": 260.3,
      "text": "例えば「あ、あのパン屋さんはすごく有名だから"
    },
    {
      "startSec": 266.4,
      "text": "いつも早い者勝ちだよね」"
    },
    {
      "startSec": 269.8,
      "text": "「早い人がパンをゲットできるよね」みたいな。"
    },
    {
      "startSec": 274.2,
      "text": "こんな感じかな。"
    },
    {
      "startSec": 276.4,
      "text": "あとは「人生楽しんだ者勝ち」"
    },
    {
      "startSec": 286.3,
      "text": "だから人生を楽しんだ人が勝つ。"
    },
    {
      "startSec": 291.1,
      "text": "これも「～がち」の「がち」じゃないです。"
    },
    {
      "startSec": 296.5,
      "text": "人生は楽しんだらいいよっていう意味の"
    },
    {
      "startSec": 301,
      "text": "フレーズ・言葉です。"
    },
    {
      "startSec": 306.5,
      "text": "今日は「～がち」の意味、勉強しました。"
    },
    {
      "startSec": 311.7,
      "text": "もし例文が考えることができたら"
    },
    {
      "startSec": 315.9,
      "text": "YouTubeのコメントに書いて"
    },
    {
      "startSec": 318.5,
      "text": "「～がち」の使い方、練習してみてください。"
    },
    {
      "startSec": 325.1,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 327.4,
      "text": "パトレオンでこのポッドキャストの"
    },
    {
      "startSec": 331,
      "text": "エピソードのトランスクリプトを"
    },
    {
      "startSec": 334.9,
      "text": "皆さんのために作っています。"
    },
    {
      "startSec": 338.1,
      "text": "よかったらメンバーになって"
    },
    {
      "startSec": 341.3,
      "text": "サポートしてくれると嬉しいです。"
    },
    {
      "startSec": 345.2,
      "text": "よろしくお願いします。"
    },
    {
      "startSec": 347.2,
      "text": "じゃあいつも聞いてくれて本当にありがとう。"
    },
    {
      "startSec": 350.6,
      "text": "また明日も新しいエピソード出すので"
    },
    {
      "startSec": 354.9,
      "text": "是非聞いてください。"
    },
    {
      "startSec": 357.2,
      "text": "じゃ良い一日を！バイバイ！"
    }
  ]
}
