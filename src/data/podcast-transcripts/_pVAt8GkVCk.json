{
  "episodeId": "_pVAt8GkVCk",
  "segments": [
    {
      "startSec": 0.3,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.3,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日は私が最近気が付いたこと、"
    },
    {
      "startSec": 10.3,
      "text": "最近わかったことについて話します。"
    },
    {
      "startSec": 14.5,
      "text": "お仕事とか人生、生活に関係することです。"
    },
    {
      "startSec": 24.8,
      "text": "それは、経験って大切だなということです。"
    },
    {
      "startSec": 33.7,
      "text": "変な感じなんですけど、ゼロから話しますね。"
    },
    {
      "startSec": 37.9,
      "text": "私が会社で働きたくない、"
    },
    {
      "startSec": 41.8,
      "text": "自分でビジネス、仕事を作りたいと思ったのは二年前です。"
    },
    {
      "startSec": 49,
      "text": "その時はたくさんビジネスの本とか読んでいて"
    },
    {
      "startSec": 54.4,
      "text": "やっぱりそういうビジネスの本って"
    },
    {
      "startSec": 57.7,
      "text": "お金にフォーカスしていますよね。"
    },
    {
      "startSec": 62.7,
      "text": "だから一千万円稼ぐ方法とか"
    },
    {
      "startSec": 68.1,
      "text": "いつもその、何だろう…"
    },
    {
      "startSec": 71.3,
      "text": "たくさんのお金を稼ぐ方法、作る方法みたいな"
    },
    {
      "startSec": 76.8,
      "text": "そういう事を書いている本が、もちろん多かったんですね。"
    },
    {
      "startSec": 84,
      "text": "だから私は素直にそれを信じて"
    },
    {
      "startSec": 89.6,
      "text": "一千万円、稼がないといけない、"
    },
    {
      "startSec": 92.9,
      "text": "じゃそのためにはどうしたらいいのか？みたいに"
    },
    {
      "startSec": 95.8,
      "text": "本当にその本を信じていたんですね。"
    },
    {
      "startSec": 100.9,
      "text": "でも実際にこうやって"
    },
    {
      "startSec": 103.8,
      "text": "ソーシャルメディアで日本語を教えてみると"
    },
    {
      "startSec": 108.1,
      "text": "お金より経験の方が絶対大事だなって"
    },
    {
      "startSec": 113.9,
      "text": "思うようになりました。"
    },
    {
      "startSec": 116.3,
      "text": "むしろ経験がしっかりあって、実力"
    },
    {
      "startSec": 120.3,
      "text": "本当に力があって、スキルがあって、"
    },
    {
      "startSec": 124.3,
      "text": "その人が特別、そんな存在になったら"
    },
    {
      "startSec": 128.8,
      "text": "多分お金は後からちゃんとゲットできます。"
    },
    {
      "startSec": 135,
      "text": "後からお金はついてくると思うんですね。"
    },
    {
      "startSec": 139.4,
      "text": "それは本当にこの一年くらいで実感しました。"
    },
    {
      "startSec": 144.7,
      "text": "本当に感じました。"
    },
    {
      "startSec": 146.7,
      "text": "特に私の場合は経験がない、"
    },
    {
      "startSec": 151.4,
      "text": "つまり、自分が知らない事に自信って持てないですよね。"
    },
    {
      "startSec": 157.2,
      "text": "だから、日本語を教えた経験がないのに"
    },
    {
      "startSec": 162.8,
      "text": "日本語を教えてお金を稼ぐなんて無理ですよね。"
    },
    {
      "startSec": 168.2,
      "text": "当たり前だけど。"
    },
    {
      "startSec": 169.4,
      "text": "そこにちゃんと気が付きました。"
    },
    {
      "startSec": 172.5,
      "text": "もちろん、すごいビジネスのマインドセットがある人は"
    },
    {
      "startSec": 178.7,
      "text": "日本語を教えた経験はなくても"
    },
    {
      "startSec": 182.1,
      "text": "日本語の先生を雇って(to hire someone)"
    },
    {
      "startSec": 187.8,
      "text": "雇って、で自分はその仕組み、システムだけを作って"
    },
    {
      "startSec": 193.8,
      "text": "そこからお金をゲットする、稼ぐみたいな"
    },
    {
      "startSec": 198.5,
      "text": "そういう方法をしている人もいるんですけど、"
    },
    {
      "startSec": 202.7,
      "text": "私はすごく「んー、えー、それっていいの？」みたいな。"
    },
    {
      "startSec": 208.3,
      "text": "「私教え方知らないけど、そんな私が"
    },
    {
      "startSec": 213.1,
      "text": "日本語の先生を雇って、え、そんなんで本当にいいの？」"
    },
    {
      "startSec": 218.5,
      "text": "みたいな、そんな感じになってしまうんですね。"
    },
    {
      "startSec": 222.1,
      "text": "だから私、本当に自分に自信がなくて"
    },
    {
      "startSec": 226.9,
      "text": "ポッドキャストはまだいいんですけど"
    },
    {
      "startSec": 230.7,
      "text": "メインのYouTubeで日本語を教える時とか"
    },
    {
      "startSec": 234.8,
      "text": "Instagramとか"
    },
    {
      "startSec": 236.7,
      "text": "やっぱり自分が勉強しながら"
    },
    {
      "startSec": 241.5,
      "text": "ビデオを作ったりするので、"
    },
    {
      "startSec": 243.9,
      "text": "自分のコンテンツにあまり自信がないんですよね。"
    },
    {
      "startSec": 248.9,
      "text": "自分も勉強しながらやってるので。"
    },
    {
      "startSec": 252.6,
      "text": "だから結構それがしんどくなって、"
    },
    {
      "startSec": 257.9,
      "text": "最近すごくしんどかったんですね。"
    },
    {
      "startSec": 260.6,
      "text": "自分に自信がないから。"
    },
    {
      "startSec": 263.6,
      "text": "でも最近はちゃんと、"
    },
    {
      "startSec": 266.1,
      "text": "「いや、自分に自信がないのは経験がないから」"
    },
    {
      "startSec": 271.4,
      "text": "「だから自分に自信がないのは当たり前」"
    },
    {
      "startSec": 276.2,
      "text": "「すごくナチュラルなことだから大丈夫」"
    },
    {
      "startSec": 279.7,
      "text": "「だからこれから経験を頑張ってゲット、"
    },
    {
      "startSec": 284.1,
      "text": "作っていけたらそれで大丈夫」って"
    },
    {
      "startSec": 288,
      "text": "頑張って自分に言っています。"
    },
    {
      "startSec": 291.1,
      "text": "そう、だから、このエピソードで言いたかったことは"
    },
    {
      "startSec": 295.7,
      "text": "自分が動いて、自分で行動して得たもの、"
    },
    {
      "startSec": 301.5,
      "text": "得る(to get something)、得るものって"
    },
    {
      "startSec": 305.6,
      "text": "本当にお金に変えることができないものなんですよね。"
    },
    {
      "startSec": 310.7,
      "text": "だから自分で行動して得たものは"
    },
    {
      "startSec": 315.6,
      "text": "経験とか自分で感じて得た知識とか"
    },
    {
      "startSec": 322.9,
      "text": "そういうものが、"
    },
    {
      "startSec": 324.7,
      "text": "その人の人生を豊かにする、人生を良くする、"
    },
    {
      "startSec": 330.8,
      "text": "人柄(personality)をもっと良くしたりとか"
    },
    {
      "startSec": 334.7,
      "text": "もっと謙虚(humble)になったりとか、"
    },
    {
      "startSec": 338.1,
      "text": "そういうことかなと最近、"
    },
    {
      "startSec": 344.3,
      "text": "この一年くらいで気が付いたんですね。"
    },
    {
      "startSec": 348.7,
      "text": "やっぱり私はお金よりも"
    },
    {
      "startSec": 352.1,
      "text": "そっちの方が大切だなと思います。"
    },
    {
      "startSec": 358.5,
      "text": "今日はこんな感じで大丈夫かな。"
    },
    {
      "startSec": 362.4,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 365.4,
      "text": "もし私のこのショーをサポートしたかったら"
    },
    {
      "startSec": 370,
      "text": "レビューを残してくれると"
    },
    {
      "startSec": 372.4,
      "text": "すっごく嬉しいし、助かります。"
    },
    {
      "startSec": 377.7,
      "text": "よかったらお願いします。"
    },
    {
      "startSec": 379.6,
      "text": "じゃあいつもありがとう。"
    },
    {
      "startSec": 381.4,
      "text": "また明日も新しいエピソード聞いてください。"
    },
    {
      "startSec": 385.1,
      "text": "いつもありがとう！バイバイ！"
    }
  ]
}
