{
  "episodeId": "r0p0V-jUERo",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.6,
      "text": "BITE SIZE JAPANESEのレイラです。"
    },
    {
      "startSec": 3.3,
      "text": "元気ですか？"
    },
    {
      "startSec": 5.6,
      "text": "今日は一回と一度"
    },
    {
      "startSec": 9.4,
      "text": "この違いについて話したいと思います。"
    },
    {
      "startSec": 13.4,
      "text": "皆さんね、今までこの一回と一度"
    },
    {
      "startSec": 17.8,
      "text": "違いについて考えたことはありますか？"
    },
    {
      "startSec": 22.6,
      "text": "例えば「もう一回言ってください」と"
    },
    {
      "startSec": 28.7,
      "text": "「もう一度言ってください」"
    },
    {
      "startSec": 32.4,
      "text": "これは何が違いますか？"
    },
    {
      "startSec": 36.7,
      "text": "何が違うと思いますか？"
    },
    {
      "startSec": 39.5,
      "text": "まあでもね、どちらも文章は同じですよね。"
    },
    {
      "startSec": 44.1,
      "text": "同じ意味です。"
    },
    {
      "startSec": 45.5,
      "text": "でもなんかちょっとね"
    },
    {
      "startSec": 47.5,
      "text": "ネイティブ、日本人にはちょっと違います。"
    },
    {
      "startSec": 52.2,
      "text": "小さなニュアンスの違いがあります。"
    },
    {
      "startSec": 56.9,
      "text": "今日はそのニュアンスの違いを"
    },
    {
      "startSec": 59.2,
      "text": "皆さんと一緒に勉強したいと思います。"
    },
    {
      "startSec": 63.5,
      "text": "私もこの違いは調べるまで知らなかったです。"
    },
    {
      "startSec": 69.6,
      "text": "調べた時に「へ、そうだったんだ！」ってびっくりしました。"
    },
    {
      "startSec": 75.2,
      "text": "なので、皆さんも今日はびっくりしてください。"
    },
    {
      "startSec": 80.5,
      "text": "じゃあまずちょっと英語で説明しますね。"
    },
    {
      "startSec": 84.9,
      "text": "えっと「回」 一回、二回の「回」"
    },
    {
      "startSec": 88.3,
      "text": "So \"回\" is used when the event is expected to happen again."
    },
    {
      "startSec": 94.5,
      "text": "「回」は、その同じことがまた起こる(to happen)"
    },
    {
      "startSec": 101.3,
      "text": "また起こると考える時、思う時に使います。"
    },
    {
      "startSec": 109.3,
      "text": "And「度」 一度の「度」一度、二度、三度の「度」"
    },
    {
      "startSec": 114.7,
      "text": "\"度\" is used when the event is NOT expected to happen again."
    },
    {
      "startSec": 121.8,
      "text": "この「度」は、その同じことがもう一度"
    },
    {
      "startSec": 126.7,
      "text": "起こらないと思う時、考える時に使います。"
    },
    {
      "startSec": 134.8,
      "text": "知ってましたか？私は知らなかったです。"
    },
    {
      "startSec": 137.6,
      "text": "びっくりしました。"
    },
    {
      "startSec": 140.7,
      "text": "なので「もう一度言ってください」"
    },
    {
      "startSec": 145.3,
      "text": "Can you say that again?"
    },
    {
      "startSec": 146.3,
      "text": "「もう一度言ってください」"
    },
    {
      "startSec": 148.4,
      "text": "これは「もう一回言ってください」より"
    },
    {
      "startSec": 153.8,
      "text": "丁寧でしょうか？丁寧じゃないでしょうか？"
    },
    {
      "startSec": 156.7,
      "text": "どっちだと思いますか？"
    },
    {
      "startSec": 162.1,
      "text": "「もう一度言ってください」の方が"
    },
    {
      "startSec": 165.4,
      "text": "「もう一回言ってください」より丁寧ですよね。"
    },
    {
      "startSec": 171.2,
      "text": "理由は「もう一度言ってください」これは今、"
    },
    {
      "startSec": 177.2,
      "text": "何回もこの後に同じことを質問しないと思っているからです。"
    },
    {
      "startSec": 185.7,
      "text": "でも「もう一回言ってください」と言うと"
    },
    {
      "startSec": 191,
      "text": "もう「一回同じことを質問するかもしれない」"
    },
    {
      "startSec": 196.5,
      "text": "そういうニュアンスがあるからです。"
    },
    {
      "startSec": 200.3,
      "text": "面白いですね。"
    },
    {
      "startSec": 202.6,
      "text": "私は「度」と「回」の違いを、勉強する前にも"
    },
    {
      "startSec": 208.2,
      "text": "「一度」の方が「一回」よりも丁寧だなと思っていました。"
    },
    {
      "startSec": 215,
      "text": "でも理由は知らなかったね。"
    },
    {
      "startSec": 218.9,
      "text": "何か「度」の方が「回」よりも"
    },
    {
      "startSec": 222.5,
      "text": "ちょっとフォーマルな、丁寧な感じがします。"
    },
    {
      "startSec": 226.4,
      "text": "なので私は、日常会話では大体いつも「回」を使ってます。"
    },
    {
      "startSec": 233.3,
      "text": "そっちの方がなんかフランクで"
    },
    {
      "startSec": 235.6,
      "text": "ちょっとカジュアルな感じだから。"
    },
    {
      "startSec": 239.5,
      "text": "いや面白いですね、うん。"
    },
    {
      "startSec": 242.3,
      "text": "なので、もし皆さんが丁寧に話したい時は「度」を使って"
    },
    {
      "startSec": 249.3,
      "text": "カジュアルな日常の時は"
    },
    {
      "startSec": 252.4,
      "text": "「回」を使ったらいいと思います。"
    },
    {
      "startSec": 258.3,
      "text": "日本語でよく使うフレーズ「I will never do it again」これね"
    },
    {
      "startSec": 264.5,
      "text": "これは日本語で「二度としません」"
    },
    {
      "startSec": 269.8,
      "text": "「二度としません」をよく使います。"
    },
    {
      "startSec": 273.8,
      "text": "「二度と」二度(second)、Second timeはしません。"
    },
    {
      "startSec": 279.9,
      "text": "\"I won't do that\"という意味ね。"
    },
    {
      "startSec": 283.9,
      "text": "これはね、私も面白いなと思いました。"
    },
    {
      "startSec": 287.4,
      "text": "これ「二回としません」じゃないです。"
    },
    {
      "startSec": 292.2,
      "text": "これはいつも「二度としません」と言います。"
    },
    {
      "startSec": 298.1,
      "text": "これもさっきの「回」と「度」の違いから来ていますよね。"
    },
    {
      "startSec": 305,
      "text": "「度」はもう一度起こると思ってない時、"
    },
    {
      "startSec": 310.5,
      "text": "これが最後と思っている時に使います。"
    },
    {
      "startSec": 315.3,
      "text": "まあそういうニュアンスがあるので"
    },
    {
      "startSec": 318.1,
      "text": "「二度としません」これはこのまま覚えて使ってください。"
    },
    {
      "startSec": 324.5,
      "text": "もう絶対に「二回としません」は使わないです。"
    },
    {
      "startSec": 328.5,
      "text": "はい、すごく面白いと思ったので"
    },
    {
      "startSec": 331.5,
      "text": "皆さんとシェアしました。"
    },
    {
      "startSec": 334.1,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 336.1,
      "text": "もしよかったらPatreon、ぜひ参加してください。"
    },
    {
      "startSec": 341.9,
      "text": "全てのこれからのエピソードのトランスクリプト"
    },
    {
      "startSec": 347.5,
      "text": "ふりがなが付いてます。"
    },
    {
      "startSec": 349.7,
      "text": "漢字の上にふりがなが付いているので"
    },
    {
      "startSec": 353.8,
      "text": "漢字の読み方が難しかったら"
    },
    {
      "startSec": 357,
      "text": "ぜひPatreonで、トランスクリプトで"
    },
    {
      "startSec": 361,
      "text": "このポッドキャストを聞いて"
    },
    {
      "startSec": 363.2,
      "text": "リスニングとねリーディングと"
    },
    {
      "startSec": 365.6,
      "text": "漢字の勉強も一緒にしてください。"
    },
    {
      "startSec": 370,
      "text": "きっと役に立つと思うので"
    },
    {
      "startSec": 372.3,
      "text": "良かったらリンクからチェックしてみてください。"
    },
    {
      "startSec": 376.6,
      "text": "じゃいつもありがとうございます。"
    },
    {
      "startSec": 378.9,
      "text": "じゃまた明日ね！"
    },
    {
      "startSec": 380.9,
      "text": "頑張ってください！"
    },
    {
      "startSec": 382.1,
      "text": "バイバイ！"
    }
  ]
}
