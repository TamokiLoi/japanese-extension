{
  "episodeId": "Gs7ja5gMOno",
  "segments": [
    {
      "startSec": 0,
      "text": "はい、皆さんこんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.5,
      "text": "元気ですか？"
    },
    {
      "startSec": 5.2,
      "text": "今日のこのマイクの音、良くないですか？"
    },
    {
      "startSec": 10.5,
      "text": "良くないですか？"
    },
    {
      "startSec": 11.9,
      "text": "いい音じゃないですか？"
    },
    {
      "startSec": 14.2,
      "text": "実はね、このマイクの使い方"
    },
    {
      "startSec": 18.2,
      "text": "今日初めてちゃんと知りました。"
    },
    {
      "startSec": 23.3,
      "text": "今までもね"
    },
    {
      "startSec": 24.6,
      "text": "ずっとこのマイクを使っていたんですが"
    },
    {
      "startSec": 28.7,
      "text": "私全然、説明書(instruction)"
    },
    {
      "startSec": 33.8,
      "text": "説明書を読むのがうまくなくて"
    },
    {
      "startSec": 38.3,
      "text": "全然読めなくて"
    },
    {
      "startSec": 40.4,
      "text": "なので、いつもカメラとかマイクとか買った時は"
    },
    {
      "startSec": 45.8,
      "text": "もう説明書、読まないで"
    },
    {
      "startSec": 48.9,
      "text": "いつも自分で「あ、これ、これかな？」"
    },
    {
      "startSec": 52.4,
      "text": "「このボタンかな？えい」"
    },
    {
      "startSec": 53.8,
      "text": "「ここ、これを押して」みたいな感じで使っています。"
    },
    {
      "startSec": 58.2,
      "text": "なので本当に、全然ね"
    },
    {
      "startSec": 60.3,
      "text": "多分このカメラも、マイクも"
    },
    {
      "startSec": 63.6,
      "text": "いいカメラ、いいマイクだけど"
    },
    {
      "startSec": 66.1,
      "text": "全然使えてないです。"
    },
    {
      "startSec": 68.9,
      "text": "でも、今日さっき"
    },
    {
      "startSec": 72.2,
      "text": "このマイクの使い方のブログを読みました。"
    },
    {
      "startSec": 76.8,
      "text": "すると、このマイクと10センチから20センチくらい離れて"
    },
    {
      "startSec": 84.7,
      "text": "録音(to record)"
    },
    {
      "startSec": 87.5,
      "text": "録音してくださいと書いてありました。"
    },
    {
      "startSec": 90.7,
      "text": "今まではね、"
    },
    {
      "startSec": 92.8,
      "text": "もう多分1メートルくらい"
    },
    {
      "startSec": 97.3,
      "text": "離れていたと思います。"
    },
    {
      "startSec": 100,
      "text": "こんな感じ。"
    },
    {
      "startSec": 101.1,
      "text": "もっと離れてたかも。"
    },
    {
      "startSec": 103,
      "text": "こんな感じで話していました。"
    },
    {
      "startSec": 108.2,
      "text": "そしてこの後ろのゲインの調節も"
    },
    {
      "startSec": 112.1,
      "text": "全然できていなかったですね。"
    },
    {
      "startSec": 114.7,
      "text": "今はちっちゃくして"
    },
    {
      "startSec": 116.7,
      "text": "あまり音が入らないようにして話してます。"
    },
    {
      "startSec": 121.3,
      "text": "音がいいとうれしいです。"
    },
    {
      "startSec": 124.4,
      "text": "で、まあ何で今日"
    },
    {
      "startSec": 127.1,
      "text": "ポッドキャストの音を"
    },
    {
      "startSec": 129.5,
      "text": "良くしたいと思ったかと言うと"
    },
    {
      "startSec": 133.9,
      "text": "これから、もっともっともっと"
    },
    {
      "startSec": 138.9,
      "text": "ポッドキャストを頑張りたいと"
    },
    {
      "startSec": 141.7,
      "text": "思うようになりました。"
    },
    {
      "startSec": 144.7,
      "text": "できたら毎日、このポッドキャストを"
    },
    {
      "startSec": 149.3,
      "text": "アップロードしたいです。"
    },
    {
      "startSec": 152.9,
      "text": "理由(reason)は"
    },
    {
      "startSec": 156.5,
      "text": "私はポッドキャストがすごく好きだということに"
    },
    {
      "startSec": 162.6,
      "text": "気が付いたからです。"
    },
    {
      "startSec": 165.8,
      "text": "私はポッドキャストが好きで"
    },
    {
      "startSec": 168.4,
      "text": "話すことも好きだし"
    },
    {
      "startSec": 171.3,
      "text": "で、何よりみなさんが"
    },
    {
      "startSec": 174.7,
      "text": "このポッドキャストで"
    },
    {
      "startSec": 176.6,
      "text": "日本語を勉強してくれていることがうれしいです。"
    },
    {
      "startSec": 181.5,
      "text": "そしてもうポッドキャストは、"
    },
    {
      "startSec": 184.6,
      "text": "日本語の勉強、言語(language)の勉強の"
    },
    {
      "startSec": 189.3,
      "text": "まあ一番いい方法だと、私が知ってるからです。"
    },
    {
      "startSec": 196.2,
      "text": "私もポッドキャストで英語を勉強して、"
    },
    {
      "startSec": 199.6,
      "text": "もう発音とかリスニングも"
    },
    {
      "startSec": 202.4,
      "text": "とても昔よりもできるようになったし"
    },
    {
      "startSec": 207.1,
      "text": "やっぱり皆さんの"
    },
    {
      "startSec": 209.5,
      "text": "日本語の勉強、手伝えることが"
    },
    {
      "startSec": 212.9,
      "text": "私にはすごくうれしいです。"
    },
    {
      "startSec": 217,
      "text": "なので、これから"
    },
    {
      "startSec": 219.6,
      "text": "毎日このポッドキャストのエピソードを"
    },
    {
      "startSec": 223.1,
      "text": "アップロードしたいと思います。"
    },
    {
      "startSec": 225.7,
      "text": "ぜひ楽しみにして"
    },
    {
      "startSec": 227.9,
      "text": "毎日、日本語のリスニングの練習に"
    },
    {
      "startSec": 232.2,
      "text": "使ってくれたらうれしいです。"
    },
    {
      "startSec": 235.7,
      "text": "やっぱりポッドキャストのコメントとかも"
    },
    {
      "startSec": 240.3,
      "text": "もう私にはすごくうれしくて"
    },
    {
      "startSec": 244.1,
      "text": "私は1年前にInstagram、ショートビデオを作り始めて"
    },
    {
      "startSec": 251.6,
      "text": "フォロワーが増えました。"
    },
    {
      "startSec": 254.5,
      "text": "まあでも、ショートビデオって"
    },
    {
      "startSec": 256.8,
      "text": "私にとってちょっとストレスで"
    },
    {
      "startSec": 260.6,
      "text": "やっぱりその再生回数、ビューですね。"
    },
    {
      "startSec": 265.2,
      "text": "再生する(to play)"
    },
    {
      "startSec": 267.7,
      "text": "回数は、数(number)"
    },
    {
      "startSec": 271,
      "text": "そう、再生回数がすごく気になるし"
    },
    {
      "startSec": 276.4,
      "text": "やっぱり本当に教えたいことよりも"
    },
    {
      "startSec": 280.8,
      "text": "人気のコンテンツとかを"
    },
    {
      "startSec": 282.9,
      "text": "やっぱり作ってしまうので"
    },
    {
      "startSec": 285.3,
      "text": "もうその自分が、あんまり好きじゃないです。"
    },
    {
      "startSec": 288.6,
      "text": "でもポッドキャストは私らしく自分らしく"
    },
    {
      "startSec": 293.9,
      "text": "いれる場所だと思います。"
    },
    {
      "startSec": 297,
      "text": "それにみなさんと"
    },
    {
      "startSec": 300.3,
      "text": "ショートビデオはもっと浅い関係だけど"
    },
    {
      "startSec": 305,
      "text": "ポッドキャストを通して"
    },
    {
      "startSec": 307.1,
      "text": "みなさんともっと仲良く"
    },
    {
      "startSec": 310.2,
      "text": "深い関係になれたら"
    },
    {
      "startSec": 313.2,
      "text": "うれしいなと思っています。"
    },
    {
      "startSec": 315.7,
      "text": "なので、これからのエピソード"
    },
    {
      "startSec": 319.1,
      "text": "毎日ぜひ聞いて"
    },
    {
      "startSec": 321.1,
      "text": "リスニング、一緒に勉強しましょう。"
    },
    {
      "startSec": 325.5,
      "text": "で、これからもエピソードに字幕、"
    },
    {
      "startSec": 331.1,
      "text": "日本語の字幕、サブタイトルは付けます。"
    },
    {
      "startSec": 335.2,
      "text": "やっぱりそれは"
    },
    {
      "startSec": 336.6,
      "text": "私は特にビギナーの人には大切だと思うからです。"
    },
    {
      "startSec": 343.3,
      "text": "でもね、やっぱり日本語の字幕を付けることは"
    },
    {
      "startSec": 348.4,
      "text": "結構難しくて、"
    },
    {
      "startSec": 350.6,
      "text": "今は私のこのポッドキャストには"
    },
    {
      "startSec": 355.3,
      "text": "字幕を作ってくれる編集者さん"
    },
    {
      "startSec": 360,
      "text": "まあエディターさん、編集者さんがいます。"
    },
    {
      "startSec": 364.2,
      "text": "その方に、お金を払ってお願いしているので"
    },
    {
      "startSec": 369,
      "text": "ぜひPatreonでこのショーをサポートしてくれると"
    },
    {
      "startSec": 374.4,
      "text": "すごくうれしいです。"
    },
    {
      "startSec": 376.6,
      "text": "これからはPatreonで"
    },
    {
      "startSec": 379.3,
      "text": "このポッドキャストのショーの"
    },
    {
      "startSec": 382.6,
      "text": "トランスクリプト、台本をみなさんにあげます。"
    },
    {
      "startSec": 387.5,
      "text": "でも、ただのトランスクリプトじゃなくて"
    },
    {
      "startSec": 392.2,
      "text": "全ての漢字の上に"
    },
    {
      "startSec": 395.1,
      "text": "ふりがなを付けたいと思っています。"
    },
    {
      "startSec": 400.7,
      "text": "これで漢字の読み方が難しい人は"
    },
    {
      "startSec": 405.5,
      "text": "読み方も勉強できるし"
    },
    {
      "startSec": 408.1,
      "text": "リスニングの勉強もできるし、"
    },
    {
      "startSec": 411.5,
      "text": "発音も勉強できるし"
    },
    {
      "startSec": 413.9,
      "text": "日本の表現、色んなフレーズも勉強できるし"
    },
    {
      "startSec": 417.9,
      "text": "ポッドキャスト最高ですよね。"
    },
    {
      "startSec": 420,
      "text": "ぜひPatreonに興味を持ってくれて"
    },
    {
      "startSec": 424.9,
      "text": "入ってくれたらとってもうれしいです。"
    },
    {
      "startSec": 428.7,
      "text": "じゃあ今日のエピソードはここまでです。"
    },
    {
      "startSec": 431.8,
      "text": "本当にいつもありがとうございます。"
    },
    {
      "startSec": 435.1,
      "text": "そして今、大体始めたばかりだけど"
    },
    {
      "startSec": 439.1,
      "text": "10人くらいの方にPatreonに入っていただきました。"
    },
    {
      "startSec": 444.2,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 446.6,
      "text": "これからもよろしくお願いします。"
    },
    {
      "startSec": 449.2,
      "text": "じゃあまたね！良い一日を！バイバイ！"
    }
  ]
}
