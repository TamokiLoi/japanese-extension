{
  "episodeId": "hM2CPM9jFFQ",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.4,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日は、四百年前の日本がわかる場所を"
    },
    {
      "startSec": 12.1,
      "text": "皆さんに教えます。"
    },
    {
      "startSec": 14.6,
      "text": "この場所は「一乗谷朝倉氏遺跡」と言います。"
    },
    {
      "startSec": 22.5,
      "text": "これは福井県にあって、この場所に行くと"
    },
    {
      "startSec": 27.5,
      "text": "四百年前の日本の町を、その世界を"
    },
    {
      "startSec": 33.9,
      "text": "感じることができます。"
    },
    {
      "startSec": 36.1,
      "text": "今日は、ちょっとワクワクしています。"
    },
    {
      "startSec": 38.2,
      "text": "皆さんにこの話をシェアしたいと思います。"
    },
    {
      "startSec": 43.4,
      "text": "前のエピソードで、三月の後半に旅行に行くと"
    },
    {
      "startSec": 49.5,
      "text": "皆さんに言いました。"
    },
    {
      "startSec": 52.5,
      "text": "で、旅行に行ってきました。"
    },
    {
      "startSec": 55.8,
      "text": "今はもう四月です。"
    },
    {
      "startSec": 58.3,
      "text": "旅行の最初は、福井県に行きました。"
    },
    {
      "startSec": 66.2,
      "text": "福井県の美味しい食べ物とかの話は"
    },
    {
      "startSec": 70.3,
      "text": "他のエピソードでします。"
    },
    {
      "startSec": 73.5,
      "text": "今日は、福井県にある素晴らしい場所、"
    },
    {
      "startSec": 79.3,
      "text": "「一乗谷朝倉氏遺跡」この場所について"
    },
    {
      "startSec": 84.3,
      "text": "皆さんと話したいです。"
    },
    {
      "startSec": 87.3,
      "text": "「一乗谷」はその場所の名前です。"
    },
    {
      "startSec": 91.6,
      "text": "「朝倉氏」は、これは「朝倉さん」という意味。"
    },
    {
      "startSec": 97,
      "text": "「遺跡(ruin)」、昔あったものが残っている場所です。"
    },
    {
      "startSec": 108.1,
      "text": "この一乗谷朝倉氏遺跡、ここは四百年前に日本で"
    },
    {
      "startSec": 116.6,
      "text": "すごくたくさんの人が生活して、有名だった町です。"
    },
    {
      "startSec": 124.6,
      "text": "城下町です。"
    },
    {
      "startSec": 126.6,
      "text": "「城下」は漢字を見るとわかります。"
    },
    {
      "startSec": 132,
      "text": "城、下、町と書いて城下町なので"
    },
    {
      "startSec": 138.3,
      "text": "大きなお城があった、お城の周りの町のことです。"
    },
    {
      "startSec": 144.3,
      "text": "四百年前は一万人の人が、その町で暮らしていました。"
    },
    {
      "startSec": 152.8,
      "text": "四百年前は、京都や大阪と同じくらい"
    },
    {
      "startSec": 160.5,
      "text": "大きな町だったんです。"
    },
    {
      "startSec": 163.9,
      "text": "もう今は本当に、人もお店もないぐらい"
    },
    {
      "startSec": 170.4,
      "text": "田舎の静かな場所です。"
    },
    {
      "startSec": 174.4,
      "text": "でも昔は、四百年前はもうすごく大きくて"
    },
    {
      "startSec": 179.4,
      "text": "すごい文化があった場所です。"
    },
    {
      "startSec": 183.3,
      "text": "私は実は建築(architecture)を勉強していたので"
    },
    {
      "startSec": 190.2,
      "text": "本当にこういう、昔の人の生活とか古い家に"
    },
    {
      "startSec": 196.4,
      "text": "すごく興味があります。"
    },
    {
      "startSec": 199.5,
      "text": "だからこの遺跡は本当に良かった。"
    },
    {
      "startSec": 205.3,
      "text": "もし皆さんが歴史とか文化、古いものが好きだったら"
    },
    {
      "startSec": 211.9,
      "text": "是非この福井県にある一乗谷朝倉氏遺跡へ"
    },
    {
      "startSec": 218.1,
      "text": "行ってください。"
    },
    {
      "startSec": 219.3,
      "text": "もうめっちゃおすすめ。"
    },
    {
      "startSec": 221.9,
      "text": "この朝倉さん、この人は戦国大名です。"
    },
    {
      "startSec": 228.9,
      "text": "四百年前は日本は戦国、もう戦う国がたくさんある"
    },
    {
      "startSec": 235.4,
      "text": "バラバラのカオスだったんです。"
    },
    {
      "startSec": 239.2,
      "text": "その中で、すごく力を持っていた人です。"
    },
    {
      "startSec": 245.1,
      "text": "大名、これは侍のリーダーみたいな感じです。"
    },
    {
      "startSec": 251.2,
      "text": "だから朝倉さんは、すごいパワーがあって"
    },
    {
      "startSec": 255.2,
      "text": "こんなに大きな町を作ることができました。"
    },
    {
      "startSec": 261.3,
      "text": "百年この町は続きました。"
    },
    {
      "startSec": 267.5,
      "text": "でも四百年前に、織田信長という人、"
    },
    {
      "startSec": 274.2,
      "text": "この人もすっごく強い人、めっちゃ有名です、今は。"
    },
    {
      "startSec": 279.9,
      "text": "すごくたくさんの人を殺して"
    },
    {
      "startSec": 283.1,
      "text": "いろんな文化を日本に持ってきた人です。"
    },
    {
      "startSec": 288.6,
      "text": "この織田信長と朝倉さんが戦って"
    },
    {
      "startSec": 295.7,
      "text": "朝倉さんは負けました。"
    },
    {
      "startSec": 299.7,
      "text": "この織田信長は優しくない人です。"
    },
    {
      "startSec": 305,
      "text": "本当にもうお坊さん(priest,monk)とか"
    },
    {
      "startSec": 310.3,
      "text": "子供も女の人もたくさん、殺した人です。"
    },
    {
      "startSec": 316.1,
      "text": "この織田信長は、朝倉さんの町にやって来て"
    },
    {
      "startSec": 323.7,
      "text": "三日三晩(three days and three nights)"
    },
    {
      "startSec": 333.9,
      "text": "この村や町を襲って(attack)"
    },
    {
      "startSec": 338.7,
      "text": "人を殺して、いい物を盗んで(盗む=to steal）"
    },
    {
      "startSec": 349,
      "text": "家に火をつけました。"
    },
    {
      "startSec": 352.1,
      "text": "そこでこの町は、終わってしまったんです。"
    },
    {
      "startSec": 357.7,
      "text": "四百年前、この町が終わって朝倉さんもいなくなって。"
    },
    {
      "startSec": 365.1,
      "text": "その戦いで死んでしまいました。"
    },
    {
      "startSec": 369.3,
      "text": "でその後、そこの場所に住んでいた人達が"
    },
    {
      "startSec": 375.2,
      "text": "村の跡に、畑・田んぼを始めました。"
    },
    {
      "startSec": 383.2,
      "text": "ちょうど五十年くらい前、"
    },
    {
      "startSec": 385.9,
      "text": "今から五十年前に田んぼ作っている人が"
    },
    {
      "startSec": 392.5,
      "text": "土の中から四百年前の町の跡を見つけました。"
    },
    {
      "startSec": 401.3,
      "text": "その時から色んな研究者(researchers)が"
    },
    {
      "startSec": 409.2,
      "text": "日本中からやってきて"
    },
    {
      "startSec": 412.4,
      "text": "四百年前のこの町の調査(investigation)を始めて"
    },
    {
      "startSec": 417.8,
      "text": "研究を始めました。"
    },
    {
      "startSec": 420.6,
      "text": "で、その人達が、四百年前の村、町を"
    },
    {
      "startSec": 427.1,
      "text": "もう一度、今の世界に作っています。"
    },
    {
      "startSec": 432.8,
      "text": "それを福井県の一乗谷で見ることができるんです。"
    },
    {
      "startSec": 439.3,
      "text": "二百円払ったら、家がたくさんある"
    },
    {
      "startSec": 442,
      "text": "四百年前の昔の町を見ることができます。"
    },
    {
      "startSec": 447.8,
      "text": "本当にこれはおすすめ。"
    },
    {
      "startSec": 452.8,
      "text": "なんかね、いいですよ。"
    },
    {
      "startSec": 455.3,
      "text": "もうタイムタイムスリップ(time-travel)した感じです。"
    },
    {
      "startSec": 462.2,
      "text": "皆さんが歴史、古い日本の文化が好きだったら"
    },
    {
      "startSec": 467.8,
      "text": "是非是非行ってみてください。"
    },
    {
      "startSec": 470.8,
      "text": "めっちゃおすすめです。"
    },
    {
      "startSec": 473.4,
      "text": "今日のエピソードは、ちょっと長くなってしまいました。"
    },
    {
      "startSec": 476.9,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 481.3,
      "text": "じゃあ良い一日を！いつもありがとう！"
    },
    {
      "startSec": 484.3,
      "text": "バイバイ！"
    }
  ]
}
