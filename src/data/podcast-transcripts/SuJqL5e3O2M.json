{
  "episodeId": "SuJqL5e3O2M",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.8,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.3,
      "text": "昨日のエピソードでお金の節約の話をしました。"
    },
    {
      "startSec": 15.2,
      "text": "節約、皆さん節約してますか？"
    },
    {
      "startSec": 20.2,
      "text": "しないとちょっともったいない、"
    },
    {
      "startSec": 23,
      "text": "無駄になることもあると思うので"
    },
    {
      "startSec": 26.2,
      "text": "楽しく節約したいですよね。"
    },
    {
      "startSec": 29.8,
      "text": "で、昨日私が話したのは"
    },
    {
      "startSec": 32.5,
      "text": "ヘアカットは半年に一回。"
    },
    {
      "startSec": 35.7,
      "text": "彼氏の髪は私が切るとか、"
    },
    {
      "startSec": 39.4,
      "text": "服は全部セカンドハンドで買うとか、"
    },
    {
      "startSec": 43.4,
      "text": "そういうことかな。"
    },
    {
      "startSec": 45.3,
      "text": "で、今日はもっと私の他の節約の話"
    },
    {
      "startSec": 50.9,
      "text": "したいと思います。"
    },
    {
      "startSec": 52.8,
      "text": "まずこれ、めっちゃ大きいのがスマホですよね。"
    },
    {
      "startSec": 57.9,
      "text": "スマホ、これは私は安いSIMカード使っています。"
    },
    {
      "startSec": 66,
      "text": "ラインモ(LINEMO)という日本のSIMカードで"
    },
    {
      "startSec": 69.3,
      "text": "これはちょっと古いプランなんですけど"
    },
    {
      "startSec": 72.8,
      "text": "一ヶ月に六百円、めっちゃ安いですよね。"
    },
    {
      "startSec": 78.7,
      "text": "一ヶ月に六百円だけスマートフォンに払っています。"
    },
    {
      "startSec": 84.7,
      "text": "で、このスマホも、これめっちゃ古いiPhone7ですが"
    },
    {
      "startSec": 90,
      "text": "ネットで中古、セカンドハンドじゃないけど"
    },
    {
      "startSec": 94.7,
      "text": "新しいスマホだけど、"
    },
    {
      "startSec": 96.7,
      "text": "箱とかがとちょっと傷んで破れているから"
    },
    {
      "startSec": 101.2,
      "text": "安かったスマホを買いました。"
    },
    {
      "startSec": 104.7,
      "text": "これ多分三万円くらいですね。"
    },
    {
      "startSec": 107.7,
      "text": "一年前に買って、今もうこの前落としたら"
    },
    {
      "startSec": 112.2,
      "text": "バキバキに割れちゃって"
    },
    {
      "startSec": 115.7,
      "text": "また新しいのを探してるんですが。"
    },
    {
      "startSec": 118.7,
      "text": "スマホは私は、安いスマホでいいと思ってます。"
    },
    {
      "startSec": 124.7,
      "text": "新しいスマホじゃないといけないことってないです。"
    },
    {
      "startSec": 130.4,
      "text": "他の人に自慢(show off)したかったら"
    },
    {
      "startSec": 136.6,
      "text": "そりゃiPhone13とか買ったらいいですけど"
    },
    {
      "startSec": 140.8,
      "text": "iPhone7で全然大丈夫。"
    },
    {
      "startSec": 143.8,
      "text": "あとはパソコンがあったら"
    },
    {
      "startSec": 146.5,
      "text": "私は全然、全然困ることはありません。"
    },
    {
      "startSec": 151.7,
      "text": "でもパソコンはやっぱりちゃんと"
    },
    {
      "startSec": 155.9,
      "text": "いいパソコンが欲しいですよね。"
    },
    {
      "startSec": 159,
      "text": "分かります、テクノロジーは大切。"
    },
    {
      "startSec": 163,
      "text": "で、そうそう、SIMカードでめっちゃ安いので"
    },
    {
      "startSec": 167.1,
      "text": "全然お金は払っていません。"
    },
    {
      "startSec": 170.8,
      "text": "私はよく家にいるので、一ヶ月に2ギガまで、"
    },
    {
      "startSec": 176.5,
      "text": "SIMカード2ギガまでなんですけど"
    },
    {
      "startSec": 179.2,
      "text": "ずっと家にいるし"
    },
    {
      "startSec": 181.5,
      "text": "外でスマホあまり使わないので全然いけます。"
    },
    {
      "startSec": 186.6,
      "text": "その方が多分いいですよね。"
    },
    {
      "startSec": 189.6,
      "text": "外にいる時くらいやっぱりスマホは持たないで"
    },
    {
      "startSec": 194.3,
      "text": "景色を楽しんだり会話を楽しんだりしたいです。"
    },
    {
      "startSec": 201.1,
      "text": "で、あとは…家で料理しますね。"
    },
    {
      "startSec": 206.6,
      "text": "よく公園に散歩に行ったり"
    },
    {
      "startSec": 209.6,
      "text": "ビーチに行ったりしますが、"
    },
    {
      "startSec": 212.3,
      "text": "家でご飯を作って持って行くことが多い。"
    },
    {
      "startSec": 216.8,
      "text": "ピクニックね。"
    },
    {
      "startSec": 218.2,
      "text": "サンドイッチとかおにぎり。"
    },
    {
      "startSec": 220.8,
      "text": "やっぱり家で作るご飯が美味しいですね。"
    },
    {
      "startSec": 225.8,
      "text": "自分で美味しく作る方がいい。"
    },
    {
      "startSec": 229.2,
      "text": "美味しいし、安いのでほとんど家で作っています。"
    },
    {
      "startSec": 236.5,
      "text": "旅行の時は結構外食、外で食べるのは楽しみますけど"
    },
    {
      "startSec": 243.5,
      "text": "もう普通は全部家で作ります。"
    },
    {
      "startSec": 247.9,
      "text": "でも食材、食べ物は、"
    },
    {
      "startSec": 250.6,
      "text": "スーパーで結構たくさん買っています。"
    },
    {
      "startSec": 255.2,
      "text": "やっぱりいろんな料理を楽しみたいし"
    },
    {
      "startSec": 258.9,
      "text": "いろんな味を食べたいし"
    },
    {
      "startSec": 262.3,
      "text": "やっぱり食べ物にはすごくお金は使っています。"
    },
    {
      "startSec": 267.4,
      "text": "結構ね、本当にこれはちょっと「あ、やばいな」"
    },
    {
      "startSec": 270.9,
      "text": "と思うんですが…"
    },
    {
      "startSec": 273.5,
      "text": "であともう一つ、女の人ならわかると思うんですけど"
    },
    {
      "startSec": 281.4,
      "text": "やっぱり新しい化粧品(cosmetics)とか"
    },
    {
      "startSec": 288.9,
      "text": "顔をケアするクリームとか"
    },
    {
      "startSec": 295.4,
      "text": "これ女の人なら分かると思うんですけど"
    },
    {
      "startSec": 301.6,
      "text": "一つ買った化粧品を全部使う前に"
    },
    {
      "startSec": 307.8,
      "text": "新しいものを買ったりしませんか？メイクとか。"
    },
    {
      "startSec": 312.8,
      "text": "「このアイシャドーかわいいから買ってみよう」とか"
    },
    {
      "startSec": 317.2,
      "text": "で新しいのたくさん買っちゃう。"
    },
    {
      "startSec": 319.7,
      "text": "でも買うけど、あまり使わないとか。"
    },
    {
      "startSec": 324.1,
      "text": "多分よくあると思うんですね。"
    },
    {
      "startSec": 326.9,
      "text": "私も結構それ、大学生の時にやっていました。"
    },
    {
      "startSec": 332.2,
      "text": "メイクのポーチがもうパンパンになって"
    },
    {
      "startSec": 337.7,
      "text": "もう何個もポーチがたくさんあるみたいな。"
    },
    {
      "startSec": 341.5,
      "text": "使っていないメイクばっかりあるとか。"
    },
    {
      "startSec": 345,
      "text": "で、これはもったいないなと思って"
    },
    {
      "startSec": 348.7,
      "text": "今は全部使うまで新しいものは"
    },
    {
      "startSec": 353.6,
      "text": "買わないようにしています。"
    },
    {
      "startSec": 356.7,
      "text": "これで私多分一ヶ月に三千円くらい"
    },
    {
      "startSec": 362.4,
      "text": "節約できているなと思います。"
    },
    {
      "startSec": 366.2,
      "text": "ほんとに。"
    },
    {
      "startSec": 368.5,
      "text": "で、あとは高い顔のクリームとか"
    },
    {
      "startSec": 373.3,
      "text": "昔は買っていたんですけど、"
    },
    {
      "startSec": 377.2,
      "text": "もう全然効果ないし(it didn't work)"
    },
    {
      "startSec": 380.7,
      "text": "全然効果なくて"
    },
    {
      "startSec": 383.3,
      "text": "今は薬局で、ドラッグストアで買える"
    },
    {
      "startSec": 387.4,
      "text": "何て言うかな、ヒルドイド、ヘパリン…"
    },
    {
      "startSec": 390.4,
      "text": "べーシックなクリームだけ使ってます。"
    },
    {
      "startSec": 394,
      "text": "あとビタミンC。"
    },
    {
      "startSec": 395.8,
      "text": "それでも全然肌は変わらないです。"
    },
    {
      "startSec": 400,
      "text": "だからちゃんと自分に何が必要か"
    },
    {
      "startSec": 405.8,
      "text": "考えないといけないなって思います。"
    },
    {
      "startSec": 409.5,
      "text": "トレンドばかり気にしていたら"
    },
    {
      "startSec": 412.9,
      "text": "やっぱり自分に必要なもの、"
    },
    {
      "startSec": 416,
      "text": "わからなくなりますよね。"
    },
    {
      "startSec": 419.2,
      "text": "だから最近は自分に必要なものを頑張って考えて、"
    },
    {
      "startSec": 426,
      "text": "お金ないしね（笑）"
    },
    {
      "startSec": 428.7,
      "text": "買うようにしています。"
    },
    {
      "startSec": 431.2,
      "text": "ということで、皆さんの節約の方法、"
    },
    {
      "startSec": 435.7,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 437.8,
      "text": "楽しみにしています。"
    },
    {
      "startSec": 440.6,
      "text": "じゃあ最後までありがとう。"
    },
    {
      "startSec": 442.3,
      "text": "また明日も聞いてね。"
    },
    {
      "startSec": 444.5,
      "text": "じゃあ良い一日を！またね、バイバイ！"
    }
  ]
}
