{
  "episodeId": "LF057ucLwoY",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.3,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.5,
      "text": "今日はちょっと面白い話をしようと思います。"
    },
    {
      "startSec": 10.3,
      "text": "これはジャックさんの働いている"
    },
    {
      "startSec": 14,
      "text": "学校の生徒の話です。"
    },
    {
      "startSec": 17.2,
      "text": "ちょっとゼロから話します。"
    },
    {
      "startSec": 19.2,
      "text": "多分皆さん、笑うと思います。"
    },
    {
      "startSec": 21.8,
      "text": "私はすっごく笑いました。"
    },
    {
      "startSec": 24,
      "text": "楽しみにしてください。"
    },
    {
      "startSec": 27.3,
      "text": "ジャックがその日、学校に行った時に"
    },
    {
      "startSec": 32.1,
      "text": "中学校一年生の生徒が一人いませんでした。"
    },
    {
      "startSec": 36.9,
      "text": "学校にいなかった。"
    },
    {
      "startSec": 38.7,
      "text": "で、その生徒の親、両親(parents)からも"
    },
    {
      "startSec": 44.3,
      "text": "連絡(contact)がなかったので"
    },
    {
      "startSec": 50,
      "text": "先生達はすごく心配して"
    },
    {
      "startSec": 54,
      "text": "警察(police)に連絡したりして"
    },
    {
      "startSec": 59.3,
      "text": "生徒を探しました。"
    },
    {
      "startSec": 62.5,
      "text": "で、生徒はその朝早くに9時くらいに"
    },
    {
      "startSec": 67.7,
      "text": "見つかりました。"
    },
    {
      "startSec": 69.9,
      "text": "どこで見つかったと思いますか、皆さん？"
    },
    {
      "startSec": 73.3,
      "text": "生徒はどこにいたでしょうか？"
    },
    {
      "startSec": 76.7,
      "text": "生徒は、近所の山の一番上"
    },
    {
      "startSec": 82.7,
      "text": "一番上で足の骨を折って"
    },
    {
      "startSec": 86.9,
      "text": "両方(both)の足の骨を折って"
    },
    {
      "startSec": 93.6,
      "text": "近所の山の一番上で"
    },
    {
      "startSec": 96.1,
      "text": "ずっと山の上にいたそうです。"
    },
    {
      "startSec": 99.6,
      "text": "で、その一日前の夜、"
    },
    {
      "startSec": 105.2,
      "text": "その生徒は夜に自分の家から出ました。"
    },
    {
      "startSec": 111.5,
      "text": "家からお父さんお母さんに"
    },
    {
      "startSec": 114.5,
      "text": "見つからないようにして"
    },
    {
      "startSec": 117.2,
      "text": "自分の家を出て、夜中ですよ！"
    },
    {
      "startSec": 120.2,
      "text": "真夜中、12時くらいに"
    },
    {
      "startSec": 122.5,
      "text": "近所の山に登ったそうです。"
    },
    {
      "startSec": 128,
      "text": "私もその山に行ったことがあるんですが"
    },
    {
      "startSec": 131.7,
      "text": "普通の、すごく大変な山で"
    },
    {
      "startSec": 134.1,
      "text": "例えば車が通る道はないです。"
    },
    {
      "startSec": 138.1,
      "text": "本当にたくさん石とか岩(rocks)があって"
    },
    {
      "startSec": 142.9,
      "text": "登るはとても大変です。"
    },
    {
      "startSec": 146.2,
      "text": "でも200メートルくらいの小さな山です。"
    },
    {
      "startSec": 150.4,
      "text": "で、その生徒は夜中に自分の家を出て"
    },
    {
      "startSec": 156.2,
      "text": "一人で山の上まで登って、"
    },
    {
      "startSec": 159.9,
      "text": "たくさん岩がある山なので"
    },
    {
      "startSec": 162.5,
      "text": "その岩の上から落ちて、骨を折って"
    },
    {
      "startSec": 169.9,
      "text": "ずっと山の上に朝までいたそうです。"
    },
    {
      "startSec": 174,
      "text": "11歳の男の子なので、携帯もなかったんですね。"
    },
    {
      "startSec": 179.1,
      "text": "お母さんお父さんに、連絡できませんでした。"
    },
    {
      "startSec": 184.3,
      "text": "その夜は寒くて、まだここは3月なので"
    },
    {
      "startSec": 188.7,
      "text": "多分ー2度（マイナス2度）くらいまでは"
    },
    {
      "startSec": 192.5,
      "text": "気温が下がっていたと思います。"
    },
    {
      "startSec": 195.7,
      "text": "その11歳の男の子は"
    },
    {
      "startSec": 197.6,
      "text": "夜中に一人で山に行って、足を折って"
    },
    {
      "startSec": 202.4,
      "text": "で、夜中のー2度くらいで"
    },
    {
      "startSec": 205.7,
      "text": "山の上に一人でいたそうです。"
    },
    {
      "startSec": 209.4,
      "text": "ごめんなさいね。"
    },
    {
      "startSec": 210.2,
      "text": "なんでだろう、すっごく面白いって私は思ったんですけど"
    },
    {
      "startSec": 214.5,
      "text": "本当にその子のことを考えると"
    },
    {
      "startSec": 217,
      "text": "もうめっちゃ面白くて。"
    },
    {
      "startSec": 219.3,
      "text": "で、その朝、地元(local)のおじいちゃんおばあちゃんは"
    },
    {
      "startSec": 227,
      "text": "毎朝その山の上に行って"
    },
    {
      "startSec": 230.4,
      "text": "体操(exercise)をするらしいです。"
    },
    {
      "startSec": 235.1,
      "text": "おじいちゃんおばあちゃんが山の上に行ったら"
    },
    {
      "startSec": 238.5,
      "text": "「助けて～助けて～」って声が聞こえたらしいです。"
    },
    {
      "startSec": 246.5,
      "text": "で、その男の子は見つかって"
    },
    {
      "startSec": 250.1,
      "text": "ちゃんと病院に行きました。"
    },
    {
      "startSec": 255.4,
      "text": "皆さん笑いましたか？"
    },
    {
      "startSec": 258.4,
      "text": "私はどうかな。"
    },
    {
      "startSec": 260.1,
      "text": "私はあんまり話を面白く話すのが"
    },
    {
      "startSec": 264.6,
      "text": "うまくないんですが"
    },
    {
      "startSec": 266.2,
      "text": "面白いなと思ってもらえたら嬉しいです。"
    },
    {
      "startSec": 270,
      "text": "その男の子、確かにちょっとバカだけど"
    },
    {
      "startSec": 272.9,
      "text": "でももうこの事件の後は多分、なんだろう…"
    },
    {
      "startSec": 277.8,
      "text": "多分クラスメートから"
    },
    {
      "startSec": 281.1,
      "text": "「お前はバカだけど、よくやった！すごい！」って"
    },
    {
      "startSec": 284.9,
      "text": "多分言ってもらえると思います。"
    },
    {
      "startSec": 287.7,
      "text": "私は5年くらい"
    },
    {
      "startSec": 290.8,
      "text": "日本の小学生と中学生に勉強を教えていました。"
    },
    {
      "startSec": 297,
      "text": "塾と言って、学校の後に勉強する"
    },
    {
      "startSec": 302.6,
      "text": "塾(cram school)があるんですが"
    },
    {
      "startSec": 305.1,
      "text": "そこで5年間アルバイトをしていて"
    },
    {
      "startSec": 308.6,
      "text": "子ども達に教えていたので"
    },
    {
      "startSec": 312.1,
      "text": "私はやっぱりそういう"
    },
    {
      "startSec": 313.8,
      "text": "子ども達の話を聞くのがすごく好きで"
    },
    {
      "startSec": 317.2,
      "text": "いつもなんか応援したくなります。"
    },
    {
      "startSec": 320,
      "text": "その男の子の顔は知りませんが、"
    },
    {
      "startSec": 322.7,
      "text": "いつもこういう話を聞くと"
    },
    {
      "startSec": 325.3,
      "text": "本当に何だろう、心が温かくなります。"
    },
    {
      "startSec": 330.2,
      "text": "じゃあ今日はこんな感じで"
    },
    {
      "startSec": 332,
      "text": "終わりたいと思います。"
    },
    {
      "startSec": 334.2,
      "text": "もし、このYouTubeの字幕(subtitles)が"
    },
    {
      "startSec": 339.9,
      "text": "読むのが難しかったら"
    },
    {
      "startSec": 341.9,
      "text": "是非Patreonでトランスクリプトを使ってください。"
    },
    {
      "startSec": 347.1,
      "text": "トランスクリプトには漢字の上に"
    },
    {
      "startSec": 349.8,
      "text": "ふりがながあるので"
    },
    {
      "startSec": 352.2,
      "text": "漢字の読み方の練習もできると思います。"
    },
    {
      "startSec": 356.5,
      "text": "良かったらサポートしてくれると嬉しいです。"
    },
    {
      "startSec": 359.9,
      "text": "いつも本当にありがとうございます。"
    },
    {
      "startSec": 362.5,
      "text": "じゃ今日も良い一日を！"
    },
    {
      "startSec": 364.4,
      "text": "あんまり無理せずに、勉強も仕事も頑張ってください。"
    },
    {
      "startSec": 369.9,
      "text": "じゃまたね！バイバイ！"
    }
  ]
}
