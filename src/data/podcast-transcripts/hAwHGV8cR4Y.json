{
  "episodeId": "hAwHGV8cR4Y",
  "segments": [
    {
      "startSec": 0.1,
      "text": "はい、みなさんこんにちは。"
    },
    {
      "startSec": 1.4,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.6,
      "text": "今日は、みんな大好き敬語"
    },
    {
      "startSec": 8,
      "text": "敬語について話したいと思います。"
    },
    {
      "startSec": 12.3,
      "text": "正直多分ね、みんなあんまり敬語は"
    },
    {
      "startSec": 15.5,
      "text": "好きじゃないと思う。"
    },
    {
      "startSec": 17.2,
      "text": "多分、苦手な人が多いと思います。"
    },
    {
      "startSec": 21.3,
      "text": "うん、でもやっぱりね"
    },
    {
      "startSec": 23.5,
      "text": "日本では、知らない人と話をする時は"
    },
    {
      "startSec": 28.8,
      "text": "全部敬語になります。"
    },
    {
      "startSec": 31.6,
      "text": "全部敬語です。"
    },
    {
      "startSec": 33,
      "text": "なので、今日はちょっと日本の敬語の種類"
    },
    {
      "startSec": 39.4,
      "text": "種類(しゅるい=kind, kinds)について"
    },
    {
      "startSec": 43.8,
      "text": "話したいと思います。"
    },
    {
      "startSec": 47.6,
      "text": "ぜひ私のPatreonもチェックしてください。"
    },
    {
      "startSec": 52.1,
      "text": "Patreonでは、ポッドキャストで使った"
    },
    {
      "startSec": 56,
      "text": "難しい単語・言葉とか"
    },
    {
      "startSec": 60.3,
      "text": "ネイティブのフレーズなど、などなど"
    },
    {
      "startSec": 63.1,
      "text": "いろいろみなさんとシェアしています。"
    },
    {
      "startSec": 66.4,
      "text": "トランスクリプトもあるので、ぜひ使ってください。"
    },
    {
      "startSec": 70.8,
      "text": "リンクは下にあります。"
    },
    {
      "startSec": 72.6,
      "text": "OK、じゃあ、敬語の話をしましょう。"
    },
    {
      "startSec": 77.3,
      "text": "えっと、まず日本語には"
    },
    {
      "startSec": 80.4,
      "text": "敬語は3つ、3種類あります。"
    },
    {
      "startSec": 85.2,
      "text": "1つは、尊敬語(そんけいご)と言います。"
    },
    {
      "startSec": 91.9,
      "text": "「尊敬する」これは動詞(verb)ですが"
    },
    {
      "startSec": 97.4,
      "text": "これは「to respect」という意味ね「尊敬する」。"
    },
    {
      "startSec": 101.7,
      "text": "で、この尊敬語は"
    },
    {
      "startSec": 105,
      "text": "文章、文(=sentence)の、主語(=subject)が"
    },
    {
      "startSec": 111.1,
      "text": "あなたが尊敬する人の時に使います。"
    },
    {
      "startSec": 115.8,
      "text": "例えば、田中先生という、すごいえらい先生がいます。"
    },
    {
      "startSec": 122.4,
      "text": "で、その先生が、例えばあなたが"
    },
    {
      "startSec": 126.6,
      "text": "「田中先生がおにぎりを食べた」と言いたい時"
    },
    {
      "startSec": 134.9,
      "text": "「田中先生がおにぎりを食べた」"
    },
    {
      "startSec": 137.6,
      "text": "ま、これは多分ちょっと失礼に聞こえます。"
    },
    {
      "startSec": 141.5,
      "text": "もう全然、敬語がないから。"
    },
    {
      "startSec": 145.7,
      "text": "なので、この「食べた」「食べる」"
    },
    {
      "startSec": 149.1,
      "text": "この動詞を、尊敬語に変えます。"
    },
    {
      "startSec": 154.4,
      "text": "「食べる」の尊敬語は、これは「召し上がる(めしあがる)」です。"
    },
    {
      "startSec": 163,
      "text": "So, you have to say,"
    },
    {
      "startSec": 165.1,
      "text": "「田中先生が召し上がった」"
    },
    {
      "startSec": 168.7,
      "text": "「田中先生が、このおにぎりを召し上がった」"
    },
    {
      "startSec": 173.9,
      "text": "こんな感じに使います。"
    },
    {
      "startSec": 176,
      "text": "これが尊敬語です。"
    },
    {
      "startSec": 179.9,
      "text": "で、敬語の種類、2つ目、"
    },
    {
      "startSec": 183.8,
      "text": "これは「謙譲語(けんじょうご)」と言います。"
    },
    {
      "startSec": 189.9,
      "text": "この「謙譲(けんじょう）」、"
    },
    {
      "startSec": 191.8,
      "text": "これは自分を低く(ひくく)言う時に使います。"
    },
    {
      "startSec": 197.3,
      "text": "なので、「humble, to be humble」の時に使いますね。"
    },
    {
      "startSec": 203.8,
      "text": "で、これは主語があなたの時、主語が自分の時に使います。"
    },
    {
      "startSec": 211.8,
      "text": "例えば「私が、このおにぎりを食べました」"
    },
    {
      "startSec": 216.8,
      "text": "この「食べました」"
    },
    {
      "startSec": 218.2,
      "text": "もちろんこれは丁寧(ていねい=polite)なんだけど"
    },
    {
      "startSec": 222.6,
      "text": "敬語じゃない。"
    },
    {
      "startSec": 224.9,
      "text": "謙譲語にするためには、"
    },
    {
      "startSec": 227.8,
      "text": "この「食べました」を"
    },
    {
      "startSec": 230.1,
      "text": "「いただきました」に変えないといけません。"
    },
    {
      "startSec": 235.9,
      "text": "そう、「食べる」の「食べる(=to eat)」"
    },
    {
      "startSec": 240,
      "text": "これの尊敬語は「召し上がる」です。"
    },
    {
      "startSec": 244.6,
      "text": "でも、この「食べる」の謙譲語は「いただく」です。"
    },
    {
      "startSec": 251.5,
      "text": "もう全然違いますよね。"
    },
    {
      "startSec": 253.5,
      "text": "なので、敬語は本当にね、難しいですね。"
    },
    {
      "startSec": 258.6,
      "text": "えっと「田中先生がこのおにぎりを召し上がった」"
    },
    {
      "startSec": 264.8,
      "text": "「私がこのおにぎりをいただきました」"
    },
    {
      "startSec": 269.5,
      "text": "全然ね、違いますよね。"
    },
    {
      "startSec": 272.1,
      "text": "はい、これが尊敬語と謙譲語です。"
    },
    {
      "startSec": 277.6,
      "text": "そして敬語の最後の種類、3つ目、"
    },
    {
      "startSec": 282.5,
      "text": "これは丁寧語(ていねいご)と言います。"
    },
    {
      "startSec": 286.6,
      "text": "丁寧(ていねい=polite)、丁寧語(ていねいご)"
    },
    {
      "startSec": 290.5,
      "text": "これはね、実はみなさん知っています。"
    },
    {
      "startSec": 297.7,
      "text": "例えば「食べます」「行きます」「話します」"
    },
    {
      "startSec": 303.8,
      "text": "「これは水です」"
    },
    {
      "startSec": 306.8,
      "text": "「これはスマホです」この「…ます」「…です」"
    },
    {
      "startSec": 310.6,
      "text": "これは全て、丁寧語です。"
    },
    {
      "startSec": 318,
      "text": "とか「お水」の「お」"
    },
    {
      "startSec": 321.4,
      "text": "「水」これはwaterだけど"
    },
    {
      "startSec": 324.3,
      "text": "「お水」は「水」よりも丁寧に聞こえます。"
    },
    {
      "startSec": 329.3,
      "text": "なので「お水」は丁寧語です。"
    },
    {
      "startSec": 333.5,
      "text": "なので、この丁寧語は、"
    },
    {
      "startSec": 337.3,
      "text": "みなさんあんまり心配しなくて大丈夫。"
    },
    {
      "startSec": 341.5,
      "text": "あのみなさんが日本語の勉強を始めた時に"
    },
    {
      "startSec": 346.5,
      "text": "勉強する言葉は、全部丁寧語です。"
    },
    {
      "startSec": 352,
      "text": "なので、みなさんは、もしね敬語を勉強したかったら"
    },
    {
      "startSec": 358.8,
      "text": "この「尊敬語」と「謙譲語」の勉強をする必要があります。"
    },
    {
      "startSec": 367.4,
      "text": "こんな感じかな。"
    },
    {
      "startSec": 369.6,
      "text": "これが日本の敬語です。"
    },
    {
      "startSec": 372.8,
      "text": "全然ね、その動詞(verb)が変わるので本当に難しい。"
    },
    {
      "startSec": 380.3,
      "text": "まあ、でもあんまり心配しないでください。"
    },
    {
      "startSec": 385.9,
      "text": "日本人も敬語は、勉強しないとできないです。"
    },
    {
      "startSec": 392.3,
      "text": "で、大体みんな20歳(さい)ぐらい、20歳(はたち)ね"
    },
    {
      "startSec": 400.3,
      "text": "20歳の時から大体みんな敬語の勉強をします、かな。"
    },
    {
      "startSec": 407.6,
      "text": "というか、20歳ぐらいの時"
    },
    {
      "startSec": 410,
      "text": "まあ22歳かな…(22歳)に、会社で働き始めるので"
    },
    {
      "startSec": 416.4,
      "text": "その時にみんな勉強します。"
    },
    {
      "startSec": 420.6,
      "text": "やっぱり勉強しないと、敬語は話せない。"
    },
    {
      "startSec": 425.8,
      "text": "なので、みなさんもあんまり心配しないで大丈夫です。"
    },
    {
      "startSec": 431.9,
      "text": "時間はかかりますけど"
    },
    {
      "startSec": 434.3,
      "text": "まあ日本で働く、働かないといけないとか"
    },
    {
      "startSec": 438.9,
      "text": "まぁ、そういうことなら、ぜひ敬語は勉強してください。"
    },
    {
      "startSec": 443.4,
      "text": "で、もしそういうことじゃないなら"
    },
    {
      "startSec": 448,
      "text": "まあまあ、あんまり勉強しなくても"
    },
    {
      "startSec": 451.5,
      "text": "私は大丈夫だと思います。"
    },
    {
      "startSec": 454.3,
      "text": "はい、じゃまた今度、他の「食べる」以外の動詞の"
    },
    {
      "startSec": 461.1,
      "text": "尊敬語とか謙譲語を、また他のビデオで"
    },
    {
      "startSec": 465.8,
      "text": "教えたいと思います。"
    },
    {
      "startSec": 468,
      "text": "はい、じゃあ今日のエピソードはここまでです。"
    },
    {
      "startSec": 472.3,
      "text": "ぜひPatreon、がんばっているので"
    },
    {
      "startSec": 474.4,
      "text": "リンクからチェックしてみてください。"
    },
    {
      "startSec": 477.5,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 479.1,
      "text": "お仕事・勉強がんばってください。"
    },
    {
      "startSec": 482.5,
      "text": "じゃまたね！バイバイ！！"
    }
  ]
}
