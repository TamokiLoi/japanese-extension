{
  "episodeId": "84ldr3vD_bA",
  "segments": [
    {
      "startSec": 0.7,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.9,
      "text": "昨日は、男子の小学生のなりたい職業(occupation)"
    },
    {
      "startSec": 12.1,
      "text": "ランキングトップテンというテーマで話しました。"
    },
    {
      "startSec": 17,
      "text": "で、今日は女の子、"
    },
    {
      "startSec": 19.9,
      "text": "女子の小学生のなりたい職業ランキング"
    },
    {
      "startSec": 25.1,
      "text": "トップテン、いきましょう。"
    },
    {
      "startSec": 28.8,
      "text": "男子とちょっと違うので"
    },
    {
      "startSec": 33,
      "text": "面白いですね、ちょっと比べてみましょう。"
    },
    {
      "startSec": 36.3,
      "text": "一番、一番はこれびっくりですね。"
    },
    {
      "startSec": 41.3,
      "text": "医者、ドクターです。"
    },
    {
      "startSec": 43.9,
      "text": "えーなんでかな医者？"
    },
    {
      "startSec": 46.7,
      "text": "やっぱり医者って"
    },
    {
      "startSec": 49.7,
      "text": "親が、お父さんお母さんが"
    },
    {
      "startSec": 52.8,
      "text": "「医者になったお金もらえるから医者になりなさい」"
    },
    {
      "startSec": 56.8,
      "text": "みたいな、そういう影響かなと思います。"
    },
    {
      "startSec": 61.7,
      "text": "でも女の子で医者が多いのは"
    },
    {
      "startSec": 65.2,
      "text": "なんか今までになかったことです。"
    },
    {
      "startSec": 70.7,
      "text": "ちょっとびっくりしました。"
    },
    {
      "startSec": 72.9,
      "text": "二つ目、二つ目は看護師(nurse)です。"
    },
    {
      "startSec": 80,
      "text": "これは分かります。"
    },
    {
      "startSec": 82,
      "text": "私の時でも看護師になりたい友達"
    },
    {
      "startSec": 87.3,
      "text": "たくさんいました。"
    },
    {
      "startSec": 88.7,
      "text": "看護師になったクラスメートもたくさんいます。"
    },
    {
      "startSec": 94.2,
      "text": "そして三つ目。三つ目は保育士。"
    },
    {
      "startSec": 101.7,
      "text": "これは幼稚園とかで"
    },
    {
      "startSec": 105.9,
      "text": "赤ちゃん、小さい子どもの世話をする人です。"
    },
    {
      "startSec": 111.7,
      "text": "これも昔から人気です。"
    },
    {
      "startSec": 114.9,
      "text": "子どもが好きな女の子多いですよね。"
    },
    {
      "startSec": 119.2,
      "text": "分かります。"
    },
    {
      "startSec": 121.3,
      "text": "でも保育士、大変な仕事ですよね。"
    },
    {
      "startSec": 124.6,
      "text": "本当に保育士さんえらいなあと思います。"
    },
    {
      "startSec": 129.7,
      "text": "じゃあ四つ目。四つ目はイラストレーターです。"
    },
    {
      "startSec": 134.8,
      "text": "いや、これもわかる。"
    },
    {
      "startSec": 136.5,
      "text": "私も昔は絵を描く仕事がしたかったので"
    },
    {
      "startSec": 141.7,
      "text": "イラストレーター、憧れますよね、わかります。"
    },
    {
      "startSec": 146.9,
      "text": "皆さんも絵を描くのが好きな人いますか？"
    },
    {
      "startSec": 150.8,
      "text": "でも結構YouTubeとか"
    },
    {
      "startSec": 153.2,
      "text": "Instagramのコンテンツ作る時"
    },
    {
      "startSec": 157.1,
      "text": "結構デザインとか色々できるので"
    },
    {
      "startSec": 160.8,
      "text": "それは今、とても楽しいです。"
    },
    {
      "startSec": 164.6,
      "text": "五つ目、教師、先生(teacher)です。"
    },
    {
      "startSec": 169.9,
      "text": "何の教師かな？"
    },
    {
      "startSec": 172,
      "text": "英語の教師？国語？"
    },
    {
      "startSec": 174.1,
      "text": "小学校？中学校？どれかな？気になりますね。"
    },
    {
      "startSec": 179.2,
      "text": "六つ目は薬剤師です。"
    },
    {
      "startSec": 182.3,
      "text": "薬剤師はPharmacistです。"
    },
    {
      "startSec": 185,
      "text": "薬局(drugstore)で働いている人です。"
    },
    {
      "startSec": 191.8,
      "text": "人気ありますね、わかる。"
    },
    {
      "startSec": 194.4,
      "text": "私の元カレ(ex-boyfriend)も"
    },
    {
      "startSec": 198.1,
      "text": "薬剤師の勉強してました。覚えています。"
    },
    {
      "startSec": 202.8,
      "text": "女の子が結構多いと言ってました、確か。"
    },
    {
      "startSec": 207.8,
      "text": "で七つ目は美容師。"
    },
    {
      "startSec": 211.8,
      "text": "美容師は髪の毛を切ったり"
    },
    {
      "startSec": 215.8,
      "text": "あと染めたり(to dye, color)。"
    },
    {
      "startSec": 220.3,
      "text": "これは結構人気ありますよね。"
    },
    {
      "startSec": 224.3,
      "text": "美容師になりたい男の人も"
    },
    {
      "startSec": 227.5,
      "text": "結構多いと思います。"
    },
    {
      "startSec": 230.3,
      "text": "で、八つ目。"
    },
    {
      "startSec": 232.6,
      "text": "八個目は、パティシエール、パティシエです。"
    },
    {
      "startSec": 237.8,
      "text": "とてもきれいなかわいいスイーツを作ったり"
    },
    {
      "startSec": 242.5,
      "text": "おしゃれな仕事ですね。"
    },
    {
      "startSec": 244.7,
      "text": "ちょっとクリエイティブですし"
    },
    {
      "startSec": 247.3,
      "text": "私もちょっとそういうことは"
    },
    {
      "startSec": 249.4,
      "text": "やってみたかったんですけど、"
    },
    {
      "startSec": 251.5,
      "text": "それはパティシエにならなくても"
    },
    {
      "startSec": 255.2,
      "text": "夜ご飯をかわいくデコレーション、飾ったり"
    },
    {
      "startSec": 259.7,
      "text": "そういうのでもう私は満足(satisfy)です。"
    },
    {
      "startSec": 267.4,
      "text": "で九個目。"
    },
    {
      "startSec": 269,
      "text": "九個目は獣医、動物のお医者さん、動物の医者のこと。"
    },
    {
      "startSec": 280.6,
      "text": "ペットが好きな人多いし"
    },
    {
      "startSec": 283.4,
      "text": "いや、私もちょっと血を見るのが怖いけど、"
    },
    {
      "startSec": 288.3,
      "text": "獣医、いい仕事ですね。"
    },
    {
      "startSec": 291.1,
      "text": "そして十個目。"
    },
    {
      "startSec": 293.6,
      "text": "これはびっくり。"
    },
    {
      "startSec": 296.1,
      "text": "男子とこれ同じなんですが"
    },
    {
      "startSec": 299.3,
      "text": "十個目は会社員。普通のサラリーマンです。"
    },
    {
      "startSec": 305.4,
      "text": "これすごく面白くて"
    },
    {
      "startSec": 307.3,
      "text": "会社員は二年前、2020年アンケートをした時"
    },
    {
      "startSec": 313.7,
      "text": "会社員はランキングの二十九個目だったらしいです。"
    },
    {
      "startSec": 321.2,
      "text": "だから二十九の会社員が"
    },
    {
      "startSec": 324.5,
      "text": "2021年にランキングの十まで上がったんですね。"
    },
    {
      "startSec": 330.8,
      "text": "会社員になりたいと思っている"
    },
    {
      "startSec": 334.2,
      "text": "若い人、小学生が増えた。"
    },
    {
      "startSec": 337.9,
      "text": "これはなんかやっぱりコロナの影響ですよね。"
    },
    {
      "startSec": 344.7,
      "text": "確かに会社に入ったらもちろん"
    },
    {
      "startSec": 349.2,
      "text": "お給料を会社からもらえるけど"
    },
    {
      "startSec": 353.4,
      "text": "でも会社員も私は楽じゃないと思います。"
    },
    {
      "startSec": 359.1,
      "text": "いつクビになるかわからないし、"
    },
    {
      "startSec": 363,
      "text": "会社がつぶれるかもしれないし"
    },
    {
      "startSec": 366.8,
      "text": "会社員になるか自分でビジネスを作るか"
    },
    {
      "startSec": 371.9,
      "text": "こういう話は大好きなので"
    },
    {
      "startSec": 373.9,
      "text": "また今度のエピソードで話したいなと思います。"
    },
    {
      "startSec": 378.1,
      "text": "よかったらコメントで皆さんの感想"
    },
    {
      "startSec": 383.9,
      "text": "思ったこととか、昔なりたかった職業について"
    },
    {
      "startSec": 390.4,
      "text": "ぜひコメントで教えてください。"
    },
    {
      "startSec": 394.7,
      "text": "じゃあ最後まで聞いてくれて"
    },
    {
      "startSec": 396.7,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 400.1,
      "text": "トランスクリプト読みたかったら"
    },
    {
      "startSec": 402.7,
      "text": "是非Patreonのメンバーになって"
    },
    {
      "startSec": 406.4,
      "text": "サポートしてくれると嬉しいです。"
    },
    {
      "startSec": 409.6,
      "text": "そして今は毎週Patreonの人のためだけに"
    },
    {
      "startSec": 416.9,
      "text": "二十分とか三十分の長いエピソードを作っています。"
    },
    {
      "startSec": 422.8,
      "text": "興味があったら、是非メンバーになってくれたら"
    },
    {
      "startSec": 427.1,
      "text": "嬉しいです。"
    },
    {
      "startSec": 429.7,
      "text": "ありがとうございます。"
    },
    {
      "startSec": 431,
      "text": "じゃあ今日はここまで。"
    },
    {
      "startSec": 432.5,
      "text": "お疲れ様でした。"
    },
    {
      "startSec": 433.9,
      "text": "また明日、バイバイ！"
    }
  ]
}
