{
  "episodeId": "3MRQdYd0Y_g",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.1,
      "text": "今日は日本に来るベストの季節・時期"
    },
    {
      "startSec": 11,
      "text": "というテーマでお話しします。"
    },
    {
      "startSec": 14.3,
      "text": "皆さんは日本に来たことはありますか？"
    },
    {
      "startSec": 19.4,
      "text": "もし来たことがあったら"
    },
    {
      "startSec": 22.1,
      "text": "いつ、どんな季節の時に来ましたか？"
    },
    {
      "startSec": 28.1,
      "text": "今日は私の一番のお勧めの季節を教えます。"
    },
    {
      "startSec": 36.1,
      "text": "それはズバリ、春です。"
    },
    {
      "startSec": 40.9,
      "text": "春、三月の終わり、三月の二十五日くらいから"
    },
    {
      "startSec": 48.5,
      "text": "四月の…七日くらいまでがお勧め。"
    },
    {
      "startSec": 56.7,
      "text": "一番お勧め。"
    },
    {
      "startSec": 59.1,
      "text": "まぁ一番の理由はやっぱり桜です。"
    },
    {
      "startSec": 64.6,
      "text": "桜、この二週間が桜が咲く時です。"
    },
    {
      "startSec": 73.7,
      "text": "この二週間以外は桜は咲きません。"
    },
    {
      "startSec": 79.1,
      "text": "本当に桜が咲くのは短い時間で"
    },
    {
      "startSec": 83.3,
      "text": "北海道とか沖縄はちょっと違うと思うんですけど"
    },
    {
      "startSec": 88.1,
      "text": "普通に日本のメインの島に来たかったら"
    },
    {
      "startSec": 94,
      "text": "この桜の時期が一番お勧めです。"
    },
    {
      "startSec": 99.1,
      "text": "たくさん桜ってあって"
    },
    {
      "startSec": 102.6,
      "text": "花が咲かないと全然わからないですけど"
    },
    {
      "startSec": 107,
      "text": "花が咲いたら「え！こんなとこに桜、あったの！」"
    },
    {
      "startSec": 111.1,
      "text": "みたいになります。"
    },
    {
      "startSec": 112.9,
      "text": "だから思っている以上に、桜は日本にたくさんあって"
    },
    {
      "startSec": 120,
      "text": "しかも大きいからめっちゃきれい。"
    },
    {
      "startSec": 123.6,
      "text": "もうやばい！"
    },
    {
      "startSec": 125.7,
      "text": "もうめっちゃテンション上がります。"
    },
    {
      "startSec": 127.9,
      "text": "本当にきれいで一番いい時。"
    },
    {
      "startSec": 131.9,
      "text": "しかもこの春はそんなに寒くないです。"
    },
    {
      "startSec": 137.6,
      "text": "もちろん暑くないし"
    },
    {
      "startSec": 140.2,
      "text": "長袖が一枚、二枚あったらいいかなという感じです。"
    },
    {
      "startSec": 147.4,
      "text": "だから、気温もいいし桜はきれいだし。"
    },
    {
      "startSec": 153.9,
      "text": "でやっぱり社会人、サラリーマンは春休みないです。"
    },
    {
      "startSec": 161.5,
      "text": "学生、小学生・中学生・高校生・大学生は"
    },
    {
      "startSec": 168.3,
      "text": "春休みが日本ではあります。"
    },
    {
      "startSec": 171.9,
      "text": "だから子供は、春は休みだけど、大人は忙しいです。"
    },
    {
      "startSec": 180.6,
      "text": "それは、学校も会社も日本は四月から始まります。"
    },
    {
      "startSec": 188.3,
      "text": "だから大人は四月は忙しい。"
    },
    {
      "startSec": 192,
      "text": "なので、そんなに人は多くないです。"
    },
    {
      "startSec": 196.5,
      "text": "でも冬休みとか夏の八月十四日、"
    },
    {
      "startSec": 202.7,
      "text": "お盆の近くは大人も休みなので"
    },
    {
      "startSec": 208.7,
      "text": "旅行は人が多くなって大変です。"
    },
    {
      "startSec": 212.9,
      "text": "だからこの四月の最初、三月の終わりがもう一番お勧め。"
    },
    {
      "startSec": 223.7,
      "text": "是非この時に良かったら、日本に旅行に来てください。"
    },
    {
      "startSec": 229.6,
      "text": "あとはゴールデンウィークも会社の人は休みだけど"
    },
    {
      "startSec": 234.7,
      "text": "やっぱりゴールデンウィークはみんな休みだから"
    },
    {
      "startSec": 239.1,
      "text": "旅行に行くのは結構人が多くて疲れます。"
    },
    {
      "startSec": 244.3,
      "text": "だからこの桜がきれいな時に是非京都へ来てください。"
    },
    {
      "startSec": 250.6,
      "text": "もう京都最高！"
    },
    {
      "startSec": 252.8,
      "text": "桜の下に椅子やテーブルを置いて"
    },
    {
      "startSec": 256.9,
      "text": "お酒を飲んだりできるレストランもあるし"
    },
    {
      "startSec": 261.3,
      "text": "鴨川がもう桜でいっぱいで"
    },
    {
      "startSec": 265,
      "text": "すごくきれいになって最高です。"
    },
    {
      "startSec": 268.6,
      "text": "はい、分かった？桜ですよ！"
    },
    {
      "startSec": 271.2,
      "text": "春、是非日本に来てください。"
    },
    {
      "startSec": 274.1,
      "text": "早くコロナが終わって、自由に旅行ができたらいいですね。"
    },
    {
      "startSec": 281.4,
      "text": "良かったら私のポッドキャストが気に入ったら"
    },
    {
      "startSec": 286,
      "text": "レビューを残してくれると嬉しいです。"
    },
    {
      "startSec": 289.6,
      "text": "是非お願いします。"
    },
    {
      "startSec": 291.1,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 293.7,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
