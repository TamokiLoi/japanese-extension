{
  "episodeId": "D6BDdt8z50k",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.1,
      "text": "今日は日本人が"
    },
    {
      "startSec": 6.8,
      "text": "ちゃんとしっかり発音しない単語について"
    },
    {
      "startSec": 14,
      "text": "話をしたいと思います。"
    },
    {
      "startSec": 17.6,
      "text": "正しい発音がちょっと難しいから"
    },
    {
      "startSec": 22.1,
      "text": "みんな簡単な方法で発音します。"
    },
    {
      "startSec": 27.7,
      "text": "今日はそういう単語を5つ持ってきました。"
    },
    {
      "startSec": 33.3,
      "text": "今から皆さんとシェアしたいと思います。"
    },
    {
      "startSec": 37.3,
      "text": "1つ目は「ふんいき(雰囲気)」です。"
    },
    {
      "startSec": 42.6,
      "text": "これは正しい発音「ふ・ん・い・き(雰囲気=atmosphere)」"
    },
    {
      "startSec": 49,
      "text": "例えばいい雰囲気、悪い雰囲気。"
    },
    {
      "startSec": 53,
      "text": "atmosphereという意味。"
    },
    {
      "startSec": 55.2,
      "text": "でも「ふんいき」、これ難しいですよね。"
    },
    {
      "startSec": 58.8,
      "text": "「ふんいき」、ふん…この「ん」が難しいので"
    },
    {
      "startSec": 63.7,
      "text": "みんな「ふ・い・ん・き」と言います。"
    },
    {
      "startSec": 69.7,
      "text": "「ふんいき」じゃなくて「ふいんき」"
    },
    {
      "startSec": 74.2,
      "text": "みんな「ふいんき」と言います。"
    },
    {
      "startSec": 77.5,
      "text": "でもこれは正しい発音じゃないですよね。"
    },
    {
      "startSec": 82.2,
      "text": "でも別に「ふいんき」と言っても"
    },
    {
      "startSec": 87.4,
      "text": "「いやいやそれ間違ってるよ」って"
    },
    {
      "startSec": 90.7,
      "text": "言われることはないです。"
    },
    {
      "startSec": 93.5,
      "text": "みんな「ふいんき」と言います。"
    },
    {
      "startSec": 96.8,
      "text": "面白いですね。"
    },
    {
      "startSec": 98.7,
      "text": "2つ目は正しい発音は「げんいん(原因=reason, causes)」です。"
    },
    {
      "startSec": 114.5,
      "text": "でもこの「ん」も難しい。"
    },
    {
      "startSec": 118.3,
      "text": "「んい」、「ん」と「い」がつながっている、"
    },
    {
      "startSec": 123,
      "text": "多分ここが難しいと思います。"
    },
    {
      "startSec": 126.3,
      "text": "なのでみんな「げーいん」と言います。"
    },
    {
      "startSec": 131,
      "text": "「げー」で長く伸ばして「いん」、「げーいん」。"
    },
    {
      "startSec": 135.8,
      "text": "「ん」を言わないです。「げーいん」"
    },
    {
      "startSec": 140.4,
      "text": "「この事故のげーいん(原因)は田中さんがお酒を飲んだからです」"
    },
    {
      "startSec": 146.3,
      "text": "みたいにです。"
    },
    {
      "startSec": 148.5,
      "text": "で次3つ目、これは正しい発音は"
    },
    {
      "startSec": 154,
      "text": "「しゅじゅつしつ(手術室surgery room)」です。"
    },
    {
      "startSec": 162.8,
      "text": "でも「しゅじゅつしつ(手術室)」、言いにくいですよね。"
    },
    {
      "startSec": 168.8,
      "text": "なので「しゅーつしつ」と言います。"
    },
    {
      "startSec": 173.5,
      "text": "普通みんな「しゅーつしつ」"
    },
    {
      "startSec": 176.1,
      "text": "「しゅじゅつしつ」正しい発音で、"
    },
    {
      "startSec": 179.7,
      "text": "「しゅーつしつ」これは間違ってるけど"
    },
    {
      "startSec": 183.3,
      "text": "みんなが発音します。"
    },
    {
      "startSec": 187.4,
      "text": "で4つ目、正しい発音は「たいいく(体育=PE)」です。"
    },
    {
      "startSec": 197.1,
      "text": "学校の授業の「たいいく(体育)」"
    },
    {
      "startSec": 201.5,
      "text": "これもちょっと難しいので"
    },
    {
      "startSec": 203.8,
      "text": "みんな「たいく」と言います。"
    },
    {
      "startSec": 206.9,
      "text": "「たいいく」じゃなくて「たいく」です。"
    },
    {
      "startSec": 211.2,
      "text": "面白いですね。"
    },
    {
      "startSec": 212.5,
      "text": "「次の授業何？」「たいく(体育)」です。"
    },
    {
      "startSec": 217.9,
      "text": "で最後5つ目は、"
    },
    {
      "startSec": 221,
      "text": "「せんたくき(洗濯機=washing machine for laundry)」"
    },
    {
      "startSec": 226,
      "text": "「せんたくき」これもちょっと面倒くさいので"
    },
    {
      "startSec": 233.7,
      "text": "みんな「せんたっき」と言います。"
    },
    {
      "startSec": 239.2,
      "text": "「せんたくき」「せんたっき」"
    },
    {
      "startSec": 242.1,
      "text": "「せんたっき」の方が簡単ですよね。"
    },
    {
      "startSec": 245,
      "text": "みんなこっちを言います。"
    },
    {
      "startSec": 247.6,
      "text": "どうでしたか、この5つの単語。"
    },
    {
      "startSec": 250.8,
      "text": "面白いですよね。"
    },
    {
      "startSec": 252.6,
      "text": "全部違う発音でしたが、やっぱり言葉は変わりますよね。"
    },
    {
      "startSec": 262.6,
      "text": "時代と時間と一緒に言葉は変わります。"
    },
    {
      "startSec": 267.8,
      "text": "なので本当に、正解(correct)とか不正解(incorrect)とか"
    },
    {
      "startSec": 277,
      "text": "決めることが難しくなります。"
    },
    {
      "startSec": 281.2,
      "text": "皆さんがもっともっと日本語を話して"
    },
    {
      "startSec": 285.4,
      "text": "日本語を話す外国人が多くなったら"
    },
    {
      "startSec": 289.4,
      "text": "日本人の日本語ともう1つ"
    },
    {
      "startSec": 292.4,
      "text": "外国人の日本語みたいなのができるかもしれません。"
    },
    {
      "startSec": 297.2,
      "text": "面白いですね。"
    },
    {
      "startSec": 298.9,
      "text": "外国人の日本語、でも"
    },
    {
      "startSec": 301.2,
      "text": "英語を話す外国人の日本語と"
    },
    {
      "startSec": 305.4,
      "text": "インド語を話す外国人の日本語、"
    },
    {
      "startSec": 308,
      "text": "これもまた違ってきますよね。"
    },
    {
      "startSec": 312.2,
      "text": "やっぱり言葉って、面白いなといつも思います。"
    },
    {
      "startSec": 319,
      "text": "じゃあ今日はこんな感じです。"
    },
    {
      "startSec": 321.5,
      "text": "もしよかったらPatreonに入って"
    },
    {
      "startSec": 324.4,
      "text": "サポートしてくれるとすっごく嬉しいです。"
    },
    {
      "startSec": 328.4,
      "text": "Patreonに入ってくれている人、"
    },
    {
      "startSec": 331.3,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 334.3,
      "text": "サポートしてくれて本当に嬉しいです。"
    },
    {
      "startSec": 338.3,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 340.5,
      "text": "じゃあ良い一日を！お仕事・勉強頑張ってください！"
    },
    {
      "startSec": 345,
      "text": "じゃあまたね！バイバイ！"
    }
  ]
}
