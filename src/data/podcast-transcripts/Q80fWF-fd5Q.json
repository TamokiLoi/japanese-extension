{
  "episodeId": "Q80fWF-fd5Q",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.1,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.8,
      "text": "今日は、日本の学校の給食について"
    },
    {
      "startSec": 10.3,
      "text": "話をしたいと思います。"
    },
    {
      "startSec": 13.4,
      "text": "私のジャックさんが今JETプログラムで"
    },
    {
      "startSec": 17.4,
      "text": "日本の中学校と小学校で働いています。"
    },
    {
      "startSec": 22.9,
      "text": "で、お昼ご飯は、学校の給食を食べています。"
    },
    {
      "startSec": 28.6,
      "text": "彼は、ちょっと変わったご飯とか"
    },
    {
      "startSec": 33.7,
      "text": "日本の料理とかすごく好きだし"
    },
    {
      "startSec": 37.4,
      "text": "あまり好き嫌いがないので"
    },
    {
      "startSec": 41.7,
      "text": "いつも美味しく楽しく食べていて、"
    },
    {
      "startSec": 45.4,
      "text": "よく面白かった料理の話をしてくれます。"
    },
    {
      "startSec": 50.3,
      "text": "私ももちろん小学校の時は給食、食べていました。"
    },
    {
      "startSec": 56.9,
      "text": "今日は日本の素晴らしい給食について"
    },
    {
      "startSec": 60.8,
      "text": "話をしたいと思います。"
    },
    {
      "startSec": 64,
      "text": "本当に日本の給食は"
    },
    {
      "startSec": 66.1,
      "text": "すごくいいと思うんですけど、その理由の一つが"
    },
    {
      "startSec": 72.3,
      "text": "栄養(Nutrition)バランス、栄養のバランスです。"
    },
    {
      "startSec": 79.4,
      "text": "いつもの料理がすごくワクワクするくらい楽しみな、"
    },
    {
      "startSec": 84.3,
      "text": "例えばハンバーガーとかカレーとか"
    },
    {
      "startSec": 88.1,
      "text": "そういうわけじゃないです。"
    },
    {
      "startSec": 89.9,
      "text": "ほとんどご飯に野菜のおかず、お肉"
    },
    {
      "startSec": 94.8,
      "text": "そして牛乳、いつも絶対牛乳が来ます。"
    },
    {
      "startSec": 98.9,
      "text": "そんな感じのメニューがほとんどなんですけど"
    },
    {
      "startSec": 103.5,
      "text": "すごくバランスがいい。"
    },
    {
      "startSec": 107.4,
      "text": "で、野菜もたくさん食べることができる。"
    },
    {
      "startSec": 112,
      "text": "で、いつも結構味が薄いんですよね。"
    },
    {
      "startSec": 116.8,
      "text": "辛いものとか甘すぎる物は全然なくて"
    },
    {
      "startSec": 121.8,
      "text": "本当に子供の健康のことを"
    },
    {
      "startSec": 125.7,
      "text": "一番に考えたメニューが多いです。"
    },
    {
      "startSec": 130.6,
      "text": "でもう一つ、すっごく給食の大切なところは"
    },
    {
      "startSec": 137.1,
      "text": "家であまりご飯が食べられない子供達の"
    },
    {
      "startSec": 142.6,
      "text": "一番、サポートできる素晴らしいものです。"
    },
    {
      "startSec": 146.5,
      "text": "あ、ヤバイ、全然説明できない！"
    },
    {
      "startSec": 149.5,
      "text": "やっぱり日本には、すごく貧乏な子供は"
    },
    {
      "startSec": 154.2,
      "text": "もしかして他の国に比べると少ないと思います。"
    },
    {
      "startSec": 160.1,
      "text": "でもそれでも、あまり家で"
    },
    {
      "startSec": 163.2,
      "text": "ちゃんとご飯が食べられない子供も"
    },
    {
      "startSec": 166.4,
      "text": "やっぱりもちろんたくさんいるんですね。"
    },
    {
      "startSec": 170.5,
      "text": "で、そういう子達は学校に来ると"
    },
    {
      "startSec": 174.3,
      "text": "もうたくさんおいしい給食を食べることができます。"
    },
    {
      "startSec": 179.5,
      "text": "で、私はよく夏休みの終わりに"
    },
    {
      "startSec": 185.2,
      "text": "悲しいニュースを見るんですけど、"
    },
    {
      "startSec": 188.5,
      "text": "夏休み、日本の夏休みは一ヶ月くらいあります。"
    },
    {
      "startSec": 195,
      "text": "でも、家であまりご飯が食べられない子供が"
    },
    {
      "startSec": 202,
      "text": "一ヶ月、学校を休んで給食が食べられないと"
    },
    {
      "startSec": 209.2,
      "text": "夏休みが終わって学校にまた来る時に"
    },
    {
      "startSec": 214.3,
      "text": "すごくやせてしまうんです。"
    },
    {
      "startSec": 218.3,
      "text": "体重が減って、ガリガリになってしまいます。"
    },
    {
      "startSec": 225,
      "text": "でこれって、"
    },
    {
      "startSec": 227.4,
      "text": "すごく悲しいけど、でも"
    },
    {
      "startSec": 230.4,
      "text": "どれだけ給食が子供達に大切かよく分かります。"
    },
    {
      "startSec": 238,
      "text": "私は、でも小学生の時は給食はあんまり好きじゃなかった。"
    },
    {
      "startSec": 245.2,
      "text": "もちろん嫌いな食べ物もたくさん出るし"
    },
    {
      "startSec": 250,
      "text": "先生は怖かったので、"
    },
    {
      "startSec": 253.4,
      "text": "給食を残すと怒るんですよね。"
    },
    {
      "startSec": 259.7,
      "text": "私結構食べられないものがたくさんあって"
    },
    {
      "startSec": 264,
      "text": "生のトマトとかグリンピースとか、しいたけとか"
    },
    {
      "startSec": 269.3,
      "text": "もうすごく嫌いで。"
    },
    {
      "startSec": 272.6,
      "text": "でも、先生は残したら怒るから"
    },
    {
      "startSec": 275.9,
      "text": "嫌いな食べ物が出た時は"
    },
    {
      "startSec": 279,
      "text": "もうずっと給食の時間が終わっても"
    },
    {
      "startSec": 282.7,
      "text": "一人で机に座って食べていました。"
    },
    {
      "startSec": 287.7,
      "text": "もうそれでなんか吐いちゃったり(to vomit)とか"
    },
    {
      "startSec": 293.7,
      "text": "泣いている子供もたくさんいました。"
    },
    {
      "startSec": 297,
      "text": "それでもやっぱり私は、今考えてみると"
    },
    {
      "startSec": 301.9,
      "text": "給食って良かったなと思います。"
    },
    {
      "startSec": 305.8,
      "text": "やっぱり給食のおかげでバランスよく食べることが"
    },
    {
      "startSec": 312.5,
      "text": "当たり前になります。"
    },
    {
      "startSec": 314.7,
      "text": "だからやっぱりちゃんと毎日"
    },
    {
      "startSec": 319.5,
      "text": "お肉とか野菜を食べないと、すごく変な感じがするし、"
    },
    {
      "startSec": 325.8,
      "text": "私の日本人の友達を見ても"
    },
    {
      "startSec": 329.6,
      "text": "みんなすごくバランスよく食べます。"
    },
    {
      "startSec": 333.8,
      "text": "ちゃんと野菜もお肉もしっかり食べる人が多いです。"
    },
    {
      "startSec": 339.9,
      "text": "野菜だけ食べないとか"
    },
    {
      "startSec": 341.8,
      "text": "お肉が嫌いみたいな人は少ないです。"
    },
    {
      "startSec": 345.9,
      "text": "であと最後、面白い話。"
    },
    {
      "startSec": 349.1,
      "text": "日本の給食ではクジラ(whale)"
    },
    {
      "startSec": 353.7,
      "text": "クジラのお肉を食べることができます。"
    },
    {
      "startSec": 358.2,
      "text": "日本ではまだ少しクジラの漁(whale hunt)がまだ少しあって"
    },
    {
      "startSec": 367.4,
      "text": "で、クジラのお肉を私も食べたことがあります。"
    },
    {
      "startSec": 373.3,
      "text": "すっごくおいしいです。"
    },
    {
      "startSec": 375.2,
      "text": "びっくりします。"
    },
    {
      "startSec": 377.5,
      "text": "魚よりは普通のお肉に近いです。"
    },
    {
      "startSec": 383.3,
      "text": "もし興味があったら皆さんも日本に来た時"
    },
    {
      "startSec": 387.3,
      "text": "クジラ料理食べてみてください。"
    },
    {
      "startSec": 391.2,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 393,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 397.1,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 400.3,
      "text": "またね！バイバイ！"
    }
  ]
}
