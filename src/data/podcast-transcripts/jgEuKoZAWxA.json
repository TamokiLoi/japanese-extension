{
  "episodeId": "jgEuKoZAWxA",
  "segments": [
    {
      "startSec": 1,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.5,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "今日は、日本で外国人が日本語を話しても"
    },
    {
      "startSec": 12.9,
      "text": "分かってもらえない、理解されないというテーマで"
    },
    {
      "startSec": 18.6,
      "text": "お話ししたいと思います。"
    },
    {
      "startSec": 21.4,
      "text": "ちょっと前にInstagramで"
    },
    {
      "startSec": 24,
      "text": "私がビデオをアップロードしました。"
    },
    {
      "startSec": 28.5,
      "text": "私の彼氏がケーキ屋さんで"
    },
    {
      "startSec": 32.4,
      "text": "レアチーズケーキを注文する(to order)動画です。"
    },
    {
      "startSec": 40.5,
      "text": "すごくたくさんの人にコメントをもらって"
    },
    {
      "startSec": 44.1,
      "text": "面白かったので"
    },
    {
      "startSec": 45.6,
      "text": "今日はそのレアチーズケーキ事件の話をしたいと思います。"
    },
    {
      "startSec": 52.4,
      "text": "あの動画の話は、本当にあったことです。"
    },
    {
      "startSec": 57.9,
      "text": "ジャックとケーキ屋さんに2回行った時に"
    },
    {
      "startSec": 62,
      "text": "2回とも「レアチーズケーキ」が"
    },
    {
      "startSec": 66.5,
      "text": "理解してもらえませんでした。"
    },
    {
      "startSec": 69.7,
      "text": "ケーキ屋さんに行って、"
    },
    {
      "startSec": 71.9,
      "text": "私はよく「ジャック、ジャック、日本語練習して」と言って"
    },
    {
      "startSec": 76.9,
      "text": "何も言わないことが多いです。"
    },
    {
      "startSec": 79.8,
      "text": "ジャックが日本語で頑張って注文をすることが多いです。"
    },
    {
      "startSec": 86.1,
      "text": "その時も私が、"
    },
    {
      "startSec": 87.6,
      "text": "「ジャック、ジャック、ケーキ注文して」と言って"
    },
    {
      "startSec": 91.4,
      "text": "ジャックに注文をしてもらいました。"
    },
    {
      "startSec": 95.3,
      "text": "で、ジャックがケーキ屋さんのお姉さんに"
    },
    {
      "startSec": 101.3,
      "text": "「あの…、レアチーズケーキお願いします」と言ったら"
    },
    {
      "startSec": 107,
      "text": "お姉さんは「ん？えっ？」みたいな顔で"
    },
    {
      "startSec": 112.8,
      "text": "分かってもらえなくて"
    },
    {
      "startSec": 114.5,
      "text": "もう1回ジャックが「レアチーズケーキ」と言いましたが"
    },
    {
      "startSec": 121.6,
      "text": "また分かってもらえませんでした。"
    },
    {
      "startSec": 126.4,
      "text": "お姉さんは分からないので私の顔を見ました。"
    },
    {
      "startSec": 131.4,
      "text": "で、私は「あ、じゃあレアチーズケーキお願いします」"
    },
    {
      "startSec": 135.1,
      "text": "と言ったら、その時はお姉さん、分かってくれました。"
    },
    {
      "startSec": 141.8,
      "text": "これが、本当に2回ありました。"
    },
    {
      "startSec": 145.5,
      "text": "2回とも違うお姉さんでした。"
    },
    {
      "startSec": 149.9,
      "text": "「何でかな～？」ってジャックと話していたんですが"
    },
    {
      "startSec": 155.2,
      "text": "皆さん何でだと思いますか？"
    },
    {
      "startSec": 158.3,
      "text": "何で、ジャックのレアチーズケーキが分かってもらえなかった？"
    },
    {
      "startSec": 166.3,
      "text": "どう思いますか？"
    },
    {
      "startSec": 171.2,
      "text": "色んな人が私のビデオのコメントで話をしていました。"
    },
    {
      "startSec": 176.1,
      "text": "何でかなって。"
    },
    {
      "startSec": 177.3,
      "text": "議論する(to discuss)、議論していました。"
    },
    {
      "startSec": 182.7,
      "text": "色んな人がジャックのアクセント、"
    },
    {
      "startSec": 186.6,
      "text": "ピッチアクセントがちょっと違うから"
    },
    {
      "startSec": 190.5,
      "text": "お姉さんは分からなかったんじゃないかなって"
    },
    {
      "startSec": 194.3,
      "text": "言っている人が多かったです。"
    },
    {
      "startSec": 197.8,
      "text": "まあ、確かにそうかな。"
    },
    {
      "startSec": 201.1,
      "text": "でも分かんない。"
    },
    {
      "startSec": 203.1,
      "text": "ただ、私も時々ジャックの日本語が分からない時もあります。"
    },
    {
      "startSec": 211.3,
      "text": "それは理由は「ジャックは英語を話す」"
    },
    {
      "startSec": 217,
      "text": "と私が思っているから、ジャックが日本語を話した時に"
    },
    {
      "startSec": 224.4,
      "text": "私が心の、頭の準備ができていない、"
    },
    {
      "startSec": 231.9,
      "text": "これも大きな理由だと思います。"
    },
    {
      "startSec": 236.1,
      "text": "やっぱり英語で話すと思ってるから"
    },
    {
      "startSec": 240.7,
      "text": "日本語で話すと「えっ？何て言った？」って"
    },
    {
      "startSec": 244.3,
      "text": "その日本語が正しくても"
    },
    {
      "startSec": 248.1,
      "text": "「ええ、何て言った？」となります。"
    },
    {
      "startSec": 254,
      "text": "じゃあケーキ屋さんのお姉さんは"
    },
    {
      "startSec": 257.7,
      "text": "ジャックが英語を話すと思って"
    },
    {
      "startSec": 260.9,
      "text": "心の準備をしていたでしょうか？"
    },
    {
      "startSec": 266.9,
      "text": "彼の日本語の発音(pronunciation)も"
    },
    {
      "startSec": 271.9,
      "text": "ちょっと確かに、日本人と全く同じじゃないですよね。"
    },
    {
      "startSec": 277.6,
      "text": "ちょっと違っていたので"
    },
    {
      "startSec": 280.2,
      "text": "だから分かりにくかった、難しかったのかなと思います。"
    },
    {
      "startSec": 287.3,
      "text": "皆さんもちょっと良かったらコメントで"
    },
    {
      "startSec": 290.6,
      "text": "皆さんの意見、教えてください。"
    },
    {
      "startSec": 293.5,
      "text": "このポッドキャストにはPatreonがあります。"
    },
    {
      "startSec": 297.7,
      "text": "サポートしてくださっている方"
    },
    {
      "startSec": 300.3,
      "text": "サポートしてくれている方"
    },
    {
      "startSec": 302.8,
      "text": "本当にありがとうございます。"
    },
    {
      "startSec": 305.5,
      "text": "皆さんのおかげで、もっとポッドキャスト"
    },
    {
      "startSec": 309.3,
      "text": "頑張りたいって思うことができます。"
    },
    {
      "startSec": 312.8,
      "text": "本当にありがとう。"
    },
    {
      "startSec": 315.2,
      "text": "じゃまた明日会いましょう！"
    },
    {
      "startSec": 317.2,
      "text": "いつもありがとう！バイバイ！"
    }
  ]
}
