{
  "episodeId": "fQj4WC7V6jo",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.4,
      "text": "前のエピソードでMBTIテストの話をして"
    },
    {
      "startSec": 11.2,
      "text": "私の性格を皆さんにシェアしました。"
    },
    {
      "startSec": 15.6,
      "text": "で今日はテストの結果じゃなくて"
    },
    {
      "startSec": 19.3,
      "text": "自分の性格を、自分の言葉で皆さんに伝えたいと思います。"
    },
    {
      "startSec": 26.3,
      "text": "やっぱりポッドキャストを聞いてくれるだけだと"
    },
    {
      "startSec": 31,
      "text": "あんまり私の本当の性格が分からないと思ったので"
    },
    {
      "startSec": 36.8,
      "text": "このエピソードを作ることにしました。"
    },
    {
      "startSec": 41.9,
      "text": "じゃあ早速始めましょう。"
    },
    {
      "startSec": 46.9,
      "text": "まず私はすごくおっちょこちょいです。"
    },
    {
      "startSec": 52.4,
      "text": "おっちょこちょい(clumsy)"
    },
    {
      "startSec": 54.9,
      "text": "たくさんミスをします。もうミスが多い。"
    },
    {
      "startSec": 59.9,
      "text": "もうミスが多すぎて、全部忘れるんですけど"
    },
    {
      "startSec": 64.1,
      "text": "忘れるのも本当に早いです。"
    },
    {
      "startSec": 68.2,
      "text": "うん…あ、何か思いつかないな。"
    },
    {
      "startSec": 72,
      "text": "でもミスが多い、で小さいことは気にしないタイプです。"
    },
    {
      "startSec": 79.8,
      "text": "例えば、なんかよくやるのが"
    },
    {
      "startSec": 83.4,
      "text": "水を飲むときに、こう水を飲みますよね。"
    },
    {
      "startSec": 86.6,
      "text": "でもいつもなんか急いでるの。"
    },
    {
      "startSec": 89.2,
      "text": "「あ、早くしないと」みたいな。"
    },
    {
      "startSec": 90.8,
      "text": "ちょっといつも焦ってるから"
    },
    {
      "startSec": 93.5,
      "text": "水飲むときも口からこぼれるみたいな。"
    },
    {
      "startSec": 97.2,
      "text": "で、それを気にしない。"
    },
    {
      "startSec": 99.5,
      "text": "水、口からこぼれて服にもつくけど"
    },
    {
      "startSec": 104.2,
      "text": "「あ、すぐ乾くば」みたいな感じのメンタルです。"
    },
    {
      "startSec": 109.5,
      "text": "はいそう、そんな感じ。"
    },
    {
      "startSec": 112.7,
      "text": "で片付けができない。"
    },
    {
      "startSec": 116.2,
      "text": "本当に片付けができない。"
    },
    {
      "startSec": 118.9,
      "text": "私結構、花粉症(hay fever)"
    },
    {
      "startSec": 129.9,
      "text": "なのですごく鼻水が出るんです。"
    },
    {
      "startSec": 134.4,
      "text": "でそれを結構鼻をかんでティッシュを"
    },
    {
      "startSec": 140.7,
      "text": "「あ、ゴミ箱ない。ちょっと机の上に置いておこう」"
    },
    {
      "startSec": 144.3,
      "text": "みたいな感じで"
    },
    {
      "startSec": 146,
      "text": "仕事の後は机に、白い山ができるみたいな感じです。"
    },
    {
      "startSec": 154,
      "text": "であとは…あでもね"
    },
    {
      "startSec": 157.1,
      "text": "ちょっと待って、ちょっと待って"
    },
    {
      "startSec": 158.3,
      "text": "でも片付けはできないけど"
    },
    {
      "startSec": 160.5,
      "text": "可愛いインテリアは大好きなの。"
    },
    {
      "startSec": 164.5,
      "text": "家をきれいにデコレーションすることは大好き。"
    },
    {
      "startSec": 170.6,
      "text": "ただ毎日少しずつ片付けができないだけ。"
    },
    {
      "startSec": 176,
      "text": "で、家を可愛くするとか"
    },
    {
      "startSec": 179.4,
      "text": "可愛い机とか椅子を買ったりするのはすっごく好き。"
    },
    {
      "startSec": 185.3,
      "text": "だからそこはちゃんと覚えてください。"
    },
    {
      "startSec": 189.5,
      "text": "きれいな可愛いものが大好き。"
    },
    {
      "startSec": 192.3,
      "text": "おしゃれなものとかね。"
    },
    {
      "startSec": 195,
      "text": "あとは私はすごく心配性です。"
    },
    {
      "startSec": 200.4,
      "text": "心配性＝心配する、いろんなことを心配します。"
    },
    {
      "startSec": 206.9,
      "text": "最近一番心配するのはやっぱり未来・将来のことです。"
    },
    {
      "startSec": 216.5,
      "text": "やっぱり会社で働きたくないから"
    },
    {
      "startSec": 220.6,
      "text": "日本語を自分で教えて"
    },
    {
      "startSec": 224.5,
      "text": "お金を稼ぎたいって思ったんです。"
    },
    {
      "startSec": 229.1,
      "text": "だからもちろん、やっぱり自分が頑張らないと"
    },
    {
      "startSec": 234,
      "text": "お金は自分の手に入らないし"
    },
    {
      "startSec": 238.7,
      "text": "まあ自分が頑張っても成功するか分からないです。"
    },
    {
      "startSec": 244.7,
      "text": "やっぱりそこがすごく心配します。"
    },
    {
      "startSec": 250.6,
      "text": "あとは本当に小さなことを心配するかな。"
    },
    {
      "startSec": 257.5,
      "text": "でもやっぱりちょっと大雑把で"
    },
    {
      "startSec": 260.5,
      "text": "小さなことは気にしないです。"
    },
    {
      "startSec": 263.3,
      "text": "ちょっと変な性格ですけど。"
    },
    {
      "startSec": 265.6,
      "text": "で結構、嫌なことがあっても"
    },
    {
      "startSec": 270.3,
      "text": "結構すぐ忘れます。"
    },
    {
      "startSec": 275.2,
      "text": "よく忘れます。"
    },
    {
      "startSec": 277.9,
      "text": "そんな感じかな。"
    },
    {
      "startSec": 279.6,
      "text": "何か食べ物で言うとレモンみたいな。"
    },
    {
      "startSec": 283.6,
      "text": "レモン…？さっぱりしてる感じかな。"
    },
    {
      "startSec": 290.3,
      "text": "納豆ってねばねば、ねばねば(sticky)ですよね。"
    },
    {
      "startSec": 295,
      "text": "納豆の性格じゃないです。"
    },
    {
      "startSec": 298.3,
      "text": "納豆よりも…レモンみたいな"
    },
    {
      "startSec": 303.4,
      "text": "一回ちょっと酸っぱいけどサラッとした…感じかな。"
    },
    {
      "startSec": 310.8,
      "text": "うん、そんな感じです。"
    },
    {
      "startSec": 312.2,
      "text": "あとは古いものが好き、古い家とか。"
    },
    {
      "startSec": 317.4,
      "text": "二百年前にできた日本の家とか大好き。"
    },
    {
      "startSec": 322,
      "text": "あとはアートが好き。"
    },
    {
      "startSec": 324.5,
      "text": "私大学で建築を勉強したんですが"
    },
    {
      "startSec": 328.7,
      "text": "論文、卒業するための論文では"
    },
    {
      "startSec": 333.8,
      "text": "ウィリアム・モリスについて書きました。"
    },
    {
      "startSec": 338.1,
      "text": "その人は大体二百年から百年前"
    },
    {
      "startSec": 342.9,
      "text": "イギリスできれいなウォールペーパーとか色々作った"
    },
    {
      "startSec": 347.6,
      "text": "アートの運動をした人です。"
    },
    {
      "startSec": 350.5,
      "text": "あとは、動物が大好き。"
    },
    {
      "startSec": 353.5,
      "text": "本当に動物、生き物が全部好きなんですよね、植物も好きだし。"
    },
    {
      "startSec": 361.5,
      "text": "あとはいつも映画で感動するのは"
    },
    {
      "startSec": 366.4,
      "text": "違う種類の恋みたいな愛みたいな、愛ですね愛。"
    },
    {
      "startSec": 373.2,
      "text": "例えばエイリアンと人間の愛とか、犬と人間の愛とか。"
    },
    {
      "startSec": 381.3,
      "text": "種類はもう関係ないけど、何か本当の愛みたいな。"
    },
    {
      "startSec": 388.2,
      "text": "それに私はいつも感動します。"
    },
    {
      "startSec": 393,
      "text": "で、好きな言葉なんですけど"
    },
    {
      "startSec": 397.6,
      "text": "言葉というよりも"
    },
    {
      "startSec": 399.3,
      "text": "昔、小学校の時に習った歌があるんです。"
    },
    {
      "startSec": 406.1,
      "text": "その歌のタイトルが「野に咲く花のように」"
    },
    {
      "startSec": 411.8,
      "text": "というタイトルで"
    },
    {
      "startSec": 414.5,
      "text": "野に咲く花のように…みたいな歌で"
    },
    {
      "startSec": 419,
      "text": "野は野原、大きな草原(field)です。"
    },
    {
      "startSec": 424.5,
      "text": "で、咲く(to bloom)、花のように、"
    },
    {
      "startSec": 429.3,
      "text": "Like a flower on a field"
    },
    {
      "startSec": 432.7,
      "text": "すごく高い宝石、ジュエリーとか"
    },
    {
      "startSec": 437.7,
      "text": "セレブリティとか有名な人とか"
    },
    {
      "startSec": 441.8,
      "text": "何かいいもの、特別なものじゃなくて"
    },
    {
      "startSec": 446.5,
      "text": "誰も気にしない場所で、なんか頑張ってる人とか"
    },
    {
      "startSec": 452.9,
      "text": "花とか生き物とか小さな命とか"
    },
    {
      "startSec": 457.9,
      "text": "考えたら涙が出るぐらい、すぐ泣くんですけど"
    },
    {
      "startSec": 461.8,
      "text": "そういう何だろう…"
    },
    {
      "startSec": 464.2,
      "text": "そういうものになんかめっちゃ感動します。"
    },
    {
      "startSec": 469.8,
      "text": "そういう性格をしています。"
    },
    {
      "startSec": 472.9,
      "text": "あんまり自分のことを、たくさんここまで話したことは"
    },
    {
      "startSec": 478.4,
      "text": "あまりなかったと思うんですけど"
    },
    {
      "startSec": 481.4,
      "text": "私の性格はこんな感じです。"
    },
    {
      "startSec": 484.9,
      "text": "皆さんの性格と似ていますか、どうですか？"
    },
    {
      "startSec": 489.4,
      "text": "よかったらコメントで教えてください。"
    },
    {
      "startSec": 494.1,
      "text": "こんな感じです。"
    },
    {
      "startSec": 495.5,
      "text": "いつも聞いてくれてありがとう。"
    },
    {
      "startSec": 498.1,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 500.8,
      "text": "じゃあまた明日！バイバイ！"
    }
  ]
}
