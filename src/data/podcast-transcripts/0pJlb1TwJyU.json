{
  "episodeId": "0pJlb1TwJyU",
  "segments": [
    {
      "startSec": 0.5,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.5,
      "text": "今日は日本の学校の校則、校則は学校のルールですね。"
    },
    {
      "startSec": 13.5,
      "text": "これについてちょっとお話したいと思います。"
    },
    {
      "startSec": 19.5,
      "text": "日本の学校は結構厳しいと思うんですよね。"
    },
    {
      "startSec": 26.8,
      "text": "結構ルールがたくさんあって。"
    },
    {
      "startSec": 29.9,
      "text": "私が行っていた中学校とか高校とか"
    },
    {
      "startSec": 34.5,
      "text": "もうルールがすごく厳しくて"
    },
    {
      "startSec": 37.3,
      "text": "みんな制服を着ているので"
    },
    {
      "startSec": 40,
      "text": "生徒がみんな同じに見えるんですよね。"
    },
    {
      "startSec": 44.2,
      "text": "そんな感じの学校に行っていました。"
    },
    {
      "startSec": 48,
      "text": "女子のルールで一番よくあるのは"
    },
    {
      "startSec": 54.3,
      "text": "スカートの長さだと思います。"
    },
    {
      "startSec": 58.7,
      "text": "高校生・中学生はみんな短いスカートが好きですよね。"
    },
    {
      "startSec": 66.2,
      "text": "だからみんなスカートを"
    },
    {
      "startSec": 68.6,
      "text": "お腹のところでこうやって折って"
    },
    {
      "startSec": 73.2,
      "text": "くるくるくるって巻いて短くするんですけど"
    },
    {
      "startSec": 78.3,
      "text": "それはよく先生に怒られました。"
    },
    {
      "startSec": 83.1,
      "text": "だから学校の門のところに先生がいつも立っていて、"
    },
    {
      "startSec": 90.4,
      "text": "で、スカートが短い女の子がいたら"
    },
    {
      "startSec": 95.3,
      "text": "「ちょっと！スカート、戻して！」って怒るみたいな。"
    },
    {
      "startSec": 101.7,
      "text": "あとは私の学校ではメイクとかピアスとか"
    },
    {
      "startSec": 108.6,
      "text": "ネイル、爪のおしゃれ、マニキュアとか"
    },
    {
      "startSec": 114.9,
      "text": "アクセサリーとか全部ダメでした。"
    },
    {
      "startSec": 119.2,
      "text": "理由は勉強に集中できないから、らしいです。"
    },
    {
      "startSec": 126.7,
      "text": "確かにメイクをすごく頑張ったら"
    },
    {
      "startSec": 130.5,
      "text": "時間も無くなるし、お金もかかるし"
    },
    {
      "startSec": 134.4,
      "text": "確かにそうだけど…ちょっと厳しいかな。"
    },
    {
      "startSec": 140,
      "text": "で、よく有名なのは日本だったら"
    },
    {
      "startSec": 144.5,
      "text": "髪が黒じゃない生徒は「黒に染めなさい」って"
    },
    {
      "startSec": 151.2,
      "text": "染める(to dye)"
    },
    {
      "startSec": 154.9,
      "text": "「染めなさい」って言われるとか、パーマはダメとか"
    },
    {
      "startSec": 162.4,
      "text": "よく言いますよね。"
    },
    {
      "startSec": 165.5,
      "text": "でも私が行っていた学校では、"
    },
    {
      "startSec": 169.6,
      "text": "先生はパーマとか髪の色については"
    },
    {
      "startSec": 174.9,
      "text": "結構優しかったです。"
    },
    {
      "startSec": 178.4,
      "text": "ちゃんと生徒のことを"
    },
    {
      "startSec": 180.4,
      "text": "わかってくれる先生が多かったです。"
    },
    {
      "startSec": 185,
      "text": "でもお父さんにこの話をしたら"
    },
    {
      "startSec": 190.4,
      "text": "お父さんはパーマ、髪がクルクル(curly)なんですけど"
    },
    {
      "startSec": 196,
      "text": "お父さんが若い時は"
    },
    {
      "startSec": 198.9,
      "text": "お父さんが中学校に行った時は"
    },
    {
      "startSec": 203.2,
      "text": "先生に「髪をストレートにしなさい」って言われたって"
    },
    {
      "startSec": 208.6,
      "text": "言っていました。"
    },
    {
      "startSec": 211.1,
      "text": "ヤバイですよね。"
    },
    {
      "startSec": 212.9,
      "text": "そこで多分確か、お父さんのお母さんがめっちゃ怒って。"
    },
    {
      "startSec": 219.3,
      "text": "お母さんも髪がクルクルのパーマです。"
    },
    {
      "startSec": 223.9,
      "text": "だからお母さんが学校に行って"
    },
    {
      "startSec": 228,
      "text": "「私の髪を見なさい。これは血なんだ」"
    },
    {
      "startSec": 231.8,
      "text": "血って言うのはDNAと言うか、親と子供のつながり"
    },
    {
      "startSec": 237.9,
      "text": "これ「血(blood)」ってよく言います。"
    },
    {
      "startSec": 241.7,
      "text": "「これは血なんだからストレートにする必要はない」って"
    },
    {
      "startSec": 247.8,
      "text": "お母さんが学校の先生に怒ったらしいです。"
    },
    {
      "startSec": 255.3,
      "text": "結構日本の学校って厳しいなと思います。"
    },
    {
      "startSec": 260.6,
      "text": "結構私もなんかしんどかったです。"
    },
    {
      "startSec": 265.8,
      "text": "やっぱり先生が生徒一人一人のことを"
    },
    {
      "startSec": 270.2,
      "text": "しっかりちゃんと見てくれているかと言ったら"
    },
    {
      "startSec": 275,
      "text": "あんまりそうでもない感じがして"
    },
    {
      "startSec": 278.6,
      "text": "結構冷たい意地悪な先生とかよくいたと思います。"
    },
    {
      "startSec": 286.2,
      "text": "私の個人的な経験なんですけど"
    },
    {
      "startSec": 292.3,
      "text": "結構小学校の先生に、すごく私はイライラしていました。"
    },
    {
      "startSec": 299.8,
      "text": "小学校の先生ってたぶんすごく大変で"
    },
    {
      "startSec": 303.9,
      "text": "子供達、三十人を一度に世話をしないといけないから"
    },
    {
      "startSec": 310.7,
      "text": "大変だと思うんですけど、"
    },
    {
      "startSec": 313,
      "text": "結構先生の気分によって言うことが変わるみたいな。"
    },
    {
      "startSec": 320.7,
      "text": "先生が例えば田中ちゃんを怒った。"
    },
    {
      "startSec": 325.5,
      "text": "で、山田君が田中ちゃんと同じことをしても"
    },
    {
      "startSec": 330.3,
      "text": "山田君のことは怒らないみたいな"
    },
    {
      "startSec": 333.5,
      "text": "そういう…何だろう…"
    },
    {
      "startSec": 335.9,
      "text": "本当に先生が好きな子には優しくする。"
    },
    {
      "startSec": 339.9,
      "text": "あまり好きじゃない子には厳しいみたいな。"
    },
    {
      "startSec": 343,
      "text": "そういう先生が多かったです。"
    },
    {
      "startSec": 347,
      "text": "結構しんどかったなという感じなんですが"
    },
    {
      "startSec": 352.3,
      "text": "今日もたくさん話したので"
    },
    {
      "startSec": 356,
      "text": "そろそろ終わりにしたいと思います。"
    },
    {
      "startSec": 359,
      "text": "良かったら皆さんも面白い学校のルールとか"
    },
    {
      "startSec": 363.7,
      "text": "コメントで教えてください。"
    },
    {
      "startSec": 367,
      "text": "じゃあいつもポッドキャスト聞いてくれて"
    },
    {
      "startSec": 370.5,
      "text": "ありがとうございます。"
    },
    {
      "startSec": 372.2,
      "text": "よかったら明日もまた聞いてくださいね。"
    },
    {
      "startSec": 376.1,
      "text": "じゃあまたね！バイバイ！"
    }
  ]
}
