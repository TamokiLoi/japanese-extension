{
  "episodeId": "SuGZY0v1IKc",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.9,
      "text": "皆さんは日本語を話す時に、性格が変わりますか？"
    },
    {
      "startSec": 15.6,
      "text": "性格、変わりますか？"
    },
    {
      "startSec": 18.3,
      "text": "よく、言語(language)を2つ以上話す時に"
    },
    {
      "startSec": 24.7,
      "text": "性格が変わる人ってよくいます。"
    },
    {
      "startSec": 30.4,
      "text": "よくそういう話を聞きます。"
    },
    {
      "startSec": 33.7,
      "text": "もちろん私がよく聞くのは"
    },
    {
      "startSec": 36.5,
      "text": "英語を話す時に性格が変わる日本人です。"
    },
    {
      "startSec": 43.3,
      "text": "日本人で英語を話す時に"
    },
    {
      "startSec": 46.3,
      "text": "ちょっと性格が変わるんだよねって言う人の話を"
    },
    {
      "startSec": 51.8,
      "text": "よく聞きます。"
    },
    {
      "startSec": 53.8,
      "text": "でも日本語を話す外国の人で性格が変わることは"
    },
    {
      "startSec": 62.4,
      "text": "ちゃんと聞いたことがないので"
    },
    {
      "startSec": 65.4,
      "text": "よかったら皆さんコメントで教えてください。"
    },
    {
      "startSec": 70.8,
      "text": "日本語を話す時の自分と"
    },
    {
      "startSec": 74,
      "text": "あなたの母国語(mother tongue)を話すときの自分"
    },
    {
      "startSec": 81.7,
      "text": "何か違いますか？"
    },
    {
      "startSec": 84.7,
      "text": "是非教えてください。"
    },
    {
      "startSec": 87.5,
      "text": "私はちょっと英語を話す時の方が"
    },
    {
      "startSec": 93.1,
      "text": "もっと直接的(direct)になると思います。"
    },
    {
      "startSec": 103.8,
      "text": "英語を話す時の方が"
    },
    {
      "startSec": 107.1,
      "text": "もっとはっきり、多分言うからだと思います。"
    },
    {
      "startSec": 113.1,
      "text": "でも日本語は結構、"
    },
    {
      "startSec": 117.7,
      "text": "もっとなんか、あやふや(vague)だから"
    },
    {
      "startSec": 124.9,
      "text": "英語の時の方が性格が強くなる、"
    },
    {
      "startSec": 129.9,
      "text": "気が強くなる感じがします。"
    },
    {
      "startSec": 134.4,
      "text": "私の友達で、ちこ先生、ちこJapaneseのちこ先生も"
    },
    {
      "startSec": 140.7,
      "text": "同じことを言っていました"
    },
    {
      "startSec": 142.9,
      "text": "もちろん、ちこ先生の方が英語上手ですが"
    },
    {
      "startSec": 147.5,
      "text": "ちこ先生は、英語を話している自分の方が好き"
    },
    {
      "startSec": 153.7,
      "text": "と言っていました。"
    },
    {
      "startSec": 155.8,
      "text": "日本語を話すと…何か…ちょっと何だろう"
    },
    {
      "startSec": 162.5,
      "text": "言いたいことがちゃんと言えないとか"
    },
    {
      "startSec": 166.5,
      "text": "もっと他の人のことを気にしないといけないとか、"
    },
    {
      "startSec": 175.3,
      "text": "そこには多分、文化の違いが現れています。"
    },
    {
      "startSec": 180.9,
      "text": "日本語は、日本人の文化から作られた言葉で"
    },
    {
      "startSec": 188.2,
      "text": "英語は、英語を話す人の文化から作られた言葉です。"
    },
    {
      "startSec": 195,
      "text": "なので、この英語と日本語の違いには"
    },
    {
      "startSec": 199,
      "text": "日本人と英語を話す国の人の"
    },
    {
      "startSec": 204.1,
      "text": "考え方の違いが出ています。"
    },
    {
      "startSec": 208.2,
      "text": "ちこさんが言っていたことで面白かったのは"
    },
    {
      "startSec": 214.7,
      "text": "英語だったら「I love you」って子供達、"
    },
    {
      "startSec": 218.4,
      "text": "ちこさんの子供に、たくさん愛を伝えることができるけど"
    },
    {
      "startSec": 225.7,
      "text": "日本語だったら愛を全然伝えられない、"
    },
    {
      "startSec": 232.7,
      "text": "素直になれないって言っていました。"
    },
    {
      "startSec": 237.7,
      "text": "確かに日本には「l love you、好きだよ」って"
    },
    {
      "startSec": 242.6,
      "text": "家族に愛を伝える文化・習慣(custom)はないです。"
    },
    {
      "startSec": 254.5,
      "text": "いやこれは私はすごく面白いなと思いました。"
    },
    {
      "startSec": 260.9,
      "text": "私はやっぱり、日本人と話す時の方が緊張します。"
    },
    {
      "startSec": 268,
      "text": "で、外国の人と話す時のほうが、もっとフレンドリーで"
    },
    {
      "startSec": 275,
      "text": "明るく楽しくいることができます。"
    },
    {
      "startSec": 279.1,
      "text": "それはやっぱり日本では"
    },
    {
      "startSec": 283.7,
      "text": "いつも空気を読まないといけない、"
    },
    {
      "startSec": 287.9,
      "text": "敬語を使わないといけない、"
    },
    {
      "startSec": 291.3,
      "text": "目上の人にはジョークは言ってはいけないとか"
    },
    {
      "startSec": 298.4,
      "text": "すごく考えることが多いです。"
    },
    {
      "startSec": 303.5,
      "text": "でもこれって結構疲れてしまいます。"
    },
    {
      "startSec": 308.8,
      "text": "特に私とか、ちこ先生みたいに…何だろう？"
    },
    {
      "startSec": 313.4,
      "text": "結構適当な人間、結構clumsyで"
    },
    {
      "startSec": 317.5,
      "text": "明るくて、あまり小さいことは気にしない人間にとっては"
    },
    {
      "startSec": 325.3,
      "text": "結構日本語ってなんか話していて"
    },
    {
      "startSec": 330,
      "text": "疲れるなと思うときがよくあります。"
    },
    {
      "startSec": 334.2,
      "text": "是非、皆さんが日本語を話す時"
    },
    {
      "startSec": 338,
      "text": "どんな風に感じるか、自分の性格が変わるか"
    },
    {
      "startSec": 344.5,
      "text": "良かったらコメントで教えてください。"
    },
    {
      "startSec": 348.2,
      "text": "いつも聞いてくれて本当にありがとうございます。"
    },
    {
      "startSec": 351.8,
      "text": "良い一日を！ここで終わります。"
    },
    {
      "startSec": 355.3,
      "text": "バイバイ！"
    }
  ]
}
