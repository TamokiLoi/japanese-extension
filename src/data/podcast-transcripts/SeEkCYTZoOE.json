    {
      "startSec": 186,
      "text": "編集するは to edit です"
    },
    {
      "startSec": 189,
      "text": "編集したりとか、コメントを返したりとか"
    },
    {
      "startSec": 195.1,
      "text": "すごくmessy ぐちゃぐちゃでした"
    },
    {
      "startSec": 198,
      "text": "でも今はね"
    },
    {
      "startSec": 200.4,
      "text": "やっぱり彼氏のおかげで"
    },
    {
      "startSec": 204.5,
      "text": "とても楽になりました。"
    },
    {
      "startSec": 207.5,
      "text": "で、今日は「私がどうやって彼氏と会ったか」"
    },
    {
      "startSec": 215.5,
      "text": "「出会ったか」について話したいと思います"
    },
    {
      "startSec": 225.2,
      "text": "じゃあ、はい、ちょっとあのね"
    },
    {
      "startSec": 227.9,
      "text": "長くなったから、はい！始めます！"
    },
    {
      "startSec": 231.6,
      "text": "えっと、私が彼と会ったのはちょうど"
    },
    {
      "startSec": 237.2,
      "text": "3年前、３年前に会いました"
    },
    {
      "startSec": 241.3,
      "text": "日本で会いました。"
    },
    {
      "startSec": 244,
      "text": "で、彼が日本に一か月旅行に来たので"
    },
    {
      "startSec": 251.4,
      "text": "その時に、ま、一緒に"
    },
    {
      "startSec": 254.9,
      "text": "ちょっと旅行して、しました。"
    },
    {
      "startSec": 258.9,
      "text": "それが初めてかな？"
    },
    {
      "startSec": 261.1,
      "text": "彼と会ったのが初めて。"
    },
    {
      "startSec": 264.8,
      "text": "彼が日本に来る前に"
    },
    {
      "startSec": 268.9,
      "text": "えーとね、6ヶ月くらい"
    },
    {
      "startSec": 273.1,
      "text": "ずっとlineをしていました。"
    },
    {
      "startSec": 276.6,
      "text": "lineは日本で有名なメッセージアプリ"
    },
    {
      "startSec": 282.4,
      "text": "メッセージアプリかな。"
    },
    {
      "startSec": 283.9,
      "text": "で、も、6ヶ月ぐらいlineをしていました"
    },
    {
      "startSec": 287.9,
      "text": "で、どうしてlineを始めたか。"
    },
    {
      "startSec": 292.8,
      "text": "それは3年と6ヶ月前"
    },
    {
      "startSec": 299,
      "text": "3年半前、2018年の3月かな？に"
    },
    {
      "startSec": 305.9,
      "text": "私はイギリスに行きました。"
    },
    {
      "startSec": 309.3,
      "text": "イギリスに行きました。で"
    },
    {
      "startSec": 311.6,
      "text": "その時に彼氏がイギリス人だから"
    },
    {
      "startSec": 318.5,
      "text": "彼氏に色々、なんだろう"
    },
    {
      "startSec": 322.2,
      "text": "イギリスの有名な場所とか"
    },
    {
      "startSec": 326.6,
      "text": "食べ物とか文化とかについて"
    },
    {
      "startSec": 331.3,
      "text": "たくさん教えてもらいました。lineでね。"
    },
    {
      "startSec": 335.9,
      "text": "なんで、じゃあジャックさんとlineを始めたか。は、"
    },
    {
      "startSec": 341.2,
      "text": "これは...難しいな"
    },
    {
      "startSec": 342.9,
      "text": "すごくね、ちょっと complicated 複雑"
    },
    {
      "startSec": 346,
      "text": "それは、それはね"
    },
    {
      "startSec": 351.8,
      "text": "皆大丈夫？話わかってるかな？えっとね"
    },
    {
      "startSec": 355.8,
      "text": "4年前に彼氏が留学で日本に来ました。"
    },
    {
      "startSec": 363.6,
      "text": "その時に、私はまだ彼のことを知らなかった。"
    },
    {
      "startSec": 370.1,
      "text": "知らなかったけど、"
    },
    {
      "startSec": 371.9,
      "text": "私の高校の時の友達、さきちゃんが"
    },
    {
      "startSec": 379.2,
      "text": "その時に彼、ジャックさんと会いました。"
    },
    {
      "startSec": 385,
      "text": "まお、ジャックさんが立命館っていう"
    },
    {
      "startSec": 388.9,
      "text": "京都の大学で留学してて、"
    },
    {
      "startSec": 392.9,
      "text": "その時、私の友達に会ってて"
    },
    {
      "startSec": 397.2,
      "text": "二人は、ジャックさんとさきちゃん"
    },
    {
      "startSec": 399.1,
      "text": "は友達になりました。"
    },
    {
      "startSec": 401.4,
      "text": "で、その時私はジャックさんのことは知らなかった。"
    },
    {
      "startSec": 405.8,
      "text": "でも、私がイギリスに行くっていう話を"
    },
    {
      "startSec": 411.6,
      "text": "さきちゃんにした時に"
    },
    {
      "startSec": 414.9,
      "text": "さきちゃんが「あ、私イギリス人の友達知ってるよ！」"
    },
    {
      "startSec": 420.1,
      "text": "「紹介するね」って言って"
    },
    {
      "startSec": 423.4,
      "text": "私にジャックさんを紹介してくれました。"
    },
    {
      "startSec": 430.5,
      "text": "ちょっと長い文章だったけど、"
    },
    {
      "startSec": 432.8,
      "text": "わかりましたか？わかりましたか？"
    },
    {
      "startSec": 436,
      "text": "そう、そんな感じで紹介してもらって、で"
    },
    {
      "startSec": 441.2,
      "text": "ずっとlineで半年間"
    },
    {
      "startSec": 443.3,
      "text": "メッセージをしていました。"
    },
    {
      "startSec": 446.3,
      "text": "で、半年間ね、すっごくたくさんメッセージした"
    },
    {
      "startSec": 451.7,
      "text": "なんか一回のメッセージが4スクロールとか５スクロール"
    },
    {
      "startSec": 458.6,
      "text": "それくらいたくさん"
    },
    {
      "startSec": 460.2,
      "text": "メッセージを送っていました。で"
    },
    {
      "startSec": 464.7,
      "text": "だいたい音楽の話とか映画の話、"
    },
    {
      "startSec": 468.9,
      "text": "私もジャックも音楽がすごく好きだったから、"
    },
    {
      "startSec": 473,
      "text": "今も好きね。"
    },
    {
      "startSec": 473.8,
      "text": "今も好きだから、"
    },
    {
      "startSec": 475.4,
      "text": "たくさん好きな音楽とか"
    },
    {
      "startSec": 478.2,
      "text": "映画とかシェアしたりとか、まぁ"
    },
    {
      "startSec": 481.5,
      "text": "時々ちょっとseriousは真剣"
    },
    {
      "startSec": 484.2,
      "text": "真剣なトピック。なんか、たまにpolitics"
    },
    {
      "startSec": 490.1,
      "text": "政治とか、まあ、文化の話とか色々ね"
    },
    {
      "startSec": 496.5,
      "text": "いろいろたくさんシェア"
    },
    {
      "startSec": 498.8,
      "text": "しました。やっぱり"
    },
    {
      "startSec": 500.3,
      "text": "たくさんメッセージをしているうちに、"
    },
    {
      "startSec": 506.3,
      "text": "している間に"
    },
    {
      "startSec": 507.9,
      "text": "なんかやっぱり、「ジャックっていい人だなー」って"
    },
    {
      "startSec": 512.3,
      "text": "思い始めて、"
    },
    {
      "startSec": 516.4,
      "text": "で、まあ日本でジャックに初めて会った時に"
    },
    {
      "startSec": 526,
      "text": "恋に落ちました。"
    },
    {
      "startSec": 527.7,
      "text": "恋に落ちました。"
    },
    {
      "startSec": 528.7,
      "text": "恋に落ちるはえーと fall in love"
    },
    {
      "startSec": 531.8,
      "text": "恋に落ちました。"
    },
    {
      "startSec": 536.4,
      "text": "本当にいい人だしユニークだし"
    },
    {
      "startSec": 542.3,
      "text": "やっぱり、ジャックみたいな人には"
    },
    {
      "startSec": 546,
      "text": "今まで会ったことがない。"
    },
    {
      "startSec": 549,
      "text": "会ったことがないかなあ..."
    },
    {
      "startSec": 553.2,
      "text": "とにかく優しい。優しいね"
    },
    {
      "startSec": 557.8,
      "text": "あとは、やっぱりちょっと繊細（せんさい）"
    },
    {
      "startSec": 560.5,
      "text": "繊細は.. 繊細って英語でなんて言う？delicate?"
    },
    {
      "startSec": 566.3,
      "text": "自分の意見を持ってる"
    },
    {
      "startSec": 575.5,
      "text": "日本人は、日本人でも"
    },
    {
      "startSec": 579.2,
      "text": "自分の意見を持っている人はたくさんいるけど"
    },
    {
      "startSec": 584.3,
      "text": "それを人に伝えようとしない。"
    },
    {
      "startSec": 590,
      "text": "みんなあまり、なんか、自分の意見を人に伝える"
    },
    {
      "startSec": 595.7,
      "text": "ことが上手じゃないし、"
    },
    {
      "startSec": 598.1,
      "text": "あまり伝えようとしない。日本人は。なんか"
    },
    {
      "startSec": 604.5,
      "text": "私は、でもジャックさんが"
    },
    {
      "startSec": 607.1,
      "text": "自分の意見をしっかり相手"
    },
    {
      "startSec": 611.7,
      "text": "人に伝えるところとか、すごく好きです"
    },
    {
      "startSec": 619.4,
      "text": "うん。そこがとても大好きです"
    },
    {
      "startSec": 622.1,
      "text": "後はユニークなところ。"
    },
    {
      "startSec": 624,
      "text": "初めてジャックにあった時は、あのね"
    },
    {
      "startSec": 627.3,
      "text": "皆、コンバースのくつ、知っていますか？"
    },
    {
      "startSec": 630.3,
      "text": "キャンバース？キャンバースだよね？（ちがいます笑う）"
    },
    {
      "startSec": 633.8,
      "text": "キャンバースの靴の片方の靴"
    },
    {
      "startSec": 638.9,
      "text": "右足の靴は、緑、緑じゃない青で"
    },
    {
      "startSec": 645.5,
      "text": "左足の靴、片方の靴はオレンジの靴をはいてました。"
    },
    {
      "startSec": 653.7,
      "text": "だから、そそ、青のコンバースのコンバース"
    },
    {
      "startSec": 658.2,
      "text": "コンバースだよね？！（はい笑）"
    },
    {
      "startSec": 659.2,
      "text": "コンバースの靴のペアを買って"
    },
    {
      "startSec": 663.8,
      "text": "オレンジのコンバースの靴のペアを買って"
    },
    {
      "startSec": 667.8,
      "text": "ちょっとエクスチェンジ、交換（こうかん）"
    },
    {
      "startSec": 670.6,
      "text": "右足と左足の靴を交換してます。"
    },
    {
      "startSec": 676.3,
      "text": "うん。なんか、めっちゃおしゃれでいいな"
    },
    {
      "startSec": 680,
      "text": "と思っていました。"
    },
    {
      "startSec": 680.9,
      "text": "そう、そんな感じね。"
    },
    {
      "startSec": 684.9,
      "text": "まあ今日はもうたくさん話したので"
    },
    {
      "startSec": 688.9,
      "text": "次は、遠距離恋愛"
    },
    {
      "startSec": 694.5,
      "text": "遠距離恋愛は"
    },
    {
      "startSec": 696.2,
      "text": "long distance relationshipです。"
    },
    {
      "startSec": 703.5,
      "text": "の話したいなーと思っています。"
    },
    {
      "startSec": 710,
      "text": "はい、今日はこんな感じかな。"
    },
    {
      "startSec": 712.7,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 716.6,
      "text": "えーと、最後だけど、"
    },
    {
      "startSec": 720.6,
      "text": "このpodcastにはビデオもあります。"
    },
    {
      "startSec": 724.4,
      "text": "はいビデオもあります。"
    },
    {
      "startSec": 726.8,
      "text": "youtubeでビデオを見ることができます。"
    },
    {
      "startSec": 731.3,
      "text": "ちょっと私の日本語が早かったら"
    },
    {
      "startSec": 736.3,
      "text": "youtubeでサブタイトル"
    },
    {
      "startSec": 739,
      "text": "サブタイトルをオンにして"
    },
    {
      "startSec": 743.4,
      "text": "日本語の字幕を呼んでください"
    },
    {
      "startSec": 753.8,
      "text": "はい。じゃあ今日もこんな感じで終わります。"
    },
    {
      "startSec": 759.1,
      "text": "最後までありがとうございます！"
    },
    {
      "startSec": 761.6,
      "text": "じゃあ、はい。ありがとう！"
    },
    {
      "startSec": 766.8,
