{
  "episodeId": "dZM4m7luKjg",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.7,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 3.9,
      "text": "今日はデートアプリ、"
    },
    {
      "startSec": 6.6,
      "text": "「マッチングアプリ」と日本語で言います"
    },
    {
      "startSec": 10.1,
      "text": "について話したいと思います。"
    },
    {
      "startSec": 13,
      "text": "デートアプリ、皆さん分かりますか？"
    },
    {
      "startSec": 15.8,
      "text": "彼氏とか彼女を見つけるためのアプリです。"
    },
    {
      "startSec": 21.5,
      "text": "皆さんの国ではどうですか？"
    },
    {
      "startSec": 25,
      "text": "みんなよく使っていますか？"
    },
    {
      "startSec": 27.9,
      "text": "日本では、特に最近かな。"
    },
    {
      "startSec": 31.2,
      "text": "ここ4年とか3年くらいで"
    },
    {
      "startSec": 35.3,
      "text": "デートアプリがすっごく有名になって"
    },
    {
      "startSec": 39.1,
      "text": "色んな人が、もうみんなが使うようになったと思います。"
    },
    {
      "startSec": 44.8,
      "text": "ちょっとびっくりですよね。"
    },
    {
      "startSec": 46.9,
      "text": "私が初めてデートアプリのことを知った時は"
    },
    {
      "startSec": 53.1,
      "text": "ちょっと怖いなという感じでした。"
    },
    {
      "startSec": 57.3,
      "text": "ちょっと怖いから使いたくないし"
    },
    {
      "startSec": 60.2,
      "text": "なんか、セフレってよく言いますよね。"
    },
    {
      "startSec": 63,
      "text": "セフレはセックスフレンドなので"
    },
    {
      "startSec": 66,
      "text": "セックスするための友達を見つける、"
    },
    {
      "startSec": 69.1,
      "text": "そういうためのアプリかなと"
    },
    {
      "startSec": 71.7,
      "text": "思っていたこともあります。"
    },
    {
      "startSec": 74.1,
      "text": "でも最近は、本当に私の友達でも"
    },
    {
      "startSec": 79.1,
      "text": "そのアプリを使っている人が多くて"
    },
    {
      "startSec": 83.3,
      "text": "そのアプリで彼氏彼女を見つけた友達は"
    },
    {
      "startSec": 88.3,
      "text": "本当に多いです。"
    },
    {
      "startSec": 90.2,
      "text": "うーん、多いですね。"
    },
    {
      "startSec": 94.3,
      "text": "アプリで彼氏を見つけた友達の"
    },
    {
      "startSec": 98,
      "text": "彼氏の話を聞いたんですが"
    },
    {
      "startSec": 102,
      "text": "なんかすっごく優しそうな誠実(honest)な人で"
    },
    {
      "startSec": 111.5,
      "text": "ちょっとびっくりしました。"
    },
    {
      "startSec": 113.2,
      "text": "「あ、アプリにこんなにいい人がいるんだな」って"
    },
    {
      "startSec": 118.2,
      "text": "ちょっとびっくりしました。"
    },
    {
      "startSec": 120.2,
      "text": "そんな感じです。"
    },
    {
      "startSec": 122.3,
      "text": "で、私の周りに国際恋愛している人"
    },
    {
      "startSec": 127.8,
      "text": "国際(international)、恋愛(dating, love)かな。"
    },
    {
      "startSec": 134.2,
      "text": "私の友達、外国の人と付き合っている友達は"
    },
    {
      "startSec": 139.8,
      "text": "そのデートアプリで彼氏を見つけた、"
    },
    {
      "startSec": 143.7,
      "text": "相手を見つけた人がすごく多いです。"
    },
    {
      "startSec": 147.9,
      "text": "ほとんどがそうだと思います。"
    },
    {
      "startSec": 150.3,
      "text": "アプリで見つけた彼氏とか彼女。"
    },
    {
      "startSec": 154.4,
      "text": "あとはHello Talkです。"
    },
    {
      "startSec": 156.7,
      "text": "Hello Talkは、日本語を勉強したかったら"
    },
    {
      "startSec": 160.8,
      "text": "日本語の友達を見つけたりすることができるアプリですが"
    },
    {
      "startSec": 165.7,
      "text": "Hello Talkで彼氏・彼女を見つけた友達もいます。"
    },
    {
      "startSec": 171.9,
      "text": "結構多いです。"
    },
    {
      "startSec": 174.6,
      "text": "ちょっとびっくりしましたね。"
    },
    {
      "startSec": 177,
      "text": "で、最近はジャックのお兄ちゃんが"
    },
    {
      "startSec": 181.5,
      "text": "もう30歳くらいなんですけど"
    },
    {
      "startSec": 184.6,
      "text": "そのお兄ちゃんが"
    },
    {
      "startSec": 186.5,
      "text": "彼女と長く付き合っていたけど、別れて"
    },
    {
      "startSec": 192,
      "text": "で、もう30歳なので"
    },
    {
      "startSec": 194,
      "text": "アプリに登録する(to register)"
    },
    {
      "startSec": 199,
      "text": "アプリに登録したと言っていました。"
    },
    {
      "startSec": 202.9,
      "text": "私は数年前は"
    },
    {
      "startSec": 206.4,
      "text": "「このアプリやばいんじゃないか」と思いましたが"
    },
    {
      "startSec": 210.2,
      "text": "今は本当に世界中の人が使っていて"
    },
    {
      "startSec": 214.9,
      "text": "本当にいい人、真面目な人、正直(honest)な人も"
    },
    {
      "startSec": 220.6,
      "text": "使ってるみたいですね。"
    },
    {
      "startSec": 222.5,
      "text": "ちょっと私がびっくりしたので"
    },
    {
      "startSec": 224.7,
      "text": "このエピソードで話してみました。"
    },
    {
      "startSec": 227.9,
      "text": "私は登録する勇気はまだないです。"
    },
    {
      "startSec": 233,
      "text": "彼氏はいるけど"
    },
    {
      "startSec": 235,
      "text": "私は彼氏がいなくても"
    },
    {
      "startSec": 238.6,
      "text": "多分登録はしないと思います。"
    },
    {
      "startSec": 242.4,
      "text": "ちょっと、ドキドキしますよね。"
    },
    {
      "startSec": 245.6,
      "text": "皆さんは登録しますか？"
    },
    {
      "startSec": 248.8,
      "text": "登録する勇気がありますか？"
    },
    {
      "startSec": 251.7,
      "text": "勇気がある(to have courage)"
    },
    {
      "startSec": 256.3,
      "text": "勇気はありますか？"
    },
    {
      "startSec": 259.2,
      "text": "今日はこんな話ですみません。"
    },
    {
      "startSec": 261.2,
      "text": "ありがとうございます、最後まで聞いてくれて。"
    },
    {
      "startSec": 264.5,
      "text": "もしよかったらPatreonで、私のこともサポートできます。"
    },
    {
      "startSec": 269,
      "text": "Patreonで私をサポートしてくれている人"
    },
    {
      "startSec": 272.7,
      "text": "本当にいつもありがとうございます。"
    },
    {
      "startSec": 276.3,
      "text": "皆さんのおかげでこれからも"
    },
    {
      "startSec": 278.9,
      "text": "コンテンツを頑張って作っていきたいと思います。"
    },
    {
      "startSec": 283.7,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 285.2,
      "text": "じゃ今日はここまでです。"
    },
    {
      "startSec": 287.1,
      "text": "素敵な一日を！無理しないでね！"
    },
    {
      "startSec": 290.4,
      "text": "バイバイ！"
    }
  ]
}
