{
  "episodeId": "UcZFkVqTykc",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さんこんにちは、レイラです。"
    },
    {
      "startSec": 2.3,
      "text": "今日も聞きに来てくれてありがとうございます。"
    },
    {
      "startSec": 6,
      "text": "今日は「私のクリスマスの思い出」"
    },
    {
      "startSec": 11.2,
      "text": "思い出について話したいと思います。"
    },
    {
      "startSec": 16.1,
      "text": "もうちょっとでクリスマスですね。"
    },
    {
      "startSec": 19.9,
      "text": "皆さんはクリスマスの予定がありますか？"
    },
    {
      "startSec": 24.6,
      "text": "予定がありますか？私はあります。まあ"
    },
    {
      "startSec": 30,
      "text": "あまり大きな、すごいことは"
    },
    {
      "startSec": 32.8,
      "text": "ないけど、まぁ、今、"
    },
    {
      "startSec": 35.5,
      "text": "彼氏が日本にいるから"
    },
    {
      "startSec": 38.2,
      "text": "一緒にリラックスして"
    },
    {
      "startSec": 41,
      "text": "なんかイギリスの料理を作ったり"
    },
    {
      "startSec": 44,
      "text": "したいなーと思っています。"
    },
    {
      "startSec": 46.5,
      "text": "でも、実は私は"
    },
    {
      "startSec": 49.1,
      "text": "昔は「クリスマス予定ある？」って言う質問"
    },
    {
      "startSec": 54.7,
      "text": "質問questionがすごくね"
    },
    {
      "startSec": 58.2,
      "text": "好きじゃなかったの。なんか苦手だった。"
    },
    {
      "startSec": 62.3,
      "text": "うん、なんか、まあね"
    },
    {
      "startSec": 64.9,
      "text": "そのやっぱり日本のクリスマスと"
    },
    {
      "startSec": 68.1,
      "text": "他の国クリスマスで全然違うと思うし、"
    },
    {
      "startSec": 73.3,
      "text": "あとは家庭その人の家"
    },
    {
      "startSec": 76.6,
      "text": "とかによっても"
    },
    {
      "startSec": 80.3,
      "text": "クリスマスのお祝い"
    },
    {
      "startSec": 84.8,
      "text": "は全然違うし、ま、だからね"
    },
    {
      "startSec": 91,
      "text": "正解はないけど"
    },
    {
      "startSec": 94.3,
      "text": "でもなんか私は、小さい時"
    },
    {
      "startSec": 97.6,
      "text": "今もちょっと、そうなんだけど"
    },
    {
      "startSec": 100.9,
      "text": "あんまりね、クリスマスが好きじゃなかったの"
    },
    {
      "startSec": 107.6,
      "text": "なんか、クリスマス....私は"
    },
    {
      "startSec": 111.4,
      "text": "あまり友達も多くなかったし、"
    },
    {
      "startSec": 115.7,
      "text": "なんかまあ、多くなかったけど"
    },
    {
      "startSec": 119.4,
      "text": "なんかクリスマスって、"
    },
    {
      "startSec": 121.9,
      "text": "社会、みんなが、社会がクリスマスは"
    },
    {
      "startSec": 127.6,
      "text": "social, 社交的 sociable になってお祝いしなさい。"
    },
    {
      "startSec": 134.7,
      "text": "みたいな、ふうに言われている"
    },
    {
      "startSec": 139.1,
      "text": "「お祝いしろ！」て"
    },
    {
      "startSec": 141.3,
      "text": "社会に言われている感じがすごくして"
    },
    {
      "startSec": 149.5,
      "text": "なんかね、私はクリスマスが苦手でした。"
    },
    {
      "startSec": 154.9,
      "text": "ずっと苦手でした。そうね"
    },
    {
      "startSec": 159.8,
      "text": "私は、今のジャックさんと付き合い始める前は"
    },
    {
      "startSec": 166.4,
      "text": "日本人の彼氏と６年間、長いね"
    },
    {
      "startSec": 173.2,
      "text": "つきあっていました。"
    },
    {
      "startSec": 176.3,
      "text": "その時も、まぁやっぱり彼氏だから"
    },
    {
      "startSec": 181.6,
      "text": "クリスマスの日は一緒に出かけて、"
    },
    {
      "startSec": 187.2,
      "text": "外出してディナーを食べたりしていました"
    },
    {
      "startSec": 191.8,
      "text": "そうそうそう、日本では"
    },
    {
      "startSec": 194.1,
      "text": "クリスマスはカップルのためのもの。"
    },
    {
      "startSec": 198.2,
      "text": "カップルのためのクリスマスですね。"
    },
    {
      "startSec": 202.2,
      "text": "なんかそれも、私結構ストレスに感じてしまって"
    },
    {
      "startSec": 207.8,
      "text": "私は本当は、好きな人と"
    },
    {
      "startSec": 211.8,
      "text": "家でリラックスするのが好きです。"
    },
    {
      "startSec": 215.6,
      "text": "好きな人って言ったら"
    },
    {
      "startSec": 218.2,
      "text": "好きな人って言ったら"
    },
    {
      "startSec": 219.7,
      "text": "まあ彼氏も好きな人ですが"
    },
    {
      "startSec": 222.7,
      "text": "私には家族の方が大切だった。だから"
    },
    {
      "startSec": 229.6,
      "text": "なんか家族を家に置いて"
    },
    {
      "startSec": 233.8,
      "text": "なんか家族のことは気にしないで"
    },
    {
      "startSec": 236.9,
      "text": "自分だけ、なんかおしゃれして"
    },
    {
      "startSec": 240.8,
      "text": "街にでなんかこうやって"
    },
    {
      "startSec": 242.8,
      "text": "ワイワイってパーティーみたいにするのは"
    },
    {
      "startSec": 246.4,
      "text": "好きじゃなかったです。"
    },
    {
      "startSec": 249.6,
      "text": "はい。でもまあ"
    },
    {
      "startSec": 253.2,
      "text": "本当にだからずっとクリスマスは全然好き"
    },
    {
      "startSec": 256.6,
      "text": "じゃなかった。"
    },
    {
      "startSec": 259.3,
      "text": "なんかやっぱり、あとは"
    },
    {
      "startSec": 261.8,
      "text": "その、お祝いできない人もいますよね？"
    },
    {
      "startSec": 266.8,
      "text": "例えば、お金がなかったり"
    },
    {
      "startSec": 269.9,
      "text": "病気で大変だったりとかね。"
    },
    {
      "startSec": 273.4,
      "text": "そういう人の気持ちを考えると"
    },
    {
      "startSec": 277.3,
      "text": "なんか、なんか、ね〜"
    },
    {
      "startSec": 280.9,
      "text": "こうやってワイワイしてパーティーするのもなあ"
    },
    {
      "startSec": 284.9,
      "text": "難しいなあって思っていました。"
    },
    {
      "startSec": 290,
      "text": "考えすぎっていう人もいると思います"
    },
    {
      "startSec": 295.2,
      "text": "私もね、そんなに気にすることはない と思うんですが"
    },
    {
      "startSec": 301.5,
      "text": "やっぱり私のお母さんが10年くらい"
    },
    {
      "startSec": 307.1,
      "text": "ずっと病気をしていたことがあって、"
    },
    {
      "startSec": 312.5,
      "text": "その時は本当に"
    },
    {
      "startSec": 314.7,
      "text": "お母さんは全然、自分で動けないし"
    },
    {
      "startSec": 319,
      "text": "お父さんがお母さんのお世話をして"
    },
    {
      "startSec": 322.9,
      "text": "あげないといけなかったし、"
    },
    {
      "startSec": 325.5,
      "text": "ちょっと大変な時がありました。"
    },
    {
      "startSec": 329.8,
      "text": "やっぱり、そういう時って、なんだろう"
    },
    {
      "startSec": 337.8,
      "text": "なんかね、こうやってそういう大変な、なんだろう"
    },
    {
      "startSec": 341.8,
      "text": "お母さんとかお父さんのことを忘れて"
    },
    {
      "startSec": 345.1,
      "text": "なんか、クリスマスを一人で友達とパーティーする"
    },
    {
      "startSec": 348.6,
      "text": "みたいなのは、ちょっと自分にはできなかった"
    },
    {
      "startSec": 355.9,
      "text": "と言うか、しんどかった。苦しかったです。 でもまあ"
    },
    {
      "startSec": 361,
      "text": "今はイギリス人の彼氏がいて"
    },
    {
      "startSec": 365.7,
      "text": "やっぱり彼は、クリスマスはお祝いしたいですね。"
    },
    {
      "startSec": 373,
      "text": "うん。彼はイギリス人で、彼のお母さんはあのー"
    },
    {
      "startSec": 379.7,
      "text": "すっごくクリスマスを家族で、"
    },
    {
      "startSec": 384.3,
      "text": "クリスマスツリーを用意して、ディナーを作って"
    },
    {
      "startSec": 389.4,
      "text": "プレゼントもたくさん用意して、"
    },
    {
      "startSec": 392.8,
      "text": "お祝いをする家族です。"
    },
    {
      "startSec": 398.8,
      "text": "ジャックさんの話を聞いていて、"
    },
    {
      "startSec": 401.8,
      "text": "やっぱり、ジャックさん達は"
    },
    {
      "startSec": 404.6,
      "text": "クリスマスはお祝いするけど、"
    },
    {
      "startSec": 408.9,
      "text": "その、なんて言うかな、自分のなんだろう"
    },
    {
      "startSec": 413.2,
      "text": "家族のためにお祝いしている"
    },
    {
      "startSec": 418.6,
      "text": "それがとてもよく伝わってきて、"
    },
    {
      "startSec": 424.1,
      "text": "私は「いいなぁ」と思いました"
    },
    {
      "startSec": 428.9,
      "text": "だからこれからは、"
    },
    {
      "startSec": 431.2,
      "text": "彼氏と一緒にジャックさんと一緒に"
    },
    {
      "startSec": 436.4,
      "text": "クリスマスを毎年、過ごすことができるので"
    },
    {
      "startSec": 444.9,
      "text": "これからは、私もね"
    },
    {
      "startSec": 447.9,
      "text": "彼と一緒に自分のために"
    },
    {
      "startSec": 451.5,
      "text": "家族のために"
    },
    {
      "startSec": 453.1,
      "text": "美味しいものを食べるために"
    },
    {
      "startSec": 456.4,
      "text": "クリスマスをお祝いしたいなと思います。"
    },
    {
      "startSec": 461.3,
      "text": "はい。そうねね"
    },
    {
      "startSec": 463.8,
      "text": "実は、ジャックさんはイギリス人だけど"
    },
    {
      "startSec": 471.9,
      "text": "10年前にオーストラリアに引っ越したので"
    },
    {
      "startSec": 477.9,
      "text": "ジャックさんの家族はオーストラリアにいます。"
    },
    {
      "startSec": 482.7,
      "text": "で、オーストラリアのジャックのお母さん"
    },
    {
      "startSec": 486.2,
      "text": "ママが2週間前に"
    },
    {
      "startSec": 492.7,
      "text": "小さなクリスマスツリーを送ってくれました。"
    },
    {
      "startSec": 497.3,
      "text": "大きな箱、ボックスに"
    },
    {
      "startSec": 500.3,
      "text": "クリスマスツリーとか"
    },
    {
      "startSec": 501.7,
      "text": "ディナーを作るための調味料（ちょうみりょう）"
    },
    {
      "startSec": 507.6,
      "text": "スパイスとか、ブリティッシュプディングを作る"
    },
    {
      "startSec": 510.9,
      "text": "なんかいろいろ、いろんなものをたくさん"
    },
    {
      "startSec": 514.3,
      "text": "お菓子とかケーキとか送ってくれました。"
    },
    {
      "startSec": 519.2,
      "text": "うん。今年の冬は"
    },
    {
      "startSec": 523.2,
      "text": "その材料を使って"
    },
    {
      "startSec": 528,
      "text": "美味しいディナーを家で"
    },
    {
      "startSec": 531.1,
      "text": "料理しようと思います。"
    },
    {
      "startSec": 534.6,
      "text": "とても楽しみです！"
    },
    {
      "startSec": 537.5,
      "text": "そうね、だからこんな感じかな？"
    },
    {
      "startSec": 540.8,
      "text": "まあ日本のクリスマスで"
    },
    {
      "startSec": 543.3,
      "text": "実は休みの日じゃないです。"
    },
    {
      "startSec": 547.9,
      "text": "これも、もしかしてみんな、びっくりすると思うけど"
    },
    {
      "startSec": 554.5,
      "text": "日本はクリスマスが、平日。平日は普通の"
    },
    {
      "startSec": 562.2,
      "text": "月曜日から金曜日までの日。"
    },
    {
      "startSec": 566.8,
      "text": "クリスマスが平日だったら仕事や学校はあります！！"
    },
    {
      "startSec": 575.9,
      "text": "そうそうそう。"
    },
    {
      "startSec": 578.9,
      "text": "確か、今年のクリスマス、24日"
    },
    {
      "startSec": 585.1,
      "text": "24日は金曜日だと思います。"
    },
    {
      "startSec": 588.5,
      "text": "たぶんね、ちょっと調べよう...."
    },
    {
      "startSec": 591.7,
      "text": "今年の24日、金曜日です。"
    },
    {
      "startSec": 594.5,
      "text": "金曜日は普通に"
    },
    {
      "startSec": 597.7,
      "text": "普通にみんな学校も仕事もあります。"
    },
    {
      "startSec": 603.4,
      "text": "でも25日が土曜日だから"
    },
    {
      "startSec": 608.1,
      "text": "25日はみんな休みだと思います。"
    },
    {
      "startSec": 613,
      "text": "はい日本は前ね"
    },
    {
      "startSec": 615,
      "text": "クリスマスは休みの日じゃないです。これはね"
    },
    {
      "startSec": 619.4,
      "text": "ちょっとがっかりですよね。"
    },
    {
      "startSec": 623.1,
      "text": "ちょっとがっかりかな。"
    },
    {
      "startSec": 625.9,
      "text": "休みになったらいいですね。"
    },
    {
      "startSec": 628.1,
      "text": "でも日本はクリスマスよりもみんなお正月"
    },
    {
      "startSec": 635.9,
      "text": "お正月の方が大きなイベントだから、"
    },
    {
      "startSec": 642.9,
      "text": "お正月はしっかり休みがあります。"
    },
    {
      "startSec": 647,
      "text": "多分12月の28日くらいから"
    },
    {
      "startSec": 651.7,
      "text": "1月の4日までくらい、１週間ですね"
    },
    {
      "startSec": 659.7,
      "text": "１週間へお正月の、お正月に"
    },
    {
      "startSec": 664.5,
      "text": "休みがあります。"
    },
    {
      "startSec": 667.1,
      "text": "またね、お正月の話とか色々したいな"
    },
    {
      "startSec": 670.2,
      "text": "と思っているんですが"
    },
    {
      "startSec": 672.3,
      "text": "今日はもうたくさん話したので"
    },
    {
      "startSec": 674.9,
      "text": "そろそろ終わりますね。"
    },
    {
      "startSec": 678.6,
      "text": "クリスマスの思い出というタイトル"
    },
    {
      "startSec": 682.4,
      "text": "テーマ、タイトルだけどね"
    },
    {
      "startSec": 686.9,
      "text": "あんまり私は思い出がなくてすいません。"
    },
    {
      "startSec": 692.1,
      "text": "これからはもっと"
    },
    {
      "startSec": 693.9,
      "text": "クリスマスが好きになると思います！"
    },
    {
      "startSec": 701,
      "text": "今日はこんな感じです！"
    },
    {
      "startSec": 703.3,
      "text": "このpodcastにはvideoもあります"
    },
    {
      "startSec": 708.9,
      "text": "もし、字幕、サブタイトルが読みたい人"
    },
    {
      "startSec": 715,
      "text": "私のyoutubeのビデオも見て、"
    },
    {
      "startSec": 718.3,
      "text": "サブタイトル、字幕、を呼んで下さい"
    },
    {
      "startSec": 722.8,
      "text": "皆さんのリスニングの練習になったら"
    },
    {
      "startSec": 726.7,
      "text": "すごく嬉しいです！"
    },
    {
      "startSec": 730.2,
      "text": "じゃあ今日こんな感じです"
    },
    {
      "startSec": 732.3,
      "text": "最後まで聞いてくれてありがとうございます。"
    },
    {
      "startSec": 735.8,
      "text": "皆さん良い一日を！皆さんも冬休み"
    },
    {
      "startSec": 740.6,
      "text": "冬休み楽しんでください！"
    },
    {
      "startSec": 744.8,
      "text": "じゃあまたねバイバイ！！"
    }
  ]
}
