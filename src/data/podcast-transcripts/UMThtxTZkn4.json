{
  "episodeId": "UMThtxTZkn4",
  "segments": [
    {
      "startSec": 0,
      "text": "はい、みなさんこんにちは。"
    },
    {
      "startSec": 2.1,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.7,
      "text": "今日は「よろしくお願いします」の"
    },
    {
      "startSec": 10,
      "text": "5つの使い方を、みなさんに紹介したいと思います。"
    },
    {
      "startSec": 16.6,
      "text": "「よろしくお願いします」"
    },
    {
      "startSec": 18.8,
      "text": "これは自己紹介(じこしょうかい)の時、"
    },
    {
      "startSec": 21.6,
      "text": "Self-introductionの時に使いますよね。"
    },
    {
      "startSec": 25.1,
      "text": "多分、みなさんが日本語の勉強始めた時に"
    },
    {
      "startSec": 31.3,
      "text": "勉強した言葉だと、フレーズだと思います。"
    },
    {
      "startSec": 36,
      "text": "でも「よろしくお願いします」"
    },
    {
      "startSec": 39.1,
      "text": "このフレーズってすっごく便利で"
    },
    {
      "startSec": 43.2,
      "text": "色んな場面(ばめん)、色んなシーンで使うことができます。"
    },
    {
      "startSec": 49.5,
      "text": "はい、自己紹介のときだけじゃないです。"
    },
    {
      "startSec": 53.2,
      "text": "なので今日は「よろしくお願いします」「よろしく」を使う"
    },
    {
      "startSec": 59.3,
      "text": "5つの場面・シチュエーションを"
    },
    {
      "startSec": 62.6,
      "text": "みなさんに教えたいと思います。"
    },
    {
      "startSec": 65.4,
      "text": "はい、最近ポッドキャストのPatreonも始めました。"
    },
    {
      "startSec": 70.9,
      "text": "今までの、そしてこれからのトランスクリプトとか"
    },
    {
      "startSec": 76.6,
      "text": "まあとても便利な日本語のコラムとか"
    },
    {
      "startSec": 81.1,
      "text": "ネイティブがよく使うフレーズのエピソードなどなど"
    },
    {
      "startSec": 87,
      "text": "みなさんとシェアしたいと思っています。"
    },
    {
      "startSec": 91.1,
      "text": "興味がある人は"
    },
    {
      "startSec": 92.9,
      "text": "ぜひリンクからチェックしてください。"
    },
    {
      "startSec": 96.3,
      "text": "はい、じゃ早速始めましょう！"
    },
    {
      "startSec": 100.9,
      "text": "はい、じゃあ「よろしくお願いします」の"
    },
    {
      "startSec": 104.5,
      "text": "よく使うシチュエーション1つ目。"
    },
    {
      "startSec": 107.7,
      "text": "これは自己紹介のときですね。"
    },
    {
      "startSec": 111.7,
      "text": "例えば「初めまして、井本です。よろしくお願いします」"
    },
    {
      "startSec": 118.7,
      "text": "これは自己紹介のテンプレート"
    },
    {
      "startSec": 122.1,
      "text": "よく使うセットのフレーズですね。"
    },
    {
      "startSec": 125.8,
      "text": "私の名字(みょうじ=family name)は井本です。"
    },
    {
      "startSec": 132.7,
      "text": "はい、なので「井本です」と言いました。"
    },
    {
      "startSec": 136.4,
      "text": "で「よろしくお願いします」は"
    },
    {
      "startSec": 138.9,
      "text": "自己紹介の最後によく使います。"
    },
    {
      "startSec": 144.3,
      "text": "で、2つ目のシチュエーション。"
    },
    {
      "startSec": 147.9,
      "text": "これは、他の人に何かお願いする時"
    },
    {
      "startSec": 154,
      "text": "何かをお願いする時に使います。"
    },
    {
      "startSec": 158.2,
      "text": "まあ例えば、えっと…友達に"
    },
    {
      "startSec": 164,
      "text": "「ちょっとごめん、これのコピー作ってくれる？」って言う時に"
    },
    {
      "startSec": 171.6,
      "text": "「このコピー作ってくれる？よろしく」みたいに"
    },
    {
      "startSec": 176.8,
      "text": "えっと、友達とか他の人に"
    },
    {
      "startSec": 179.7,
      "text": "何かをお願いする時に使います。"
    },
    {
      "startSec": 183.5,
      "text": "うん、これもね、本当によく使いますね。"
    },
    {
      "startSec": 187.7,
      "text": "あの私も、YouTubeとかのビデオを作る時に"
    },
    {
      "startSec": 193.9,
      "text": "英語の台本"
    },
    {
      "startSec": 196.1,
      "text": "台本(だいほん=transcript)を作ります。"
    },
    {
      "startSec": 201.1,
      "text": "その時に彼氏に"
    },
    {
      "startSec": 204,
      "text": "「ごめん、英語のトランスクリプト、チェックしてくれる？」"
    },
    {
      "startSec": 207.7,
      "text": "「よろしく、ありがとう」みたいにお願いします。"
    },
    {
      "startSec": 212.8,
      "text": "はい、人にお願いする時に使います。"
    },
    {
      "startSec": 216.2,
      "text": "はい、とてもね、優しい便利なフレーズです。"
    },
    {
      "startSec": 220,
      "text": "ぜひ使ってください。"
    },
    {
      "startSec": 222.3,
      "text": "で、シチュエーション3つ目。"
    },
    {
      "startSec": 225.8,
      "text": "これは、会議とかプレゼンテーションを始める時に使います。"
    },
    {
      "startSec": 234.3,
      "text": "はい、例えば私が、じゃあ今から"
    },
    {
      "startSec": 240,
      "text": "プレゼンテーションを始めるなら、こんな感じ。"
    },
    {
      "startSec": 246,
      "text": "「みなさん、おはようございます」"
    },
    {
      "startSec": 248.1,
      "text": "「では本日、今日プレゼンテーションをします井本と申します」"
    },
    {
      "startSec": 255.4,
      "text": "「よろしくお願いします」"
    },
    {
      "startSec": 257.6,
      "text": "みたいな感じでプレゼンテーションを始めます。"
    },
    {
      "startSec": 263.7,
      "text": "とか、会議(かいぎ=meeting)を、"
    },
    {
      "startSec": 266.8,
      "text": "会議を始める時は、"
    },
    {
      "startSec": 269.6,
      "text": "「みなさん、おはようございます」"
    },
    {
      "startSec": 272.1,
      "text": "「今から会議を始めます。よろしくお願いします」"
    },
    {
      "startSec": 276.9,
      "text": "と言って会議を始めます。"
    },
    {
      "startSec": 280.1,
      "text": "これもね、会社ではよく使いますね。"
    },
    {
      "startSec": 287.2,
      "text": "「よろしくお願いします」のシチュエーション4つ目。"
    },
    {
      "startSec": 290.7,
      "text": "まあこれは、えっと、英語だと"
    },
    {
      "startSec": 294.3,
      "text": "\"Please say hello to someone\"と言いたい時によく使うかな。"
    },
    {
      "startSec": 301.4,
      "text": "例えば、私はおばあちゃんによく電話します。"
    },
    {
      "startSec": 307.7,
      "text": "で、その時に「あ、おばあちゃん、おじいちゃんによろしくね」"
    },
    {
      "startSec": 314.8,
      "text": "\"Please say hello to my granddad\"みたいに使います。"
    },
    {
      "startSec": 320.2,
      "text": "「Someoneによろしくね」"
    },
    {
      "startSec": 323.5,
      "text": "「Someoneによろしくお伝えください」"
    },
    {
      "startSec": 328.1,
      "text": "これ「お伝えください」は、丁寧(ていねい=polite)な言い方で"
    },
    {
      "startSec": 332.9,
      "text": "「よろしくね」はカジュアルな感じですね。"
    },
    {
      "startSec": 337.3,
      "text": "これもよく使います。"
    },
    {
      "startSec": 341.3,
      "text": "で、最後「よろしくお願いします」の"
    },
    {
      "startSec": 344.1,
      "text": "シチュエーション最後5つ目。"
    },
    {
      "startSec": 346.9,
      "text": "これは、えっと、手紙とかメールの後、最後によく使います。"
    },
    {
      "startSec": 356.1,
      "text": "例えばえっと、私はこのポッドキャストも"
    },
    {
      "startSec": 360.5,
      "text": "えっと、編集者(へんしゅうしゃ=editor)さんにね"
    },
    {
      "startSec": 364.7,
      "text": "字幕(じまく)を作るのをお願いしています。"
    },
    {
      "startSec": 368.3,
      "text": "その時に「今月のポッドキャストの動画ファイルを送ります」"
    },
    {
      "startSec": 374.1,
      "text": "「よろしくお願いします。井本」"
    },
    {
      "startSec": 377.3,
      "text": "みたいにメッセージ・メールの最後に書きます。"
    },
    {
      "startSec": 382.1,
      "text": "これも、多分ほとんどのメールで"
    },
    {
      "startSec": 385.8,
      "text": "「よろしくお願いします」を"
    },
    {
      "startSec": 387.7,
      "text": "私は書いていると思います。"
    },
    {
      "startSec": 390.8,
      "text": "もう本当によく使うフレーズです。"
    },
    {
      "startSec": 394.2,
      "text": "ぜひ使ってみてください。"
    },
    {
      "startSec": 396.1,
      "text": "はい、じゃ今日のエピソードはここまでです。"
    },
    {
      "startSec": 400.4,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 402.6,
      "text": "日本語の勉強がんばってください。"
    },
    {
      "startSec": 405,
      "text": "じゃあね、バイバイ！いい一日を！"
    }
  ]
}
