      "text": "で、今私の話したことだけじゃなくて"
    },
    {
      "startSec": 930.1,
      "text": "他にもたくさん色んなイベントとか"
    },
    {
      "startSec": 934.9,
      "text": "お料理とか色々お正月にはあります。"
    },
    {
      "startSec": 940,
      "text": "またねl、これからも"
    },
    {
      "startSec": 942.3,
      "text": "そういう話をポッドキャストでしたいと思います。"
    },
    {
      "startSec": 947,
      "text": "はい、今日はいつもより少し長く話したので"
    },
    {
      "startSec": 952.1,
      "text": "えそろそろ終わりにします。"
    },
    {
      "startSec": 955.6,
      "text": "えっとね"
    },
    {
      "startSec": 957.5,
      "text": "私のリスナーさんの中には"
    },
    {
      "startSec": 960.6,
      "text": "ユーチューブに"
    },
    {
      "startSec": 961.8,
      "text": "とても優しいコメントを書いてくれた人が"
    },
    {
      "startSec": 967.1,
      "text": "たくさんいます。本当にありがとうございます"
    },
    {
      "startSec": 972.3,
      "text": "正直、ポッドキャストのコメントが"
    },
    {
      "startSec": 977.4,
      "text": "もう一番嬉しいです！"
    },
    {
      "startSec": 980.1,
      "text": "インスタグラムの動画のコメントよりも"
    },
    {
      "startSec": 984.9,
      "text": "ポッドキャストのコメントの方が本当に嬉しい！"
    },
    {
      "startSec": 989.4,
      "text": "ポッドキャストは本当に私は"
    },
    {
      "startSec": 993.1,
      "text": "自分の、自分を隠さないで"
    },
    {
      "startSec": 999.6,
      "text": "自分を隠さないで話しているので"
    },
    {
      "startSec": 1004.9,
      "text": "もう本当に皆さんの優しい言葉が"
    },
    {
      "startSec": 1009.6,
      "text": "うれしいです！ありがとうございます"
    },
    {
      "startSec": 1013,
      "text": "もしアドバイスとかリクエストあったら"
    },
    {
      "startSec": 1018,
      "text": "コメントに書いてください"
    },
    {
      "startSec": 1020.5,
      "text": "はい今日はこんな感じです！"
    },
    {
      "startSec": 1023.3,
      "text": "じゃあ皆さん、良いお年を！"
    },
    {
      "startSec": 1027,
      "text": "素敵なお正月過ごしてください。"
    },
    {
      "startSec": 1030.7,
      "text": "最後まで聞いてくれてありがとうございます！"
    },
    {
      "startSec": 1034.4,
      "text": "じゃあ良いおとしを！ バイバイ"
    }
  ]
}
