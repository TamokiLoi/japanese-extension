{
  "episodeId": "rGFkX_PzWa4",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.5,
      "text": "BITE SIZE JAPANESEのレイラです。"
    },
    {
      "startSec": 3.1,
      "text": "元気ですか？"
    },
    {
      "startSec": 4.5,
      "text": "はい、今日はね"
    },
    {
      "startSec": 6.2,
      "text": "日本人の2つのタイプについて話したいと思います。"
    },
    {
      "startSec": 13.3,
      "text": "この2つのタイプは、外国の人にどうやって話すか"
    },
    {
      "startSec": 18.9,
      "text": "外国の人に話す時の"
    },
    {
      "startSec": 21.8,
      "text": "2つのタイプという意味です。"
    },
    {
      "startSec": 26.1,
      "text": "今私は彼氏のジャックさんと"
    },
    {
      "startSec": 30.9,
      "text": "一緒に暮らしているので"
    },
    {
      "startSec": 33.9,
      "text": "彼に他の日本人の話をよく聞きます。"
    },
    {
      "startSec": 40.3,
      "text": "で、やっぱり日本人には2つね"
    },
    {
      "startSec": 44.7,
      "text": "タイプがあるなぁと思うようになりました。"
    },
    {
      "startSec": 50.7,
      "text": "1つのタイプは外国の人に"
    },
    {
      "startSec": 55.3,
      "text": "全部英語で話すタイプです。"
    },
    {
      "startSec": 60.4,
      "text": "まあその理由は、英語を勉強したい理由もあるし"
    },
    {
      "startSec": 66.9,
      "text": "または外国の人に迷惑をかけたくない、"
    },
    {
      "startSec": 74.4,
      "text": "日本語で話したら、申し訳ないから英語で話す"
    },
    {
      "startSec": 81.5,
      "text": "こういう理由もあります。"
    },
    {
      "startSec": 85.2,
      "text": "でもう1つの、2つ目のタイプは"
    },
    {
      "startSec": 90.8,
      "text": "全部普通の日本語で話すタイプです。"
    },
    {
      "startSec": 96.9,
      "text": "あの相手、外国の人が"
    },
    {
      "startSec": 99.5,
      "text": "その日本語を理解してるか、分かっているかとか"
    },
    {
      "startSec": 103.9,
      "text": "全然もう関係なく、もう方言とか敬語とかも"
    },
    {
      "startSec": 110.7,
      "text": "全部入れて話すタイプです。"
    },
    {
      "startSec": 114.8,
      "text": "これはね、おじいちゃんに多いかも。"
    },
    {
      "startSec": 118.3,
      "text": "うん、ちょっとお年寄りの(older or elderly people)"
    },
    {
      "startSec": 125,
      "text": "お年寄りのおじいちゃんに多いと思います。"
    },
    {
      "startSec": 130.3,
      "text": "で、英語で話すタイプには、若い人が多いかな。"
    },
    {
      "startSec": 138.5,
      "text": "私も、私はよくジャックさんと散歩"
    },
    {
      "startSec": 144.4,
      "text": "毎日散歩をしています。"
    },
    {
      "startSec": 147.3,
      "text": "その時に、時々ジャックに"
    },
    {
      "startSec": 151.8,
      "text": "もう日本語でめっちゃ話してくるおじいちゃんがいます。"
    },
    {
      "startSec": 158.9,
      "text": "もうめっちゃ「うわ～どこから来たんや」"
    },
    {
      "startSec": 161.5,
      "text": "「ああそうか、お前どこに住んでるんや」"
    },
    {
      "startSec": 164.2,
      "text": "みたいな感じでなんか方言ね。"
    },
    {
      "startSec": 168.3,
      "text": "ここは岡山県なので"
    },
    {
      "startSec": 170.3,
      "text": "岡山弁でめっちゃ早く、フレンドリーに"
    },
    {
      "startSec": 174.9,
      "text": "話しかけてくるおじいちゃんがいます。"
    },
    {
      "startSec": 179.1,
      "text": "でね、もちろんジャックは何も分からないから"
    },
    {
      "startSec": 186.2,
      "text": "「あっはい、そうです、はいはい、そうです」だけで"
    },
    {
      "startSec": 193.4,
      "text": "返事をしていました。"
    },
    {
      "startSec": 195.8,
      "text": "返事をする(to respond)"
    },
    {
      "startSec": 199.3,
      "text": "もう「はい、そうです」だけね。"
    },
    {
      "startSec": 201.8,
      "text": "もうおじいちゃんが"
    },
    {
      "startSec": 203.2,
      "text": "何言ってるか分からないからね。"
    },
    {
      "startSec": 207,
      "text": "だから時々めっちゃフレンドリーで"
    },
    {
      "startSec": 210.9,
      "text": "日本語で話しかけてくる人は時々います。"
    },
    {
      "startSec": 217.2,
      "text": "まあでもね、やっぱり何か日本人は"
    },
    {
      "startSec": 222.6,
      "text": "やっぱりシャイな人が多いし"
    },
    {
      "startSec": 226.2,
      "text": "英語が全然できない人の方が多いので"
    },
    {
      "startSec": 231.7,
      "text": "まああんまり外国の人に話しかける人、"
    },
    {
      "startSec": 236.3,
      "text": "自分から外国の人に話す人は"
    },
    {
      "startSec": 240,
      "text": "あんまりいないです。"
    },
    {
      "startSec": 246.6,
      "text": "よく私はジャックが働いている学校の話を聞きます。"
    },
    {
      "startSec": 254.4,
      "text": "ジャックはALT、英語の先生で"
    },
    {
      "startSec": 258.3,
      "text": "JETプログラムで日本に来たんですが"
    },
    {
      "startSec": 262,
      "text": "ジャックは英語の先生で"
    },
    {
      "startSec": 264.5,
      "text": "その学校に外国の先生はジャックさんだけです。"
    },
    {
      "startSec": 269.9,
      "text": "他はみんな日本人。"
    },
    {
      "startSec": 273.5,
      "text": "でも他の日本の先生は"
    },
    {
      "startSec": 277.4,
      "text": "ジャックに多分ちょっと緊張して"
    },
    {
      "startSec": 280.6,
      "text": "全然話しかけないです。"
    },
    {
      "startSec": 284.1,
      "text": "全然ジャックに話さないですね。"
    },
    {
      "startSec": 288.1,
      "text": "やっぱりそれはちょっと、私は話を聞いて"
    },
    {
      "startSec": 293.5,
      "text": "悲しいなと思います。"
    },
    {
      "startSec": 295.6,
      "text": "やっぱり、ジャックは一人だけ外国人で"
    },
    {
      "startSec": 300.4,
      "text": "日本に住んでいて"
    },
    {
      "startSec": 302.6,
      "text": "今まだ友達もいないし"
    },
    {
      "startSec": 305.6,
      "text": "すごく仕事も緊張すると思います。"
    },
    {
      "startSec": 309.9,
      "text": "うん、だから他の日本の先生には"
    },
    {
      "startSec": 314,
      "text": "ジャックに優しくしてほしいし"
    },
    {
      "startSec": 317.8,
      "text": "たくさん話しかけてほしいです。"
    },
    {
      "startSec": 321.5,
      "text": "でも多分他の先生ね、日本人は緊張して"
    },
    {
      "startSec": 327.3,
      "text": "ジャックにあいさつとかも"
    },
    {
      "startSec": 329.5,
      "text": "あんまりしてないみたいですね。"
    },
    {
      "startSec": 333.3,
      "text": "うん、これは私はちょっとショックで"
    },
    {
      "startSec": 336.5,
      "text": "もうちょっと…う～ん、ね…"
    },
    {
      "startSec": 341.2,
      "text": "どうしたらいいか分からないけど"
    },
    {
      "startSec": 343.6,
      "text": "私は本当にそれは、ちょっと悲しいし辛いです。"
    },
    {
      "startSec": 350.4,
      "text": "まあでもね、それはジャックのことが嫌いだから"
    },
    {
      "startSec": 354.6,
      "text": "話しかけないんじゃなくて"
    },
    {
      "startSec": 356.2,
      "text": "もちろん「英語できるか分からない」"
    },
    {
      "startSec": 358.8,
      "text": "「ヤバイ、どうしよう」とか"
    },
    {
      "startSec": 361,
      "text": "いろいろ多分考えているから"
    },
    {
      "startSec": 363.3,
      "text": "緊張して話せないと思います。"
    },
    {
      "startSec": 368,
      "text": "今日は日本人のこういう話を色々しましたが"
    },
    {
      "startSec": 372.8,
      "text": "もし皆さんの意見とか、昔の経験とかね"
    },
    {
      "startSec": 377.8,
      "text": "色々話があったら"
    },
    {
      "startSec": 380.1,
      "text": "コメントでシェアしてくれるとうれしいです。"
    },
    {
      "startSec": 384.1,
      "text": "ありがとうございます、今日も最後まで…"
    },
    {
      "startSec": 386.9,
      "text": "もし良かったら、レビューも書いてくれたら"
    },
    {
      "startSec": 390.7,
      "text": "今度ポッドキャストで"
    },
    {
      "startSec": 392.5,
      "text": "皆さんのレビューも読みたいと思います。"
    },
    {
      "startSec": 396,
      "text": "いつもありがとうございます。"
    },
    {
      "startSec": 398.1,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 400.9,
      "text": "お仕事・勉強頑張ってください。"
    },
    {
      "startSec": 403.7,
      "text": "じゃまたね！バイバイ！"
    }
  ]
}
