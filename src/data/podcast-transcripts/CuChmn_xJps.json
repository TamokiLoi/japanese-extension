{
  "episodeId": "CuChmn_xJps",
  "segments": [
    {
      "startSec": 0.4,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 1.9,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 4.6,
      "text": "皆さんは、皆さんが友達をパーティーに誘った時"
    },
    {
      "startSec": 11.6,
      "text": "その友達が「あ、行けた行く」って言ったら"
    },
    {
      "startSec": 18.5,
      "text": "どう思いますか？"
    },
    {
      "startSec": 20.8,
      "text": "その友達はパーティーに来ると思いますか？"
    },
    {
      "startSec": 26.3,
      "text": "私は関西、京都出身ですが"
    },
    {
      "startSec": 31.7,
      "text": "私が住んでいた場所では"
    },
    {
      "startSec": 35.6,
      "text": "「行けたら行く」は「多分行かない」"
    },
    {
      "startSec": 40.9,
      "text": "という意味だと、ずっと思っていました。"
    },
    {
      "startSec": 45.3,
      "text": "だから友達に「あ、明日家来る？」って聞いて"
    },
    {
      "startSec": 51.7,
      "text": "友達が「あ、行けたら行く」って言ったら"
    },
    {
      "startSec": 57.7,
      "text": "「あ、じゃあ多分来ないなぁ」って感じでね。"
    },
    {
      "startSec": 62.6,
      "text": "で、この前おばあちゃんの家のテレビで"
    },
    {
      "startSec": 66.8,
      "text": "この「行けたら行く」について"
    },
    {
      "startSec": 69.9,
      "text": "すごく面白いリサーチを紹介していたので"
    },
    {
      "startSec": 75.2,
      "text": "ちょっとそれを皆さんにシェアしたいと思います。"
    },
    {
      "startSec": 80.7,
      "text": "私はずっと「行けたら行く」は"
    },
    {
      "startSec": 83.4,
      "text": "「多分行かない」という意味だと思っていました。"
    },
    {
      "startSec": 88.3,
      "text": "でもこれは日本のエリア、場所によるらしいです。"
    },
    {
      "startSec": 97.2,
      "text": "そのテレビが言っていたことは"
    },
    {
      "startSec": 100.8,
      "text": "関西、ここら辺、大阪・京都。"
    },
    {
      "startSec": 103.9,
      "text": "関西は七十パーセントくらいの人が"
    },
    {
      "startSec": 109.2,
      "text": "「行けたら行く」は「行かない、多分行かない」"
    },
    {
      "startSec": 114,
      "text": "という意味だと思っているそうです。"
    },
    {
      "startSec": 119.5,
      "text": "でも関東、東京では"
    },
    {
      "startSec": 122.7,
      "text": "この「行けたら行く」を聞いたら"
    },
    {
      "startSec": 126.7,
      "text": "「あ、じゃあ多分来るんだな」「多分行くな」"
    },
    {
      "startSec": 130.9,
      "text": "そういう意味で考えるそうです。"
    },
    {
      "startSec": 134,
      "text": "面白いですよね。"
    },
    {
      "startSec": 135.2,
      "text": "「行けたら行く」"
    },
    {
      "startSec": 136.8,
      "text": "これは関西では「あ、多分行かないな」"
    },
    {
      "startSec": 142,
      "text": "東京では「あ、じゃあ多分来るな」"
    },
    {
      "startSec": 147.2,
      "text": "全然意味が違いますよね。"
    },
    {
      "startSec": 150.5,
      "text": "これ私すごくびっくりして、面白いなと思いました。"
    },
    {
      "startSec": 157,
      "text": "で、そのテレビは理由を説明していて"
    },
    {
      "startSec": 163,
      "text": "それが「あ、なるほど！」と思ったんです。"
    },
    {
      "startSec": 169.2,
      "text": "そのテレビが言っていたことは"
    },
    {
      "startSec": 172.5,
      "text": "東京、関東は人が色んな場所から来ます。"
    },
    {
      "startSec": 179.9,
      "text": "東京は一番人口(population)、人が多い場所です。"
    },
    {
      "startSec": 186.1,
      "text": "色んな場所から人が来ます。"
    },
    {
      "startSec": 189.6,
      "text": "でも関西では結構、人があまり動かない。"
    },
    {
      "startSec": 196.3,
      "text": "関西で生まれて、関西にずっと住んでいる人が"
    },
    {
      "startSec": 202.2,
      "text": "東京よりも多いらしいです。"
    },
    {
      "startSec": 206.4,
      "text": "だから東京では「行けたら行く」この意味を"
    },
    {
      "startSec": 212,
      "text": "そのまま「あ、じゃ行けたら行くんだ」って"
    },
    {
      "startSec": 215.9,
      "text": "深い意味を考えないで、そのまま理解する。"
    },
    {
      "startSec": 221.3,
      "text": "これが普通だそうです。"
    },
    {
      "startSec": 224.5,
      "text": "でも関西、特に京都とか古い町では"
    },
    {
      "startSec": 229.3,
      "text": "その言葉の深い意味を考えるそうです。"
    },
    {
      "startSec": 235.8,
      "text": "だから例えば、京都では"
    },
    {
      "startSec": 239.2,
      "text": "京都のお母さん達が"
    },
    {
      "startSec": 241.2,
      "text": "「まあ、あなたの子供さんは元気でいいですね」"
    },
    {
      "startSec": 245.8,
      "text": "って言ったら、もう一人のお母さんは"
    },
    {
      "startSec": 250.3,
      "text": "「あ、私の子供ちょっとうるさかったかな。"
    },
    {
      "startSec": 255,
      "text": "元気すぎたかな」みたいに"
    },
    {
      "startSec": 257.8,
      "text": "ほめ言葉の中の、深い意味を考えるそうです。"
    },
    {
      "startSec": 266.7,
      "text": "すごく面白いなと思って"
    },
    {
      "startSec": 269.3,
      "text": "今日は皆さんにシェアしました。"
    },
    {
      "startSec": 274.6,
      "text": "言葉って面白いですね。"
    },
    {
      "startSec": 276.8,
      "text": "良かったら感想を"
    },
    {
      "startSec": 278.4,
      "text": "YouTubeのコメントで教えてください。"
    },
    {
      "startSec": 281.4,
      "text": "そしてこのポッドキャストが気に入ったら"
    },
    {
      "startSec": 284.7,
      "text": "レビューを書いてくれると、とても嬉しいです。"
    },
    {
      "startSec": 288.8,
      "text": "皆さんの優しいレビューのおかげで"
    },
    {
      "startSec": 292.9,
      "text": "もっと成長することができます。"
    },
    {
      "startSec": 296.3,
      "text": "優しいレビューを書いてくれたら"
    },
    {
      "startSec": 299.3,
      "text": "ぜひポッドキャストで紹介したいと思います。"
    },
    {
      "startSec": 304.6,
      "text": "是非宜しくお願いします。"
    },
    {
      "startSec": 306.9,
      "text": "じゃあいつもありがとう。"
    },
    {
      "startSec": 309,
      "text": "良い一日を！バイバイ！"
    }
  ]
}
