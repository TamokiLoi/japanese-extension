{
  "episodeId": "ia9zkar_mXY",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2.3,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.1,
      "text": "今日は食事のマナーについて話したいと思います。"
    },
    {
      "startSec": 11.8,
      "text": "私はあまりマナーとかルールは気にしないタイプです。"
    },
    {
      "startSec": 19.7,
      "text": "あまり気にしたくないし。"
    },
    {
      "startSec": 21.9,
      "text": "もちろん、そのルールが他の人に迷惑をかけたりとか"
    },
    {
      "startSec": 28.3,
      "text": "自然、環境を悪くしたりとか"
    },
    {
      "startSec": 33,
      "text": "そういうことは絶対にダメだと思いますが"
    },
    {
      "startSec": 38.9,
      "text": "小さな事とかは本当に全然気にしないタイプです。"
    },
    {
      "startSec": 45.4,
      "text": "食べ物も全然何でも手で食べるし、"
    },
    {
      "startSec": 49.2,
      "text": "水がこぼれても私はふかないし、"
    },
    {
      "startSec": 53.8,
      "text": "ティッシュはごみ箱に入れないし、"
    },
    {
      "startSec": 56.7,
      "text": "結構汚い人間なんですけど"
    },
    {
      "startSec": 60.6,
      "text": "でも本当に食事、食べ物については"
    },
    {
      "startSec": 67.1,
      "text": "すごく気にしますね、本当に。"
    },
    {
      "startSec": 71.8,
      "text": "これは日本人だからか、私の家族の影響か"
    },
    {
      "startSec": 79.3,
      "text": "わからないですけど、本当によく気にします。"
    },
    {
      "startSec": 88.5,
      "text": "ジャックのJETのメンバーが聞いていたら"
    },
    {
      "startSec": 91.4,
      "text": "本当に申し訳ないんですけど"
    },
    {
      "startSec": 94.3,
      "text": "この前、ジャックのJETメンバーの友達が"
    },
    {
      "startSec": 100.5,
      "text": "パーティーみたいな感じで家に来たんですね。"
    },
    {
      "startSec": 105.7,
      "text": "で、その時にちょっとびっくりしてしまったことがあって。"
    },
    {
      "startSec": 112.7,
      "text": "それは私とジャックで手巻き寿司を"
    },
    {
      "startSec": 118.3,
      "text": "たくさんみんなのために"
    },
    {
      "startSec": 120.7,
      "text": "いっぱい作って用意したんですけど"
    },
    {
      "startSec": 125.2,
      "text": "そのジャックの友達は"
    },
    {
      "startSec": 128,
      "text": "全然食べてくれなかったんですよね。"
    },
    {
      "startSec": 132.1,
      "text": "本当に何にも食べないで"
    },
    {
      "startSec": 135.8,
      "text": "多分、私達たくさん作った料理の"
    },
    {
      "startSec": 140,
      "text": "80パーセントぐらいが残ってしまいました。"
    },
    {
      "startSec": 148.4,
      "text": "ちょっとそれが私はびっくりして悲しくて。"
    },
    {
      "startSec": 154,
      "text": "もちろんそのパーティーの前に"
    },
    {
      "startSec": 156.8,
      "text": "今回はお寿司を作るので"
    },
    {
      "startSec": 160.8,
      "text": "夜ご飯は良かったら食べないで来てくださいって"
    },
    {
      "startSec": 166.4,
      "text": "メールはしたんですけど"
    },
    {
      "startSec": 171.7,
      "text": "なんでその人達が食べなかったのかは"
    },
    {
      "startSec": 175.3,
      "text": "ちょっとよくわかりません。"
    },
    {
      "startSec": 177.9,
      "text": "もしかして、魚や野菜が結構多かったので"
    },
    {
      "startSec": 183.9,
      "text": "野菜とか魚が好きじゃなかったら"
    },
    {
      "startSec": 187.4,
      "text": "お寿司、食べたくないですよね。"
    },
    {
      "startSec": 190.6,
      "text": "だから好き嫌いの問題かもしれませんし"
    },
    {
      "startSec": 199,
      "text": "もしかしたら気まずかった？"
    },
    {
      "startSec": 202.1,
      "text": "本当はなんかその人達はもしかして"
    },
    {
      "startSec": 205.3,
      "text": "おしゃべりのためだけに来たかもしれないけど"
    },
    {
      "startSec": 209.5,
      "text": "私とジャックが、料理をちょっと頑張り過ぎたから"
    },
    {
      "startSec": 214.7,
      "text": "何か「あ、いやっ、ちょっとその…」みたいな"
    },
    {
      "startSec": 218.8,
      "text": "なんかちょっと気まずかったのかなとか"
    },
    {
      "startSec": 222.7,
      "text": "色々考えたんですけど。"
    },
    {
      "startSec": 225.5,
      "text": "日本人って結構好き嫌いは"
    },
    {
      "startSec": 230.1,
      "text": "良くないことって考えるんですよね。"
    },
    {
      "startSec": 235,
      "text": "学校のご飯＝給食は、私が小学生の時は"
    },
    {
      "startSec": 242.3,
      "text": "残したらめっちゃ怒られました。"
    },
    {
      "startSec": 246.7,
      "text": "「絶対に残さないで」って言われて"
    },
    {
      "startSec": 250.7,
      "text": "私の小学校は給食の時間の後が、昼休み＝遊びの時間。"
    },
    {
      "startSec": 257.6,
      "text": "で、その後が掃除の時間だったんですけど"
    },
    {
      "startSec": 261.8,
      "text": "私はトマトが大嫌いで、トマトがどうしても、"
    },
    {
      "startSec": 267.1,
      "text": "給食のトマトが食べられなくて。"
    },
    {
      "startSec": 271.2,
      "text": "そしたら先生に"
    },
    {
      "startSec": 273,
      "text": "「食べるまで椅子に座っていなさい」って言われて"
    },
    {
      "startSec": 278.8,
      "text": "だから昼休みの時間も、掃除の時間も"
    },
    {
      "startSec": 283.4,
      "text": "みんなが遊んだり、掃除をしてる時間も"
    },
    {
      "startSec": 287.1,
      "text": "ずっと机に座って、一人で食べていました。"
    },
    {
      "startSec": 292.9,
      "text": "で、これは私はちょっとやり過ぎだと思います。"
    },
    {
      "startSec": 298,
      "text": "そんなに子供が「ウェッ」って吐いたりとか"
    },
    {
      "startSec": 302.5,
      "text": "泣いたりとかしてるのに、"
    },
    {
      "startSec": 304.5,
      "text": "「食べなさい、一人で食べなさい」"
    },
    {
      "startSec": 306.9,
      "text": "これはちょっとやり過ぎだと思います。"
    },
    {
      "startSec": 311.2,
      "text": "でも野菜が全然食べれないとか"
    },
    {
      "startSec": 317.3,
      "text": "それはちょっとどうかなと思います。"
    },
    {
      "startSec": 322.7,
      "text": "とか、魚が全然食べられないとか。"
    },
    {
      "startSec": 325.8,
      "text": "野菜って必要ですよね、体にすごくいいし"
    },
    {
      "startSec": 332,
      "text": "ヘルシーだし、必要ですよね。"
    },
    {
      "startSec": 335.5,
      "text": "だからやっぱりバランスよく色んな物を食べることは"
    },
    {
      "startSec": 340.4,
      "text": "私はすごく大切だと思います。"
    },
    {
      "startSec": 344.5,
      "text": "よく私も…よくじゃない、"
    },
    {
      "startSec": 347.6,
      "text": "何回か友達のパーティーとかに"
    },
    {
      "startSec": 350.8,
      "text": "行ったりしたこともあります。"
    },
    {
      "startSec": 353.6,
      "text": "で、その時は「作ってくれてありがとう」"
    },
    {
      "startSec": 356.9,
      "text": "「用意してくれてありがとう」って言って"
    },
    {
      "startSec": 359.5,
      "text": "全部の物をちょっとずつ食べて"
    },
    {
      "startSec": 361.9,
      "text": "「あ、美味しい！本当にありがとう」って"
    },
    {
      "startSec": 364.8,
      "text": "気持ちを伝えました。"
    },
    {
      "startSec": 367.7,
      "text": "それが結構日本では当たり前だと思います。"
    },
    {
      "startSec": 374.7,
      "text": "食べ物を残すことは良くないし、"
    },
    {
      "startSec": 379.3,
      "text": "作ってくれた人に"
    },
    {
      "startSec": 381.1,
      "text": "ちゃんと感謝することもすごく大切。"
    },
    {
      "startSec": 386.2,
      "text": "で、色んな物をバランスよく"
    },
    {
      "startSec": 389.8,
      "text": "できるだけ好き嫌いはしないで食べることも大切です。"
    },
    {
      "startSec": 397.3,
      "text": "私の彼氏のイギリス人のジャックさんも同じ考えです。"
    },
    {
      "startSec": 405.2,
      "text": "イギリスの人はみんなそうか知らないけど、"
    },
    {
      "startSec": 410.6,
      "text": "結構食べ物は大切にする文化が"
    },
    {
      "startSec": 415,
      "text": "日本みたいにあるんじゃないかなと思います。"
    },
    {
      "startSec": 419.2,
      "text": "もちろん国によっても違うし"
    },
    {
      "startSec": 422.9,
      "text": "その家族、家庭によっても全然違いますよね。"
    },
    {
      "startSec": 429,
      "text": "良かったら皆さんもコメントで"
    },
    {
      "startSec": 432.9,
      "text": "皆さんの国のそういう食事の文化とかルール、"
    },
    {
      "startSec": 439.7,
      "text": "面白いルールとかあったら是非教えてください。"
    },
    {
      "startSec": 444.7,
      "text": "じゃあ今日はここまでです。"
    },
    {
      "startSec": 446.2,
      "text": "いつも本当にありがとうございます。"
    },
    {
      "startSec": 448.8,
      "text": "じゃあ良い一日を！バイバイ！"
    }
  ]
}
