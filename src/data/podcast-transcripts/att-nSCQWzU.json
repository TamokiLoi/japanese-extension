{
  "episodeId": "att-nSCQWzU",
  "segments": [
    {
      "startSec": 0,
      "text": "はい皆さん、こんにちは。"
    },
    {
      "startSec": 2,
      "text": "Bite size Japaneseのレイラです。"
    },
    {
      "startSec": 5.1,
      "text": "今日は白い服を着ています。"
    },
    {
      "startSec": 8.6,
      "text": "いつもポッドキャストでは黒い服なんですけど"
    },
    {
      "startSec": 12.6,
      "text": "洗濯中で白しかなかったので、白い服を着ています。"
    },
    {
      "startSec": 18.8,
      "text": "この前、ちこさんの娘さんに会いに行った時に"
    },
    {
      "startSec": 26.1,
      "text": "三月の話です。"
    },
    {
      "startSec": 28.2,
      "text": "ちこさんの娘さんがすっごく元気で面白くて"
    },
    {
      "startSec": 34.3,
      "text": "で、その日私は黒い服を着ていたんですね。"
    },
    {
      "startSec": 40.1,
      "text": "上も下も黒、全部黒みたいな"
    },
    {
      "startSec": 43.3,
      "text": "で、私は黒はスタイリッシュで"
    },
    {
      "startSec": 46.2,
      "text": "かっこいいと思っているんですが、"
    },
    {
      "startSec": 51.6,
      "text": "ちこさんの娘さん、みとちゃんが"
    },
    {
      "startSec": 56.5,
      "text": "「レイラ、レイラなんで黒ばっかり着てるの？"
    },
    {
      "startSec": 60.5,
      "text": "お葬式みたい」って言われました。"
    },
    {
      "startSec": 65.1,
      "text": "お葬式(funeral)"
    },
    {
      "startSec": 69.5,
      "text": "いや、子供はやっぱり面白いですね。"
    },
    {
      "startSec": 72.8,
      "text": "正直でいいですね。"
    },
    {
      "startSec": 76.2,
      "text": "今日は私の恋愛の話です。"
    },
    {
      "startSec": 85.3,
      "text": "私は今、もちろんジャックさんと付き合っているんですが、"
    },
    {
      "startSec": 90.7,
      "text": "ジャックと付き合い始めたのは、もう三年半前です。"
    },
    {
      "startSec": 97.6,
      "text": "三年間ずっと遠距離をしていました。"
    },
    {
      "startSec": 103.1,
      "text": "で、実はジャックと付き合う前に"
    },
    {
      "startSec": 107.5,
      "text": "日本の男の人と、日本の同級生、同級生は同い年。"
    },
    {
      "startSec": 116.2,
      "text": "同い年は、同じ年、同じ年齢の人で"
    },
    {
      "startSec": 122.4,
      "text": "同じ学校にいた人です。"
    },
    {
      "startSec": 126.6,
      "text": "その人と六年間一緒にいました。"
    },
    {
      "startSec": 132.2,
      "text": "付き合っていました。"
    },
    {
      "startSec": 134,
      "text": "で、その人と別れてジャックと付き合いました。"
    },
    {
      "startSec": 139.2,
      "text": "今日はその時の話を"
    },
    {
      "startSec": 141.5,
      "text": "ちょっとみんなにしたいなと思います。"
    },
    {
      "startSec": 145.9,
      "text": "私は中学生、高校生だった時は、"
    },
    {
      "startSec": 151.7,
      "text": "今よりも結構ストレスを感じていて"
    },
    {
      "startSec": 155.9,
      "text": "やっぱり学校で友達と仲良くするって"
    },
    {
      "startSec": 160.4,
      "text": "難しいじゃないですか。"
    },
    {
      "startSec": 162.8,
      "text": "私は学校は好きじゃなかったし"
    },
    {
      "startSec": 167.2,
      "text": "たくさんの人と一緒にいることが苦手だったので"
    },
    {
      "startSec": 173.3,
      "text": "でも結構他の人のことを"
    },
    {
      "startSec": 176.6,
      "text": "すごく気にしていたんですよね。"
    },
    {
      "startSec": 179.7,
      "text": "どんな風に自分が見られているか、"
    },
    {
      "startSec": 183.4,
      "text": "すごく気にしていました。"
    },
    {
      "startSec": 186.2,
      "text": "そんな時でした。"
    },
    {
      "startSec": 188.2,
      "text": "で私と付き合っていた男の子ですね、"
    },
    {
      "startSec": 193.2,
      "text": "もう十四歳くらいの時から付き合っていましたね。"
    },
    {
      "startSec": 199.2,
      "text": "その子はすごくいい子で"
    },
    {
      "startSec": 202.3,
      "text": "クラスの人気者、すごく人気がある"
    },
    {
      "startSec": 206.7,
      "text": "運動もできて、もう優しい子でした。"
    },
    {
      "startSec": 213.3,
      "text": "子って子供の子ですけど"
    },
    {
      "startSec": 216.6,
      "text": "友達とか若い人のことで"
    },
    {
      "startSec": 220.7,
      "text": "ちょっとフレンドリーに言う時は"
    },
    {
      "startSec": 223.6,
      "text": "「あの子」とか「その子」とか"
    },
    {
      "startSec": 226.6,
      "text": "「あの子、その子」って子を使います、人じゃなくて。"
    },
    {
      "startSec": 232,
      "text": "だからその子と付き合っていました。"
    },
    {
      "startSec": 235.9,
      "text": "ですごくいい人だったんだけど、"
    },
    {
      "startSec": 239.7,
      "text": "ちょっと私と違ったんですよね。"
    },
    {
      "startSec": 243.6,
      "text": "私はその時は、本当に"
    },
    {
      "startSec": 246,
      "text": "みんなとできるだけ同じようにしたい、"
    },
    {
      "startSec": 251,
      "text": "目立たないようにしたいって思っていたから"
    },
    {
      "startSec": 255,
      "text": "だからその子と多分、ずっと一緒にいたんだと思います。"
    },
    {
      "startSec": 260.4,
      "text": "もちろんすごく優しかったし、いい人だったんだけど"
    },
    {
      "startSec": 264.8,
      "text": "今考えるとすごく普通の人でした。"
    },
    {
      "startSec": 271.6,
      "text": "ユニークじゃない。"
    },
    {
      "startSec": 273.1,
      "text": "なんか特別すごいことがあるわけじゃなくて、"
    },
    {
      "startSec": 277.5,
      "text": "みんなから好かれる、"
    },
    {
      "startSec": 280.2,
      "text": "好きになってもらえるタイプの人。"
    },
    {
      "startSec": 283.7,
      "text": "でも、例えば私のジャックさんは全然普通じゃなくて、"
    },
    {
      "startSec": 289.7,
      "text": "多分ジャックが学校にいた時は"
    },
    {
      "startSec": 295.3,
      "text": "多分全然目立たないし、人気者じゃないし"
    },
    {
      "startSec": 301.6,
      "text": "他の人と違うことが好きなタイプの"
    },
    {
      "startSec": 306.8,
      "text": "男の子だったと思います。"
    },
    {
      "startSec": 309.8,
      "text": "本当の私はみんなと一緒が好きなんじゃなくて"
    },
    {
      "startSec": 315.2,
      "text": "やっぱり自分の好きなことを、とか"
    },
    {
      "startSec": 319.1,
      "text": "自分の考えを持っている人がすごく好きなんですね。"
    },
    {
      "startSec": 326,
      "text": "尊敬もします。"
    },
    {
      "startSec": 328.3,
      "text": "だからやっぱり本当の自分が好きなことに"
    },
    {
      "startSec": 333.8,
      "text": "二十歳くらいでちゃんと気が付いて、"
    },
    {
      "startSec": 338.1,
      "text": "他の人よりも、もっと自分を大切にしたいと思ったことが"
    },
    {
      "startSec": 346.9,
      "text": "やっぱり別れるきっかけになったと思います。"
    },
    {
      "startSec": 354.8,
      "text": "なんかこういう言い方をすると"
    },
    {
      "startSec": 357.2,
      "text": "その付き合っていた人にちょっと失礼なんですけど、"
    },
    {
      "startSec": 362.5,
      "text": "その時は本当に、彼のおかげで"
    },
    {
      "startSec": 365.6,
      "text": "私も他の友達と仲良くすることができたけど"
    },
    {
      "startSec": 371.5,
      "text": "これからの人生は、たくさん友達を作って"
    },
    {
      "startSec": 375.8,
      "text": "みんなに好かれよう、気に入られようとするよりも"
    },
    {
      "startSec": 380.7,
      "text": "もっと自分が大切なこと、自分が本当に大切な人、"
    },
    {
      "startSec": 386.7,
      "text": "家族とか動物とかそういうのをもっと大事にして"
    },
    {
      "startSec": 393.3,
      "text": "自分らしく生きていきたい、仕事もしたい"
    },
    {
      "startSec": 397.9,
      "text": "生活したいと思っています。"
    },
    {
      "startSec": 402.4,
      "text": "で、ジャックはそんな私に"
    },
    {
      "startSec": 405,
      "text": "本当にパーフェクトだったんですよね。"
    },
    {
      "startSec": 409.3,
      "text": "ジャックは私のことは全部認めてくれるし"
    },
    {
      "startSec": 415.9,
      "text": "やっぱり人生は自分のもの。"
    },
    {
      "startSec": 419.3,
      "text": "他の人のためのものじゃないし、"
    },
    {
      "startSec": 422.5,
      "text": "他の人と自分や、"
    },
    {
      "startSec": 424.9,
      "text": "他の人と自分の家族を比べて悲しくなったり"
    },
    {
      "startSec": 430.9,
      "text": "嫌な思いをするのは、"
    },
    {
      "startSec": 433,
      "text": "ちょっと違うなと思っています。"
    },
    {
      "startSec": 436.8,
      "text": "今日はこんな感じで"
    },
    {
      "startSec": 438.5,
      "text": "自分の恋愛について話してみました。"
    },
    {
      "startSec": 441.7,
      "text": "またこれからもこういうパーソナルな"
    },
    {
      "startSec": 444,
      "text": "今までの経験とかを"
    },
    {
      "startSec": 446.2,
      "text": "皆さんとシェアできたらいいなと思っています。"
    },
    {
      "startSec": 451.1,
      "text": "いつも聞いてくれてありがとうございます。"
    },
    {
      "startSec": 453.8,
      "text": "じゃあまた明日も聞いてください。"
    },
    {
      "startSec": 456.5,
      "text": "いつもありがとう！バイバイ！"
    }
  ]
}
